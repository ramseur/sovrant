# Sovrant environment configuration.
#
# Every variable below works from the shell, a container's environment (docker run -e,
# compose `environment:` / `env_file:`), or a `.env` file in the app's working directory
# (copy this file to .env). Values already in the process environment win over .env.
#
# Applies to: [all] = Server, Web, Desktop and CLI · [server] = Sovrant.Server only ·
#             [web] = Sovrant.Web only · [cli] = the sovrant CLI only
# A guard test (EnvExampleGuardTests) fails if a variable listed here isn't read by the code.

# ── How these variables relate to the app [all] ───────────────────────────────
# Keys and settings work the same way:
#   - Default: a value set here SEEDS the app once (written on start when nothing is stored yet).
#     After that the app's value wins, so changes an admin makes in the app stick.
#   - SOVRANT_ENV_OVERRIDE=true: values set here are FINAL. They're used on every start, and in the
#     app those settings and keys are shown disabled with a note naming the variable (saving them
#     is refused). For CI, ephemeral containers, and deployments managed as code.
# SOVRANT_ENV_OVERRIDE=false              # older name, still accepted: SOVRANT_ENV_KEYS_OVERRIDE

# ── Provider keys [all] ───────────────────────────────────────────────────────
# Keys are stored encrypted (AES-256-GCM credential store), seeded from here as described above.
#
# LLM_API_KEY also becomes one shared provider, owned by the first admin, in the default model set
# every personal workspace gets (unless the admin already chose a set), so a fresh container can
# chat with no setup. Members never need their own keys.
# LLM_API_KEY=sk-...                      # alias: OPENAI_API_KEY
# LLM_BASE_URL=https://openrouter.ai/api/v1  # default: inferred from the key (sk-or- → OpenRouter, sk-ant- → Anthropic), else OpenAI
# SOVRANT_MODEL=openai/gpt-4.1-mini       # default model when a user hasn't picked one
# OPENROUTER_API_KEY=sk-or-...            # live model metadata + pricing from OpenRouter
# BRAVE_API_KEY=                          # WebSearch via Brave
# FIRECRAWL_API_KEY=                      # WebSearch via Firecrawl

# ── Infrastructure endpoints (not secrets) [all] ──────────────────────────────
# PROVIDER_BASE_URL=https://api.anthropic.com   # Anthropic native API endpoint
# PROVIDER_API_KEY=                       # its key (imported like the keys above)

# ── Local models (opt-in) [all] ───────────────────────────────────────────────
# Sovrant contacts Ollama ONLY when an admin adds an Ollama provider
# (Admin → Providers) and enables it for your workspace (Admin → Workspaces).
# OLLAMA_BASE_URL just sets the address that new Ollama provider starts with;
# on its own it enables nothing. Leave unset and Ollama is never contacted.
# OLLAMA_BASE_URL=http://localhost:11434/v1

# ── Network ───────────────────────────────────────────────────────────────────
# SOVRANT_PORT=5200                        # [server] HTTP port (default 5200)
# SOVRANT_WEB_PORT=5100                    # [web] HTTP port (default 5100)
# SOVRANT_CORS_ORIGINS=https://app.example.com  # [server] comma-separated; overrides localhost defaults
# Behind a reverse proxy (Traefik, Caddy, nginx) [server, web]: X-Forwarded-For/-Proto/-Host
# are honoured from trusted proxies only. Loopback is trusted by default; add your proxy's
# address or network (e.g. a Docker network), or * to trust any sender (only when the app is
# reachable solely through the proxy).
# SOVRANT_TRUSTED_PROXIES=172.18.0.0/16,10.0.0.5

# ── TLS (disabled by default) [server, web] ───────────────────────────────────
# For development: dotnet dev-certs https --trust  (no config needed)
# For self-hosted: point to a PFX or separate PEM cert + key pair. Behind a TLS-terminating
# proxy, leave these unset and set SOVRANT_TRUSTED_PROXIES instead.
# SOVRANT_TLS_CERT=/etc/sovrant/certs/server.pfx
# SOVRANT_TLS_CERT_PASSWORD=changeme       # PFX passphrase only; omit for PEM
# SOVRANT_TLS_KEY=/etc/sovrant/certs/server.key  # PEM key; omit for PEM
# SOVRANT_TLS_HTTPS_PORT=5443             # defaults: 5443 (Server), 5101 (Web)

# ── Shared servers [server, web] ──────────────────────────────────────────────
# File and shell tools (Bash, Read/Write/Edit, Glob/Grep, background tasks, code tools) would run on
# the server itself, so they're off on Web and Server for everyone — admins included — unless this is
# on. Only for a server used by one trusted team. Also under Governance. (Phase 145 Part D.)
# SOVRANT_GOVERNANCE_HOST_FILE_TOOLS=false
# When the above is on, members (non-admins) also need this; otherwise only admins can use them.
# SOVRANT_GOVERNANCE_MEMBER_FILE_TOOLS=false

# ── Web sign-in [web] (Phase 145) ─────────────────────────────────────────────
# Each browser signs in separately (HttpOnly cookie). Signed out after this long without activity
# (renewed by activity), and after the absolute limit regardless; "Keep me signed in" lasts
# SOVRANT_WEB_REMEMBER_DAYS instead (0 turns it off). These seed the settings; admins change them
# under Users → Registration & sign-in (unless SOVRANT_ENV_OVERRIDE is on).
# SOVRANT_WEB_IDLE_MINUTES=60
# SOVRANT_WEB_MAX_SESSION_HOURS=12
# SOVRANT_WEB_REMEMBER_DAYS=14
# Any run (chat reply, workflow run, swarm, scheduled job) stops after this many minutes, keeping what it
# finished. Seeds the setting; admins change it under Users → Registration & sign-in. (Phase 145 A8.)
# SOVRANT_MAX_RUN_MINUTES=120

# ── Health checks [server, web] ───────────────────────────────────────────────
# GET /health (liveness + DB status) and, on Web, GET /ready (503 until start-up finishes).
# No variables needed; listed here so container probes know where to look.

# ── Remote mode [web] (Desktop picks this in its first-run screen) ────────────
# SOVRANT_RUNTIME_MODE=embedded           # embedded (default) | remote (use a Sovrant.Server)
# SOVRANT_SERVER_URL=http://localhost:5200  # the server to use in remote mode

# ── Model & session defaults [all] ────────────────────────────────────────────
# SOVRANT_COMPACT_THRESHOLD=80000         # token count that triggers context compaction; 0 = disabled

# ── Router [all] ──────────────────────────────────────────────────────────────
# ROUTER_MODE=Smart                       # Smart (default) | Fixed
# ROUTER_STRATEGY=Balanced                # Balanced (default) | Latency | Cost

# ── Intent-aware routing [all] ────────────────────────────────────────────────
# SOVRANT_INTENT_ROUTING=false            # enable tier selection based on message intent
# SOVRANT_FREE_MODELS_ONLY=false          # restrict routing to zero-cost models only
# SOVRANT_ROUTING_DEFAULT_TIER=standard   # fast | standard | high
# SOVRANT_ROUTING_AUTO_TIER=true          # auto-assign models to tiers from pricing
# SOVRANT_ROUTING_ESCALATION=true         # retry with higher tier on low-quality responses
# SOVRANT_ROUTING_MAX_ESCALATIONS=1       # max escalations per turn
# SOVRANT_TIER_MODELS={"fast":"auto","standard":"auto","high":"auto"}
# SOVRANT_ROUTING_RULES=[{"pattern":"fix.*bug","tier":"high"}]

# ── Workflow scheduler [server] ───────────────────────────────────────────────
# Sovrant.Server advances Planning/Running workflows in the background. (Web and Desktop in
# embedded mode advance a workflow when you press Run now / Resume.)
# SOVRANT_WORKFLOW_POLL_SECONDS=20        # seconds between scheduler ticks
# SOVRANT_WORKFLOW_MAX_CONCURRENT=3       # workflows advanced at once

# ── Agents [all] ──────────────────────────────────────────────────────────────
# AGENT_MODE=isolated                     # isolated (process-per-agent, default) | shared (in-process)

# ── Web search [all] ──────────────────────────────────────────────────────────
# SOVRANT_WEB_SEARCH=auto                 # auto | brave | firecrawl | native | off

# ── MCP server (opt-in) [server] ──────────────────────────────────────────────
# SOVRANT_MCP_HTTP=true                   # enable MCP HTTP/SSE endpoint at /mcp
# SOVRANT_MCP_TOKEN=                      # bearer token required for MCP access
# SOVRANT_MCP_TOOLS=                      # comma-separated tool allow-list (empty = all tools)

# ── Storage paths (defaults shown) [all] ──────────────────────────────────────
# SOVRANT_DB_PATH=~/.sovrant/data/sovrant.db
# SOVRANT_DB_REQUIRE=false                # true = fail fast on DB init errors (recommended for production)
# SOVRANT_DB_BACKUP_ON_UPGRADE=false      # true = snapshot DB before applying migrations
# SOVRANT_LOG_FILE=~/.sovrant/logs/sovrant-{Date}.log
# SOVRANT_ARTIFACTS_ROOT=~/.sovrant/artifacts
# SOVRANT_KEYSTORE_PATH=~/.sovrant/credentials/.keystore

# ── Logging [all] ─────────────────────────────────────────────────────────────
# SOVRANT_LOG_LEVEL=Information           # Verbose | Debug | Information | Warning | Error | Fatal
# SOVRANT_LOG_FORMAT=text                 # text (default) | json (structured, recommended for production)
# SOVRANT_LOG_CONSOLE=true               # false to suppress console output (e.g. when only file logging is needed)

# ── Production tuning [server] ────────────────────────────────────────────────
# SOVRANT_SESSION_TTL_SECONDS=3600        # idle session lifetime before eviction
# SOVRANT_MAX_SESSIONS=500                # max live sessions before LRU eviction
# SOVRANT_RATE_LIMIT_RPM=60              # per-session request rate limit (requests/minute)

# ── Identity [server, desktop, cli] ───────────────────────────────────────────
# SOVRANT_USER_ID=                        # override OS username for session ownership (before sign-in); Web uses each browser's sign-in
