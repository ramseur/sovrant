# Sovrant — environment variable reference
#
# Copy this file to `.env` and fill in the values you need, then load it
# into your shell before running Sovrant. Sovrant does NOT auto-load .env
# files — pick whichever method suits your shell:
#
#   bash/zsh:   set -a; source .env; set +a
#   PowerShell: Get-Content .env | ForEach-Object { if ($_ -match '^([^#=]+)=(.*)$') { [Environment]::SetEnvironmentVariable($matches[1], $matches[2]) } }
#   direnv:     rename to `.envrc`, prefix each line with `export `, then `direnv allow`
#
# Most variables are OPTIONAL. The minimum to run Sovrant against an LLM
# provider is one of the API keys in the "Provider credentials" section.
#
# Where each value lives at runtime
# ─────────────────────────────────
#   • Secrets (LLM_API_KEY, OPENAI_API_KEY, BRAVE_API_KEY, …)
#       env var (this file) → encrypted keystore (via `sovrant auth set <name>`)
#       → built-in default. Env wins. Prefer the keystore for persistent
#       installs; .env is most useful for CI / containers.
#   • Bootstrap paths (DB, log file, artifacts root, keystore, server token)
#       env var → CLI --config / --db-path → ./.sovrant/sovrant.config (project)
#       → ~/.sovrant/sovrant.config (user) → built-in default. See
#       sovrant.config.example at the repo root for the file format.
#   • All other runtime knobs (model, port, log level, governance, etc.)
#       env var → built-in default. (Some have UI-managed equivalents in
#       the Desktop/Web Settings page that persist to the DB.)

# ─────────────────────────────────────────────────────────────────────────────
# Provider credentials — set at least one
# ─────────────────────────────────────────────────────────────────────────────

# Primary LLM API key. Checked first by ConfigLoader. Use whichever provider
# you want to be the default (OpenAI, OpenRouter, Anthropic, Gemini, etc.).
# Alternative: omit this and run `sovrant auth set llm` to store the key
# encrypted in ~/.sovrant/data/sovrant.db (decrypted with the keystore).
LLM_API_KEY=

# Optional override of the LLM base URL (any OpenAI-compatible endpoint).
# Defaults to https://api.openai.com/v1 when unset.
# LLM_BASE_URL=https://openrouter.ai/api/v1

# OpenAI key — used as a fallback if LLM_API_KEY is not set.
# OPENAI_API_KEY=sk-proj-...

# Anthropic-style provider key (used by the native Messages API path).
# PROVIDER_API_KEY=sk-ant-...
# PROVIDER_BASE_URL=https://api.anthropic.com/v1

# OpenRouter key — enables live model discovery and pricing for the cost tracker.
# OPENROUTER_API_KEY=sk-or-v1-...

# Ollama (local models). Default base URL works out of the box if Ollama is running.
# OLLAMA_BASE_URL=http://localhost:11434/v1

# Web tools (optional). Set one of the search keys for explicit results;
# leave both unset to delegate to the model's built-in web search via
# SOVRANT_WEB_SEARCH=native (or auto, which prefers paid keys when set).
# BRAVE_API_KEY=
# FIRECRAWL_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Runtime configuration
# ─────────────────────────────────────────────────────────────────────────────

# Default model identifier sent to the provider. Can also be passed per-run
# via `--model`. Examples: gpt-4o-mini, anthropic/claude-sonnet-4, llama3.2.
# SOVRANT_MODEL=gpt-4o-mini

# SQLite database path. Defaults to ~/.sovrant/data/sovrant.db.
# SOVRANT_DB_PATH=

# Fail fast if the database cannot be initialized.
# SOVRANT_DB_REQUIRE=true

# Auto-backup the database before applying schema migrations.
# SOVRANT_DB_BACKUP_ON_UPGRADE=true

# Input-token threshold that triggers context auto-compaction.
# SOVRANT_COMPACT_THRESHOLD=80000

# User identifier used in multi-tenant scenarios. Defaults to OS username.
# SOVRANT_USER_ID=

# ─────────────────────────────────────────────────────────────────────────────
# Server mode (sovrant serve / Sovrant.Server)
# ─────────────────────────────────────────────────────────────────────────────

# HTTP server port. Default 5200.
# SOVRANT_PORT=5200

# Static bearer token required by the server when set. Required for production.
# SOVRANT_TOKEN=change-me-in-production

# Session lifecycle.
# SOVRANT_SESSION_TTL_SECONDS=3600
# SOVRANT_MAX_SESSIONS=500
# SOVRANT_RATE_LIMIT_RPM=60

# ─────────────────────────────────────────────────────────────────────────────
# Web app (Sovrant.Web — Blazor on port 5100)
# ─────────────────────────────────────────────────────────────────────────────

# embedded = run runtime in-process; remote = call a Sovrant server.
# SOVRANT_RUNTIME_MODE=embedded

# When SOVRANT_RUNTIME_MODE=remote, point at a running Sovrant server.
# SOVRANT_SERVER_URL=http://localhost:5200
# SOVRANT_API_TOKEN=change-me-in-production

# Active workspace/project for the web UI. Usually set by the UI itself.
# SOVRANT_WORKSPACE_ID=
# SOVRANT_PROJECT_ID=

# ─────────────────────────────────────────────────────────────────────────────
# Artifacts
# ─────────────────────────────────────────────────────────────────────────────

# Where artifacts are stored on disk. Defaults to ~/.sovrant/artifacts.
# SOVRANT_ARTIFACTS_ROOT=
# SOVRANT_ARTIFACTS_BACKEND=local
# SOVRANT_ARTIFACTS_URL_PREFIX=/artifacts
# SOVRANT_ARTIFACTS_MIGRATE_LEGACY=true

# ─────────────────────────────────────────────────────────────────────────────
# Bootstrap paths (also settable in sovrant.config — env wins)
# ─────────────────────────────────────────────────────────────────────────────

# Override the keystore master-key file. Defaults to
# ~/.sovrant/credentials/.keystore. The keystore decrypts the credentials
# table and provider-profile API keys in the SQLite DB.
# SOVRANT_KEYSTORE_PATH=

# Override the rolling log file path (alternative to SOVRANT_LOG_FILE in the
# logging block above; this entry exists for parity with sovrant.config).
# SOVRANT_LOG_FILE=

# ─────────────────────────────────────────────────────────────────────────────
# Routing
# ─────────────────────────────────────────────────────────────────────────────

# Smart (cost/latency/health scoring) or Fixed (always use SOVRANT_MODEL).
# ROUTER_MODE=Smart
# ROUTER_STRATEGY=Balanced

# Intent-aware tier routing (Fast / Standard / High).
# SOVRANT_INTENT_ROUTING=true

# Restrict routing to free-tier OpenRouter models only.
# SOVRANT_FREE_MODELS_ONLY=false

# ─────────────────────────────────────────────────────────────────────────────
# Logging & observability
# ─────────────────────────────────────────────────────────────────────────────

# SOVRANT_LOG_LEVEL=Information      # Debug | Information | Warning | Error
# SOVRANT_LOG_FILE=~/.sovrant/logs/sovrant-{Date}.log
# SOVRANT_LOG_CONSOLE=true
# SOVRANT_LOG_FORMAT=text             # text | json

# ─────────────────────────────────────────────────────────────────────────────
# Permissions, governance, hooks
# ─────────────────────────────────────────────────────────────────────────────

# SOVRANT_GOVERNANCE_LEVEL=standard   # minimal | standard | strict
# SOVRANT_HOOK_PROFILE=standard       # minimal | standard | strict
# SOVRANT_DISABLED_HOOKS=

# DANGEROUS — bypasses all permission prompts. Only safe inside CI sandboxes.
# SOVRANT_UNSAFE_DONTASK=false

# ─────────────────────────────────────────────────────────────────────────────
# Agent orchestration
# ─────────────────────────────────────────────────────────────────────────────

# isolated = process-per-agent (default); shared = in-process coordinator.
# AGENT_MODE=isolated

# ─────────────────────────────────────────────────────────────────────────────
# MCP server mode
# ─────────────────────────────────────────────────────────────────────────────

# Bearer token required by `sovrant mcp-server` (stdio transport). If unset,
# MCP server runs unauthenticated. Validated as a startup gate — callers pass
# the token via `--token`. See docs/mcp-server.md.
# SOVRANT_MCP_TOKEN=

# Enable MCP over HTTP/SSE on Sovrant.Server at /mcp. When true, IDE/agents
# can connect to the running server (port 5200) instead of spawning a child
# process. Reuses the server's bearer-token auth (SOVRANT_TOKEN). Default: false.
# SOVRANT_MCP_HTTP=false

# ─────────────────────────────────────────────────────────────────────────────
# Cost tracking
# ─────────────────────────────────────────────────────────────────────────────

# SOVRANT_COST_PROVIDER=openrouter    # openrouter | anthropic | none

# ─────────────────────────────────────────────────────────────────────────────
# Web search
# ─────────────────────────────────────────────────────────────────────────────

# Backend selector. Resolved once at startup and used by both the WebSearch
# tool and the per-provider native-search injection (OpenAI Responses
# web_search_preview, OpenRouter plugins, Anthropic web_search_20250305).
#
#   auto      — prefer Brave > Firecrawl > native (default)
#   brave     — Brave Search exclusively (requires BRAVE_API_KEY)
#   firecrawl — FireCrawl exclusively (requires FIRECRAWL_API_KEY)
#   native    — delegate to the model's built-in web search
#   off       — disable web search entirely
#
# Per-session override: /websearch <backend> in the CLI/Web/Desktop apps.
# See docs/web-search.md for the full decision matrix.
# SOVRANT_WEB_SEARCH=auto

# Legacy: LLM_WEB_SEARCH=true is equivalent to SOVRANT_WEB_SEARCH=native.
# Kept for back-compat; prefer the new variable. Emits a deprecation warning.
# LLM_WEB_SEARCH=false

# ─────────────────────────────────────────────────────────────────────────────
# Misc
# ─────────────────────────────────────────────────────────────────────────────

# Suppress ANSI color in the CLI (also: `--no-color` flag). https://no-color.org/
# NO_COLOR=1
