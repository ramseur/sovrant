# Sovrant environment configuration.
# Copy this file to .env in your working directory (or set these variables in
# your shell / CI environment). Values already in the process environment take
# precedence over this file.
#
# ┌─────────────────────────────────────────────────────────────────────────────┐
# │  API KEYS ARE NOT SET HERE                                                  │
# │  All provider credentials (LLM, web-search, etc.) are stored exclusively   │
# │  in the AES-256-GCM encrypted credential store. Use the setup wizard or    │
# │  admin settings UI to configure keys. They are never read from env vars.   │
# └─────────────────────────────────────────────────────────────────────────────┘

# ── Infrastructure endpoints (not secrets) ────────────────────────────────────
# PROVIDER_BASE_URL=https://api.anthropic.com   # Anthropic native API endpoint
# OLLAMA_BASE_URL=http://localhost:11434         # local Ollama service

# ── Server auth ───────────────────────────────────────────────────────────────
SOVRANT_TOKEN=                            # bearer token required for all API calls (server mode)

# ── Network ───────────────────────────────────────────────────────────────────
# SOVRANT_PORT=5200                        # HTTP port (default 5200)
# SOVRANT_CORS_ORIGINS=https://app.example.com  # comma-separated; overrides localhost defaults

# ── TLS (disabled by default) ─────────────────────────────────────────────────
# For development: dotnet dev-certs https --trust  (no config needed)
# For self-hosted: point to a PFX or separate PEM cert + key pair
# SOVRANT_TLS_CERT=/etc/sovrant/certs/server.pfx
# SOVRANT_TLS_CERT_PASSWORD=changeme       # PFX passphrase only; omit for PEM
# SOVRANT_TLS_KEY=/etc/sovrant/certs/server.key  # PEM key; omit for PEM
# SOVRANT_TLS_HTTPS_PORT=5443             # defaults: 5443 (Server), 5101 (Web)

# ── Model & session defaults ──────────────────────────────────────────────────
# SOVRANT_MODEL=gpt-4o                    # default model name
# SOVRANT_COMPACT_THRESHOLD=80000         # token count that triggers context compaction; 0 = disabled

# ── Router ────────────────────────────────────────────────────────────────────
# ROUTER_MODE=Smart                       # Smart (default) | Fixed
# ROUTER_STRATEGY=Balanced                # Balanced (default) | Latency | Cost

# ── Intent-aware routing ──────────────────────────────────────────────────────
# SOVRANT_INTENT_ROUTING=false            # enable tier selection based on message intent
# SOVRANT_FREE_MODELS_ONLY=false          # restrict routing to zero-cost models only
# SOVRANT_ROUTING_DEFAULT_TIER=standard   # fast | standard | high
# SOVRANT_ROUTING_AUTO_TIER=true          # auto-assign models to tiers from pricing
# SOVRANT_ROUTING_ESCALATION=true         # retry with higher tier on low-quality responses
# SOVRANT_ROUTING_MAX_ESCALATIONS=1       # max escalations per turn
# SOVRANT_TIER_MODELS={"fast":"auto","standard":"auto","high":"auto"}
# SOVRANT_ROUTING_RULES=[{"pattern":"fix.*bug","tier":"high"}]

# ── Agents ────────────────────────────────────────────────────────────────────
# AGENT_MODE=isolated                     # isolated (process-per-agent, default) | shared (in-process)

# ── Web search ────────────────────────────────────────────────────────────────
# SOVRANT_WEB_SEARCH=auto                 # auto | brave | firecrawl | native | off

# ── MCP server (opt-in) ───────────────────────────────────────────────────────
# SOVRANT_MCP_HTTP=true                   # enable MCP HTTP/SSE endpoint at /mcp
# SOVRANT_MCP_TOKEN=                      # bearer token required for MCP access
# SOVRANT_MCP_TOOLS=                      # comma-separated tool allow-list (empty = all tools)

# ── Storage paths (defaults shown) ────────────────────────────────────────────
# SOVRANT_DB_PATH=~/.sovrant/data/sovrant.db
# SOVRANT_DB_REQUIRE=false                # true = fail fast on DB init errors (recommended for production)
# SOVRANT_DB_BACKUP_ON_UPGRADE=false      # true = snapshot DB before applying migrations
# SOVRANT_LOG_FILE=~/.sovrant/logs/sovrant-{Date}.log
# SOVRANT_ARTIFACTS_ROOT=~/.sovrant/artifacts
# SOVRANT_KEYSTORE_PATH=~/.sovrant/credentials/.keystore

# ── Logging ───────────────────────────────────────────────────────────────────
# SOVRANT_LOG_LEVEL=Information           # Verbose | Debug | Information | Warning | Error | Fatal
# SOVRANT_LOG_FORMAT=text                 # text (default) | json (structured, recommended for production)

# ── Production tuning ─────────────────────────────────────────────────────────
# SOVRANT_SESSION_TTL_SECONDS=3600        # idle session lifetime before eviction
# SOVRANT_MAX_SESSIONS=500                # max live sessions before LRU eviction
# SOVRANT_RATE_LIMIT_RPM=60              # per-session request rate limit (requests/minute)
# SOVRANT_USER_ID=                        # override OS username for session ownership
