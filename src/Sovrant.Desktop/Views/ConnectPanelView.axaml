<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Sovrant.Desktop.ViewModels"
             x:Class="Sovrant.Desktop.Views.ConnectPanelView"
             x:DataType="vm:SidebarViewModel"
             Background="{DynamicResource SidebarBackground}">
    <ScrollViewer>
        <StackPanel Margin="10">
            <TextBlock Text="CONNECT" FontSize="11" FontWeight="Bold"
                       Foreground="{DynamicResource TextMuted}"
                       Margin="6,4,0,10" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
