<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Sovrant.Desktop.ViewModels"
             x:Class="Sovrant.Desktop.Views.AgentsPanelView"
             x:DataType="vm:SidebarViewModel"
             Background="{DynamicResource SidebarBackground}">
    <ScrollViewer>
        <StackPanel Margin="12,10,12,10">
            <TextBlock Text="AGENTS" FontSize="11.5" FontWeight="Bold"
                       Foreground="{DynamicResource TextMuted}"
                       Margin="9,4,0,8" />
            <Button Content="Library"
                    Command="{Binding NavigateCommand}" CommandParameter="Agents"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" VerticalContentAlignment="Center"
                    Padding="12,0" Height="40" Margin="0,1" CornerRadius="8" FontSize="13.5"
                    Background="{Binding SelectedNavItem, Converter={x:Static vm:NavActiveBrushConverter.SubNavBgSoft}, ConverterParameter=Agents}"
                    Foreground="{Binding SelectedNavItem, Converter={x:Static vm:NavActiveBrushConverter.SubNavFgOrText}, ConverterParameter=Agents}" />
            <Button Content="Orchestration"
                    Command="{Binding NavigateCommand}" CommandParameter="Orchestration"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" VerticalContentAlignment="Center"
                    Padding="12,0" Height="40" Margin="0,1" CornerRadius="8" FontSize="13.5"
                    Background="{Binding SelectedNavItem, Converter={x:Static vm:NavActiveBrushConverter.SubNavBgSoft}, ConverterParameter=Orchestration}"
                    Foreground="{Binding SelectedNavItem, Converter={x:Static vm:NavActiveBrushConverter.SubNavFgOrText}, ConverterParameter=Orchestration}" />
            <Button Content="Workflows"
                    Command="{Binding NavigateCommand}" CommandParameter="Workflows"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" VerticalContentAlignment="Center"
                    Padding="12,0" Height="40" Margin="0,1" CornerRadius="8" FontSize="13.5"
                    Background="{Binding SelectedNavItem, Converter={x:Static vm:NavActiveBrushConverter.SubNavBgSoft}, ConverterParameter=Workflows}"
                    Foreground="{Binding SelectedNavItem, Converter={x:Static vm:NavActiveBrushConverter.SubNavFgOrText}, ConverterParameter=Workflows}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
