<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Sovrant.Desktop.ViewModels"
             x:Class="Sovrant.Desktop.Views.SidebarView"
             x:DataType="vm:SidebarViewModel"
             Background="{DynamicResource SidebarBackground}">

    <DockPanel>
        <!-- Bottom: User profile -->
        <Border DockPanel.Dock="Bottom"
                Padding="12,10"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource SurfaceBorder}">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Border Width="28" Height="28" CornerRadius="14"
                        Background="{DynamicResource BrandPrimary}">
                    <TextBlock Text="{Binding UserInitial}" FontSize="12" FontWeight="SemiBold"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding CurrentUserName}" FontSize="11"
                               Foreground="{DynamicResource TextPrimary}" />
                    <TextBlock Text="Personal workspace" FontSize="9"
                               Foreground="{DynamicResource TextSecondary}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Main sidebar content -->
        <ScrollViewer>
            <StackPanel Margin="10,10,10,4">
                <!-- Logo row: icon + name + collapse button -->
                <DockPanel Margin="2,0,2,10">
                    <Button DockPanel.Dock="Right"
                            Content="◫"
                            Command="{Binding ToggleCollapseCommand}"
                            Padding="4,2"
                            FontSize="14"
                            Background="Transparent"
                            Foreground="{DynamicResource TextSecondary}"
                            CornerRadius="4"
                            VerticalAlignment="Center"
                            ToolTip.Tip="Collapse sidebar" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border Width="26" Height="26" CornerRadius="6"
                                Background="{DynamicResource BrandPrimary}">
                            <TextBlock Text="⚡" FontSize="13"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Sovrant" FontSize="17" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimary}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </DockPanel>

                <!-- + New Chat button (full width) -->
                <Button Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).NewChatCommand}"
                        HorizontalAlignment="Stretch"
                        Padding="10,7"
                        Margin="0,0,0,8"
                        Background="{DynamicResource BrandPrimary}"
                        Foreground="White"
                        CornerRadius="8"
                        FontWeight="SemiBold"
                        FontSize="13">
                    <DockPanel>
                        <Border DockPanel.Dock="Right"
                                Padding="5,2" CornerRadius="4"
                                Background="#8070B8"
                                VerticalAlignment="Center">
                            <TextBlock Text="⌘N" FontSize="9" Foreground="#E0E0E0" FontWeight="SemiBold" />
                        </Border>
                        <TextBlock Text="＋ New Chat" VerticalAlignment="Center" />
                    </DockPanel>
                </Button>

                <!-- Search -->
                <DockPanel Margin="0,0,0,8">
                    <TextBox Watermark="Search conversations..."
                             CornerRadius="8"
                             Padding="8,5"
                             FontSize="11" />
                </DockPanel>

                <!-- Provider/Model two-step switcher -->
                <Panel Margin="0,0,0,4">
                    <!-- Trigger button -->
                    <Button Command="{Binding ToggleDropdownCommand}"
                            HorizontalAlignment="Stretch"
                            Padding="8,6" CornerRadius="6"
                            Background="{DynamicResource SurfaceCard}"
                            BorderBrush="{DynamicResource SurfaceBorder}"
                            BorderThickness="1">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="▾" FontSize="12"
                                       Foreground="{DynamicResource TextMuted}"
                                       VerticalAlignment="Center" Margin="4,0,0,0" />
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                                         Fill="{DynamicResource StatusPass}"
                                         IsVisible="{Binding IsConnected}" />
                                <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                                         Fill="{DynamicResource StatusWarn}"
                                         IsVisible="{Binding !IsConnected}" />
                                <StackPanel Spacing="0">
                                    <TextBlock Text="{Binding CurrentModel}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}"
                                               TextTrimming="CharacterEllipsis" MaxWidth="160" />
                                    <TextBlock Text="{Binding CurrentProvider}" FontSize="9"
                                               Foreground="{DynamicResource TextSecondary}" />
                                </StackPanel>
                            </StackPanel>
                        </DockPanel>
                    </Button>

                    <!-- Dropdown popup -->
                    <Popup IsOpen="{Binding IsDropdownOpen, Mode=TwoWay}"
                           Placement="BottomEdgeAlignedLeft"
                           IsLightDismissEnabled="True"
                           MaxHeight="340">
                        <Border Background="{DynamicResource SurfaceCard}"
                                BorderBrush="{DynamicResource SurfaceBorder}"
                                BorderThickness="1" CornerRadius="8"
                                Padding="4" MinWidth="220"
                                BoxShadow="0 8 24 0 #59000000">
                            <StackPanel>
                                <!-- Step 1: Provider list -->
                                <StackPanel IsVisible="{Binding IsProviderStep}">
                                    <TextBlock Text="SELECT PROVIDER" FontSize="9" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextMuted}"
                                               Margin="8,4,0,4" />
                                    <ItemsControl ItemsSource="{Binding TreeGroups}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:ProviderTreeGroup">
                                                <Button Command="{Binding $parent[UserControl].((vm:SidebarViewModel)DataContext).SelectProviderCommand}"
                                                        CommandParameter="{Binding}"
                                                        HorizontalAlignment="Stretch"
                                                        HorizontalContentAlignment="Left"
                                                        Padding="8,5" Margin="0,1" CornerRadius="5"
                                                        Background="Transparent"
                                                        Foreground="{DynamicResource TextPrimary}">
                                                    <DockPanel>
                                                        <Border DockPanel.Dock="Right"
                                                                Padding="5,1" CornerRadius="8"
                                                                Background="{DynamicResource SurfaceBackground}"
                                                                VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding ModelCount}" FontSize="9"
                                                                       Foreground="{DynamicResource TextMuted}" />
                                                        </Border>
                                                        <TextBlock Text="{Binding Provider}" FontSize="12" FontWeight="Medium"
                                                                   VerticalAlignment="Center" />
                                                    </DockPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <!-- Step 2: Model list for selected provider -->
                                <StackPanel IsVisible="{Binding !IsProviderStep}">
                                    <Button Command="{Binding BackToProvidersCommand}"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            Padding="8,4" CornerRadius="5"
                                            Background="Transparent"
                                            Foreground="{DynamicResource TextSecondary}"
                                            FontSize="11">
                                        <TextBlock Text="◂ Back to providers" />
                                    </Button>
                                    <TextBlock Text="{Binding SelectedTreeGroup.Provider, StringFormat='{}{0} models'}"
                                               FontSize="9" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextMuted}"
                                               Margin="8,4,0,4" />
                                    <ScrollViewer MaxHeight="260">
                                        <ItemsControl ItemsSource="{Binding SelectedTreeGroup.Models}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:ModelOption">
                                                    <Button Command="{Binding $parent[UserControl].((vm:SidebarViewModel)DataContext).SelectModelCommand}"
                                                            CommandParameter="{Binding}"
                                                            HorizontalAlignment="Stretch"
                                                            HorizontalContentAlignment="Left"
                                                            Padding="10,4" Margin="0,1" CornerRadius="4"
                                                            Background="Transparent"
                                                            Foreground="{DynamicResource TextSecondary}"
                                                            FontSize="11">
                                                        <TextBlock Text="{Binding DisplayName}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Popup>
                </Panel>

                <!-- Active workspace/project context -->
                <Border Padding="8,6" Margin="0,0,0,8"
                        CornerRadius="6"
                        Background="{DynamicResource SurfaceCard}"
                        BorderBrush="{DynamicResource SurfaceBorder}"
                        BorderThickness="1">
                    <StackPanel Spacing="5">
                        <!-- Workspace selector -->
                        <StackPanel Spacing="2">
                            <TextBlock Text="🏢  Workspace" FontSize="9" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextMuted}" />
                            <ComboBox ItemsSource="{Binding ActiveContext.Workspaces}"
                                      SelectedItem="{Binding ActiveContext.SelectedWorkspace}"
                                      DisplayMemberBinding="{Binding Name}"
                                      HorizontalAlignment="Stretch"
                                      CornerRadius="4"
                                      Padding="6,3"
                                      FontSize="11" />
                        </StackPanel>
                        <!-- Project selector -->
                        <StackPanel Spacing="2">
                            <TextBlock Text="📁  Project" FontSize="9" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextMuted}" />
                            <ComboBox ItemsSource="{Binding ActiveContext.ProjectChoices}"
                                      SelectedItem="{Binding ActiveContext.SelectedProjectChoice}"
                                      DisplayMemberBinding="{Binding Name}"
                                      HorizontalAlignment="Stretch"
                                      CornerRadius="4"
                                      Padding="6,3"
                                      FontSize="11" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Primary nav -->
                <Button Content="💬  Chat"
                        Command="{Binding NavigateCommand}" CommandParameter="Chat"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Padding="10,5" Margin="0,1" CornerRadius="6" FontSize="13"
                        Background="Transparent" Foreground="{DynamicResource TextPrimary}" />
                <Button Content="⚙  Settings"
                        Command="{Binding NavigateCommand}" CommandParameter="Settings"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Padding="10,5" Margin="0,1" CornerRadius="6" FontSize="13"
                        Background="Transparent" Foreground="{DynamicResource TextPrimary}" />
                <Button Content="🔧  Diagnostics"
                        Command="{Binding NavigateCommand}" CommandParameter="Diagnostics"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Padding="10,5" Margin="0,1" CornerRadius="6" FontSize="13"
                        Background="Transparent" Foreground="{DynamicResource TextPrimary}" />

                <!-- Knowledge section -->
                <TextBlock Text="KNOWLEDGE" FontSize="9" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondary}"
                           Margin="4,10,0,4" />

                <Button Content="📄  Artifacts"
                        Command="{Binding NavigateCommand}" CommandParameter="Artifacts"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Padding="10,4" Margin="0,1" CornerRadius="6" FontSize="12"
                        Background="Transparent" Foreground="{DynamicResource TextPrimary}" />
                <Button Content="🛠  Tools"
                        Command="{Binding NavigateCommand}" CommandParameter="Tools"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Padding="10,4" Margin="0,1" CornerRadius="6" FontSize="12"
                        Background="Transparent" Foreground="{DynamicResource TextPrimary}" />
                <Button Content="📜  Skills"
                        Command="{Binding NavigateCommand}" CommandParameter="Skills"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Padding="10,4" Margin="0,1" CornerRadius="6" FontSize="12"
                        Background="Transparent" Foreground="{DynamicResource TextPrimary}" />
                <Button Content="🤖  Agents"
                        Command="{Binding NavigateCommand}" CommandParameter="Agents"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Padding="10,4" Margin="0,1" CornerRadius="6" FontSize="12"
                        Background="Transparent" Foreground="{DynamicResource TextPrimary}" />
                <Button Content="🧠  Memory"
                        Command="{Binding NavigateCommand}" CommandParameter="Memory"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Padding="10,4" Margin="0,1" CornerRadius="6" FontSize="12"
                        Background="Transparent" Foreground="{DynamicResource TextPrimary}" />

                <!-- Orchestration section -->
                <TextBlock Text="ORCHESTRATION" FontSize="9" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondary}"
                           Margin="4,10,0,4" />

                <Button Content="📁  Projects"
                        Command="{Binding NavigateCommand}" CommandParameter="Projects"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Padding="10,4" Margin="0,1" CornerRadius="6" FontSize="12"
                        Background="Transparent" Foreground="{DynamicResource TextPrimary}" />
                <Button Content="🏢  Workspaces"
                        Command="{Binding NavigateCommand}" CommandParameter="Workspaces"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Padding="10,4" Margin="0,1" CornerRadius="6" FontSize="12"
                        Background="Transparent" Foreground="{DynamicResource TextPrimary}" />
                <Button Content="👥  Multi-Agent"
                        Command="{Binding NavigateCommand}" CommandParameter="MultiAgent"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Padding="10,4" Margin="0,1" CornerRadius="6" FontSize="12"
                        Background="Transparent" Foreground="{DynamicResource TextPrimary}" />
                <Button Content="🔌  Integrations"
                        Command="{Binding NavigateCommand}" CommandParameter="Integrations"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Padding="10,4" Margin="0,1" CornerRadius="6" FontSize="12"
                        Background="Transparent" Foreground="{DynamicResource TextPrimary}" />
                <Button Content="⚡  Automations"
                        Command="{Binding NavigateCommand}" CommandParameter="Automations"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Padding="10,4" Margin="0,1" CornerRadius="6" FontSize="12"
                        Background="Transparent" Foreground="{DynamicResource TextPrimary}" />
                <Button Content="🛡  Governance"
                        Command="{Binding NavigateCommand}" CommandParameter="Governance"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Padding="10,4" Margin="0,1" CornerRadius="6" FontSize="12"
                        Background="Transparent" Foreground="{DynamicResource TextPrimary}" />

                <!-- Recent conversations -->
                <TextBlock Text="RECENT" FontSize="9" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondary}"
                           Margin="4,10,0,4" />

                <ItemsControl ItemsSource="{Binding RecentSessions}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:SessionListItem">
                            <DockPanel Margin="0,1">
                                <Button DockPanel.Dock="Right"
                                        Content="✕"
                                        Command="{Binding $parent[UserControl].((vm:SidebarViewModel)DataContext).DeleteSessionCommand}"
                                        CommandParameter="{Binding SessionId}"
                                        FontSize="9"
                                        Padding="3,1"
                                        Margin="2,0,0,0"
                                        VerticalAlignment="Center"
                                        Background="Transparent"
                                        Foreground="{DynamicResource TextMuted}"
                                        CornerRadius="4"
                                        ToolTip.Tip="Delete session" />
                                <Button Command="{Binding $parent[UserControl].((vm:SidebarViewModel)DataContext).ResumeSessionCommand}"
                                        CommandParameter="{Binding SessionId}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Padding="8,3"
                                        CornerRadius="4"
                                        Background="Transparent">
                                    <StackPanel Spacing="1">
                                        <TextBlock Text="{Binding Label}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextPrimary}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:MMM d, HH:mm}'}"
                                                   FontSize="9"
                                                   Foreground="{DynamicResource TextMuted}" />
                                    </StackPanel>
                                </Button>
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="No recent conversations"
                           FontSize="10"
                           Foreground="{DynamicResource TextSecondary}"
                           IsVisible="{Binding !RecentSessions.Count}"
                           Margin="4,0" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
