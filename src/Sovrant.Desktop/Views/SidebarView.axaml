<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Sovrant.Desktop.ViewModels"
             x:Class="Sovrant.Desktop.Views.SidebarView"
             x:DataType="vm:SidebarViewModel"
             Background="{DynamicResource SidebarBackground}">

    <!-- Phase 133 — conversation folders. Same structure as docs/design/desktop.html (Chat screen):
         search + New folder, FOLDERS tree, UNFILED, ⋯ menus, drag and drop. -->
    <UserControl.Styles>
        <Style Selector="Border.sfrow">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="0,4,4,4" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Border.sfrow:pointerover">
            <Setter Property="Background" Value="{DynamicResource SurfaceHover}" />
        </Style>
        <Style Selector="Border.sfrow.on">
            <Setter Property="Background" Value="{DynamicResource BrandPrimarySoft}" />
        </Style>
        <Style Selector="Border.sfrow.on TextBlock.sfname">
            <Setter Property="Foreground" Value="{DynamicResource BrandPrimary}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Border.sfrow.dragging">
            <Setter Property="Opacity" Value="0.4" />
        </Style>
        <Style Selector="Border.drop">
            <Setter Property="Background" Value="{DynamicResource BrandPrimarySoft}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrandPrimary}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
        <Style Selector="Border.nodrop">
            <Setter Property="BorderBrush" Value="{DynamicResource StatusFail}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
        <Style Selector="TextBlock.sfmeta">
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
        </Style>
        <Style Selector="TextBlock.sfmeta.active">
            <Setter Property="Foreground" Value="{DynamicResource StatusPass}" />
        </Style>
        <Style Selector="Button.sfmore">
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="Border.sfrow:pointerover Button.sfmore">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Border.sfhead">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="2,4" />
            <Setter Property="Margin" Value="0,8,0,4" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
    </UserControl.Styles>

    <UserControl.Resources>
        <DataTemplate x:Key="SfRowTemplate" x:DataType="vm:SessionTreeRowViewModel">
            <Border Classes="sfrow"
                    Classes.on="{Binding IsCurrent}"
                    Classes.dragging="{Binding IsDragging}"
                    Classes.drop="{Binding IsValidDrop}"
                    Classes.nodrop="{Binding IsRefusedDrop}"
                    DragDrop.AllowDrop="{Binding IsFolder}"
                    ToolTip.Tip="{Binding Text}">
                <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" Margin="{Binding Indent}">
                    <!-- Chevron (folders) -->
                    <Path Grid.Column="0" Data="{StaticResource IconChevronRight}"
                          Width="12" Height="12" Stretch="Uniform" Margin="0,0,7,0"
                          Stroke="{DynamicResource TextMuted}" StrokeThickness="2.4" Fill="Transparent"
                          StrokeLineCap="Round" StrokeJoin="Round" VerticalAlignment="Center"
                          IsVisible="{Binding IsFolder}">
                        <Path.RenderTransform>
                            <RotateTransform Angle="{Binding ChevronAngle}" />
                        </Path.RenderTransform>
                    </Path>
                    <Border Grid.Column="0" Width="19" IsVisible="{Binding IsSession}" />

                    <!-- Folder icon, or the conversation dot (green while a turn is running) -->
                    <Path Grid.Column="1" Data="{StaticResource IconFolder}"
                          Width="15" Height="15" Stretch="Uniform" Margin="0,0,7,0"
                          Stroke="{DynamicResource TextMuted}" StrokeThickness="1.9" Fill="Transparent"
                          StrokeLineCap="Round" StrokeJoin="Round" VerticalAlignment="Center"
                          IsVisible="{Binding IsFolder}" />
                    <Panel Grid.Column="1" IsVisible="{Binding IsSession}" Margin="4,0,10,0" VerticalAlignment="Center">
                        <Ellipse Width="6" Height="6" Fill="{DynamicResource TextMuted}" IsVisible="{Binding !IsRunning}" />
                        <Ellipse Width="6" Height="6" Fill="{DynamicResource StatusPass}" IsVisible="{Binding IsRunning}" />
                    </Panel>

                    <!-- Title + derived link labels -->
                    <StackPanel Grid.Column="2" Spacing="1" VerticalAlignment="Center">
                        <TextBlock Classes="sfname" Text="{Binding Text}" FontSize="13"
                                   Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Classes="sfmeta" Text="{Binding Meta}" IsVisible="{Binding HasMeta}" FontSize="11"
                                   TextTrimming="CharacterEllipsis"
                                   Classes.active="{Binding MetaActive}" />
                        <TextBlock Text="{Binding DropRefusal}" IsVisible="{Binding HasDropRefusal}" FontSize="11"
                                   Foreground="{DynamicResource StatusFail}" TextWrapping="Wrap" />
                    </StackPanel>

                    <TextBlock Grid.Column="3" Text="{Binding Count}" IsVisible="{Binding IsFolder}"
                               FontSize="11" Foreground="{DynamicResource TextMuted}"
                               VerticalAlignment="Center" Margin="4,0" />

                    <!-- ⋯ menu -->
                    <Button Grid.Column="4" Classes="sfmore" Width="24" Height="24" Padding="0"
                            Background="Transparent" CornerRadius="6" VerticalAlignment="Center"
                            ToolTip.Tip="More">
                        <Path Data="{StaticResource IconDots}" Width="15" Height="15" Stretch="Uniform"
                              Stroke="{DynamicResource TextMuted}" StrokeThickness="2.4" Fill="Transparent"
                              StrokeLineCap="Round" StrokeJoin="Round" />
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuItem Header="New subfolder" IsVisible="{Binding IsFolder}" IsEnabled="{Binding CanAddSubfolder}"
                                          Command="{Binding $parent[UserControl].((vm:SidebarViewModel)DataContext).NewSubfolderCommand}"
                                          CommandParameter="{Binding}" />
                                <MenuItem Header="Rename"
                                          Command="{Binding $parent[UserControl].((vm:SidebarViewModel)DataContext).RenameRowCommand}"
                                          CommandParameter="{Binding}" />
                                <MenuItem Header="Move to…" IsVisible="{Binding IsFolder}"
                                          Command="{Binding $parent[UserControl].((vm:SidebarViewModel)DataContext).MoveRowCommand}"
                                          CommandParameter="{Binding}" />
                                <MenuItem Header="Move to folder…" IsVisible="{Binding IsSession}"
                                          Command="{Binding $parent[UserControl].((vm:SidebarViewModel)DataContext).MoveRowCommand}"
                                          CommandParameter="{Binding}" />
                                <Separator />
                                <MenuItem Header="Delete folder" IsVisible="{Binding IsFolder}" Foreground="{DynamicResource StatusFail}"
                                          Command="{Binding $parent[UserControl].((vm:SidebarViewModel)DataContext).DeleteFolderCommand}"
                                          CommandParameter="{Binding}" />
                                <MenuItem IsVisible="{Binding IsFolder}" IsEnabled="False">
                                    <MenuItem.Header>
                                        <TextBlock Text="{Binding DeleteHint}" TextWrapping="Wrap" MaxWidth="220" FontSize="11" />
                                    </MenuItem.Header>
                                </MenuItem>
                                <MenuItem Header="Delete conversation" IsVisible="{Binding IsSession}" Foreground="{DynamicResource StatusFail}"
                                          Command="{Binding $parent[UserControl].((vm:SidebarViewModel)DataContext).DeleteRowSessionCommand}"
                                          CommandParameter="{Binding}" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel>
        <!-- Phase 69: shared sidebar footer (in MainWindow) owns the user info; Chat panel just renders chat tools. -->
        <ScrollViewer x:Name="TreeScroller">
            <StackPanel Margin="12,8,12,4">

                <!-- Search + New folder -->
                <DockPanel Margin="0,0,0,10">
                    <Button DockPanel.Dock="Right" Width="30" Height="30" Padding="0" Margin="6,0,0,0"
                            Background="Transparent" CornerRadius="8" ToolTip.Tip="New folder"
                            Command="{Binding NewFolderCommand}">
                        <Path Data="{StaticResource IconFolderPlus}" Width="16" Height="16" Stretch="Uniform"
                              Stroke="{DynamicResource TextSecondary}" StrokeThickness="2" Fill="Transparent"
                              StrokeLineCap="Round" StrokeJoin="Round" />
                    </Button>
                    <TextBox Watermark="Search conversations..."
                             Text="{Binding SearchText}"
                             CornerRadius="9"
                             Padding="10,7"
                             FontSize="13.5" />
                </DockPanel>

                <!-- Inline error (a refused folder change) -->
                <Border IsVisible="{Binding HasFolderError}" CornerRadius="8" Padding="8,6" Margin="0,0,0,8"
                        Background="{DynamicResource SurfaceHover}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="✕" Padding="4,0" Background="Transparent"
                                Foreground="{DynamicResource StatusFail}" Command="{Binding DismissFolderErrorCommand}" />
                        <TextBlock Text="{Binding FolderError}" TextWrapping="Wrap" FontSize="12"
                                   Foreground="{DynamicResource StatusFail}" />
                    </DockPanel>
                </Border>

                <!-- Search results (across every folder) -->
                <StackPanel IsVisible="{Binding IsSearching}">
                    <TextBlock Text="RESULTS" FontSize="10.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondary}" Margin="2,4,0,4" />
                    <ItemsControl ItemsSource="{Binding SearchRows}" ItemTemplate="{StaticResource SfRowTemplate}" />
                    <TextBlock Text="No matching conversations" FontSize="12" Margin="2,0"
                               Foreground="{DynamicResource TextSecondary}" IsVisible="{Binding !HasSearchRows}" />
                </StackPanel>

                <StackPanel IsVisible="{Binding IsBrowsing}">
                    <!-- FOLDERS (drop a folder on the heading to move it to the top level) -->
                    <Border x:Name="TopHead" Classes="sfhead"
                            Classes.drop="{Binding IsTopValidDrop}" Classes.nodrop="{Binding IsTopRefusedDrop}"
                            DragDrop.AllowDrop="True" IsVisible="{Binding HasFolders}">
                        <StackPanel>
                            <TextBlock Text="FOLDERS" FontSize="10.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondary}" />
                            <TextBlock Text="{Binding HeadDropRefusal}" IsVisible="{Binding HasTopDropRefusal}"
                                       FontSize="11" Foreground="{DynamicResource StatusFail}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <ItemsControl ItemsSource="{Binding FolderRows}" ItemTemplate="{StaticResource SfRowTemplate}" />

                    <!-- UNFILED (drop a conversation on the heading to unfile it) -->
                    <Border x:Name="UnfiledHead" Classes="sfhead"
                            Classes.drop="{Binding IsUnfiledValidDrop}" Classes.nodrop="{Binding IsUnfiledRefusedDrop}"
                            DragDrop.AllowDrop="True">
                        <StackPanel>
                            <TextBlock Text="{Binding UnfiledHeader}" FontSize="10.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondary}" />
                            <TextBlock Text="{Binding HeadDropRefusal}" IsVisible="{Binding HasUnfiledDropRefusal}"
                                       FontSize="11" Foreground="{DynamicResource StatusFail}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <ItemsControl ItemsSource="{Binding UnfiledRows}" ItemTemplate="{StaticResource SfRowTemplate}" />
                    <TextBlock Text="{Binding UnfiledEmptyText}" FontSize="12" Margin="2,0"
                               Foreground="{DynamicResource TextSecondary}" IsVisible="{Binding !HasUnfiled}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
