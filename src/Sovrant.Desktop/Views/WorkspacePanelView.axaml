<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Sovrant.Desktop.ViewModels"
             xmlns:ctrl="using:Sovrant.Desktop.Controls"
             x:Class="Sovrant.Desktop.Views.WorkspacePanelView"
             x:DataType="vm:SidebarViewModel"
             Background="{DynamicResource SidebarBackground}">
    <ScrollViewer>
        <StackPanel Margin="10">
            <TextBlock Text="PROJECTS" FontSize="11" FontWeight="Bold"
                       Foreground="{DynamicResource TextMuted}"
                       Margin="6,4,0,10" />
            <Button Command="{Binding NavigateCommand}" CommandParameter="Projects"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                    Padding="10,6" Margin="0,1" CornerRadius="6" FontSize="13"
                    Background="{Binding SelectedNavItem, Converter={x:Static vm:NavActiveBrushConverter.SubNavBg}, ConverterParameter=Projects}"
                    Foreground="{DynamicResource TextPrimary}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ctrl:SovrantIcon IconName="folder" Width="14" Height="14" />
                    <TextBlock Text="Projects" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

        </StackPanel>
    </ScrollViewer>
</UserControl>
