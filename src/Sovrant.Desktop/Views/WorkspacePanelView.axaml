<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Sovrant.Desktop.ViewModels"
             x:Class="Sovrant.Desktop.Views.WorkspacePanelView"
             x:DataType="vm:SidebarViewModel"
             Background="{DynamicResource SidebarBackground}">
    <ScrollViewer>
        <StackPanel Margin="12,10,12,10">
            <TextBlock Text="PROJECTS" FontSize="11.5" FontWeight="Bold"
                       Foreground="{DynamicResource TextMuted}"
                       Margin="9,4,0,8" />
            <Button Content="Projects"
                    Command="{Binding NavigateCommand}" CommandParameter="Projects"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" VerticalContentAlignment="Center"
                    Padding="12,0" Height="40" Margin="0,1" CornerRadius="8" FontSize="13.5"
                    Background="{Binding SelectedNavItem, Converter={x:Static vm:NavActiveBrushConverter.SubNavBgSoft}, ConverterParameter=Projects}"
                    Foreground="{Binding SelectedNavItem, Converter={x:Static vm:NavActiveBrushConverter.SubNavFgOrText}, ConverterParameter=Projects}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
