<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="using:Sovrant.Desktop.Controls"
             xmlns:ui="using:Sovrant.Api.Ui"
             xmlns:vm="using:Sovrant.Desktop.ViewModels"
             xmlns:views="using:Sovrant.Desktop.Views"
             xmlns:onb="using:Sovrant.Runtime.Onboarding"
             x:Class="Sovrant.Desktop.Views.UserDashboardView"
             x:DataType="vm:UserDashboardViewModel"
             Background="{DynamicResource SurfaceBackground}">

    <!-- Phase 142 — Home has two tabs. Overview (always opens first): the guide, centred like the chat
         welcome and sized for a laptop screen. Activity: the report (stats + table), unchanged.
         See docs/design/desktop.html → Home. -->
    <UserControl.Styles>
        <Style Selector="Button.hometab">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0,0,0,2" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.hometab.on">
            <Setter Property="BorderBrush" Value="{DynamicResource BrandPrimary}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        </Style>
        <Style Selector="Button.hometab:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.glance">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="13,0" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="CornerRadius" Value="15" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorder}" />
            <Setter Property="Background" Value="{DynamicResource SurfaceCard}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.glance:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BorderBrush" Value="{DynamicResource BrandPrimary}" />
            <Setter Property="Background" Value="{DynamicResource SurfaceCard}" />
        </Style>
    </UserControl.Styles>

    <DockPanel>
        <!-- Tabs -->
        <Border DockPanel.Dock="Top" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource SurfaceBorder}" Margin="32,10,32,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"
                            IsVisible="{Binding !IsOverview}">
                    <TextBlock FontSize="11" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"
                               IsVisible="{Binding LastRefreshed, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <Run Text="Last updated: " /><Run Text="{Binding LastRefreshed}" />
                    </TextBlock>
                    <Button Content="Refresh" Command="{Binding RefreshCommand}"
                            Padding="12,5" CornerRadius="6"
                            Background="Transparent" Foreground="{DynamicResource TextPrimary}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <Button Classes="hometab" Classes.on="{Binding IsOverview}" Content="Overview" Command="{Binding ShowOverviewCommand}" />
                    <Button Classes="hometab" Classes.on="{Binding !IsOverview}" Content="Activity" Command="{Binding ShowActivityCommand}" />
                </StackPanel>
            </DockPanel>
        </Border>

    <ScrollViewer x:Name="HomeScroll" HorizontalScrollBarVisibility="Disabled">
    <Panel>
        <!-- Overview: the guide -->
        <StackPanel IsVisible="{Binding IsOverview}" MaxWidth="1080" Margin="28,12,28,16" Spacing="14">
            <StackPanel Spacing="6" HorizontalAlignment="Center" Margin="0,0,0,6">
                <TextBlock Text="{Binding Guide.Greeting}" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextPrimary}" />
                <TextBlock Text="{x:Static onb:OnboardingService.Tagline}" FontSize="14" TextWrapping="Wrap"
                           TextAlignment="Center" MaxWidth="760" HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextSecondary}" />
            </StackPanel>

            <!-- At a glance: the six stats; each opens Activity -->
            <ItemsControl ItemsSource="{Binding Glance}" HorizontalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:GlanceItem">
                        <Button Classes="glance" ToolTip.Tip="Open Activity"
                                Command="{Binding $parent[UserControl].((vm:UserDashboardViewModel)DataContext).ShowActivityCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="{Binding Value}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Label}" FontSize="12" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <views:HomeGuideView DataContext="{Binding Guide}" />
        </StackPanel>

        <!-- Activity: the report -->
        <StackPanel IsVisible="{Binding !IsOverview}">
        <StackPanel Margin="32,14,32,0" Spacing="8">
            <!-- Wraps at any width (the old WrapPanel kept it on one line and cut it off). -->
            <DockPanel>
                <Button DockPanel.Dock="Right" Command="{Binding ToggleHelpCommand}" VerticalAlignment="Top"
                        Padding="10,0,0,0" Background="Transparent" BorderThickness="0"
                        Foreground="{DynamicResource BrandPrimary}" FontSize="12" Cursor="Hand">
                    <TextBlock Text="{Binding HelpToggleLabel}" TextDecorations="Underline" />
                </Button>
                <TextBlock FontSize="12.5" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}"
                           Text="Your activity across every workspace you belong to — plus your teammates' public activity." />
            </DockPanel>

            <TextBlock Text="{Binding ErrorMessage}"
                       FontSize="11"
                       Foreground="{DynamicResource StatusFail}"
                       IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                       TextWrapping="Wrap" />

            <!-- Help / explainer panel -->
            <Border IsVisible="{Binding ShowHelp}"
                    Background="{DynamicResource SurfaceCard}"
                    BorderBrush="{DynamicResource SurfaceBorder}" BorderThickness="1"
                    CornerRadius="8" Padding="16,12" Margin="0,8,0,0">
                <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="130,*">
                        <TextBlock Grid.Column="0" Text="Workflows" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Top" />
                        <TextBlock Grid.Column="1" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondary}" FontSize="12"
                                   Text="Long-running goals you own across all workspaces. A workflow decomposes into team runs and agent runs until the goal is complete." />
                    </Grid>
                    <Grid ColumnDefinitions="130,*">
                        <TextBlock Grid.Column="0" Text="Team runs" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Top" />
                        <TextBlock Grid.Column="1" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondary}" FontSize="12"
                                   Text="Team executions you kicked off — a group of agents running together under a sequential, parallel, or swarm profile." />
                    </Grid>
                    <Grid ColumnDefinitions="130,*">
                        <TextBlock Grid.Column="0" Text="Agent runs" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Top" />
                        <TextBlock Grid.Column="1" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondary}" FontSize="12"
                                   Text="Solo agent runs you launched directly from the Agents page, or as individual members of a team run." />
                    </Grid>
                    <Grid ColumnDefinitions="130,*">
                        <TextBlock Grid.Column="0" Text="Sessions" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Top" />
                        <TextBlock Grid.Column="1" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondary}" FontSize="12"
                                   Text="Chat conversations you started. Private sessions are only visible to you; public ones are visible to workspace admins." />
                    </Grid>
                    <Grid ColumnDefinitions="130,*">
                        <TextBlock Grid.Column="0" Text="Shared" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Top" />
                        <TextBlock Grid.Column="1" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondary}" FontSize="12"
                                   Text="Your own items you've made public — workflows, runs, and sessions with the privacy toggle set to public. These are visible to workspace admins and teammates." />
                    </Grid>
                    <Grid ColumnDefinitions="130,*">
                        <TextBlock Grid.Column="0" Text="Claws" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Top" />
                        <TextBlock Grid.Column="1" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondary}" FontSize="12"
                                   Text="External MCP systems Sovrant is connected to (n8n, Zapier, custom servers). Sovrant monitors and steers them from the Command Center." />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- KPI tiles -->
            <UniformGrid Rows="1" Columns="6" Margin="0,8,0,0">
                <Border Background="{DynamicResource SurfaceCard}"
                        BorderBrush="{DynamicResource SurfaceBorder}" BorderThickness="1"
                        CornerRadius="8" Padding="14,12" Margin="0,0,8,0"
                        ToolTip.Tip="Long-running goals you own.">
                    <StackPanel>
                        <TextBlock Text="MY WORKFLOWS" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                        <TextBlock Text="{Binding OwnWorkflows}" FontSize="24" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}" />
                    </StackPanel>
                </Border>
                <Border Background="{DynamicResource SurfaceCard}"
                        BorderBrush="{DynamicResource SurfaceBorder}" BorderThickness="1"
                        CornerRadius="8" Padding="14,12" Margin="0,0,8,0"
                        ToolTip.Tip="Team executions you kicked off.">
                    <StackPanel>
                        <TextBlock Text="MY TEAM RUNS" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                        <TextBlock Text="{Binding OwnTeamRuns}" FontSize="24" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}" />
                    </StackPanel>
                </Border>
                <Border Background="{DynamicResource SurfaceCard}"
                        BorderBrush="{DynamicResource SurfaceBorder}" BorderThickness="1"
                        CornerRadius="8" Padding="14,12" Margin="0,0,8,0"
                        ToolTip.Tip="Solo agent runs you launched.">
                    <StackPanel>
                        <TextBlock Text="MY AGENT RUNS" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                        <TextBlock Text="{Binding OwnAgentRuns}" FontSize="24" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}" />
                    </StackPanel>
                </Border>
                <Border Background="{DynamicResource SurfaceCard}"
                        BorderBrush="{DynamicResource SurfaceBorder}" BorderThickness="1"
                        CornerRadius="8" Padding="14,12" Margin="0,0,8,0"
                        ToolTip.Tip="Chat conversations you started.">
                    <StackPanel>
                        <TextBlock Text="MY SESSIONS" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                        <TextBlock Text="{Binding OwnSessions}" FontSize="24" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}" />
                    </StackPanel>
                </Border>
                <Border Background="{DynamicResource SurfaceCard}"
                        BorderBrush="{DynamicResource SurfaceBorder}" BorderThickness="1"
                        CornerRadius="8" Padding="14,12" Margin="0,0,8,0"
                        ToolTip.Tip="Your items you've made public — visible to workspace teammates.">
                    <StackPanel>
                        <TextBlock Text="SHARED (PUBLIC)" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                        <TextBlock Text="{Binding OthersPublicRows}" FontSize="24" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}" />
                    </StackPanel>
                </Border>
                <Border Background="{DynamicResource SurfaceCard}"
                        BorderBrush="{DynamicResource SurfaceBorder}" BorderThickness="1"
                        CornerRadius="8" Padding="14,12"
                        ToolTip.Tip="External MCP systems Sovrant is connected to.">
                    <StackPanel>
                        <TextBlock Text="CLAWS" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                        <TextBlock Text="{Binding Claws}" FontSize="24" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}" />
                    </StackPanel>
                </Border>
            </UniformGrid>
        </StackPanel>

        <!-- Empty state -->
        <StackPanel DockPanel.Dock="Top" HorizontalAlignment="Center" Margin="0,40"
                    Spacing="10" IsVisible="{Binding IsEmpty}">
            <TextBlock Text="Nothing yet" FontSize="18" FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource TextPrimary}" />
            <TextBlock TextWrapping="Wrap" MaxWidth="480"
                       HorizontalAlignment="Center" TextAlignment="Center"
                       Foreground="{DynamicResource TextSecondary}"
                       Text="Start a chat or run an agent template — your activity and your teammates' public activity will appear here." />
        </StackPanel>

        <!-- Content -->
        <DockPanel Margin="32,8,32,24" IsVisible="{Binding !IsEmpty}">
            <Border DockPanel.Dock="Top"
                    Background="{DynamicResource SurfaceCard}"
                    BorderBrush="{DynamicResource SurfaceBorder}" BorderThickness="1"
                    CornerRadius="8,8,0,0" Padding="14,8" Margin="0,0,0,-1">
                <Grid ColumnDefinitions="120,28,*,90,150,110,80">
                    <TextBlock Grid.Column="0" Text="KIND" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondary}" />
                    <!-- Column 1: blank — aligns with the per-row lock icon -->
                    <TextBlock Grid.Column="2" Text="TITLE" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondary}" />
                    <TextBlock Grid.Column="3" Text="STATUS" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondary}" />
                    <TextBlock Grid.Column="4" Text="OWNER" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondary}" />
                    <TextBlock Grid.Column="5" Text="LAST ACTIVITY" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondary}" />
                    <TextBlock Grid.Column="6" Text="COST" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondary}" />
                </Grid>
            </Border>
            <!-- Pager — must be declared before ScrollViewer so DockPanel places it at the bottom -->
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Center"
                        Spacing="12" Margin="0,8,0,0"
                        IsVisible="{Binding PageInfo, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <Button Content="← Prev" Command="{Binding PreviousPageCommand}"
                        IsEnabled="{Binding HasPreviousPage}"
                        Padding="12,5" CornerRadius="6"
                        Background="Transparent" Foreground="{DynamicResource TextPrimary}" />
                <TextBlock Text="{Binding PageInfo}" VerticalAlignment="Center"
                           FontSize="12" Foreground="{DynamicResource TextMuted}" />
                <Button Content="Next →" Command="{Binding NextPageCommand}"
                        IsEnabled="{Binding HasNextPage}"
                        Padding="12,5" CornerRadius="6"
                        Background="Transparent" Foreground="{DynamicResource TextPrimary}" />
            </StackPanel>
            <Panel>
                <ItemsControl ItemsSource="{Binding PagedRows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:UserDashboardRowViewModel">
                            <Button Command="{Binding $parent[ItemsControl].((vm:UserDashboardViewModel)DataContext).SelectRowCommand}"
                                    CommandParameter="{Binding}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    Padding="14,10"
                                    Background="{DynamicResource SurfaceCard}"
                                    BorderBrush="{DynamicResource SurfaceBorder}"
                                    BorderThickness="1,0,1,1"
                                    CornerRadius="0"
                                    Cursor="Hand">
                                <Grid ColumnDefinitions="120,28,*,90,150,110,80">
                                    <Border Grid.Column="0"
                                            Background="{DynamicResource SurfaceBackground}"
                                            BorderBrush="{DynamicResource SurfaceBorder}" BorderThickness="1"
                                            CornerRadius="999" Padding="8,2"
                                            HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <TextBlock Text="{Binding Kind}" FontSize="11"
                                                       Foreground="{DynamicResource TextSecondary}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                    <!-- Column 1: privacy lock in its own dedicated column -->
                                    <Button Grid.Column="1"
                                            IsVisible="{Binding IsOwn}"
                                            Command="{Binding $parent[ItemsControl].((vm:UserDashboardViewModel)DataContext).TogglePrivacyCommand}"
                                            CommandParameter="{Binding}"
                                            Padding="4,1"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            ToolTip.Tip="Click to toggle privacy"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Center">
                                        <Panel>
                                            <ctrl:SovrantIcon IconName="{x:Static ui:IconNames.Private}" Size="12"
                                                  IsVisible="{Binding IsPrivate}"
                                                  Foreground="{DynamicResource TextMuted}" />
                                            <ctrl:SovrantIcon IconName="{x:Static ui:IconNames.Public}" Size="12"
                                                  IsVisible="{Binding !IsPrivate}"
                                                  Foreground="{DynamicResource TextMuted}" />
                                        </Panel>
                                    </Button>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimary}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Preview}" FontSize="11"
                                                   Foreground="{DynamicResource TextMuted}"
                                                   TextTrimming="CharacterEllipsis"
                                                   IsVisible="{Binding Preview, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="3" Text="{Binding Status}" FontSize="11"
                                               Foreground="{DynamicResource StatusPass}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="4" Text="{Binding Owner}" FontSize="11"
                                               Foreground="{DynamicResource TextMuted}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="5" Text="{Binding LastActivity}" FontSize="11"
                                               Foreground="{DynamicResource TextMuted}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="6" Text="{Binding Cost}" FontSize="11"
                                               Foreground="{DynamicResource TextMuted}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Panel>
        </DockPanel>

        </StackPanel>
    </Panel>
    </ScrollViewer>
    </DockPanel>
</UserControl>
