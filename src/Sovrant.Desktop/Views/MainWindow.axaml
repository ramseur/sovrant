<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Sovrant.Desktop.ViewModels"
        xmlns:views="using:Sovrant.Desktop.Views"
        x:Class="Sovrant.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Sovrant"
        Icon="avares://Sovrant.Desktop/Assets/icon.png"
        Width="1280" Height="800"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource SurfaceBackground}">

    <Window.Styles>
        <!-- Left-nav redesign: smooth background fade on nav-row buttons (hover and
             active-state changes alike), matching Web's 0.12s CSS transition. Scoped to
             the sidebar so it doesn't touch button behavior elsewhere in the app. -->
        <Style Selector="Border.nav-shell Button">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>
    </Window.Styles>

    <Window.DataTemplates>
        <DataTemplate DataType="vm:ChatViewModel">
            <views:ChatView />
        </DataTemplate>
        <DataTemplate DataType="vm:SettingsViewModel">
            <views:SettingsView />
        </DataTemplate>
        <DataTemplate DataType="vm:DiagnosticsViewModel">
            <views:DiagnosticsView />
        </DataTemplate>
        <DataTemplate DataType="vm:IntegrationsViewModel">
            <views:IntegrationsView />
        </DataTemplate>
        <DataTemplate DataType="vm:ArtifactsViewModel">
            <views:ArtifactsView />
        </DataTemplate>
        <DataTemplate DataType="vm:DocumentsViewModel">
            <views:DocumentsView />
        </DataTemplate>

        <DataTemplate DataType="vm:ToolsViewModel">
            <views:ToolsView />
        </DataTemplate>
        <DataTemplate DataType="vm:SkillsViewModel">
            <views:SkillsView />
        </DataTemplate>
        <DataTemplate DataType="vm:MemoryViewModel">
            <views:MemoryView />
        </DataTemplate>
        <DataTemplate DataType="vm:GuidelinesViewModel">
            <views:GuidelinesView />
        </DataTemplate>
        <DataTemplate DataType="vm:GovernanceViewModel">
            <views:GovernanceView />
        </DataTemplate>
        <DataTemplate DataType="vm:TrustBoundaryViewModel">
            <views:TrustBoundaryView />
        </DataTemplate>
        <DataTemplate DataType="vm:ProjectsViewModel">
            <views:ProjectsView />
        </DataTemplate>
        <DataTemplate DataType="vm:WorkspacesViewModel">
            <views:WorkspacesView />
        </DataTemplate>
        <DataTemplate DataType="vm:AgentsViewModel">
            <views:AgentsView />
        </DataTemplate>
        <DataTemplate DataType="vm:AutomationsViewModel">
            <views:AutomationsView />
        </DataTemplate>
        <DataTemplate DataType="vm:OrchestrationViewModel">
            <views:OrchestrationView />
        </DataTemplate>
        <DataTemplate DataType="vm:WorkflowsViewModel">
            <views:WorkflowsView />
        </DataTemplate>
        <DataTemplate DataType="vm:CommandCenterViewModel">
            <views:CommandCenterView />
        </DataTemplate>
        <DataTemplate DataType="vm:UserDashboardViewModel">
            <views:UserDashboardView />
        </DataTemplate>
        <DataTemplate DataType="vm:PlaceholderViewModel">
            <views:PlaceholderView />
        </DataTemplate>
        <DataTemplate DataType="vm:AdminViewModel">
            <views:AdminView />
        </DataTemplate>
        <DataTemplate DataType="vm:SystemIntegrationsViewModel">
            <views:SystemIntegrationsView />
        </DataTemplate>
    </Window.DataTemplates>

    <Panel>
        <DockPanel>
            <!-- Left-nav redesign — collapsible rail: a single vertical group-nav
                 list starting flush at the top (icon+label expanded / icon-only
                 collapsed), swappable sub-panel below, settings + user footer at
                 bottom. The collapse toggle floats on the rail's own border edge
                 instead of reserving a header row, so Dashboard is the first thing
                 in the rail with no blank space above it. -->
            <Panel DockPanel.Dock="Left">
            <Border Classes="nav-shell"
                    Width="{Binding NavWidth}"
                    Background="{DynamicResource SidebarBackground}"
                    BorderBrush="{DynamicResource SurfaceBorder}"
                    BorderThickness="0,0,1,0">
                <DockPanel>
                    <!-- Bottom: shared footer — avatar + name on left, settings on the right -->
                    <Border DockPanel.Dock="Bottom" IsVisible="{Binding IsNavExpanded}"
                            Padding="12,10"
                            BorderThickness="0,1,0,0"
                            BorderBrush="{DynamicResource SurfaceBorder}">
                        <DockPanel LastChildFill="True">
                            <Button DockPanel.Dock="Right"
                                    Content="↪" ToolTip.Tip="Log out"
                                    Command="{Binding LogoutCommand}"
                                    Width="34" Height="34" CornerRadius="9"
                                    FontSize="16" Padding="0" Margin="4,0,0,0"
                                    Background="Transparent"
                                    Foreground="{DynamicResource TextSecondary}"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center" />
                            <Button Command="{Binding SelectGroupCommand}" CommandParameter="settings"
                                    Background="Transparent" BorderThickness="0" Padding="5,2"
                                    CornerRadius="8" ToolTip.Tip="Settings" Cursor="Hand"
                                    HorizontalContentAlignment="Left" VerticalContentAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <Border Width="32" Height="32" CornerRadius="16"
                                            Background="{DynamicResource BrandPrimary}">
                                        <TextBlock Text="{Binding Sidebar.UserInitial}" FontSize="13.5" FontWeight="SemiBold"
                                                   Foreground="White"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Sidebar.CurrentUserName}" FontSize="13"
                                                   Foreground="{DynamicResource TextPrimary}" />
                                        <TextBlock Text="{Binding Sidebar.ActiveContext.ActiveWorkspaceRole}" FontSize="11"
                                                   Foreground="{DynamicResource TextSecondary}"
                                                   IsVisible="{Binding Sidebar.ActiveContext.ActiveWorkspaceRole, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                        </DockPanel>
                    </Border>

                    <!-- Middle: group nav list on top (icon+label expanded / icon-only
                         collapsed, single source for both states), swappable sub-panel below. -->
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Margin="10,8,10,8" Spacing="2">
                            <Grid Height="40">
                                <Button Command="{Binding SelectGroupCommand}" CommandParameter="dashboard"
                                        HorizontalAlignment="Stretch" Height="40"
                                        HorizontalContentAlignment="{Binding IsNavCollapsed, Converter={x:Static vm:BoolToAlignmentConverter.CenterWhenTrue}}"
                                        VerticalContentAlignment="Center"
                                        CornerRadius="9" Padding="10,0"
                                        Background="{Binding IsDashboardGroup, Converter={x:Static vm:BoolToBrushConverter.BrandTintOrTransparent}}">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <Path Data="{StaticResource IconDashboard}" Width="19" Height="19" Stretch="Uniform"
                                                  StrokeThickness="1.9" StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
                                                  Stroke="{Binding IsDashboardGroup, Converter={x:Static vm:BoolToBrushConverter.BrandOrSecondary}}" />
                                        <TextBlock Text="Dashboard" FontSize="14.5" FontWeight="Medium"
                                                   IsVisible="{Binding IsNavExpanded}"
                                                   Foreground="{Binding IsDashboardGroup, Converter={x:Static vm:BoolToBrushConverter.BrandOrSecondary}}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Border Width="3" HorizontalAlignment="Left" Margin="0,6,0,6" CornerRadius="0,3,3,0"
                                        Background="{DynamicResource BrandPrimary}"
                                        IsVisible="{Binding IsDashboardGroup}" />
                            </Grid>
                            <Grid Height="40">
                                <Button Command="{Binding SelectGroupCommand}" CommandParameter="chat"
                                        HorizontalAlignment="Stretch" Height="40"
                                        HorizontalContentAlignment="{Binding IsNavCollapsed, Converter={x:Static vm:BoolToAlignmentConverter.CenterWhenTrue}}"
                                        VerticalContentAlignment="Center"
                                        CornerRadius="9" Padding="10,0"
                                        Background="{Binding IsChatGroup, Converter={x:Static vm:BoolToBrushConverter.BrandTintOrTransparent}}">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <Path Data="{StaticResource IconChat}" Width="19" Height="19" Stretch="Uniform"
                                                  StrokeThickness="1.9" StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
                                                  Stroke="{Binding IsChatGroup, Converter={x:Static vm:BoolToBrushConverter.BrandOrSecondary}}" />
                                        <TextBlock Text="Chat" FontSize="14.5" FontWeight="Medium"
                                                   IsVisible="{Binding IsNavExpanded}"
                                                   Foreground="{Binding IsChatGroup, Converter={x:Static vm:BoolToBrushConverter.BrandOrSecondary}}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Border Width="3" HorizontalAlignment="Left" Margin="0,6,0,6" CornerRadius="0,3,3,0"
                                        Background="{DynamicResource BrandPrimary}"
                                        IsVisible="{Binding IsChatGroup}" />
                            </Grid>
                            <Grid Height="40">
                                <Button Command="{Binding SelectGroupCommand}" CommandParameter="knowledge"
                                        HorizontalAlignment="Stretch" Height="40"
                                        HorizontalContentAlignment="{Binding IsNavCollapsed, Converter={x:Static vm:BoolToAlignmentConverter.CenterWhenTrue}}"
                                        VerticalContentAlignment="Center"
                                        CornerRadius="9" Padding="10,0"
                                        Background="{Binding IsKnowledgeGroup, Converter={x:Static vm:BoolToBrushConverter.BrandTintOrTransparent}}">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <Path Data="{StaticResource IconKnowledge}" Width="19" Height="19" Stretch="Uniform"
                                                  StrokeThickness="1.9" StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
                                                  Stroke="{Binding IsKnowledgeGroup, Converter={x:Static vm:BoolToBrushConverter.BrandOrSecondary}}" />
                                        <TextBlock Text="Knowledge" FontSize="14.5" FontWeight="Medium"
                                                   IsVisible="{Binding IsNavExpanded}"
                                                   Foreground="{Binding IsKnowledgeGroup, Converter={x:Static vm:BoolToBrushConverter.BrandOrSecondary}}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Border Width="3" HorizontalAlignment="Left" Margin="0,6,0,6" CornerRadius="0,3,3,0"
                                        Background="{DynamicResource BrandPrimary}"
                                        IsVisible="{Binding IsKnowledgeGroup}" />
                            </Grid>
                            <Grid Height="40">
                                <Button Command="{Binding SelectGroupCommand}" CommandParameter="agents"
                                        HorizontalAlignment="Stretch" Height="40"
                                        HorizontalContentAlignment="{Binding IsNavCollapsed, Converter={x:Static vm:BoolToAlignmentConverter.CenterWhenTrue}}"
                                        VerticalContentAlignment="Center"
                                        CornerRadius="9" Padding="10,0"
                                        Background="{Binding IsAgentsGroup, Converter={x:Static vm:BoolToBrushConverter.BrandTintOrTransparent}}">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <Path Data="{StaticResource IconAgents}" Width="19" Height="19" Stretch="Uniform"
                                                  StrokeThickness="1.9" StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
                                                  Stroke="{Binding IsAgentsGroup, Converter={x:Static vm:BoolToBrushConverter.BrandOrSecondary}}" />
                                        <TextBlock Text="Agents" FontSize="14.5" FontWeight="Medium"
                                                   IsVisible="{Binding IsNavExpanded}"
                                                   Foreground="{Binding IsAgentsGroup, Converter={x:Static vm:BoolToBrushConverter.BrandOrSecondary}}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Border Width="3" HorizontalAlignment="Left" Margin="0,6,0,6" CornerRadius="0,3,3,0"
                                        Background="{DynamicResource BrandPrimary}"
                                        IsVisible="{Binding IsAgentsGroup}" />
                            </Grid>
                            <Grid Height="40">
                                <Button Command="{Binding SelectGroupCommand}" CommandParameter="workspace"
                                        HorizontalAlignment="Stretch" Height="40"
                                        HorizontalContentAlignment="{Binding IsNavCollapsed, Converter={x:Static vm:BoolToAlignmentConverter.CenterWhenTrue}}"
                                        VerticalContentAlignment="Center"
                                        CornerRadius="9" Padding="10,0"
                                        Background="{Binding IsWorkspaceGroup, Converter={x:Static vm:BoolToBrushConverter.BrandTintOrTransparent}}">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <Path Data="{StaticResource IconProjects}" Width="19" Height="19" Stretch="Uniform"
                                                  StrokeThickness="1.9" StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
                                                  Stroke="{Binding IsWorkspaceGroup, Converter={x:Static vm:BoolToBrushConverter.BrandOrSecondary}}" />
                                        <TextBlock Text="Projects" FontSize="14.5" FontWeight="Medium"
                                                   IsVisible="{Binding IsNavExpanded}"
                                                   Foreground="{Binding IsWorkspaceGroup, Converter={x:Static vm:BoolToBrushConverter.BrandOrSecondary}}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Border Width="3" HorizontalAlignment="Left" Margin="0,6,0,6" CornerRadius="0,3,3,0"
                                        Background="{DynamicResource BrandPrimary}"
                                        IsVisible="{Binding IsWorkspaceGroup}" />
                            </Grid>
                            <Grid Height="40" IsVisible="{Binding IsAdmin}">
                                <Button Command="{Binding SelectGroupCommand}" CommandParameter="admin"
                                        HorizontalAlignment="Stretch" Height="40"
                                        HorizontalContentAlignment="{Binding IsNavCollapsed, Converter={x:Static vm:BoolToAlignmentConverter.CenterWhenTrue}}"
                                        VerticalContentAlignment="Center"
                                        CornerRadius="9" Padding="10,0"
                                        Background="{Binding IsAdminGroup, Converter={x:Static vm:BoolToBrushConverter.BrandTintOrTransparent}}">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <Path Data="{StaticResource IconAdmin}" Width="19" Height="19" Stretch="Uniform"
                                                  StrokeThickness="1.9" StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
                                                  Stroke="{Binding IsAdminGroup, Converter={x:Static vm:BoolToBrushConverter.BrandOrSecondary}}" />
                                        <TextBlock Text="Admin" FontSize="14.5" FontWeight="Medium"
                                                   IsVisible="{Binding IsNavExpanded}"
                                                   Foreground="{Binding IsAdminGroup, Converter={x:Static vm:BoolToBrushConverter.BrandOrSecondary}}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Border Width="3" HorizontalAlignment="Left" Margin="0,6,0,6" CornerRadius="0,3,3,0"
                                        Background="{DynamicResource BrandPrimary}"
                                        IsVisible="{Binding IsAdminGroup}" />
                            </Grid>
                        </StackPanel>

                        <Border DockPanel.Dock="Top" Height="1" Margin="10,0"
                                Background="{DynamicResource SurfaceBorder}"
                                IsVisible="{Binding IsNavExpanded}" />

                        <!-- Sub-panel content swaps based on SelectedGroup — only shown expanded. -->
                        <Panel IsVisible="{Binding IsNavExpanded}">
                            <views:SidebarView DataContext="{Binding Sidebar}"
                                               IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext).IsChatGroup}" />
                            <views:KnowledgePanelView DataContext="{Binding Sidebar}"
                                                      IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext).IsKnowledgeGroup}" />
                            <views:AgentsPanelView DataContext="{Binding Sidebar}"
                                                   IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext).IsAgentsGroup}" />
                            <views:WorkspacePanelView DataContext="{Binding Sidebar}"
                                                      IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext).IsWorkspaceGroup}" />
                            <views:AdminPanelView DataContext="{Binding Sidebar}"
                                                 IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext).IsAdminGroup}" />
                        </Panel>
                    </DockPanel>
                </DockPanel>
            </Border>

            <!-- Collapse/expand toggle — floats on the rail's border edge rather
                 than owning its own row. -->
            <Button HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,14,-13,0"
                    ToolTip.Tip="Collapse sidebar"
                    Command="{Binding ToggleNavCommand}"
                    IsVisible="{Binding IsNavExpanded}"
                    Height="26" Width="26" CornerRadius="13" Padding="0"
                    Background="{DynamicResource SurfaceBackground}"
                    BorderBrush="{DynamicResource SurfaceBorder}" BorderThickness="1"
                    Foreground="{DynamicResource TextMuted}"
                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                <Viewbox Width="16" Height="14" Stretch="Fill">
                    <Canvas Width="16" Height="14">
                        <Border Canvas.Left="1" Canvas.Top="1" Width="14" Height="12"
                                CornerRadius="1.75" BorderThickness="1.3"
                                BorderBrush="{DynamicResource TextMuted}" Background="Transparent"/>
                        <Path Data="M5.5,1 L5.5,13" Canvas.Left="0" Canvas.Top="0"
                              Stroke="{DynamicResource TextMuted}" StrokeThickness="1.3"/>
                        <Border Canvas.Left="1.65" Canvas.Top="1.65" Width="3.2" Height="10.7"
                                CornerRadius="0.75" Opacity="0.55"
                                Background="{DynamicResource TextMuted}"/>
                    </Canvas>
                </Viewbox>
            </Button>
            <Button HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,14,-13,0"
                    ToolTip.Tip="Expand sidebar"
                    Command="{Binding ToggleNavCommand}"
                    IsVisible="{Binding IsNavCollapsed}"
                    Height="26" Width="26" CornerRadius="13" Padding="0"
                    Background="{DynamicResource SurfaceBackground}"
                    BorderBrush="{DynamicResource SurfaceBorder}" BorderThickness="1"
                    Foreground="{DynamicResource TextMuted}"
                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                <Viewbox Width="16" Height="14" Stretch="Fill">
                    <Canvas Width="16" Height="14">
                        <Border Canvas.Left="1" Canvas.Top="1" Width="14" Height="12"
                                CornerRadius="1.75" BorderThickness="1.3"
                                BorderBrush="{DynamicResource TextMuted}" Background="Transparent"/>
                        <Path Data="M5.5,1 L5.5,13" Canvas.Left="0" Canvas.Top="0"
                              Stroke="{DynamicResource TextMuted}" StrokeThickness="1.3"/>
                    </Canvas>
                </Viewbox>
            </Button>
            </Panel>

            <!-- Main content -->
            <DockPanel>
                <views:TopContextBarView DataContext="{Binding Sidebar}"
                                         DockPanel.Dock="Top" />
                <ContentControl Content="{Binding CurrentPage}"
                                Margin="0" />
            </DockPanel>
        </DockPanel>

        <!-- Command palette overlay -->
        <views:CommandPaletteOverlay DataContext="{Binding CommandPalette}" />
    </Panel>
</Window>
