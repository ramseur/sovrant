<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Sovrant.Desktop.ViewModels"
        xmlns:views="using:Sovrant.Desktop.Views"
        xmlns:ctrl="using:Sovrant.Desktop.Controls"
        x:Class="Sovrant.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Sovrant"
        Icon="avares://Sovrant.Desktop/Assets/icon.png"
        Width="1280" Height="800"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource SurfaceBackground}">

    <Window.DataTemplates>
        <DataTemplate DataType="vm:ChatViewModel">
            <views:ChatView />
        </DataTemplate>
        <DataTemplate DataType="vm:SettingsViewModel">
            <views:SettingsView />
        </DataTemplate>
        <DataTemplate DataType="vm:DiagnosticsViewModel">
            <views:DiagnosticsView />
        </DataTemplate>
        <DataTemplate DataType="vm:IntegrationsViewModel">
            <views:IntegrationsView />
        </DataTemplate>
        <DataTemplate DataType="vm:ArtifactsViewModel">
            <views:ArtifactsView />
        </DataTemplate>
        <DataTemplate DataType="vm:DocumentsViewModel">
            <views:DocumentsView />
        </DataTemplate>

        <DataTemplate DataType="vm:ToolsViewModel">
            <views:ToolsView />
        </DataTemplate>
        <DataTemplate DataType="vm:SkillsViewModel">
            <views:SkillsView />
        </DataTemplate>
        <DataTemplate DataType="vm:MemoryViewModel">
            <views:MemoryView />
        </DataTemplate>
        <DataTemplate DataType="vm:GuidelinesViewModel">
            <views:GuidelinesView />
        </DataTemplate>
        <DataTemplate DataType="vm:GovernanceViewModel">
            <views:GovernanceView />
        </DataTemplate>
        <DataTemplate DataType="vm:TrustBoundaryViewModel">
            <views:TrustBoundaryView />
        </DataTemplate>
        <DataTemplate DataType="vm:ProjectsViewModel">
            <views:ProjectsView />
        </DataTemplate>
        <DataTemplate DataType="vm:WorkspacesViewModel">
            <views:WorkspacesView />
        </DataTemplate>
        <DataTemplate DataType="vm:AgentsViewModel">
            <views:AgentsView />
        </DataTemplate>
        <DataTemplate DataType="vm:AutomationsViewModel">
            <views:AutomationsView />
        </DataTemplate>
        <DataTemplate DataType="vm:OrchestrationViewModel">
            <views:OrchestrationView />
        </DataTemplate>
        <DataTemplate DataType="vm:CommandCenterViewModel">
            <views:CommandCenterView />
        </DataTemplate>
        <DataTemplate DataType="vm:UserDashboardViewModel">
            <views:UserDashboardView />
        </DataTemplate>
        <DataTemplate DataType="vm:PlaceholderViewModel">
            <views:PlaceholderView />
        </DataTemplate>
        <DataTemplate DataType="vm:AdminViewModel">
            <views:AdminView />
        </DataTemplate>
        <DataTemplate DataType="vm:SystemIntegrationsViewModel">
            <views:SystemIntegrationsView />
        </DataTemplate>
    </Window.DataTemplates>

    <Panel>
        <DockPanel>
            <!-- Phase 69 — single 240px sidebar: icon row at top, group panel in middle, settings + user at bottom. -->
            <Border DockPanel.Dock="Left"
                    Width="{Binding NavWidth}"
                    Background="{DynamicResource SidebarBackground}"
                    BorderBrush="{DynamicResource SurfaceBorder}"
                    BorderThickness="0,0,1,0">
                <DockPanel>
                    <Border DockPanel.Dock="Top"
                            BorderBrush="{DynamicResource SurfaceBorder}"
                            BorderThickness="0,0,0,1"
                            Padding="6,8">
                        <DockPanel LastChildFill="True">
                            <!-- Collapse toggle: always visible -->
                            <Button DockPanel.Dock="Right" ToolTip.Tip="Collapse sidebar"
                                    Command="{Binding ToggleNavCommand}"
                                    IsVisible="{Binding IsNavExpanded}"
                                    Height="30" Width="30" CornerRadius="6" Padding="7,8"
                                    Background="Transparent"
                                    Foreground="{DynamicResource TextMuted}"
                                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                                <Viewbox Width="16" Height="14" Stretch="Fill">
                                    <Canvas Width="16" Height="14">
                                        <Border Canvas.Left="1" Canvas.Top="1" Width="14" Height="12"
                                                CornerRadius="1.75" BorderThickness="1.3"
                                                BorderBrush="{DynamicResource TextMuted}" Background="Transparent"/>
                                        <Path Data="M5.5,1 L5.5,13" Canvas.Left="0" Canvas.Top="0"
                                              Stroke="{DynamicResource TextMuted}" StrokeThickness="1.3"/>
                                        <Border Canvas.Left="1.65" Canvas.Top="1.65" Width="3.2" Height="10.7"
                                                CornerRadius="0.75" Opacity="0.55"
                                                Background="{DynamicResource TextMuted}"/>
                                    </Canvas>
                                </Viewbox>
                            </Button>
                            <Button DockPanel.Dock="Right" ToolTip.Tip="Expand sidebar"
                                    Command="{Binding ToggleNavCommand}"
                                    IsVisible="{Binding IsNavCollapsed}"
                                    Height="30" Width="30" CornerRadius="6" Padding="7,8"
                                    Background="Transparent"
                                    Foreground="{DynamicResource TextMuted}"
                                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                                <Viewbox Width="16" Height="14" Stretch="Fill">
                                    <Canvas Width="16" Height="14">
                                        <Border Canvas.Left="1" Canvas.Top="1" Width="14" Height="12"
                                                CornerRadius="1.75" BorderThickness="1.3"
                                                BorderBrush="{DynamicResource TextMuted}" Background="Transparent"/>
                                        <Path Data="M5.5,1 L5.5,13" Canvas.Left="0" Canvas.Top="0"
                                              Stroke="{DynamicResource TextMuted}" StrokeThickness="1.3"/>
                                    </Canvas>
                                </Viewbox>
                            </Button>
                            <!-- Admin + main icons: hidden when collapsed -->
                            <DockPanel LastChildFill="True" IsVisible="{Binding IsNavExpanded}">
                                <Button DockPanel.Dock="Right" ToolTip.Tip="Admin"
                                        Command="{Binding SelectGroupCommand}" CommandParameter="admin"
                                        Height="30" CornerRadius="6" FontSize="13" Padding="4,0"
                                        IsVisible="{Binding IsAdmin}"
                                        Background="{Binding IsAdminGroup, Converter={x:Static vm:BoolToBrushConverter.BrandOrTransparent}}"
                                        Foreground="{Binding IsAdminGroup, Converter={x:Static vm:BoolToBrushConverter.WhiteOrSecondary}}"
                                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                                    <ctrl:SovrantIcon IconName="key" Width="13" Height="13" />
                                </Button>
                                <UniformGrid Rows="1">
                                <Button ToolTip.Tip="User Dashboard"
                                        Command="{Binding SelectGroupCommand}" CommandParameter="dashboard"
                                        Height="30" CornerRadius="6" FontSize="13" Padding="0"
                                        Background="{Binding IsDashboardGroup, Converter={x:Static vm:BoolToBrushConverter.BrandOrTransparent}}"
                                        Foreground="{Binding IsDashboardGroup, Converter={x:Static vm:BoolToBrushConverter.WhiteOrSecondary}}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                                    <ctrl:SovrantIcon IconName="chart" Width="13" Height="13" />
                                </Button>
                                <Button ToolTip.Tip="Chat"
                                        Command="{Binding SelectGroupCommand}" CommandParameter="chat"
                                        Height="30" CornerRadius="6" FontSize="13" Padding="0"
                                        Background="{Binding IsChatGroup, Converter={x:Static vm:BoolToBrushConverter.BrandOrTransparent}}"
                                        Foreground="{Binding IsChatGroup, Converter={x:Static vm:BoolToBrushConverter.WhiteOrSecondary}}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                                    <ctrl:SovrantIcon IconName="message" Width="13" Height="13" />
                                </Button>
                                <Button ToolTip.Tip="Knowledge"
                                        Command="{Binding SelectGroupCommand}" CommandParameter="knowledge"
                                        Height="30" CornerRadius="6" FontSize="13" Padding="0"
                                        Background="{Binding IsKnowledgeGroup, Converter={x:Static vm:BoolToBrushConverter.BrandOrTransparent}}"
                                        Foreground="{Binding IsKnowledgeGroup, Converter={x:Static vm:BoolToBrushConverter.WhiteOrSecondary}}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                                    <ctrl:SovrantIcon IconName="knowledge" Width="13" Height="13" />
                                </Button>
                                <Button ToolTip.Tip="Agents"
                                        Command="{Binding SelectGroupCommand}" CommandParameter="agents"
                                        Height="30" CornerRadius="6" FontSize="13" Padding="0"
                                        Background="{Binding IsAgentsGroup, Converter={x:Static vm:BoolToBrushConverter.BrandOrTransparent}}"
                                        Foreground="{Binding IsAgentsGroup, Converter={x:Static vm:BoolToBrushConverter.WhiteOrSecondary}}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                                    <ctrl:SovrantIcon IconName="agent" Width="13" Height="13" />
                                </Button>
                                <Button ToolTip.Tip="Projects"
                                        Command="{Binding SelectGroupCommand}" CommandParameter="workspace"
                                        Height="30" CornerRadius="6" FontSize="13" Padding="0"
                                        Background="{Binding IsWorkspaceGroup, Converter={x:Static vm:BoolToBrushConverter.BrandOrTransparent}}"
                                        Foreground="{Binding IsWorkspaceGroup, Converter={x:Static vm:BoolToBrushConverter.WhiteOrSecondary}}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                                    <ctrl:SovrantIcon IconName="project" Width="13" Height="13" />
                                </Button>
                                </UniformGrid>
                            </DockPanel>
                        </DockPanel>
                    </Border>

                    <!-- Bottom: shared footer — avatar + name on left, settings on the right -->
                    <Border DockPanel.Dock="Bottom" IsVisible="{Binding IsNavExpanded}"
                            Padding="10,8"
                            BorderThickness="0,1,0,0"
                            BorderBrush="{DynamicResource SurfaceBorder}">
                        <DockPanel LastChildFill="True">
                            <Button DockPanel.Dock="Right"
                                    ToolTip.Tip="Log out"
                                    Command="{Binding LogoutCommand}"
                                    Width="32" Height="32" CornerRadius="8"
                                    FontSize="16" Padding="0" Margin="4,0,0,0"
                                    Background="Transparent"
                                    Foreground="{DynamicResource TextSecondary}"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center">
                                <ctrl:SovrantIcon IconName="logout" Width="16" Height="16" />
                            </Button>
                            <Button Command="{Binding SelectGroupCommand}" CommandParameter="settings"
                                    Background="Transparent" BorderThickness="0" Padding="4,2"
                                    CornerRadius="6" ToolTip.Tip="Settings" Cursor="Hand"
                                    HorizontalContentAlignment="Left" VerticalContentAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Border Width="28" Height="28" CornerRadius="14"
                                            Background="{DynamicResource BrandPrimary}">
                                        <TextBlock Text="{Binding Sidebar.UserInitial}" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="White"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Sidebar.CurrentUserName}" FontSize="11"
                                                   Foreground="{DynamicResource TextPrimary}" />
                                        <TextBlock Text="{Binding Sidebar.ActiveContext.ActiveWorkspaceRole}" FontSize="9"
                                                   Foreground="{DynamicResource TextSecondary}"
                                                   IsVisible="{Binding Sidebar.ActiveContext.ActiveWorkspaceRole, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                        </DockPanel>
                    </Border>

                    <!-- Middle: collapsed icon strip OR expanded sub-panel -->
                    <Panel>
                        <!-- Collapsed: vertical icon strip -->
                        <StackPanel IsVisible="{Binding IsNavCollapsed}" Margin="4,8,4,4" Spacing="2">
                            <Button ToolTip.Tip="User Dashboard"
                                    Command="{Binding SelectGroupCommand}" CommandParameter="dashboard"
                                    Height="36" CornerRadius="6" FontSize="16" Padding="0"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                    Background="{Binding IsDashboardGroup, Converter={x:Static vm:BoolToBrushConverter.BrandOrTransparent}}"
                                    Foreground="{Binding IsDashboardGroup, Converter={x:Static vm:BoolToBrushConverter.WhiteOrSecondary}}">
                                <ctrl:SovrantIcon IconName="chart" Width="16" Height="16" />
                            </Button>
                            <Button ToolTip.Tip="Chat"
                                    Command="{Binding SelectGroupCommand}" CommandParameter="chat"
                                    Height="36" CornerRadius="6" FontSize="16" Padding="0"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                    Background="{Binding IsChatGroup, Converter={x:Static vm:BoolToBrushConverter.BrandOrTransparent}}"
                                    Foreground="{Binding IsChatGroup, Converter={x:Static vm:BoolToBrushConverter.WhiteOrSecondary}}">
                                <ctrl:SovrantIcon IconName="message" Width="16" Height="16" />
                            </Button>
                            <Button ToolTip.Tip="Knowledge"
                                    Command="{Binding SelectGroupCommand}" CommandParameter="knowledge"
                                    Height="36" CornerRadius="6" FontSize="16" Padding="0"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                    Background="{Binding IsKnowledgeGroup, Converter={x:Static vm:BoolToBrushConverter.BrandOrTransparent}}"
                                    Foreground="{Binding IsKnowledgeGroup, Converter={x:Static vm:BoolToBrushConverter.WhiteOrSecondary}}">
                                <ctrl:SovrantIcon IconName="knowledge" Width="16" Height="16" />
                            </Button>
                            <Button ToolTip.Tip="Agents"
                                    Command="{Binding SelectGroupCommand}" CommandParameter="agents"
                                    Height="36" CornerRadius="6" FontSize="16" Padding="0"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                    Background="{Binding IsAgentsGroup, Converter={x:Static vm:BoolToBrushConverter.BrandOrTransparent}}"
                                    Foreground="{Binding IsAgentsGroup, Converter={x:Static vm:BoolToBrushConverter.WhiteOrSecondary}}">
                                <ctrl:SovrantIcon IconName="agent" Width="16" Height="16" />
                            </Button>
                            <Button ToolTip.Tip="Projects"
                                    Command="{Binding SelectGroupCommand}" CommandParameter="workspace"
                                    Height="36" CornerRadius="6" FontSize="16" Padding="0"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                    Background="{Binding IsWorkspaceGroup, Converter={x:Static vm:BoolToBrushConverter.BrandOrTransparent}}"
                                    Foreground="{Binding IsWorkspaceGroup, Converter={x:Static vm:BoolToBrushConverter.WhiteOrSecondary}}">
                                <ctrl:SovrantIcon IconName="project" Width="16" Height="16" />
                            </Button>
                            <Button ToolTip.Tip="Admin"
                                    Command="{Binding SelectGroupCommand}" CommandParameter="admin"
                                    Height="36" CornerRadius="6" FontSize="16" Padding="0"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                    IsVisible="{Binding IsAdmin}"
                                    Background="{Binding IsAdminGroup, Converter={x:Static vm:BoolToBrushConverter.BrandOrTransparent}}"
                                    Foreground="{Binding IsAdminGroup, Converter={x:Static vm:BoolToBrushConverter.WhiteOrSecondary}}">
                                <ctrl:SovrantIcon IconName="key" Width="16" Height="16" />
                            </Button>
                        </StackPanel>

                        <!-- Expanded: sub-panel content swaps based on SelectedGroup -->
                        <Panel IsVisible="{Binding IsNavExpanded}">
                            <views:SidebarView DataContext="{Binding Sidebar}"
                                               IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext).IsChatGroup}" />
                            <views:KnowledgePanelView DataContext="{Binding Sidebar}"
                                                      IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext).IsKnowledgeGroup}" />
                            <views:AgentsPanelView DataContext="{Binding Sidebar}"
                                                   IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext).IsAgentsGroup}" />
                            <views:WorkspacePanelView DataContext="{Binding Sidebar}"
                                                      IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext).IsWorkspaceGroup}" />
                            <views:AdminPanelView DataContext="{Binding Sidebar}"
                                                 IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext).IsAdminGroup}" />
                        </Panel>
                    </Panel>
                </DockPanel>
            </Border>

            <!-- Main content -->
            <DockPanel>
                <views:TopContextBarView DataContext="{Binding Sidebar}"
                                         DockPanel.Dock="Top" />
                <ContentControl Content="{Binding CurrentPage}"
                                Margin="0" />
            </DockPanel>
        </DockPanel>

        <!-- Command palette overlay -->
        <views:CommandPaletteOverlay DataContext="{Binding CommandPalette}" />
    </Panel>
</Window>
