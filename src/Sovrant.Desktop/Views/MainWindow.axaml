<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Sovrant.Desktop.ViewModels"
        xmlns:views="using:Sovrant.Desktop.Views"
        x:Class="Sovrant.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Sovrant"
        Width="1280" Height="800"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource SurfaceBackground}">

    <Window.DataTemplates>
        <DataTemplate DataType="vm:ChatViewModel">
            <views:ChatView />
        </DataTemplate>
        <DataTemplate DataType="vm:SettingsViewModel">
            <views:SettingsView />
        </DataTemplate>
        <DataTemplate DataType="vm:DiagnosticsViewModel">
            <views:DiagnosticsView />
        </DataTemplate>
        <DataTemplate DataType="vm:IntegrationsViewModel">
            <views:IntegrationsView />
        </DataTemplate>
        <DataTemplate DataType="vm:ArtifactsViewModel">
            <views:ArtifactsView />
        </DataTemplate>
        <DataTemplate DataType="vm:ToolsViewModel">
            <views:ToolsView />
        </DataTemplate>
        <DataTemplate DataType="vm:MemoryViewModel">
            <views:MemoryView />
        </DataTemplate>
        <DataTemplate DataType="vm:GovernanceViewModel">
            <views:GovernanceView />
        </DataTemplate>
        <DataTemplate DataType="vm:ProjectsViewModel">
            <views:ProjectsView />
        </DataTemplate>
        <DataTemplate DataType="vm:WorkspacesViewModel">
            <views:WorkspacesView />
        </DataTemplate>
        <DataTemplate DataType="vm:AgentsViewModel">
            <views:AgentsView />
        </DataTemplate>
        <DataTemplate DataType="vm:AutomationsViewModel">
            <views:AutomationsView />
        </DataTemplate>
        <DataTemplate DataType="vm:MultiAgentViewModel">
            <views:MultiAgentView />
        </DataTemplate>
        <DataTemplate DataType="vm:PlaceholderViewModel">
            <views:PlaceholderView />
        </DataTemplate>
    </Window.DataTemplates>

    <Panel>
        <DockPanel>
            <!-- Collapsed sidebar strip -->
            <Border DockPanel.Dock="Left"
                    Width="44"
                    Background="{DynamicResource SidebarBackground}"
                    IsVisible="{Binding Sidebar.IsCollapsed}">
                <StackPanel Margin="0,10,0,0" HorizontalAlignment="Center">
                    <Button Content="◫"
                            Command="{Binding Sidebar.ToggleCollapseCommand}"
                            Padding="6,4" FontSize="16"
                            Background="Transparent"
                            Foreground="{DynamicResource TextSecondary}"
                            CornerRadius="4"
                            HorizontalAlignment="Center"
                            ToolTip.Tip="Expand sidebar" />
                </StackPanel>
            </Border>

            <!-- Sidebar (full) -->
            <views:SidebarView DockPanel.Dock="Left"
                               DataContext="{Binding Sidebar}"
                               Width="240"
                               IsVisible="{Binding !IsCollapsed}" />

            <!-- Main content -->
            <ContentControl Content="{Binding CurrentPage}"
                            Margin="0" />
        </DockPanel>

        <!-- Command palette overlay -->
        <views:CommandPaletteOverlay DataContext="{Binding CommandPalette}" />
    </Panel>
</Window>
