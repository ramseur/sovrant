<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Sovrant.Desktop.ViewModels"
        xmlns:views="using:Sovrant.Desktop.Views"
        x:Class="Sovrant.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Sovrant"
        Icon="avares://Sovrant.Desktop/Assets/icon.png"
        Width="1280" Height="800"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource SurfaceBackground}">

    <Window.Styles>
        <!-- Left-nav redesign: smooth background fade on nav-row buttons (hover and
             active-state changes alike), matching Web's 0.12s CSS transition. Scoped to
             the sidebar so it doesn't touch button behavior elsewhere in the app. -->
        <Style Selector="Border.nav-shell Button">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>

        <!-- Phase 135 — app sidebar rows (expanded nav, collapsed icons, flyout items). -->
        <Style Selector="Button.navrow, Button.navitem">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.navitem">
            <Setter Property="Padding" Value="44,0,10,0" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="Button.navitem.flyitem">
            <Setter Property="Padding" Value="10,0" />
        </Style>
        <Style Selector="Button.navrow.railicon">
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="Button.navrow:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.navitem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceHover}" />
        </Style>
        <Style Selector="Button.navrow.active, Button.navitem.active">
            <Setter Property="Background" Value="{DynamicResource BrandPrimarySoft}" />
        </Style>
        <Style Selector="Button.navrow.active:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.navitem.active:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BrandPrimarySoft}" />
        </Style>
        <Style Selector="Button.navrow Path.navicon">
            <Setter Property="Stroke" Value="{DynamicResource TextSecondary}" />
        </Style>
        <Style Selector="Button.navrow.active Path.navicon">
            <Setter Property="Stroke" Value="{DynamicResource BrandPrimary}" />
        </Style>
        <Style Selector="Button.navrow TextBlock.navlabel">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        </Style>
        <Style Selector="Button.navrow.active TextBlock.navlabel">
            <Setter Property="Foreground" Value="{DynamicResource BrandPrimary}" />
        </Style>
        <Style Selector="Button.navitem TextBlock.navitemlabel">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        </Style>
        <Style Selector="Button.navitem.active TextBlock.navitemlabel">
            <Setter Property="Foreground" Value="{DynamicResource BrandPrimary}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Styles>

    <Window.DataTemplates>
        <DataTemplate DataType="vm:ChatViewModel">
            <views:ChatView />
        </DataTemplate>
        <DataTemplate DataType="vm:SettingsViewModel">
            <views:SettingsView />
        </DataTemplate>
        <DataTemplate DataType="vm:DiagnosticsViewModel">
            <views:DiagnosticsView />
        </DataTemplate>
        <DataTemplate DataType="vm:IntegrationsViewModel">
            <views:IntegrationsView />
        </DataTemplate>
        <DataTemplate DataType="vm:ArtifactsViewModel">
            <views:ArtifactsView />
        </DataTemplate>
        <DataTemplate DataType="vm:DocumentsViewModel">
            <views:DocumentsView />
        </DataTemplate>

        <DataTemplate DataType="vm:ToolsViewModel">
            <views:ToolsView />
        </DataTemplate>
        <DataTemplate DataType="vm:SkillsViewModel">
            <views:SkillsView />
        </DataTemplate>
        <DataTemplate DataType="vm:MemoryViewModel">
            <views:MemoryView />
        </DataTemplate>
        <DataTemplate DataType="vm:GuidelinesViewModel">
            <views:GuidelinesView />
        </DataTemplate>
        <DataTemplate DataType="vm:GovernanceViewModel">
            <views:GovernanceView />
        </DataTemplate>
        <DataTemplate DataType="vm:TrustBoundaryViewModel">
            <views:TrustBoundaryView />
        </DataTemplate>
        <DataTemplate DataType="vm:ProjectsViewModel">
            <views:ProjectsView />
        </DataTemplate>
        <DataTemplate DataType="vm:WorkspacesViewModel">
            <views:WorkspacesView />
        </DataTemplate>
        <DataTemplate DataType="vm:AgentsViewModel">
            <views:AgentsView />
        </DataTemplate>
        <DataTemplate DataType="vm:AutomationsViewModel">
            <views:AutomationsView />
        </DataTemplate>
        <DataTemplate DataType="vm:OrchestrationViewModel">
            <views:OrchestrationView />
        </DataTemplate>
        <DataTemplate DataType="vm:WorkflowsViewModel">
            <views:WorkflowsView />
        </DataTemplate>
        <DataTemplate DataType="vm:CommandCenterViewModel">
            <views:CommandCenterView />
        </DataTemplate>
        <DataTemplate DataType="vm:UserDashboardViewModel">
            <views:UserDashboardView />
        </DataTemplate>
        <DataTemplate DataType="vm:PlaceholderViewModel">
            <views:PlaceholderView />
        </DataTemplate>
        <DataTemplate DataType="vm:AdminViewModel">
            <views:AdminView />
        </DataTemplate>
        <DataTemplate DataType="vm:SystemIntegrationsViewModel">
            <views:SystemIntegrationsView />
        </DataTemplate>
    </Window.DataTemplates>

    <Panel>
        <DockPanel>
            <!-- Left-nav redesign — collapsible rail: a single vertical group-nav
                 list starting flush at the top (icon+label expanded / icon-only
                 collapsed), swappable sub-panel below, settings + user footer at
                 bottom. The collapse toggle floats on the rail's own border edge
                 instead of reserving a header row, so Dashboard is the first thing
                 in the rail with no blank space above it. -->
            <Panel DockPanel.Dock="Left">
            <Border Classes="nav-shell"
                    Width="{Binding NavWidth}"
                    Background="{DynamicResource SidebarBackground}"
                    BorderBrush="{DynamicResource SurfaceBorder}"
                    BorderThickness="0,0,1,0">
                <DockPanel>
                    <!-- Bottom: shared footer — avatar + name on left, settings on the right -->
                    <Border DockPanel.Dock="Bottom" IsVisible="{Binding IsNavExpanded}"
                            Padding="12,10"
                            BorderThickness="0,1,0,0"
                            BorderBrush="{DynamicResource SurfaceBorder}">
                        <DockPanel LastChildFill="True">
                            <Button DockPanel.Dock="Right"
                                    Content="↪" ToolTip.Tip="Log out"
                                    Command="{Binding LogoutCommand}"
                                    Width="34" Height="34" CornerRadius="9"
                                    FontSize="16" Padding="0" Margin="4,0,0,0"
                                    Background="Transparent"
                                    Foreground="{DynamicResource TextSecondary}"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center" />
                            <Button Command="{Binding SelectGroupCommand}" CommandParameter="settings"
                                    Background="Transparent" BorderThickness="0" Padding="5,2"
                                    CornerRadius="8" ToolTip.Tip="Settings" Cursor="Hand"
                                    HorizontalContentAlignment="Left" VerticalContentAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <Border Width="32" Height="32" CornerRadius="16"
                                            Background="{DynamicResource BrandPrimary}">
                                        <TextBlock Text="{Binding Sidebar.UserInitial}" FontSize="13.5" FontWeight="SemiBold"
                                                   Foreground="White"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Sidebar.CurrentUserName}" FontSize="13"
                                                   Foreground="{DynamicResource TextPrimary}" />
                                        <TextBlock Text="{Binding Sidebar.ActiveContext.ActiveWorkspaceRole}" FontSize="11"
                                                   Foreground="{DynamicResource TextSecondary}"
                                                   IsVisible="{Binding Sidebar.ActiveContext.ActiveWorkspaceRole, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                        </DockPanel>
                    </Border>

                    <!-- Phase 135 — app sidebar (docs/design/desktop.html). Expanded: collapsible
                         nav groups (one open at a time, the current page's group by default), then
                         Conversations on every page. The nav never scrolls on its own; Conversations
                         fill the rest (min 160px) with their own scroll; only a very short window
                         scrolls this middle area as one (RailGrid sizing in MainWindow.axaml.cs).
                         Collapsed: icon rail with flyouts (click / Enter / Space / hover; Esc closes). -->
                    <Panel>
                        <ScrollViewer x:Name="RailScroll" IsVisible="{Binding IsNavExpanded}"
                                      HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <Grid x:Name="RailGrid" RowDefinitions="Auto,Auto,*">
                                <ItemsControl x:Name="NavRows" Grid.Row="0" Margin="10,6,10,6"
                                              ItemsSource="{Binding AppNav.Rows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:AppNavRowViewModel">
                                            <Panel>
                                                <!-- Group header: 36px, icon + label (+ chevron when collapsible) -->
                                                <Button Classes="navrow" Classes.active="{Binding IsActive}" IsVisible="{Binding IsGroup}"
                                                        Height="36" Margin="0,1" HorizontalContentAlignment="Stretch"
                                                        Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).AppNav.ActivateCommand}"
                                                        CommandParameter="{Binding}">
                                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                                        <Path Grid.Column="0" Classes="navicon" Data="{Binding IconData}" Width="19" Height="19" Stretch="Uniform"
                                                              StrokeThickness="1.9" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round"
                                                              VerticalAlignment="Center" Margin="0,0,12,0" />
                                                        <TextBlock Grid.Column="1" Classes="navlabel" Text="{Binding Label}" FontSize="14.5" FontWeight="Medium"
                                                                   VerticalAlignment="Center" />
                                                        <Path Grid.Column="2" Data="{StaticResource IconChevronRight}" IsVisible="{Binding IsCollapsible}"
                                                              Width="13" Height="13" Stretch="Uniform" Stroke="{DynamicResource TextMuted}"
                                                              StrokeThickness="2.4" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round"
                                                              VerticalAlignment="Center">
                                                            <Path.RenderTransform>
                                                                <RotateTransform Angle="{Binding ChevronAngle}" />
                                                            </Path.RenderTransform>
                                                        </Path>
                                                    </Grid>
                                                </Button>
                                                <!-- Section label (Admin): Overview / Access / Safety / System -->
                                                <TextBlock IsVisible="{Binding IsSection}" Text="{Binding Label}" FontSize="10" FontWeight="Bold"
                                                           Foreground="{DynamicResource TextMuted}" Margin="44,6,0,2" />
                                                <!-- Page: 30px, indented under its group -->
                                                <Button Classes="navitem" Classes.active="{Binding IsActive}" IsVisible="{Binding IsItem}"
                                                        Height="30" Margin="0,1"
                                                        Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).AppNav.ActivateCommand}"
                                                        CommandParameter="{Binding}">
                                                    <TextBlock Classes="navitemlabel" Text="{Binding Label}" FontSize="12.5" VerticalAlignment="Center" />
                                                </Button>
                                            </Panel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Border Grid.Row="1" Height="1" Margin="10,0" Background="{DynamicResource SurfaceBorder}" />

                                <DockPanel Grid.Row="2" MinHeight="160">
                                    <TextBlock DockPanel.Dock="Top" Text="CONVERSATIONS" FontSize="10.5" FontWeight="Bold"
                                               Foreground="{DynamicResource TextMuted}" Margin="14,10,0,0" />
                                    <views:SidebarView DataContext="{Binding Sidebar}" />
                                </DockPanel>
                            </Grid>
                        </ScrollViewer>

                        <!-- Collapsed rail: icons; collapsible groups and Chat open a flyout. -->
                        <ItemsControl IsVisible="{Binding IsNavCollapsed}" Margin="10,8,10,8"
                                      ItemsSource="{Binding AppNav.Groups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:AppNavRowViewModel">
                                    <Button Classes="navrow railicon" Classes.active="{Binding IsActive}" Height="40" Margin="0,1"
                                            HorizontalContentAlignment="Center" ToolTip.Tip="{Binding Label}"
                                            PointerEntered="OnRailIconPointerEntered"
                                            Click="OnRailIconClick">
                                        <Path Classes="navicon" Data="{Binding IconData}" Width="19" Height="19" Stretch="Uniform"
                                              StrokeThickness="1.9" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round" />
                                        <FlyoutBase.AttachedFlyout>
                                            <Flyout Placement="RightEdgeAlignedTop" ShowMode="Standard">
                                                <StackPanel Width="236" Margin="-4">
                                                    <TextBlock Text="{Binding Label}" FontSize="10.5" FontWeight="Bold"
                                                               Foreground="{DynamicResource TextMuted}" Margin="10,4,0,6" />
                                                    <!-- Group pages -->
                                                    <ItemsControl ItemsSource="{Binding FlyoutItems}" IsVisible="{Binding HasFlyoutItems}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:AppNavRowViewModel">
                                                                <Panel>
                                                                    <TextBlock IsVisible="{Binding IsSection}" Text="{Binding Label}" FontSize="10" FontWeight="Bold"
                                                                               Foreground="{DynamicResource TextMuted}" Margin="10,6,0,2" />
                                                                    <Button Classes="navitem flyitem" Classes.active="{Binding IsActive}" IsVisible="{Binding IsItem}"
                                                                            Height="32" Click="OnFlyoutItemClick"
                                                                            Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).AppNav.ActivateCommand}"
                                                                            CommandParameter="{Binding}">
                                                                        <TextBlock Classes="navitemlabel" Text="{Binding Label}" FontSize="12.5" VerticalAlignment="Center" />
                                                                    </Button>
                                                                </Panel>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <!-- Chat: recent conversations + Show all -->
                                                    <StackPanel IsVisible="{Binding IsChatGroup}">
                                                        <ItemsControl ItemsSource="{Binding $parent[Window].((vm:MainViewModel)DataContext).Sidebar.RecentConversations}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="vm:SessionTreeRowViewModel">
                                                                    <Button Classes="navitem flyitem" Height="32" Click="OnFlyoutItemClick"
                                                                            Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).Sidebar.ResumeSessionCommand}"
                                                                            CommandParameter="{Binding Id}">
                                                                        <TextBlock Classes="navitemlabel" Text="{Binding Text}" FontSize="12.5"
                                                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                                    </Button>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                        <Border Height="1" Margin="2,4" Background="{DynamicResource SurfaceBorder}" />
                                                        <Button Classes="navitem flyitem" Height="32" Click="OnShowAllConversationsClick">
                                                            <TextBlock Text="Show all conversations" FontSize="12.5" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource BrandPrimary}" VerticalAlignment="Center" />
                                                        </Button>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Flyout>
                                        </FlyoutBase.AttachedFlyout>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Panel>
                </DockPanel>
            </Border>

            <!-- Collapse/expand toggle — floats on the rail's border edge rather
                 than owning its own row. -->
            <Button HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,14,-13,0"
                    ToolTip.Tip="Collapse sidebar"
                    Command="{Binding ToggleNavCommand}"
                    IsVisible="{Binding IsNavExpanded}"
                    Height="26" Width="26" CornerRadius="13" Padding="0"
                    Background="{DynamicResource SurfaceBackground}"
                    BorderBrush="{DynamicResource SurfaceBorder}" BorderThickness="1"
                    Foreground="{DynamicResource TextMuted}"
                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                <Viewbox Width="16" Height="14" Stretch="Fill">
                    <Canvas Width="16" Height="14">
                        <Border Canvas.Left="1" Canvas.Top="1" Width="14" Height="12"
                                CornerRadius="1.75" BorderThickness="1.3"
                                BorderBrush="{DynamicResource TextMuted}" Background="Transparent"/>
                        <Path Data="M5.5,1 L5.5,13" Canvas.Left="0" Canvas.Top="0"
                              Stroke="{DynamicResource TextMuted}" StrokeThickness="1.3"/>
                        <Border Canvas.Left="1.65" Canvas.Top="1.65" Width="3.2" Height="10.7"
                                CornerRadius="0.75" Opacity="0.55"
                                Background="{DynamicResource TextMuted}"/>
                    </Canvas>
                </Viewbox>
            </Button>
            <Button HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,14,-13,0"
                    ToolTip.Tip="Expand sidebar"
                    Command="{Binding ToggleNavCommand}"
                    IsVisible="{Binding IsNavCollapsed}"
                    Height="26" Width="26" CornerRadius="13" Padding="0"
                    Background="{DynamicResource SurfaceBackground}"
                    BorderBrush="{DynamicResource SurfaceBorder}" BorderThickness="1"
                    Foreground="{DynamicResource TextMuted}"
                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                <Viewbox Width="16" Height="14" Stretch="Fill">
                    <Canvas Width="16" Height="14">
                        <Border Canvas.Left="1" Canvas.Top="1" Width="14" Height="12"
                                CornerRadius="1.75" BorderThickness="1.3"
                                BorderBrush="{DynamicResource TextMuted}" Background="Transparent"/>
                        <Path Data="M5.5,1 L5.5,13" Canvas.Left="0" Canvas.Top="0"
                              Stroke="{DynamicResource TextMuted}" StrokeThickness="1.3"/>
                    </Canvas>
                </Viewbox>
            </Button>
            </Panel>

            <!-- Main content -->
            <DockPanel>
                <views:TopContextBarView DataContext="{Binding Sidebar}"
                                         DockPanel.Dock="Top" />
                <ContentControl Content="{Binding CurrentPage}"
                                Margin="0" />
            </DockPanel>
        </DockPanel>

        <!-- Command palette overlay -->
        <views:CommandPaletteOverlay DataContext="{Binding CommandPalette}" />

        <!-- Phase 133 — conversation-folder dialogs (Move picker, name prompt) -->
        <views:SessionFolderDialogOverlay DataContext="{Binding Sidebar.FolderDialog}" />
    </Panel>
</Window>
