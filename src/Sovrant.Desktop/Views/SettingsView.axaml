<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Sovrant.Desktop.ViewModels"
             xmlns:perm="using:Sovrant.Runtime.Permissions"
             x:Class="Sovrant.Desktop.Views.SettingsView"
             x:DataType="vm:SettingsViewModel"
             Background="{DynamicResource SurfaceBackground}">

    <ScrollViewer Padding="32,24">
        <StackPanel MaxWidth="640" Spacing="20">
            <!-- Header -->
            <TextBlock Text="Settings" FontSize="24" FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimary}" />

            <!-- Provider selection -->
            <StackPanel Spacing="6">
                <TextBlock Text="Provider" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondary}" />
                <ComboBox ItemsSource="{Binding Providers}"
                          SelectedItem="{Binding SelectedProvider}"
                          HorizontalAlignment="Stretch"
                          CornerRadius="8"
                          Padding="12,8" />
            </StackPanel>

            <!-- Model name -->
            <StackPanel Spacing="6">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right"
                               Text="Loading models..."
                               FontSize="11"
                               Foreground="{DynamicResource TextMuted}"
                               VerticalAlignment="Center"
                               IsVisible="{Binding IsLoadingModels}" />
                    <TextBlock Text="Model" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondary}" />
                </DockPanel>
                <Grid ColumnDefinitions="*,Auto">
                    <AutoCompleteBox Grid.Column="0"
                                     ItemsSource="{Binding AvailableModels}"
                                     Text="{Binding ModelName, Mode=TwoWay}"
                                     Watermark="Click to browse or type to search..."
                                     FilterMode="ContainsOrdinal"
                                     IsTextCompletionEnabled="False"
                                     MinimumPrefixLength="0"
                                     MinimumPopulateDelay="0"
                                     CornerRadius="8,0,0,8"
                                     Padding="12,8"
                                     FontSize="13"
                                     MaxDropDownHeight="300" />
                    <Button Grid.Column="1"
                            Content="✕"
                            Command="{Binding ClearModelCommand}"
                            Padding="10,8"
                            CornerRadius="0,8,8,0"
                            Background="{DynamicResource SurfaceCard}"
                            BorderBrush="{DynamicResource SurfaceBorder}"
                            BorderThickness="0,1,1,1"
                            Foreground="{DynamicResource TextSecondary}"
                            FontSize="12"
                            ToolTip.Tip="Clear to browse all models" />
                </Grid>
            </StackPanel>

            <!-- API Key -->
            <StackPanel Spacing="6">
                <TextBlock Text="API Key" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondary}" />
                <TextBox Text="{Binding ApiKey}"
                         PasswordChar="*"
                         Watermark="sk-..."
                         CornerRadius="8"
                         Padding="12,8" />
            </StackPanel>

            <!-- Base URL -->
            <StackPanel Spacing="6">
                <TextBlock Text="Base URL (optional)" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondary}" />
                <TextBox Text="{Binding BaseUrl}"
                         Watermark="https://api.openai.com/v1"
                         CornerRadius="8"
                         Padding="12,8" />
            </StackPanel>

            <!-- Max output tokens -->
            <StackPanel Spacing="6">
                <TextBlock Text="Max Output Tokens" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondary}" />
                <NumericUpDown Value="{Binding MaxOutputTokens}"
                               Minimum="256" Maximum="128000"
                               Increment="1000"
                               CornerRadius="8"
                               Padding="12,8"
                               HorizontalAlignment="Stretch" />
            </StackPanel>

            <!-- Streaming toggle -->
            <Border Padding="12" CornerRadius="8"
                    Background="{DynamicResource SurfaceCard}"
                    BorderBrush="{DynamicResource SurfaceBorder}"
                    BorderThickness="1">
                <DockPanel>
                    <ToggleSwitch DockPanel.Dock="Right"
                                  IsChecked="{Binding Streaming}"
                                  OnContent="" OffContent="" />
                    <StackPanel>
                        <TextBlock Text="Streaming" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}" />
                        <TextBlock Text="Stream response tokens as they arrive"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondary}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Permissions section -->
            <TextBlock Text="Permissions" FontSize="16" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimary}"
                       Margin="0,12,0,0" />

            <StackPanel Spacing="6">
                <TextBlock Text="Permission Mode" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondary}" />
                <ComboBox ItemsSource="{Binding PermissionModes}"
                          SelectedItem="{Binding PermissionMode}"
                          HorizontalAlignment="Stretch"
                          CornerRadius="8"
                          Padding="12,8" />
                <TextBlock FontSize="11" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextMuted}">
                    <Run Text="Default" FontWeight="SemiBold" /> — ask before destructive ops.
                    <Run Text="AcceptEdits" FontWeight="SemiBold" /> — auto-approve edits, ask for bash.
                    <Run Text="BypassPermissions" FontWeight="SemiBold" /> — allow all.
                </TextBlock>
            </StackPanel>

            <!-- Appearance section -->
            <TextBlock Text="Appearance" FontSize="16" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimary}"
                       Margin="0,12,0,0" />

            <!-- Dark mode toggle -->
            <Border Padding="12" CornerRadius="8"
                    Background="{DynamicResource SurfaceCard}"
                    BorderBrush="{DynamicResource SurfaceBorder}"
                    BorderThickness="1">
                <DockPanel>
                    <ToggleSwitch DockPanel.Dock="Right"
                                  IsChecked="{Binding IsDarkMode}"
                                  OnContent="🌙" OffContent="☀️" />
                    <StackPanel>
                        <TextBlock Text="Dark Mode" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}" />
                        <TextBlock Text="Switch between dark and light theme"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondary}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Status message (auto-save feedback) -->
            <TextBlock Text="{Binding StatusMessage}"
                       FontSize="12"
                       Foreground="{DynamicResource StatusPass}"
                       Margin="0,8,0,0" />

            <!-- Info note -->
            <TextBlock Text="Settings auto-save and apply immediately. Stored in ~/.sovrant/settings.json."
                       FontSize="11" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextMuted}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
