<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Sovrant.Desktop.ViewModels"
             xmlns:ctrl="using:Sovrant.Desktop.Controls"
             x:Class="Sovrant.Desktop.Views.WorkspacesView"
             x:DataType="vm:WorkspacesViewModel"
             Background="{DynamicResource SurfaceBackground}">

    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="32,24,32,0" Spacing="12">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Refresh"
                        Command="{Binding RefreshCommand}"
                        Padding="12,6" CornerRadius="6"
                        Background="Transparent" Foreground="{DynamicResource TextPrimary}" />
                <StackPanel>
                    <TextBlock Text="Workspaces" FontSize="24" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimary}" />
                    <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondary}">
                        <Run Text="{Binding TotalCount}" />
                        <Run Text=" workspaces" />
                    </TextBlock>
                </StackPanel>
            </DockPanel>
            <TextBlock Text="{Binding StatusMessage}" FontSize="11"
                       Foreground="{DynamicResource TextMuted}"
                       IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>

        <Grid Margin="32,12,32,24" ColumnDefinitions="320,12,*">
            <DockPanel Grid.Column="0">
                <!-- Create form -->
                <Border DockPanel.Dock="Bottom" Margin="0,8,0,0" Padding="12" CornerRadius="8"
                        Background="{DynamicResource SurfaceCard}"
                        BorderBrush="{DynamicResource SurfaceBorder}" BorderThickness="1">
                    <StackPanel Spacing="8">
                        <TextBlock Text="New Team Workspace" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}" />
                        <TextBox Text="{Binding NewWorkspaceName}"
                                 Watermark="Workspace name"
                                 FontSize="12" Padding="8,6" CornerRadius="6" />
                        <Button Content="Create"
                                Command="{Binding CreateWorkspaceCommand}"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                Padding="8,6" CornerRadius="6"
                                Background="{DynamicResource BrandPrimary}" Foreground="White" FontSize="12" />
                    </StackPanel>
                </Border>

                <!-- Workspace list -->
                <ScrollViewer>
                    <ItemsControl ItemsSource="{Binding Workspaces}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:WorkspaceItemViewModel">
                                <Button Command="{Binding $parent[ItemsControl].((vm:WorkspacesViewModel)DataContext).SelectWorkspaceCommand}"
                                        CommandParameter="{Binding}"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                        Padding="0" Margin="0,2"
                                        Background="Transparent" BorderThickness="0" Cursor="Hand">
                                    <Border Padding="12,10" CornerRadius="8"
                                            Background="{DynamicResource SurfaceCard}"
                                            BorderBrush="{DynamicResource SurfaceBorder}" BorderThickness="1">
                                        <StackPanel Spacing="4">
                                            <DockPanel>
                                                <Border DockPanel.Dock="Right"
                                                        Padding="6,2" CornerRadius="4"
                                                        Background="{DynamicResource BrandPrimary}"
                                                        IsVisible="{Binding IsPersonal}">
                                                    <TextBlock Text="Personal" FontSize="10" Foreground="White" />
                                                </Border>
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="13" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource BrandPrimary}" />
                                            </DockPanel>
                                            <TextBlock Text="{Binding Slug}" FontSize="10"
                                                       FontFamily="Consolas,Menlo,monospace"
                                                       Foreground="{DynamicResource TextMuted}" />
                                            <TextBlock FontSize="10" Foreground="{DynamicResource TextMuted}"
                                                       Text="{Binding CreatedAt, StringFormat='{}{0:MMM d, yyyy}'}" />
                                        </StackPanel>
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>

            <!-- Detail pane -->
            <Grid Grid.Column="2">
                <Border CornerRadius="10"
                        Background="{DynamicResource SurfaceCard}"
                        BorderBrush="{DynamicResource SurfaceBorder}" BorderThickness="1"
                        Padding="20,16"
                        IsVisible="{Binding !SelectedWorkspace}">
                    <TextBlock Text="Select a workspace to view details"
                               FontSize="14" Foreground="{DynamicResource TextMuted}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <Border CornerRadius="10"
                        Background="{DynamicResource SurfaceCard}"
                        BorderBrush="{DynamicResource SurfaceBorder}" BorderThickness="1"
                        Padding="20,16"
                        IsVisible="{Binding !!SelectedWorkspace}">
                    <DockPanel>
                        <!-- Action buttons -->
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,0,0,12">
                            <Button Content="Delete"
                                    Command="{Binding DeleteWorkspaceCommand}"
                                    CommandParameter="{Binding SelectedWorkspace}"
                                    Padding="10,5" CornerRadius="4" FontSize="11"
                                    Background="#44F44336" Foreground="{DynamicResource StatusFail}"
                                    IsVisible="{Binding SelectedWorkspace.IsPersonal, Converter={x:Static BoolConverters.Not}, FallbackValue=False}" />
                        </StackPanel>

                        <!-- Workspace markdown info -->
                        <ContentControl DockPanel.Dock="Top" Content="{Binding SelectedWorkspace}" Margin="0,0,0,16">
                            <ContentControl.ContentTemplate>
                                <DataTemplate DataType="vm:WorkspaceItemViewModel">
                                    <ctrl:SafeMarkdownPresenter Markdown="{Binding Markdown}" />
                                </DataTemplate>
                            </ContentControl.ContentTemplate>
                        </ContentControl>

                        <!-- Members section -->
                        <ScrollViewer>
                            <StackPanel Spacing="8">
                                <TextBlock Text="Members" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}" />

                                <TextBlock Text="Loading members…" FontSize="12"
                                           Foreground="{DynamicResource TextMuted}"
                                           IsVisible="{Binding MembersLoading}" />

                                <ItemsControl ItemsSource="{Binding Members}"
                                              IsVisible="{Binding !MembersLoading}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="vm:WorkspaceMemberViewModel">
                                            <Border Padding="10,8" Margin="0,2" CornerRadius="6"
                                                    Background="{DynamicResource SurfaceBackground}"
                                                    BorderBrush="{DynamicResource SurfaceBorder}" BorderThickness="1">
                                                <DockPanel>
                                                    <Button DockPanel.Dock="Right"
                                                            Content="Remove"
                                                            Command="{Binding $parent[ItemsControl].((vm:WorkspacesViewModel)DataContext).RemoveMemberCommand}"
                                                            CommandParameter="{Binding}"
                                                            Padding="8,4" CornerRadius="4" FontSize="10"
                                                            Background="#44F44336" Foreground="{DynamicResource StatusFail}" />
                                                    <StackPanel Spacing="2">
                                                        <TextBlock Text="{Binding UserId}" FontSize="12" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextPrimary}" />
                                                        <TextBlock FontSize="10" Foreground="{DynamicResource TextMuted}">
                                                            <Run Text="{Binding Role}" />
                                                            <Run Text=" · Joined " />
                                                            <Run Text="{Binding JoinedAt, StringFormat='{}{0:MMM d, yyyy}'}" />
                                                        </TextBlock>
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Add member form -->
                                <Border Padding="12" CornerRadius="8" Margin="0,4,0,0"
                                        Background="{DynamicResource SurfaceBackground}"
                                        BorderBrush="{DynamicResource SurfaceBorder}" BorderThickness="1">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="Add Member" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimary}" />
                                        <TextBox Text="{Binding AddMemberUserId}"
                                                 Watermark="User ID"
                                                 FontSize="12" Padding="8,6" CornerRadius="6" />
                                        <ComboBox ItemsSource="{Binding RoleOptions}"
                                                  SelectedItem="{Binding AddMemberRole}"
                                                  HorizontalAlignment="Stretch" FontSize="12" />
                                        <Button Content="Add Member"
                                                Command="{Binding AddMemberCommand}"
                                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                                Padding="8,6" CornerRadius="6"
                                                Background="{DynamicResource BrandPrimary}" Foreground="White" FontSize="12" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</UserControl>
