<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Sovrant.Desktop.ViewModels"
             xmlns:ctrl="using:Sovrant.Desktop.Controls"
             xmlns:ae="using:AvaloniaEdit"
             x:Class="Sovrant.Desktop.Views.Shared.MarkdownEditorView"
             x:DataType="vm:MarkdownEditorViewModel">

    <DockPanel>
        <!-- Toolbar -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource SurfaceCard}"
                BorderBrush="{DynamicResource SurfaceBorder}"
                BorderThickness="0,0,0,1"
                Padding="12,8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
                    <TextBlock VerticalAlignment="Center"
                               FontSize="11"
                               Foreground="{DynamicResource TextMuted}">
                        <Run Text="{Binding WordCount}" />
                        <Run Text=" words" />
                    </TextBlock>
                    <Button Content="Toggle preview"
                            Command="{Binding TogglePreviewCommand}"
                            Padding="10,4" />
                    <Button Content="Cancel"
                            Command="{Binding CancelCommand}"
                            Padding="10,4" />
                    <Button Content="Save"
                            Command="{Binding SaveCommand}"
                            Padding="10,4"
                            Background="{DynamicResource BrandPrimary}"
                            Foreground="White"
                            IsEnabled="{Binding ValidationError, Converter={x:Static StringConverters.IsNullOrEmpty}}"
                            IsVisible="{Binding !IsReadOnly}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}"
                               IsVisible="{Binding Title, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <Border Background="{DynamicResource SurfaceBorder}"
                            CornerRadius="3"
                            Padding="6,2"
                            IsVisible="{Binding IsReadOnly}">
                        <TextBlock Text="Read-only"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextSecondary}" />
                    </Border>
                    <TextBlock Text="{Binding ValidationError}"
                               FontSize="12"
                               Foreground="{DynamicResource StatusFail}"
                               IsVisible="{Binding ValidationError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Editor + preview -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ae:TextEditor x:Name="Editor"
                           Grid.Column="0"
                           ShowLineNumbers="True"
                           WordWrap="True"
                           FontFamily="Consolas,Menlo,monospace"
                           FontSize="13"
                           IsReadOnly="{Binding IsReadOnly}"
                           Background="{DynamicResource SurfaceBackground}"
                           Foreground="{DynamicResource TextPrimary}" />

            <GridSplitter Grid.Column="1"
                          Width="4"
                          Background="{DynamicResource SurfaceBorder}"
                          IsVisible="{Binding ShowPreview}" />

            <ScrollViewer Grid.Column="2"
                          IsVisible="{Binding ShowPreview}"
                          Padding="16,12">
                <ctrl:SafeMarkdownPresenter Markdown="{Binding PreviewMarkdown}" />
            </ScrollViewer>
        </Grid>
    </DockPanel>
</UserControl>
