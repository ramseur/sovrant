<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Sovrant.Desktop.ViewModels"
             x:Class="Sovrant.Desktop.Views.AdminPanelView"
             x:DataType="vm:SidebarViewModel"
             Background="{DynamicResource SidebarBackground}">
    <ScrollViewer>
        <StackPanel Margin="12,10,12,10">
            <TextBlock Text="ADMIN" FontSize="11.5" FontWeight="Bold"
                       Foreground="{DynamicResource TextMuted}"
                       Margin="9,4,0,8" />

            <TextBlock Text="OVERVIEW" FontSize="10.5" FontWeight="Bold"
                       Foreground="{DynamicResource TextMuted}"
                       Margin="9,0,0,4" />
            <Button Content="Command Center"
                    Command="{Binding NavigateCommand}" CommandParameter="CommandCenter"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" VerticalContentAlignment="Center"
                    Padding="12,0" Height="40" Margin="0,1" CornerRadius="8" FontSize="13.5"
                    Background="{Binding SelectedNavItem, Converter={x:Static vm:NavActiveBrushConverter.SubNavBgSoft}, ConverterParameter=CommandCenter}"
                    Foreground="{Binding SelectedNavItem, Converter={x:Static vm:NavActiveBrushConverter.SubNavFgOrText}, ConverterParameter=CommandCenter}" />

            <TextBlock Text="ACCESS" FontSize="10.5" FontWeight="Bold"
                       Foreground="{DynamicResource TextMuted}"
                       Margin="9,14,0,4" />
            <Button Content="Users"
                    Command="{Binding NavigateCommand}" CommandParameter="Admin"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" VerticalContentAlignment="Center"
                    Padding="12,0" Height="40" Margin="0,1" CornerRadius="8" FontSize="13.5"
                    Background="{Binding SelectedNavItem, Converter={x:Static vm:NavActiveBrushConverter.SubNavBgSoft}, ConverterParameter=Admin}"
                    Foreground="{Binding SelectedNavItem, Converter={x:Static vm:NavActiveBrushConverter.SubNavFgOrText}, ConverterParameter=Admin}" />
            <Button Content="Workspaces"
                    Command="{Binding NavigateCommand}" CommandParameter="AdminWorkspaces"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" VerticalContentAlignment="Center"
                    Padding="12,0" Height="40" Margin="0,1" CornerRadius="8" FontSize="13.5"
                    Background="{Binding SelectedNavItem, Converter={x:Static vm:NavActiveBrushConverter.SubNavBgSoft}, ConverterParameter=AdminWorkspaces}"
                    Foreground="{Binding SelectedNavItem, Converter={x:Static vm:NavActiveBrushConverter.SubNavFgOrText}, ConverterParameter=AdminWorkspaces}" />
            <Button Content="Providers"
                    Command="{Binding NavigateCommand}" CommandParameter="AdminProviders"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" VerticalContentAlignment="Center"
                    Padding="12,0" Height="40" Margin="0,1" CornerRadius="8" FontSize="13.5"
                    Background="{Binding SelectedNavItem, Converter={x:Static vm:NavActiveBrushConverter.SubNavBgSoft}, ConverterParameter=AdminProviders}"
                    Foreground="{Binding SelectedNavItem, Converter={x:Static vm:NavActiveBrushConverter.SubNavFgOrText}, ConverterParameter=AdminProviders}" />

            <TextBlock Text="SAFETY" FontSize="10.5" FontWeight="Bold"
                       Foreground="{DynamicResource TextMuted}"
                       Margin="9,14,0,4" />
            <Button Content="Governance"
                    Command="{Binding NavigateCommand}" CommandParameter="Governance"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" VerticalContentAlignment="Center"
                    Padding="12,0" Height="40" Margin="0,1" CornerRadius="8" FontSize="13.5"
                    Background="{Binding SelectedNavItem, Converter={x:Static vm:NavActiveBrushConverter.SubNavBgSoft}, ConverterParameter=Governance}"
                    Foreground="{Binding SelectedNavItem, Converter={x:Static vm:NavActiveBrushConverter.SubNavFgOrText}, ConverterParameter=Governance}" />
            <Button Content="Trust Boundary"
                    Command="{Binding NavigateCommand}" CommandParameter="TrustBoundary"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" VerticalContentAlignment="Center"
                    Padding="12,0" Height="40" Margin="0,1" CornerRadius="8" FontSize="13.5"
                    Background="{Binding SelectedNavItem, Converter={x:Static vm:NavActiveBrushConverter.SubNavBgSoft}, ConverterParameter=TrustBoundary}"
                    Foreground="{Binding SelectedNavItem, Converter={x:Static vm:NavActiveBrushConverter.SubNavFgOrText}, ConverterParameter=TrustBoundary}" />

            <TextBlock Text="SYSTEM" FontSize="10.5" FontWeight="Bold"
                       Foreground="{DynamicResource TextMuted}"
                       Margin="9,14,0,4" />
            <Button Content="Diagnostics"
                    Command="{Binding NavigateCommand}" CommandParameter="Diagnostics"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" VerticalContentAlignment="Center"
                    Padding="12,0" Height="40" Margin="0,1" CornerRadius="8" FontSize="13.5"
                    Background="{Binding SelectedNavItem, Converter={x:Static vm:NavActiveBrushConverter.SubNavBgSoft}, ConverterParameter=Diagnostics}"
                    Foreground="{Binding SelectedNavItem, Converter={x:Static vm:NavActiveBrushConverter.SubNavFgOrText}, ConverterParameter=Diagnostics}" />
            <Button Content="Platform Integrations"
                    Command="{Binding NavigateCommand}" CommandParameter="AdminPlatformIntegrations"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" VerticalContentAlignment="Center"
                    Padding="12,0" Height="40" Margin="0,1" CornerRadius="8" FontSize="13.5"
                    Background="{Binding SelectedNavItem, Converter={x:Static vm:NavActiveBrushConverter.SubNavBgSoft}, ConverterParameter=AdminPlatformIntegrations}"
                    Foreground="{Binding SelectedNavItem, Converter={x:Static vm:NavActiveBrushConverter.SubNavFgOrText}, ConverterParameter=AdminPlatformIntegrations}" />
            <Button Content="System Integrations"
                    Command="{Binding NavigateCommand}" CommandParameter="AdminSystemIntegrations"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" VerticalContentAlignment="Center"
                    Padding="12,0" Height="40" Margin="0,1" CornerRadius="8" FontSize="13.5"
                    Background="{Binding SelectedNavItem, Converter={x:Static vm:NavActiveBrushConverter.SubNavBgSoft}, ConverterParameter=AdminSystemIntegrations}"
                    Foreground="{Binding SelectedNavItem, Converter={x:Static vm:NavActiveBrushConverter.SubNavFgOrText}, ConverterParameter=AdminSystemIntegrations}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
