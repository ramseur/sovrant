<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Sovrant.Desktop.ViewModels"
             xmlns:md="https://github.com/whistyun/Markdown.Avalonia"
             x:Class="Sovrant.Desktop.Views.ArtifactsView"
             x:DataType="vm:ArtifactsViewModel"
             Background="{DynamicResource SurfaceBackground}">

    <DockPanel>
        <!-- Header -->
        <StackPanel DockPanel.Dock="Top" Margin="32,24,32,0" Spacing="12">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Reload"
                        Command="{Binding LoadCommand}"
                        Padding="12,6" CornerRadius="6"
                        Background="Transparent" Foreground="{DynamicResource TextPrimary}" />
                <StackPanel>
                    <TextBlock Text="Artifacts" FontSize="24" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimary}" />
                    <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondary}">
                        <Run Text="{Binding TotalCount}" />
                        <Run Text=" artifacts — select one to preview" />
                    </TextBlock>
                </StackPanel>
            </DockPanel>

            <TextBox Text="{Binding SearchText}"
                     Watermark="Search artifacts..."
                     CornerRadius="8" Padding="12,8" />
        </StackPanel>

        <!-- Master-detail -->
        <Grid Margin="32,12,32,24" ColumnDefinitions="340,12,*">
            <!-- Artifact list -->
            <ScrollViewer Grid.Column="0">
                <ItemsControl ItemsSource="{Binding FilteredArtifacts}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:ArtifactItemViewModel">
                            <Button Command="{Binding $parent[ItemsControl].((vm:ArtifactsViewModel)DataContext).SelectArtifactCommand}"
                                    CommandParameter="{Binding}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    Padding="0" Margin="0,2"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand">
                                <Border Padding="12,10" CornerRadius="8"
                                        Background="{DynamicResource SurfaceCard}"
                                        BorderBrush="{DynamicResource SurfaceBorder}"
                                        BorderThickness="1">
                                    <StackPanel Spacing="4">
                                        <DockPanel>
                                            <!-- Size badge -->
                                            <TextBlock DockPanel.Dock="Right"
                                                       Text="{Binding SizeDisplay}"
                                                       FontSize="10"
                                                       Foreground="{DynamicResource TextMuted}"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding FileName}"
                                                       FontSize="13" FontWeight="SemiBold"
                                                       FontFamily="Consolas,Menlo,monospace"
                                                       Foreground="{DynamicResource BrandPrimary}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                        <TextBlock Text="{Binding Path}"
                                                   FontSize="10"
                                                   FontFamily="Consolas,Menlo,monospace"
                                                   Foreground="{DynamicResource TextSecondary}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <TextBlock Text="{Binding WorkspaceId}"
                                                       FontSize="10"
                                                       Foreground="{DynamicResource TextMuted}" />
                                            <TextBlock Text="{Binding ContentType}"
                                                       FontSize="10"
                                                       Foreground="{DynamicResource TextMuted}" />
                                            <TextBlock Text="{Binding LastModified, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}"
                                                       FontSize="10"
                                                       Foreground="{DynamicResource TextMuted}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Detail/preview pane -->
            <Grid Grid.Column="2">
                <Border CornerRadius="10"
                        Background="{DynamicResource SurfaceCard}"
                        BorderBrush="{DynamicResource SurfaceBorder}"
                        BorderThickness="1"
                        Padding="20,16"
                        IsVisible="{Binding !SelectedArtifact}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                Spacing="8">
                        <TextBlock Text="Select an artifact to preview"
                                   FontSize="14"
                                   Foreground="{DynamicResource TextMuted}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="No artifacts yet"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextMuted}"
                                   HorizontalAlignment="Center"
                                   IsVisible="{Binding !TotalCount}" />
                    </StackPanel>
                </Border>
                <Border CornerRadius="10"
                        Background="{DynamicResource SurfaceCard}"
                        BorderBrush="{DynamicResource SurfaceBorder}"
                        BorderThickness="1"
                        Padding="20,16"
                        IsVisible="{Binding !!SelectedArtifact}">
                    <Panel>
                        <!-- Markdown preview for .md files -->
                        <md:MarkdownScrollViewer Markdown="{Binding DetailText}"
                                                 IsVisible="{Binding IsMarkdownPreview}" />
                        <!-- Plain text preview for other files -->
                        <ScrollViewer IsVisible="{Binding !IsMarkdownPreview}">
                            <SelectableTextBlock Text="{Binding DetailText}"
                                                 TextWrapping="Wrap"
                                                 FontSize="13"
                                                 FontFamily="Consolas,Menlo,monospace"
                                                 Foreground="{DynamicResource TextPrimary}"
                                                 Padding="4" />
                        </ScrollViewer>
                    </Panel>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</UserControl>
