<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Sovrant.Desktop.ViewModels"
             x:Class="Sovrant.Desktop.Views.ArtifactsView"
             x:DataType="vm:ArtifactsViewModel"
             Background="{DynamicResource SurfaceBackground}">

    <ScrollViewer Padding="32,24">
        <StackPanel MaxWidth="800" Spacing="16">
            <!-- Header -->
            <DockPanel>
                <Button DockPanel.Dock="Right"
                        Content="Reload"
                        Command="{Binding LoadCommand}"
                        Padding="16,8"
                        CornerRadius="8"
                        Background="{DynamicResource BrandPrimary}"
                        Foreground="White"
                        FontWeight="SemiBold" />
                <TextBlock Text="Artifacts" FontSize="24" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimary}"
                           VerticalAlignment="Center" />
            </DockPanel>

            <TextBlock Text="Files generated by agent runs"
                       FontSize="13"
                       Foreground="{DynamicResource TextSecondary}"
                       Margin="0,0,0,8" />

            <!-- Artifact list -->
            <ItemsControl ItemsSource="{Binding Artifacts}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:ArtifactItemViewModel">
                        <Border Margin="0,3"
                                Padding="14,10"
                                CornerRadius="8"
                                Background="{DynamicResource SurfaceCard}"
                                BorderBrush="{DynamicResource SurfaceBorder}"
                                BorderThickness="1">
                            <DockPanel>
                                <!-- Size on the right -->
                                <TextBlock DockPanel.Dock="Right"
                                           Text="{Binding SizeDisplay}"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextMuted}"
                                           VerticalAlignment="Center" />
                                <!-- File info -->
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{Binding Path}"
                                               FontSize="13" FontWeight="SemiBold"
                                               FontFamily="Consolas,Menlo,monospace"
                                               Foreground="{DynamicResource TextPrimary}" />
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <TextBlock Text="{Binding ContentType}" FontSize="11"
                                                   Foreground="{DynamicResource TextMuted}" />
                                        <TextBlock Text="{Binding LastModified, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextMuted}" />
                                    </StackPanel>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Empty state -->
            <TextBlock Text="No artifacts yet. Artifacts are created by agent runs."
                       FontSize="13"
                       Foreground="{DynamicResource TextSecondary}"
                       IsVisible="{Binding !Artifacts.Count}"
                       Margin="0,20"
                       HorizontalAlignment="Center" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
