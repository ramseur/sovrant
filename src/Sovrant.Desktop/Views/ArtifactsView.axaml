<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Sovrant.Desktop.ViewModels"
             xmlns:ctrl="using:Sovrant.Desktop.Controls"
             x:Class="Sovrant.Desktop.Views.ArtifactsView"
             x:DataType="vm:ArtifactsViewModel"
             Background="{DynamicResource SurfaceBackground}">

    <DockPanel>
        <!-- Header -->
        <StackPanel DockPanel.Dock="Top" Margin="32,24,32,0" Spacing="12">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Reload"
                        Command="{Binding LoadCommand}"
                        Padding="12,6" CornerRadius="6"
                        Background="Transparent" Foreground="{DynamicResource TextPrimary}" />
                <StackPanel>
                    <TextBlock Text="Artifacts" FontSize="24" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimary}" />
                    <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondary}">
                        <Run Text="{Binding TotalCount}" />
                        <Run Text=" artifacts — select one to preview" />
                    </TextBlock>
                </StackPanel>
            </DockPanel>

            <TextBox Text="{Binding SearchText}"
                     Watermark="Search artifacts..."
                     CornerRadius="8" Padding="12,8" />
        </StackPanel>

        <!-- Master-detail -->
        <Grid Margin="32,12,32,24" ColumnDefinitions="340,12,*">
            <!-- Artifact list -->
            <ScrollViewer Grid.Column="0">
                <ItemsControl ItemsSource="{Binding FilteredArtifacts}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:ArtifactItemViewModel">
                            <Button Command="{Binding $parent[ItemsControl].((vm:ArtifactsViewModel)DataContext).SelectArtifactCommand}"
                                    CommandParameter="{Binding}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    Padding="0" Margin="0,2"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand">
                                <Border Padding="12,10" CornerRadius="8"
                                        Background="{DynamicResource SurfaceCard}"
                                        BorderBrush="{DynamicResource SurfaceBorder}"
                                        BorderThickness="1">
                                    <StackPanel Spacing="4">
                                        <!-- Folder display -->
                                        <DockPanel IsVisible="{Binding IsFolder}">
                                            <TextBlock DockPanel.Dock="Right"
                                                       Text="{Binding SizeDisplay}"
                                                       FontSize="10"
                                                       Foreground="{DynamicResource TextMuted}"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding FolderDisplayName}"
                                                       FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource BrandPrimary}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                        <StackPanel IsVisible="{Binding IsFolder}" Orientation="Horizontal" Spacing="8">
                                            <TextBlock FontSize="10" Foreground="{DynamicResource TextSecondary}">
                                                <Run Text="{Binding FolderFiles.Count}" />
                                                <Run Text=" files" />
                                            </TextBlock>
                                            <TextBlock Text="{Binding LastModified, StringFormat='{}{0:yyyy-MM-dd}'}"
                                                       FontSize="10" Foreground="{DynamicResource TextMuted}" />
                                        </StackPanel>

                                        <!-- File display -->
                                        <DockPanel IsVisible="{Binding !IsFolder}">
                                            <TextBlock DockPanel.Dock="Right"
                                                       Text="{Binding SizeDisplay}"
                                                       FontSize="10"
                                                       Foreground="{DynamicResource TextMuted}"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding FileName}"
                                                       FontSize="13" FontWeight="SemiBold"
                                                       FontFamily="Consolas,Menlo,monospace"
                                                       Foreground="{DynamicResource BrandPrimary}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                        <TextBlock IsVisible="{Binding !IsFolder}"
                                                   Text="{Binding Path}"
                                                   FontSize="10"
                                                   FontFamily="Consolas,Menlo,monospace"
                                                   Foreground="{DynamicResource TextSecondary}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <StackPanel IsVisible="{Binding !IsFolder}" Orientation="Horizontal" Spacing="10">
                                            <TextBlock Text="{Binding WorkspaceId}"
                                                       FontSize="10"
                                                       Foreground="{DynamicResource TextMuted}" />
                                            <TextBlock Text="{Binding ContentType}"
                                                       FontSize="10"
                                                       Foreground="{DynamicResource TextMuted}" />
                                            <TextBlock Text="{Binding LastModified, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}"
                                                       FontSize="10"
                                                       Foreground="{DynamicResource TextMuted}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Detail/preview pane -->
            <Grid Grid.Column="2">
                <!-- Empty state -->
                <Border CornerRadius="10"
                        Background="{DynamicResource SurfaceCard}"
                        BorderBrush="{DynamicResource SurfaceBorder}"
                        BorderThickness="1"
                        Padding="20,16"
                        IsVisible="{Binding !SelectedArtifact}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                Spacing="8">
                        <TextBlock Text="Select an artifact to preview"
                                   FontSize="14"
                                   Foreground="{DynamicResource TextMuted}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="No artifacts yet"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextMuted}"
                                   HorizontalAlignment="Center"
                                   IsVisible="{Binding !TotalCount}" />
                    </StackPanel>
                </Border>

                <!-- Folder detail -->
                <Border CornerRadius="10"
                        Background="{DynamicResource SurfaceCard}"
                        BorderBrush="{DynamicResource SurfaceBorder}"
                        BorderThickness="1"
                        Padding="20,16"
                        IsVisible="{Binding IsSelectedFolder}">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
                                <Button Content="Download .zip"
                                        Command="{Binding DownloadRunZipCommand}"
                                        Padding="10,5" CornerRadius="6"
                                        Background="Transparent"
                                        Foreground="{DynamicResource TextPrimary}"
                                        BorderBrush="{DynamicResource SurfaceBorder}"
                                        BorderThickness="1" />
                                <Button Content="Open folder"
                                        Command="{Binding OpenRunFolderCommand}"
                                        Padding="10,5" CornerRadius="6"
                                        Background="Transparent"
                                        Foreground="{DynamicResource TextPrimary}"
                                        BorderBrush="{DynamicResource SurfaceBorder}"
                                        BorderThickness="1" />
                            </StackPanel>
                            <TextBlock Text="{Binding SelectedArtifact.FolderDisplayName}"
                                       FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="12" Margin="0,0,0,12">
                            <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondary}">
                                <Run Text="{Binding SelectedArtifact.FolderFiles.Count}" />
                                <Run Text=" files" />
                            </TextBlock>
                            <TextBlock Text="{Binding SelectedArtifact.SizeDisplay}"
                                       FontSize="12" Foreground="{DynamicResource TextSecondary}" />
                            <TextBlock Text="{Binding SelectedArtifact.LastModified, StringFormat='{}{0:MMM d, yyyy h:mm tt}'}"
                                       FontSize="12" Foreground="{DynamicResource TextSecondary}" />
                        </StackPanel>
                        <ScrollViewer>
                            <ItemsControl ItemsSource="{Binding SelectedArtifact.FolderFiles}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="vm:ArtifactItemViewModel">
                                        <Border Padding="10,8" Margin="0,2" CornerRadius="6"
                                                Background="{DynamicResource SurfaceBackground}"
                                                BorderBrush="{DynamicResource SurfaceBorder}"
                                                BorderThickness="1">
                                            <DockPanel>
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding SizeDisplay}"
                                                               FontSize="10"
                                                               Foreground="{DynamicResource TextMuted}"
                                                               VerticalAlignment="Center" />
                                                    <Button Content="Open"
                                                            Command="{Binding OpenFileCommand}"
                                                            Padding="8,4" CornerRadius="5" FontSize="11"
                                                            Background="Transparent"
                                                            Foreground="{DynamicResource TextPrimary}"
                                                            BorderBrush="{DynamicResource SurfaceBorder}"
                                                            BorderThickness="1" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding Path}"
                                                           FontSize="12"
                                                           FontFamily="Consolas,Menlo,monospace"
                                                           Foreground="{DynamicResource TextPrimary}"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" />
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- File detail -->
                <Border CornerRadius="10"
                        Background="{DynamicResource SurfaceCard}"
                        BorderBrush="{DynamicResource SurfaceBorder}"
                        BorderThickness="1"
                        Padding="20,16"
                        IsVisible="{Binding IsSelectedFile}">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
                                <Button Content="Download .zip"
                                        Command="{Binding DownloadRunZipCommand}"
                                        Padding="10,5" CornerRadius="6"
                                        Background="Transparent"
                                        Foreground="{DynamicResource TextPrimary}"
                                        BorderBrush="{DynamicResource SurfaceBorder}"
                                        BorderThickness="1" />
                                <Button Content="Open folder"
                                        Command="{Binding OpenRunFolderCommand}"
                                        Padding="10,5" CornerRadius="6"
                                        Background="Transparent"
                                        Foreground="{DynamicResource TextPrimary}"
                                        BorderBrush="{DynamicResource SurfaceBorder}"
                                        BorderThickness="1" />
                            </StackPanel>
                            <TextBlock Text="{Binding SelectedArtifact.FileName}"
                                       FontSize="14" FontWeight="SemiBold"
                                       FontFamily="Consolas,Menlo,monospace"
                                       Foreground="{DynamicResource TextPrimary}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                        </DockPanel>

                        <!-- Preview area -->
                        <Panel>
                            <ctrl:SafeMarkdownPresenter Markdown="{Binding DetailText}"
                                                        IsVisible="{Binding IsMarkdownPreview}" />
                            <ScrollViewer IsVisible="{Binding !IsMarkdownPreview}">
                                <SelectableTextBlock Text="{Binding DetailText}"
                                                     TextWrapping="Wrap"
                                                     FontSize="13"
                                                     FontFamily="Consolas,Menlo,monospace"
                                                     Foreground="{DynamicResource TextPrimary}"
                                                     Padding="4" />
                            </ScrollViewer>
                        </Panel>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</UserControl>
