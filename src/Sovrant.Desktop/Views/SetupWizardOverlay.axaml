<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Sovrant.Desktop.ViewModels"
             x:Class="Sovrant.Desktop.Views.SetupWizardOverlay"
             x:DataType="vm:SetupWizardViewModel"
             IsVisible="{Binding IsVisible}">

    <!-- Dark overlay backdrop -->
    <Border Background="#CC000000">
        <Border MaxWidth="500"
                CornerRadius="16"
                Background="{DynamicResource SurfaceCard}"
                BorderBrush="{DynamicResource SurfaceBorder}"
                BorderThickness="1"
                Padding="32,28"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                BoxShadow="0 8 32 0 #40000000">

            <StackPanel Spacing="14">
                <!-- Header -->
                <StackPanel HorizontalAlignment="Center" Spacing="6">
                    <Border Width="48" Height="48" CornerRadius="12"
                            Background="{DynamicResource BrandPrimary}"
                            HorizontalAlignment="Center">
                        <TextBlock Text="⚡" FontSize="24"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Welcome to Sovrant"
                               FontSize="22" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimary}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Connect a provider to get started. You can switch models anytime from the sidebar."
                               FontSize="13"
                               Foreground="{DynamicResource TextSecondary}"
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap"
                               TextAlignment="Center" />
                </StackPanel>

                <!-- Provider selector -->
                <StackPanel Spacing="4">
                    <TextBlock Text="Provider" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondary}" />
                    <ComboBox ItemsSource="{Binding Providers}"
                              SelectedItem="{Binding SelectedProvider}"
                              HorizontalAlignment="Stretch"
                              CornerRadius="8"
                              Padding="10,8" />
                </StackPanel>

                <!-- API Key -->
                <StackPanel Spacing="4">
                    <TextBlock Text="API Key" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondary}" />
                    <TextBox Text="{Binding ApiKey}"
                             Watermark="sk-..."
                             PasswordChar="•"
                             CornerRadius="8"
                             Padding="10,8" />
                </StackPanel>

                <!-- Base URL (auto-filled) -->
                <StackPanel Spacing="4">
                    <TextBlock Text="Base URL" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondary}" />
                    <TextBox Text="{Binding BaseUrl}"
                             Watermark="Auto-filled for known providers"
                             CornerRadius="8"
                             Padding="10,8"
                             FontSize="12" />
                    <TextBlock Text="Auto-filled when you select a known provider. Edit for custom endpoints."
                               FontSize="10"
                               Foreground="{DynamicResource TextMuted}" />
                </StackPanel>

                <!-- Status message -->
                <TextBlock Text="{Binding StatusMessage}"
                           FontSize="12"
                           Foreground="{DynamicResource StatusFail}"
                           IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                <!-- Save button -->
                <Button Content="Get Started"
                        Command="{Binding SaveAndStartCommand}"
                        HorizontalAlignment="Stretch"
                        Padding="14,10"
                        CornerRadius="8"
                        Background="{DynamicResource BrandPrimary}"
                        Foreground="White"
                        FontWeight="SemiBold"
                        FontSize="14"
                        IsEnabled="{Binding !IsSaving}" />

                <TextBlock Text="You can add more providers and switch models from the sidebar."
                           FontSize="11"
                           Foreground="{DynamicResource TextMuted}"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Border>
</UserControl>
