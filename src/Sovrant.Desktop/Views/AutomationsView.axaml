<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Sovrant.Desktop.ViewModels"
             x:Class="Sovrant.Desktop.Views.AutomationsView"
             x:DataType="vm:AutomationsViewModel"
             Background="{DynamicResource SurfaceBackground}">

    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="32,24,32,0" Spacing="8">
            <TextBlock Text="Automations" FontSize="24" FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimary}" />
            <TextBlock Text="Scheduled tasks, triggers, and automated workflows"
                       FontSize="12" Foreground="{DynamicResource TextSecondary}" />
        </StackPanel>

        <StackPanel Margin="32,40" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Spacing="16" MaxWidth="480">
            <Border Width="64" Height="64" CornerRadius="16"
                    Background="{DynamicResource BrandPrimary}"
                    HorizontalAlignment="Center">
                <TextBlock Text="⚡" FontSize="28"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Border>

            <TextBlock Text="Automations" FontSize="22" FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimary}"
                       HorizontalAlignment="Center" />

            <TextBlock Text="Create scheduled tasks, event-driven triggers, and automated workflows that run agents on your behalf. Set up recurring code reviews, automated deployments, and more."
                       FontSize="14" Foreground="{DynamicResource TextSecondary}"
                       TextWrapping="Wrap" TextAlignment="Center" />

            <Border Padding="10,4" CornerRadius="6"
                    Background="{DynamicResource StatusWarn}"
                    HorizontalAlignment="Center" Margin="0,8,0,0">
                <TextBlock Text="COMING SOON" FontSize="11" FontWeight="Bold" Foreground="White" />
            </Border>

            <TextBlock Text="This feature is under active development. Check back soon!"
                       FontSize="12" Foreground="{DynamicResource TextMuted}"
                       HorizontalAlignment="Center" />
        </StackPanel>
    </DockPanel>
</UserControl>
