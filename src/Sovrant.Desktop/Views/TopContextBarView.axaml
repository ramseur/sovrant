<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Sovrant.Desktop.ViewModels"
             xmlns:conv="using:Sovrant.Desktop.Converters"
             x:Class="Sovrant.Desktop.Views.TopContextBarView"
             x:DataType="vm:SidebarViewModel"
             Background="{DynamicResource SurfaceBackground}">

    <Border Height="50"
            Padding="12,0"
            BorderBrush="{DynamicResource SurfaceBorder}"
            BorderThickness="0,0,0,1">
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">

            <!-- Provider/Model two-step switcher -->
            <Panel Width="280">
                <Button Command="{Binding ToggleDropdownCommand}"
                        HorizontalAlignment="Stretch"
                        Padding="8,5" CornerRadius="6"
                        Background="{DynamicResource SurfaceCard}"
                        BorderBrush="{DynamicResource SurfaceBorder}"
                        BorderThickness="1">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="▾" FontSize="12"
                                   Foreground="{DynamicResource TextMuted}"
                                   VerticalAlignment="Center" Margin="4,0,0,0" />
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                                     Fill="{DynamicResource StatusPass}"
                                     IsVisible="{Binding IsConnected}" />
                            <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                                     Fill="{DynamicResource StatusWarn}"
                                     IsVisible="{Binding !IsConnected}" />
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <TextBlock Text="{Binding CurrentModel}" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}"
                                           TextTrimming="CharacterEllipsis" MaxWidth="150"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="·" FontSize="12"
                                           Foreground="{DynamicResource TextMuted}"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{Binding CurrentProvider}" FontSize="11"
                                           Foreground="{DynamicResource TextSecondary}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>
                </Button>

                <Popup IsOpen="{Binding IsDropdownOpen, Mode=TwoWay}"
                       Placement="BottomEdgeAlignedLeft"
                       IsLightDismissEnabled="True"
                       MaxHeight="340">
                    <Border Background="{DynamicResource SurfaceCard}"
                            BorderBrush="{DynamicResource SurfaceBorder}"
                            BorderThickness="1" CornerRadius="8"
                            Padding="4" MinWidth="240"
                            BoxShadow="0 8 24 0 #59000000">
                        <StackPanel>
                            <StackPanel IsVisible="{Binding IsProviderStep}">
                                <TextBlock Text="SELECT PROVIDER" FontSize="9" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextMuted}"
                                           Margin="8,4,0,4"
                                           IsVisible="{Binding HasProviderProfiles}" />
                                <ItemsControl ItemsSource="{Binding TreeGroups}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ProviderTreeGroup">
                                            <Button Command="{Binding $parent[UserControl].((vm:SidebarViewModel)DataContext).SelectProviderCommand}"
                                                    CommandParameter="{Binding}"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Left"
                                                    Padding="8,5" Margin="0,1" CornerRadius="5"
                                                    Background="Transparent"
                                                    Foreground="{DynamicResource TextPrimary}">
                                                <DockPanel>
                                                    <Border DockPanel.Dock="Right"
                                                            Padding="5,1" CornerRadius="8"
                                                            Background="{DynamicResource SurfaceBackground}"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding ModelCount}" FontSize="9"
                                                                   Foreground="{DynamicResource TextMuted}" />
                                                    </Border>
                                                    <TextBlock Text="{Binding Provider}" FontSize="12" FontWeight="Medium"
                                                               VerticalAlignment="Center" />
                                                </DockPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                    <!-- Available to set up (unconfigured known providers) -->
                                <StackPanel IsVisible="{Binding HasUnconfiguredProviders}">
                                    <Border Height="1" Background="{DynamicResource SurfaceBorder}"
                                            Margin="8,6,8,0"
                                            IsVisible="{Binding HasProviderProfiles}" />
                                    <TextBlock Text="{Binding UnconfiguredSectionLabel}"
                                               FontSize="9" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextMuted}"
                                               Margin="8,6,0,2" />
                                    <ItemsControl ItemsSource="{Binding UnconfiguredProviders}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:UnconfiguredProviderItem">
                                                <Button Command="{Binding $parent[UserControl].((vm:SidebarViewModel)DataContext).SetUpProviderCommand}"
                                                        CommandParameter="{Binding}"
                                                        HorizontalAlignment="Stretch"
                                                        HorizontalContentAlignment="Left"
                                                        Padding="8,4" Margin="0,1" CornerRadius="5"
                                                        Background="Transparent"
                                                        Opacity="0.65"
                                                        Foreground="{DynamicResource TextPrimary}">
                                                    <DockPanel>
                                                        <TextBlock DockPanel.Dock="Right"
                                                                   Text="Set up →"
                                                                   FontSize="10"
                                                                   Foreground="{DynamicResource BrandPrimary}"
                                                                   VerticalAlignment="Center" />
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <TextBlock Text="{Binding Icon}" FontSize="12"
                                                                       VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding Name}" FontSize="12"
                                                                       FontWeight="Normal"
                                                                       VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </DockPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel IsVisible="{Binding !IsProviderStep}">
                                <Button Command="{Binding BackToProvidersCommand}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Padding="8,4" CornerRadius="5"
                                        Background="Transparent"
                                        Foreground="{DynamicResource TextSecondary}"
                                        FontSize="11">
                                    <TextBlock Text="◂ Back to providers" />
                                </Button>
                                <TextBlock Text="{Binding SelectedTreeGroup.Provider, StringFormat='{}{0} models'}"
                                           FontSize="9" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextMuted}"
                                           Margin="8,4,0,4" />
                                <ScrollViewer MaxHeight="260">
                                    <ItemsControl ItemsSource="{Binding SelectedTreeGroup.Models}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:ModelOption">
                                                <Button Command="{Binding $parent[UserControl].((vm:SidebarViewModel)DataContext).SelectModelCommand}"
                                                        CommandParameter="{Binding}"
                                                        HorizontalAlignment="Stretch"
                                                        HorizontalContentAlignment="Left"
                                                        Padding="10,4" Margin="0,1" CornerRadius="4"
                                                        Background="Transparent"
                                                        Foreground="{DynamicResource TextSecondary}"
                                                        FontSize="11">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <TextBlock Text="{Binding DisplayName}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   VerticalAlignment="Center" />
                                                        <Border IsVisible="{Binding IsFree}"
                                                                Background="#1A22C55E"
                                                                BorderBrush="#22C55E"
                                                                BorderThickness="1"
                                                                CornerRadius="3"
                                                                Padding="4,1"
                                                                VerticalAlignment="Center">
                                                            <TextBlock Text="Free"
                                                                       FontSize="9"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="#22C55E" />
                                                        </Border>
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Popup>
            </Panel>

            <!-- Vertical separator -->
            <Border Width="1" Height="22"
                    Background="{DynamicResource SurfaceBorder}"
                    Margin="2,0" />

            <!-- Workspace -->
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <TextBlock Text="🏢" FontSize="12" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextMuted}" />
                <ComboBox ItemsSource="{Binding ActiveContext.Workspaces}"
                          SelectedItem="{Binding ActiveContext.SelectedWorkspace}"
                          DisplayMemberBinding="{Binding Name}"
                          MinWidth="140"
                          CornerRadius="6"
                          Padding="8,4"
                          FontSize="12" />
            </StackPanel>

            <!-- Project -->
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <TextBlock Text="📁" FontSize="12" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextMuted}" />
                <ComboBox ItemsSource="{Binding ActiveContext.ProjectChoices}"
                          SelectedItem="{Binding ActiveContext.SelectedProjectChoice}"
                          DisplayMemberBinding="{Binding Name}"
                          MinWidth="160"
                          CornerRadius="6"
                          Padding="8,4"
                          FontSize="12" />
            </StackPanel>

            <!-- Vertical separator -->
            <Border Width="1" Height="22"
                    Background="{DynamicResource SurfaceBorder}"
                    Margin="2,0" />

            <!-- Integrations / MCP multi-select — styled to match workspace/project switchers -->
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <TextBlock Text="🔌" FontSize="12" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextMuted}" />
                <Panel MinWidth="140">
                    <Button Command="{Binding ToggleMcpDropdownCommand}"
                            HorizontalAlignment="Stretch"
                            Padding="8,4" CornerRadius="6"
                            Background="{DynamicResource SurfaceCard}"
                            BorderBrush="{DynamicResource SurfaceBorder}"
                            BorderThickness="1">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="▾" FontSize="11"
                                       Foreground="{DynamicResource TextMuted}"
                                       VerticalAlignment="Center" Margin="6,0,0,0" />
                            <TextBlock Text="{Binding McpSummaryLabel}"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextPrimary}"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />
                        </DockPanel>
                    </Button>

                    <Popup IsOpen="{Binding IsMcpDropdownOpen, Mode=TwoWay}"
                           Placement="BottomEdgeAlignedLeft"
                           IsLightDismissEnabled="True">
                        <Border Background="{DynamicResource SurfaceCard}"
                                BorderBrush="{DynamicResource SurfaceBorder}"
                                BorderThickness="1" CornerRadius="8"
                                Padding="6,8" MinWidth="220"
                                BoxShadow="0 8 24 0 #59000000">
                            <StackPanel>

                                <TextBlock Text="INTEGRATIONS"
                                           FontSize="9" FontWeight="Bold"
                                           Foreground="{DynamicResource TextMuted}"
                                           Margin="8,0,0,6" />

                                <!-- Configured servers — toggle rows -->
                                <ItemsControl ItemsSource="{Binding ActiveContext.AvailableMcpServers}"
                                              IsVisible="{Binding ActiveContext.AvailableMcpServers.Count,
                                                                  Converter={x:Static conv:IntToBoolConverter.Instance}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="vm:McpServerToggleItem">
                                            <Border CornerRadius="5" Margin="0,1"
                                                    Background="Transparent">
                                                <Border.Styles>
                                                    <Style Selector="Border:pointerover">
                                                        <Setter Property="Background" Value="{DynamicResource SurfaceBackground}" />
                                                    </Style>
                                                </Border.Styles>
                                                <DockPanel Margin="6,5">
                                                    <CheckBox DockPanel.Dock="Left"
                                                              IsChecked="{Binding IsActive, Mode=TwoWay}"
                                                              VerticalAlignment="Center"
                                                              Margin="0,0,8,0" />
                                                    <TextBlock Text="{Binding Name}"
                                                               FontSize="12"
                                                               Foreground="{DynamicResource TextPrimary}"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis" />
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Empty state -->
                                <StackPanel IsVisible="{Binding ActiveContext.AvailableMcpServers.Count,
                                                                Converter={x:Static conv:IntToBoolConverter.Inverse}}"
                                            Margin="8,2,8,6" Spacing="6">
                                    <TextBlock Text="No integrations connected."
                                               FontSize="11"
                                               Foreground="{DynamicResource TextMuted}" />
                                </StackPanel>

                                <!-- Divider + footer action -->
                                <Border Height="1" Background="{DynamicResource SurfaceBorder}"
                                        Margin="4,6,4,4" />
                                <Button Command="{Binding GoToIntegrationsCommand}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Padding="8,5" CornerRadius="5"
                                        Background="Transparent"
                                        Foreground="{DynamicResource BrandPrimary}"
                                        FontSize="11"
                                        Content="Manage Integrations →" />

                            </StackPanel>
                        </Border>
                    </Popup>
                </Panel>
            </StackPanel>

            <!-- Agent indicator — only visible when a session is scoped to an agent -->
            <Border CornerRadius="12"
                    Padding="8,3"
                    Background="{DynamicResource SurfaceCard}"
                    BorderBrush="{DynamicResource SurfaceBorder}"
                    BorderThickness="1"
                    VerticalAlignment="Center"
                    IsVisible="{Binding ActiveContext.ActiveAgentName,
                                        Converter={x:Static conv:StringNotNullOrEmptyConverter.Instance}}"
                    ToolTip.Tip="{Binding ActiveContext.ActiveAgentName,
                                         StringFormat='Session scoped to agent: {0}'}">
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <TextBlock Text="🤖" FontSize="11" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding ActiveContext.ActiveAgentName}"
                               FontSize="12" FontWeight="Medium"
                               Foreground="{DynamicResource TextPrimary}"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="120"
                               VerticalAlignment="Center" />
                    <Button Command="{Binding ClearAgentCommand}"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="2,0"
                            VerticalAlignment="Center"
                            ToolTip.Tip="Clear agent">
                        <TextBlock Text="✕"
                                   FontSize="9"
                                   Foreground="{DynamicResource TextMuted}" />
                    </Button>
                </StackPanel>
            </Border>

        </StackPanel>
    </Border>
</UserControl>
