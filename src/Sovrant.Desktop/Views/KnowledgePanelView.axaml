<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Sovrant.Desktop.ViewModels"
             x:Class="Sovrant.Desktop.Views.KnowledgePanelView"
             x:DataType="vm:SidebarViewModel"
             Background="{DynamicResource SidebarBackground}">
    <ScrollViewer>
        <StackPanel Margin="10">
            <TextBlock Text="KNOWLEDGE" FontSize="11" FontWeight="Bold"
                       Foreground="{DynamicResource TextMuted}"
                       Margin="6,4,0,10" />
            <Button Content="📄  Artifacts"
                    Command="{Binding NavigateCommand}" CommandParameter="Artifacts"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                    Padding="10,6" Margin="0,1" CornerRadius="6" FontSize="13"
                    Background="{Binding SelectedNavItem, Converter={x:Static vm:NavActiveBrushConverter.SubNavBg}, ConverterParameter=Artifacts}"
                    Foreground="{DynamicResource TextPrimary}" />
            <Button Content="📐  Code Templates"
                    Command="{Binding NavigateCommand}" CommandParameter="Guidelines"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                    Padding="10,6" Margin="0,1" CornerRadius="6" FontSize="13"
                    Background="{Binding SelectedNavItem, Converter={x:Static vm:NavActiveBrushConverter.SubNavBg}, ConverterParameter=Guidelines}"
                    Foreground="{DynamicResource TextPrimary}" />
            <Button Content="📝  Documents"
                    Command="{Binding NavigateCommand}" CommandParameter="Documents"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                    Padding="10,6" Margin="0,1" CornerRadius="6" FontSize="13"
                    Background="{Binding SelectedNavItem, Converter={x:Static vm:NavActiveBrushConverter.SubNavBg}, ConverterParameter=Documents}"
                    Foreground="{DynamicResource TextPrimary}" />
            <Button Content="🧠  Memory"
                    Command="{Binding NavigateCommand}" CommandParameter="Memory"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                    Padding="10,6" Margin="0,1" CornerRadius="6" FontSize="13"
                    Background="{Binding SelectedNavItem, Converter={x:Static vm:NavActiveBrushConverter.SubNavBg}, ConverterParameter=Memory}"
                    Foreground="{DynamicResource TextPrimary}" />
            <Button Content="📜  Skills"
                    Command="{Binding NavigateCommand}" CommandParameter="Skills"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                    Padding="10,6" Margin="0,1" CornerRadius="6" FontSize="13"
                    Background="{Binding SelectedNavItem, Converter={x:Static vm:NavActiveBrushConverter.SubNavBg}, ConverterParameter=Skills}"
                    Foreground="{DynamicResource TextPrimary}" />
            <Button Content="🛠  Tools"
                    Command="{Binding NavigateCommand}" CommandParameter="Tools"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                    Padding="10,6" Margin="0,1" CornerRadius="6" FontSize="13"
                    Background="{Binding SelectedNavItem, Converter={x:Static vm:NavActiveBrushConverter.SubNavBg}, ConverterParameter=Tools}"
                    Foreground="{DynamicResource TextPrimary}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
