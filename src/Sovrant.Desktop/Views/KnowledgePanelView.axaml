<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Sovrant.Desktop.ViewModels"
             xmlns:ctrl="using:Sovrant.Desktop.Controls"
             x:Class="Sovrant.Desktop.Views.KnowledgePanelView"
             x:DataType="vm:SidebarViewModel"
             Background="{DynamicResource SidebarBackground}">
    <ScrollViewer>
        <StackPanel Margin="10">
            <TextBlock Text="KNOWLEDGE" FontSize="11" FontWeight="Bold"
                       Foreground="{DynamicResource TextMuted}"
                       Margin="6,4,0,10" />
            <Button Command="{Binding NavigateCommand}" CommandParameter="Artifacts"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                    Padding="10,6" Margin="0,1" CornerRadius="6" FontSize="13"
                    Background="{Binding SelectedNavItem, Converter={x:Static vm:NavActiveBrushConverter.SubNavBg}, ConverterParameter=Artifacts}"
                    Foreground="{DynamicResource TextPrimary}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ctrl:SovrantIcon Name="artifacts" Width="14" Height="14" />
                    <TextBlock Text="Artifacts" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button Command="{Binding NavigateCommand}" CommandParameter="Guidelines"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                    Padding="10,6" Margin="0,1" CornerRadius="6" FontSize="13"
                    Background="{Binding SelectedNavItem, Converter={x:Static vm:NavActiveBrushConverter.SubNavBg}, ConverterParameter=Guidelines}"
                    Foreground="{DynamicResource TextPrimary}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ctrl:SovrantIcon Name="code" Width="14" Height="14" />
                    <TextBlock Text="Code Templates" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button Command="{Binding NavigateCommand}" CommandParameter="Documents"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                    Padding="10,6" Margin="0,1" CornerRadius="6" FontSize="13"
                    Background="{Binding SelectedNavItem, Converter={x:Static vm:NavActiveBrushConverter.SubNavBg}, ConverterParameter=Documents}"
                    Foreground="{DynamicResource TextPrimary}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ctrl:SovrantIcon Name="document" Width="14" Height="14" />
                    <TextBlock Text="Documents" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button Command="{Binding NavigateCommand}" CommandParameter="Memory"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                    Padding="10,6" Margin="0,1" CornerRadius="6" FontSize="13"
                    Background="{Binding SelectedNavItem, Converter={x:Static vm:NavActiveBrushConverter.SubNavBg}, ConverterParameter=Memory}"
                    Foreground="{DynamicResource TextPrimary}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ctrl:SovrantIcon Name="memory" Width="14" Height="14" />
                    <TextBlock Text="Memory" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button Command="{Binding NavigateCommand}" CommandParameter="Skills"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                    Padding="10,6" Margin="0,1" CornerRadius="6" FontSize="13"
                    Background="{Binding SelectedNavItem, Converter={x:Static vm:NavActiveBrushConverter.SubNavBg}, ConverterParameter=Skills}"
                    Foreground="{DynamicResource TextPrimary}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ctrl:SovrantIcon Name="file" Width="14" Height="14" />
                    <TextBlock Text="Skills" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button Command="{Binding NavigateCommand}" CommandParameter="Tools"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                    Padding="10,6" Margin="0,1" CornerRadius="6" FontSize="13"
                    Background="{Binding SelectedNavItem, Converter={x:Static vm:NavActiveBrushConverter.SubNavBg}, ConverterParameter=Tools}"
                    Foreground="{DynamicResource TextPrimary}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ctrl:SovrantIcon Name="tools" Width="14" Height="14" />
                    <TextBlock Text="Tools" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </StackPanel>
    </ScrollViewer>
</UserControl>
