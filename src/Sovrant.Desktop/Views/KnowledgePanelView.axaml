<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Sovrant.Desktop.ViewModels"
             x:Class="Sovrant.Desktop.Views.KnowledgePanelView"
             x:DataType="vm:SidebarViewModel"
             Background="{DynamicResource SidebarBackground}">
    <ScrollViewer>
        <StackPanel Margin="12,10,12,10">
            <TextBlock Text="KNOWLEDGE" FontSize="11.5" FontWeight="Bold"
                       Foreground="{DynamicResource TextMuted}"
                       Margin="9,4,0,8" />
            <Button Content="Artifacts"
                    Command="{Binding NavigateCommand}" CommandParameter="Artifacts"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" VerticalContentAlignment="Center"
                    Padding="12,0" Height="40" Margin="0,1" CornerRadius="8" FontSize="13.5"
                    Background="{Binding SelectedNavItem, Converter={x:Static vm:NavActiveBrushConverter.SubNavBgSoft}, ConverterParameter=Artifacts}"
                    Foreground="{Binding SelectedNavItem, Converter={x:Static vm:NavActiveBrushConverter.SubNavFgOrText}, ConverterParameter=Artifacts}" />
            <Button Content="Code Templates"
                    Command="{Binding NavigateCommand}" CommandParameter="Guidelines"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" VerticalContentAlignment="Center"
                    Padding="12,0" Height="40" Margin="0,1" CornerRadius="8" FontSize="13.5"
                    Background="{Binding SelectedNavItem, Converter={x:Static vm:NavActiveBrushConverter.SubNavBgSoft}, ConverterParameter=Guidelines}"
                    Foreground="{Binding SelectedNavItem, Converter={x:Static vm:NavActiveBrushConverter.SubNavFgOrText}, ConverterParameter=Guidelines}" />
            <Button Content="Documents"
                    Command="{Binding NavigateCommand}" CommandParameter="Documents"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" VerticalContentAlignment="Center"
                    Padding="12,0" Height="40" Margin="0,1" CornerRadius="8" FontSize="13.5"
                    Background="{Binding SelectedNavItem, Converter={x:Static vm:NavActiveBrushConverter.SubNavBgSoft}, ConverterParameter=Documents}"
                    Foreground="{Binding SelectedNavItem, Converter={x:Static vm:NavActiveBrushConverter.SubNavFgOrText}, ConverterParameter=Documents}" />
            <Button Content="Memory"
                    Command="{Binding NavigateCommand}" CommandParameter="Memory"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" VerticalContentAlignment="Center"
                    Padding="12,0" Height="40" Margin="0,1" CornerRadius="8" FontSize="13.5"
                    Background="{Binding SelectedNavItem, Converter={x:Static vm:NavActiveBrushConverter.SubNavBgSoft}, ConverterParameter=Memory}"
                    Foreground="{Binding SelectedNavItem, Converter={x:Static vm:NavActiveBrushConverter.SubNavFgOrText}, ConverterParameter=Memory}" />
            <Button Content="Skills"
                    Command="{Binding NavigateCommand}" CommandParameter="Skills"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" VerticalContentAlignment="Center"
                    Padding="12,0" Height="40" Margin="0,1" CornerRadius="8" FontSize="13.5"
                    Background="{Binding SelectedNavItem, Converter={x:Static vm:NavActiveBrushConverter.SubNavBgSoft}, ConverterParameter=Skills}"
                    Foreground="{Binding SelectedNavItem, Converter={x:Static vm:NavActiveBrushConverter.SubNavFgOrText}, ConverterParameter=Skills}" />
            <Button Content="Tools"
                    Command="{Binding NavigateCommand}" CommandParameter="Tools"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" VerticalContentAlignment="Center"
                    Padding="12,0" Height="40" Margin="0,1" CornerRadius="8" FontSize="13.5"
                    Background="{Binding SelectedNavItem, Converter={x:Static vm:NavActiveBrushConverter.SubNavBgSoft}, ConverterParameter=Tools}"
                    Foreground="{Binding SelectedNavItem, Converter={x:Static vm:NavActiveBrushConverter.SubNavFgOrText}, ConverterParameter=Tools}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
