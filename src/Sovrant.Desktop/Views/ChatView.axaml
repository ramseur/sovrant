<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:Sovrant.Api.Ui"
             xmlns:vm="using:Sovrant.Desktop.ViewModels"
             xmlns:conv="using:Sovrant.Desktop.Converters"
             xmlns:ctrl="using:Sovrant.Desktop.Controls"
             xmlns:knowledge="using:Sovrant.Runtime.Knowledge"
             xmlns:session="using:Sovrant.Runtime.Session"
             x:Class="Sovrant.Desktop.Views.ChatView"
             x:DataType="vm:ChatViewModel"
             Background="{DynamicResource SurfaceBackground}">

    <!-- Phase 137 — composer box, icon Send/Stop, user bubble (docs/design/desktop.html, Chat). -->
    <UserControl.Styles>
        <Style Selector="Border.composer">
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorder}" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.composer:focus-within">
            <Setter Property="BorderBrush" Value="{DynamicResource BrandPrimary}" />
        </Style>
        <Style Selector="TextBox.composer-input /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="TextBox.composer-input:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="TextBox.composer-input:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Button.composer-send">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Background" Value="{DynamicResource BrandPrimary}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.composer-send:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BrandPrimary}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Opacity" Value="0.9" />
        </Style>
        <Style Selector="Button.composer-send:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BrandPrimary}" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.composer-send:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BrandPrimary}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Opacity" Value="0.45" />
        </Style>
        <Style Selector="Button.metaact">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.metaact:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        </Style>
    </UserControl.Styles>

    <DockPanel>
        <!-- Phase 133 — top: where this conversation is filed, its links, and Move -->
        <Border DockPanel.Dock="Top" IsVisible="{Binding HasMessages}"
                MinHeight="44" Padding="16,6"
                BorderThickness="0,0,0,1" BorderBrush="{DynamicResource SurfaceBorder}">
            <DockPanel DataContext="{Binding $parent[Window].((vm:MainViewModel)DataContext).Sidebar}"
                       x:DataType="vm:SidebarViewModel">
                <Button DockPanel.Dock="Right" Background="Transparent" CornerRadius="8" Padding="10,5"
                        Command="{Binding MoveCurrentSessionCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <ctrl:SovrantIcon IconName="{x:Static ui:IconNames.Folder}" Size="14"
                              Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                        <TextBlock Text="Move" FontSize="12.5" Foreground="{DynamicResource TextSecondary}" />
                    </StackPanel>
                </Button>
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <ctrl:SovrantIcon IconName="{x:Static ui:IconNames.Folder}" Size="13"
                          Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding CurrentPath}" FontSize="12.5" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                    <ctrl:SovrantIcon IconName="{x:Static ui:IconNames.Expand}" Size="11"
                          Foreground="{DynamicResource TextMuted}" StrokeWidth="2.4" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding CurrentTitle}" FontSize="12.5" FontWeight="SemiBold" MaxWidth="360"
                               Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <ItemsControl ItemsSource="{Binding CurrentLabels}" VerticalAlignment="Center" Margin="6,0,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="6" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="session:SessionLabel">
                                <Border CornerRadius="999" Padding="8,2" Background="{DynamicResource BrandPrimarySoft}">
                                    <TextBlock Text="{Binding Text}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource BrandPrimary}" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Bottom: Input bar -->
        <Border DockPanel.Dock="Bottom"
                Padding="22,12,22,14"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource SurfaceBorder}">
            <!-- Phase 137 — one composer box, centred at 760px; the brand Send button becomes
                 Stop in place while a reply streams (Esc also stops: ChatView.axaml.cs). -->
            <!-- BorderBrush comes from the Border.composer style (not set here) so :focus-within can override it. -->
            <Border Classes="composer" MaxWidth="760" HorizontalAlignment="Stretch"
                    CornerRadius="12" BorderThickness="1" Padding="12,8,8,8"
                    Background="{DynamicResource InputBackground}">
                <DockPanel>
                    <Panel DockPanel.Dock="Bottom" HorizontalAlignment="Right">
                        <Button Classes="composer-send"
                                Command="{Binding SendCommand}"
                                IsVisible="{Binding !IsSending}"
                                ToolTip.Tip="Send message (Enter)"
                                AutomationProperties.Name="Send message">
                            <ctrl:SovrantIcon IconName="{x:Static ui:IconNames.Send}" Size="16" StrokeWidth="2" />
                        </Button>
                        <Button Classes="composer-send"
                                Command="{Binding StopCommand}"
                                IsVisible="{Binding IsSending}"
                                ToolTip.Tip="Stop generating (Esc)"
                                AutomationProperties.Name="Stop generating">
                            <ctrl:SovrantIcon IconName="{x:Static ui:IconNames.Stop}" Size="14" StrokeWidth="2.6" />
                        </Button>
                    </Panel>
                    <Grid>
                            <TextBox x:Name="InputBox"
                                     Text="{Binding InputText}"
                                     Watermark="{Binding InputWatermark}"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     Classes="composer-input"
                                     MinHeight="44"
                                     MaxHeight="300"
                                     Padding="2,2"
                                     Background="Transparent"
                                     BorderThickness="0" />
                            <!-- Command suggestions popup above input (rendered after TextBox for z-order) -->
                            <Border VerticalAlignment="Bottom"
                                    Margin="0,0,0,44"
                                    CornerRadius="8"
                                    Background="{DynamicResource SurfaceCard}"
                                    BorderBrush="{DynamicResource SurfaceBorder}"
                                    BorderThickness="1"
                                    Padding="4"
                                    IsVisible="{Binding ShowCommandSuggestions}"
                                    MaxHeight="260"
                                    ZIndex="10">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding CommandSuggestions}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="vm:CommandSuggestion">
                                                <Button Command="{Binding $parent[ItemsControl].((vm:ChatViewModel)DataContext).AcceptSuggestionCommand}"
                                                        CommandParameter="{Binding}"
                                                        HorizontalAlignment="Stretch"
                                                        HorizontalContentAlignment="Stretch"
                                                        Padding="10,6"
                                                        Margin="0,1"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        CornerRadius="4"
                                                        Cursor="Hand">
                                                    <DockPanel>
                                                        <TextBlock DockPanel.Dock="Left"
                                                                   Text="{Binding Display}"
                                                                   FontSize="13"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource BrandPrimary}"
                                                                   MinWidth="120" />
                                                        <TextBlock Text="{Binding Description}"
                                                                   FontSize="12"
                                                                   Foreground="{DynamicResource TextSecondary}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </DockPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                </DockPanel>
            </Border>
        </Border>

        <!-- Remember panel — slides in above bottom bar when IsRememberOpen -->
        <Border DockPanel.Dock="Bottom"
                Padding="48,8"
                Background="{DynamicResource SurfaceCard}"
                BorderBrush="{DynamicResource SurfaceBorder}"
                BorderThickness="0,1,0,0"
                IsVisible="{Binding IsRememberOpen}">
            <StackPanel Spacing="6">
                <TextBox Text="{Binding RememberText}"
                         Watermark="What should I remember? (e.g. Always check tests before committing)"
                         AcceptsReturn="True" MinHeight="48" TextWrapping="Wrap"
                         FontSize="12" />
                <DockPanel>
                    <CheckBox DockPanel.Dock="Left"
                              IsChecked="{Binding RememberIsPrivate}"
                                                            FontSize="11"
                              Foreground="{DynamicResource TextMuted}"
                              VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <ctrl:SovrantIcon IconName="{x:Static ui:IconNames.Private}" Size="12" VerticalAlignment="Center" />
                            <TextBlock Text="Private" VerticalAlignment="Center" />
                        </StackPanel>
                    </CheckBox>
                    <TextBlock DockPanel.Dock="Left"
                               Margin="10,0,0,0"
                               Text="{Binding RememberStatus}"
                               FontSize="11"
                               Foreground="{DynamicResource StatusSuccess}"
                               VerticalAlignment="Center"
                               IsVisible="{Binding RememberStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6">
                        <Button Content="Cancel"
                                Command="{Binding ToggleRememberCommand}"
                                Padding="12,4" CornerRadius="6" FontSize="11"
                                Background="Transparent"
                                Foreground="{DynamicResource TextMuted}" />
                        <Button Content="Save"
                                Command="{Binding SaveRememberCommand}"
                                IsEnabled="{Binding RememberText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                Padding="12,4" CornerRadius="6" FontSize="11"
                                Background="{DynamicResource BrandPrimary}" Foreground="White" />
                    </StackPanel>
                </DockPanel>
            </StackPanel>
        </Border>

        <!-- Session stats (tokens + cost) + privacy toggle — visible once messages exist -->
        <Border DockPanel.Dock="Bottom"
                Padding="48,4">
            <DockPanel>
                <!-- Phase 99 — privacy toggle (lock icon), always visible so a fresh
                     session can be made public before any message is sent. -->
                <Button DockPanel.Dock="Left"
                        Command="{Binding TogglePrivacyCommand}"
                        Padding="8,3"
                        CornerRadius="10"
                        Background="Transparent"
                        BorderBrush="{DynamicResource SurfaceBorder}"
                        BorderThickness="1"
                        FontSize="11"
                        VerticalAlignment="Center"
                        ToolTip.Tip="Toggle private — masked for anyone but you in Command Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <ctrl:SovrantIcon IconName="{Binding IsSessionPrivate, Converter={x:Static vm:BoolToLockIconConverter.Instance}}"
                              Size="12"
                              Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding IsSessionPrivate, Converter={x:Static vm:BoolToPrivacyLabelConverter.Instance}}"
                                   Foreground="{DynamicResource TextMuted}" />
                    </StackPanel>
                </Button>
                <!-- Remember button -->
                <Button DockPanel.Dock="Left"
                        Margin="8,0,0,0"
                        Command="{Binding ToggleRememberCommand}"
                        Padding="8,3"
                        CornerRadius="10"
                        Background="Transparent"
                        BorderBrush="{DynamicResource SurfaceBorder}"
                        BorderThickness="1"
                        FontSize="11"
                        VerticalAlignment="Center"
                        ToolTip.Tip="Save a note to memory — injected into every future chat session">
                    <TextBlock Text="+ Remember" Foreground="{DynamicResource TextMuted}" />
                </Button>
                <StackPanel Orientation="Horizontal" Spacing="16" HorizontalAlignment="Right"
                            IsVisible="{Binding HasMessages}">
                    <TextBlock FontSize="11" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="{}{0:N0} tokens">
                                <Binding Path="TokenCount" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                    <TextBlock FontSize="11" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="~${0:F4}">
                                <Binding Path="SessionCost" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Content area: Grid allows hero to truly center while ScrollViewer fills -->
        <Grid>
            <!-- Empty hero state — centered in the full remaining space -->
            <StackPanel IsVisible="{Binding !HasMessages}"
                        IsHitTestVisible="{Binding !HasMessages}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="16"
                        Margin="24"
                        MaxWidth="920">
                <!-- Logo icon — same chat-bubble mark as the assistant avatar below, on the soft
                     brand tile from the Phase 140 mock (a tint, not the solid titlebar square). -->
                <Border Width="72" Height="72" CornerRadius="20" HorizontalAlignment="Center"
                        Background="{DynamicResource BrandPrimarySoft}">
                    <ctrl:SovrantIcon IconName="{x:Static ui:IconNames.Chat}" Size="38"
                          Foreground="{DynamicResource BrandPrimary}"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <!-- Agent scope badge — visible when session is bound to an agent -->
                <Border CornerRadius="12" Padding="10,4"
                        Background="{DynamicResource SurfaceCard}"
                        BorderBrush="{DynamicResource SurfaceBorder}"
                        BorderThickness="1"
                        HorizontalAlignment="Center"
                        IsVisible="{Binding AgentName,
                                            Converter={x:Static conv:StringNotNullOrEmptyConverter.Instance}}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <ctrl:SovrantIcon IconName="{x:Static ui:IconNames.Agents}" Size="13"
                              Foreground="{DynamicResource TextSecondary}"
                              VerticalAlignment="Center" />
                        <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondary}"
                                   VerticalAlignment="Center">
                            <Run Text="Chatting with " />
                            <Run Text="{Binding AgentName}" FontWeight="SemiBold"
                                 Foreground="{DynamicResource TextPrimary}" />
                        </TextBlock>
                    </StackPanel>
                </Border>

                <TextBlock Text="What are you working on?"
                           FontSize="28" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimary}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="Chat with any model, or put agents, teams and workflows to work. Pick a starting point, or just type below."
                           FontSize="15" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="560"
                           Foreground="{DynamicResource TextSecondary}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,8" />

                <!-- Suggestion cards — 3 columns (Phase 140) -->
                <UniformGrid Columns="3" HorizontalAlignment="Stretch">
                    <Button Margin="4" Padding="14,10" CornerRadius="10"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Background="{DynamicResource SurfaceCard}"
                            BorderBrush="{DynamicResource SurfaceBorder}" BorderThickness="1"
                            Command="{Binding SuggestionCommand}" CommandParameter="Create a custom agent with tools for web research and summarization">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ctrl:SovrantIcon IconName="{x:Static ui:IconNames.Agents}" Size="15"
                                  Foreground="{DynamicResource BrandPrimary}" VerticalAlignment="Center" />
                            <TextBlock Text="Create a custom agent" FontSize="13"
                                       Foreground="{DynamicResource TextPrimary}" />
                        </StackPanel>
                    </Button>
                    <Button Margin="4" Padding="14,10" CornerRadius="10"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Background="{DynamicResource SurfaceCard}"
                            BorderBrush="{DynamicResource SurfaceBorder}" BorderThickness="1"
                            Command="{Binding SuggestionCommand}" CommandParameter="Create a team that researches a topic and produces a structured report">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ctrl:SovrantIcon IconName="{x:Static ui:IconNames.Team}" Size="15"
                                  Foreground="{DynamicResource BrandPrimary}" VerticalAlignment="Center" />
                            <TextBlock Text="Build a team of agents" FontSize="13"
                                       Foreground="{DynamicResource TextPrimary}" />
                        </StackPanel>
                    </Button>
                    <Button Margin="4" Padding="14,10" CornerRadius="10"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Background="{DynamicResource SurfaceCard}"
                            BorderBrush="{DynamicResource SurfaceBorder}" BorderThickness="1"
                            Command="{Binding SuggestionCommand}" CommandParameter="Build a best-practice swarm that parallelizes tasks across agents">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ctrl:SovrantIcon IconName="{x:Static ui:IconNames.Swarm}" Size="15"
                                  Foreground="{DynamicResource BrandPrimary}" VerticalAlignment="Center" />
                            <TextBlock Text="Design an agent swarm" FontSize="13"
                                       Foreground="{DynamicResource TextPrimary}" />
                        </StackPanel>
                    </Button>
                    <Button Margin="4" Padding="14,10" CornerRadius="10"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Background="{DynamicResource SurfaceCard}"
                            BorderBrush="{DynamicResource SurfaceBorder}" BorderThickness="1"
                            Command="{Binding SuggestionCommand}" CommandParameter="Set up a workflow that monitors a project and sends daily updates">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ctrl:SovrantIcon IconName="{x:Static ui:IconNames.Workflow}" Size="15"
                                  Foreground="{DynamicResource BrandPrimary}" VerticalAlignment="Center" />
                            <TextBlock Text="Set up a workflow" FontSize="13"
                                       Foreground="{DynamicResource TextPrimary}" />
                        </StackPanel>
                    </Button>
                    <Button Margin="4" Padding="14,10" CornerRadius="10"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Background="{DynamicResource SurfaceCard}"
                            BorderBrush="{DynamicResource SurfaceBorder}" BorderThickness="1"
                            Command="{Binding SuggestionCommand}" CommandParameter="Orchestrate a multi-agent pipeline for code review and testing">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ctrl:SovrantIcon IconName="{x:Static ui:IconNames.Orchestration}" Size="15"
                                  Foreground="{DynamicResource BrandPrimary}" VerticalAlignment="Center" />
                            <TextBlock Text="Orchestrate a pipeline" FontSize="13"
                                       Foreground="{DynamicResource TextPrimary}" />
                        </StackPanel>
                    </Button>
                    <Button Margin="4" Padding="14,10" CornerRadius="10"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Background="{DynamicResource SurfaceCard}"
                            BorderBrush="{DynamicResource SurfaceBorder}" BorderThickness="1"
                            Command="{Binding SuggestionCommand}" CommandParameter="Connect an MCP server and create an agent that uses its tools">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ctrl:SovrantIcon IconName="{x:Static ui:IconNames.Integrations}" Size="15"
                                  Foreground="{DynamicResource BrandPrimary}" VerticalAlignment="Center" />
                            <TextBlock Text="Connect an MCP server" FontSize="13"
                                       Foreground="{DynamicResource TextPrimary}" />
                        </StackPanel>
                    </Button>
                </UniformGrid>

                <!-- Phase 140 — "What Sovrant can do": same areas as Home's guide (Phase 141), role-aware -->
                <StackPanel Spacing="10" Margin="0,8,0,0">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="See everything on Home →" Padding="0" Background="Transparent"
                                BorderThickness="0" FontSize="12" FontWeight="SemiBold" Cursor="Hand"
                                Foreground="{DynamicResource BrandPrimary}"
                                Command="{Binding OpenAreaCommand}" CommandParameter="Dashboard" />
                        <TextBlock Text="WHAT SOVRANT CAN DO" FontSize="11" FontWeight="Bold" LetterSpacing="0.6"
                                   Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" />
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Capabilities}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Columns="6" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:CapabilityCard">
                                <Button Margin="4" Padding="11,10" CornerRadius="10" Cursor="Hand"
                                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                        HorizontalContentAlignment="Left" VerticalContentAlignment="Top"
                                        Background="Transparent" BorderThickness="1"
                                        BorderBrush="{DynamicResource SurfaceBorder}"
                                        Command="{Binding $parent[ItemsControl].((vm:ChatViewModel)DataContext).OpenAreaCommand}"
                                        CommandParameter="{Binding Page}">
                                    <StackPanel Spacing="4">
                                        <ctrl:SovrantIcon IconName="{Binding IconName}" Size="16"
                                                          Foreground="{DynamicResource BrandPrimary}" HorizontalAlignment="Left" />
                                        <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Description}" FontSize="11.5" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextMuted}" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>

            <!-- Messages area -->
            <ScrollViewer x:Name="MessageScroller"
                          IsVisible="{Binding HasMessages}"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Messages}"
                              Margin="22,16"
                              MaxWidth="760"
                              HorizontalAlignment="Stretch">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:MessageViewModel">
                            <Border Margin="0,8" Padding="0">
                                <Border.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Copy message"
                                                  Click="OnCopyMessageClick" />
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <StackPanel>
                                    <!-- === User message layout === -->
                                    <!-- Phase 137 — right-aligned brand bubble + initials avatar -->
                                    <Grid IsVisible="{Binding IsUser}" ColumnDefinitions="*,Auto">
                                        <Border Grid.Column="0" HorizontalAlignment="Right" MaxWidth="620"
                                                CornerRadius="12,12,4,12" Padding="14,10"
                                                Background="{DynamicResource BrandPrimary}">
                                            <SelectableTextBlock Text="{Binding Text}"
                                                                 TextWrapping="Wrap"
                                                                 FontSize="14"
                                                                 LineHeight="21"
                                                                 Foreground="White" />
                                        </Border>
                                        <Border Grid.Column="1" Width="28" Height="28" CornerRadius="8" Margin="11,0,0,0"
                                                VerticalAlignment="Top" ToolTip.Tip="{Binding SenderLabel}">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                                    <GradientStop Offset="0" Color="#6D52C6" />
                                                    <GradientStop Offset="1" Color="#4A3789" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <TextBlock Text="{Binding UserInitial}" FontSize="11" FontWeight="Bold"
                                                       Foreground="White"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </Grid>

                                    <!-- === Sovrant (assistant) message layout === -->
                                    <Border IsVisible="{Binding !IsUser}" Padding="0,2">
                                        <Grid ColumnDefinitions="Auto,*">
                                            <Border Grid.Column="0" Width="28" Height="28" CornerRadius="8" Margin="0,0,11,0"
                                                    VerticalAlignment="Top" Background="{DynamicResource SurfaceBorder}">
                                                <ctrl:SovrantIcon IconName="{x:Static ui:IconNames.Chat}" Size="14"
                                                      Foreground="{DynamicResource TextSecondary}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Spacing="6">
                                            <!-- Intent narration — what the system thinks the user wants -->
                                            <TextBlock Text="{Binding IntentNarration}"
                                                       FontSize="12" FontStyle="Italic"
                                                       Foreground="{DynamicResource TextSecondary}"
                                                       Margin="0,0,0,0"
                                                       IsVisible="{Binding IntentNarration, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                                            <!-- Thinking indicator -->
                                            <StackPanel Orientation="Horizontal" Spacing="8"
                                                        Margin="0,4,0,0"
                                                        IsVisible="{Binding IsThinking}">
                                                <Border Width="8" Height="8" CornerRadius="4"
                                                        Background="{DynamicResource BrandPrimary}">
                                                    <Border.Styles>
                                                        <Style Selector="Border">
                                                            <Style.Animations>
                                                                <Animation Duration="0:0:1" IterationCount="INFINITE">
                                                                    <KeyFrame Cue="0%">
                                                                        <Setter Property="Opacity" Value="1.0" />
                                                                    </KeyFrame>
                                                                    <KeyFrame Cue="50%">
                                                                        <Setter Property="Opacity" Value="0.3" />
                                                                    </KeyFrame>
                                                                    <KeyFrame Cue="100%">
                                                                        <Setter Property="Opacity" Value="1.0" />
                                                                    </KeyFrame>
                                                                </Animation>
                                                            </Style.Animations>
                                                        </Style>
                                                    </Border.Styles>
                                                </Border>
                                                <TextBlock Text="{Binding ThinkingText}"
                                                           FontSize="13" FontStyle="Italic"
                                                           Foreground="{DynamicResource TextSecondary}" />
                                                <TextBlock Text="{Binding ElapsedText}"
                                                           FontSize="11" Margin="8,0,0,0"
                                                           Foreground="{DynamicResource TextMuted}"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>

                                            <!-- Step progress bar — visible during plan execution -->
                                            <Border Margin="0,4,0,0"
                                                    Padding="10,6"
                                                    CornerRadius="6"
                                                    Background="{DynamicResource SurfaceCard}"
                                                    BorderBrush="{DynamicResource SurfaceBorder}"
                                                    BorderThickness="1"
                                                    IsVisible="{Binding StepProgressText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                                <TextBlock Text="{Binding StepProgressText}"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource TextSecondary}" />
                                            </Border>

                                            <!-- Raw text while streaming (fast, no re-parsing) -->
                                            <SelectableTextBlock Text="{Binding Text}"
                                                                 TextWrapping="Wrap"
                                                                 FontSize="14"
                                                                 Foreground="{DynamicResource TextPrimary}"
                                                                 Margin="0,0,0,0"
                                                                 IsVisible="{Binding IsStreaming}" />

                                            <!-- Markdown rendered after response completes -->
                                            <ctrl:SafeMarkdownPresenter Markdown="{Binding SafeMarkdown}"
                                                                        Margin="0,0,0,0"
                                                                        IsVisible="{Binding IsComplete}" />

                                            <!-- Phase 126 #4 — answer-first: thin divider between the completed
                                                 answer and the (now-subordinate) work strip / pending tools below. -->
                                            <Border Height="1"
                                                    Margin="0,10,0,10"
                                                    Background="{DynamicResource SurfaceBorder}"
                                                    Opacity="0.6"
                                                    IsVisible="{Binding ShowWorkSeparator}" />

                                            <!-- Auto-saved artifacts (from large text blocks) -->
                                            <ItemsControl ItemsSource="{Binding StandaloneArtifacts}"
                                                          IsVisible="{Binding HasStandaloneArtifacts}"
                                                          Margin="0,4,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="vm:DocumentArtifactViewModel">
                                                        <Border Margin="0,3"
                                                                Padding="10,8"
                                                                CornerRadius="6"
                                                                Background="{DynamicResource SurfaceCard}"
                                                                BorderBrush="{DynamicResource SurfaceBorder}"
                                                                BorderThickness="1">
                                                            <DockPanel>
                                                                <ctrl:SovrantIcon IconName="{Binding Icon}" Size="18" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{DynamicResource TextSecondary}" />
                                                                <StackPanel DockPanel.Dock="Right"
                                                                            Orientation="Horizontal"
                                                                            Spacing="6"
                                                                            VerticalAlignment="Center">
                                                                    <Button Content="Open"
                                                                            Command="{Binding OpenCommand}"
                                                                            Padding="8,3"
                                                                            CornerRadius="4"
                                                                            FontSize="11"
                                                                            Background="{DynamicResource BrandPrimary}"
                                                                            Foreground="White" />
                                                                    <Button Content="Reveal"
                                                                            Command="{Binding RevealInFolderCommand}"
                                                                            Padding="8,3"
                                                                            CornerRadius="4"
                                                                            FontSize="11"
                                                                            Background="Transparent"
                                                                            BorderBrush="{DynamicResource SurfaceBorder}"
                                                                            BorderThickness="1"
                                                                            Foreground="{DynamicResource TextSecondary}"
                                                                            IsVisible="{Binding LocalPath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                                                </StackPanel>
                                                                <StackPanel Spacing="2">
                                                                    <TextBlock Text="{Binding DisplayName}"
                                                                               FontSize="12"
                                                                               FontWeight="SemiBold"
                                                                               Foreground="{DynamicResource TextPrimary}"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                                        <TextBlock Text="{Binding Format}"
                                                                                   FontSize="10"
                                                                                   Foreground="{DynamicResource TextMuted}" />
                                                                        <TextBlock Text="·"
                                                                                   FontSize="10"
                                                                                   Foreground="{DynamicResource TextMuted}"
                                                                                   IsVisible="{Binding SizeText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                                                        <TextBlock Text="{Binding SizeText}"
                                                                                   FontSize="10"
                                                                                   Foreground="{DynamicResource TextMuted}" />
                                                                        <TextBlock Text="· auto-saved"
                                                                                   FontSize="10"
                                                                                   Foreground="{DynamicResource TextMuted}" />
                                                                    </StackPanel>
                                                                </StackPanel>
                                                            </DockPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- Phase 116 H — Sources / provenance -->
                                            <StackPanel Margin="0,6,0,2"
                                                        IsVisible="{Binding HasSources}"
                                                        Spacing="4">
                                                <TextBlock Text="SOURCES"
                                                           FontSize="10"
                                                           Foreground="{DynamicResource TextMuted}"
                                                           FontWeight="SemiBold" />
                                                <ItemsControl ItemsSource="{Binding Sources}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel Orientation="Horizontal" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type knowledge:KnowledgeAttribution}">
                                                            <Border Margin="0,0,5,4"
                                                                    Padding="5,2"
                                                                    CornerRadius="8"
                                                                    Background="{DynamicResource SurfaceCard}"
                                                                    BorderBrush="{DynamicResource SurfaceBorder}"
                                                                    BorderThickness="1">
                                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                                    <TextBlock Text="{Binding Kind}"
                                                                               FontSize="9"
                                                                               Foreground="{DynamicResource TextMuted}"
                                                                               FontFamily="{DynamicResource MonoFont}"
                                                                               VerticalAlignment="Center" />
                                                                    <TextBlock Text="{Binding Slug}"
                                                                               FontSize="10"
                                                                               Foreground="{DynamicResource TextSecondary}"
                                                                               FontFamily="{DynamicResource MonoFont}"
                                                                               VerticalAlignment="Center" />
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>

                                            <!-- Error banner with retry -->
                                            <Border Margin="0,6,0,0"
                                                    Padding="12,10"
                                                    CornerRadius="8"
                                                    Background="#2D1A1A"
                                                    BorderBrush="{DynamicResource StatusFail}"
                                                    BorderThickness="1"
                                                    IsVisible="{Binding HasError}">
                                                <DockPanel>
                                                    <Button DockPanel.Dock="Right"
                                                            Content="Retry"
                                                            Command="{Binding $parent[ItemsControl].((vm:ChatViewModel)DataContext).RetryLastCommand}"
                                                            Padding="14,6"
                                                            CornerRadius="6"
                                                            Background="{DynamicResource BrandPrimary}"
                                                            Foreground="White"
                                                            FontWeight="SemiBold"
                                                            FontSize="12"
                                                            VerticalAlignment="Center"
                                                            Margin="12,0,0,0" />
                                                    <StackPanel Spacing="2">
                                                        <TextBlock Text="Request failed"
                                                                   FontWeight="SemiBold"
                                                                   FontSize="13"
                                                                   Foreground="{DynamicResource StatusFail}" />
                                                        <TextBlock Text="{Binding ErrorMessage}"
                                                                   FontSize="12"
                                                                   Foreground="{DynamicResource TextSecondary}"
                                                                   TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>

                                            <!-- Pending tool confirmations — always visible, never collapsed into the strip -->
                                            <ItemsControl ItemsSource="{Binding ToolUses}"
                                                          Margin="0,2,0,0"
                                                          IsVisible="{Binding ToolUses.Count}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="vm:ToolUseViewModel">
                                                        <Border Margin="0,4"
                                                                Padding="10,8"
                                                                CornerRadius="8"
                                                                Background="{DynamicResource ToolUseBackground}"
                                                                BorderBrush="{DynamicResource SurfaceBorder}"
                                                                BorderThickness="1"
                                                                IsVisible="{Binding IsPendingConfirmation}">
                                                            <StackPanel Spacing="4">
                                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                                    <ctrl:SovrantIcon IconName="{x:Static ui:IconNames.Tool}" Size="13" VerticalAlignment="Center" />
                                                                    <TextBlock Text="{Binding ToolName}"
                                                                               FontWeight="SemiBold"
                                                                               FontSize="12"
                                                                               Foreground="{DynamicResource TextPrimary}" />
                                                                    <Border Padding="6,1" CornerRadius="10"
                                                                            Background="{DynamicResource SurfaceCard}"
                                                                            BorderThickness="0">
                                                                        <TextBlock Text="{Binding Status}"
                                                                                   FontSize="10" FontWeight="SemiBold"
                                                                                   Foreground="{DynamicResource StatusWarn}" />
                                                                    </Border>
                                                                </StackPanel>
                                                                <SelectableTextBlock Text="{Binding Result}"
                                                                                     TextWrapping="Wrap"
                                                                                     FontSize="11"
                                                                                     FontFamily="Consolas,Menlo,monospace"
                                                                                     Foreground="{DynamicResource TextSecondary}"
                                                                                     IsVisible="{Binding HasResult}"
                                                                                     MaxLines="6" />
                                                                <StackPanel Orientation="Horizontal" Spacing="8"
                                                                            Margin="0,6,0,0">
                                                                    <Button
                                                                            Command="{Binding ApproveCommand}"
                                                                            Padding="10,4"
                                                                            CornerRadius="6"
                                                                            Background="{DynamicResource StatusPass}"
                                                                            Foreground="White"
                                                                            FontSize="11"
                                                                            FontWeight="SemiBold">
                                                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                                                            <ctrl:SovrantIcon IconName="{x:Static ui:IconNames.Allow}" Size="12" VerticalAlignment="Center" />
                                                                            <TextBlock Text="Allow once" VerticalAlignment="Center" />
                                                                        </StackPanel>
                                                                    </Button>
                                                                    <Button
                                                                            Command="{Binding ApproveForTurnCommand}"
                                                                            ToolTip.Tip="Auto-approve this tool for the rest of this turn"
                                                                            Padding="10,4"
                                                                            CornerRadius="6"
                                                                            Background="Transparent"
                                                                            BorderBrush="{DynamicResource StatusPass}"
                                                                            BorderThickness="1"
                                                                            Foreground="{DynamicResource StatusPass}"
                                                                            FontSize="11"
                                                                            FontWeight="SemiBold">
                                                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                                                            <ctrl:SovrantIcon IconName="{x:Static ui:IconNames.AllowAll}" Size="12" VerticalAlignment="Center" />
                                                                            <TextBlock Text="Allow for turn" VerticalAlignment="Center" />
                                                                        </StackPanel>
                                                                    </Button>
                                                                    <Button
                                                                            Command="{Binding DenyCommand}"
                                                                            Padding="10,4"
                                                                            CornerRadius="6"
                                                                            Background="{DynamicResource StatusFail}"
                                                                            Foreground="White"
                                                                            FontSize="11"
                                                                            FontWeight="SemiBold">
                                                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                                                            <ctrl:SovrantIcon IconName="{x:Static ui:IconNames.Deny}" Size="12" VerticalAlignment="Center" />
                                                                            <TextBlock Text="Deny" VerticalAlignment="Center" />
                                                                        </StackPanel>
                                                                    </Button>
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- Work strip (Phase 126) — collapsed summary of completed/running tool calls -->
                                            <StackPanel Margin="0,2,0,0" IsVisible="{Binding HasWorkStrip}">
                                                <!-- Mid-turn animated indicator -->
                                                <Border Padding="10,6"
                                                        CornerRadius="6"
                                                        Background="{DynamicResource ToolUseBackground}"
                                                        BorderBrush="{DynamicResource BrandPrimary}"
                                                        BorderThickness="1"
                                                        IsVisible="{Binding IsExecutingTools}">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <Border Width="8" Height="8" CornerRadius="4"
                                                                Background="{DynamicResource BrandPrimary}">
                                                            <Border.Styles>
                                                                <Style Selector="Border">
                                                                    <Style.Animations>
                                                                        <Animation Duration="0:0:0.8" IterationCount="INFINITE">
                                                                            <KeyFrame Cue="0%">
                                                                                <Setter Property="Opacity" Value="1.0" />
                                                                            </KeyFrame>
                                                                            <KeyFrame Cue="50%">
                                                                                <Setter Property="Opacity" Value="0.2" />
                                                                            </KeyFrame>
                                                                            <KeyFrame Cue="100%">
                                                                                <Setter Property="Opacity" Value="1.0" />
                                                                            </KeyFrame>
                                                                        </Animation>
                                                                    </Style.Animations>
                                                                </Style>
                                                            </Border.Styles>
                                                        </Border>
                                                        <TextBlock Text="{Binding ExecutionStatusText}"
                                                                   FontSize="12" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextPrimary}" />
                                                    </StackPanel>
                                                </Border>

                                                <!-- Collapsed / collapsible header — shown once the turn's tool calls settle -->
                                                <Button Command="{Binding ToggleWorkStripCommand}"
                                                        Padding="10,6"
                                                        CornerRadius="6"
                                                        Background="{DynamicResource ToolUseBackground}"
                                                        BorderBrush="{Binding HasWorkStripErrors, Converter={x:Static vm:BoolToBrushConverter.ErrorOrToolBorder}}"
                                                        BorderThickness="1"
                                                        HorizontalAlignment="Stretch"
                                                        HorizontalContentAlignment="Left"
                                                        IsVisible="{Binding !IsExecutingTools}">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <ctrl:SovrantIcon IconName="{x:Static ui:IconNames.Expand}" Size="12" StrokeWidth="2.4"
                                                                   Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center">
                                                            <ctrl:SovrantIcon.RenderTransform>
                                                                <RotateTransform Angle="{Binding WorkStripCaretAngle}" />
                                                            </ctrl:SovrantIcon.RenderTransform>
                                                        </ctrl:SovrantIcon>
                                                        <TextBlock Text="{Binding WorkStripActionLabel}" FontSize="12" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                                                        <TextBlock Text="·" FontSize="12" Foreground="{DynamicResource TextMuted}"
                                                                   IsVisible="{Binding ActionSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                                        <TextBlock Text="{Binding ActionSummary}" FontSize="12"
                                                                   Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"
                                                                   IsVisible="{Binding ActionSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                                        <TextBlock Text="·" FontSize="12" Foreground="{DynamicResource TextMuted}"
                                                                   IsVisible="{Binding HasWorkStripErrors}" />
                                                        <TextBlock Text="{Binding WorkStripErrorLabel}" FontSize="12"
                                                                   Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"
                                                                   IsVisible="{Binding HasWorkStripErrors}" />
                                                        <TextBlock Text="·" FontSize="12" Foreground="{DynamicResource TextMuted}"
                                                                   IsVisible="{Binding ElapsedText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                                        <TextBlock Text="{Binding ElapsedText}" FontSize="12"
                                                                   Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" />
                                                        <ctrl:SovrantIcon IconName="{x:Static ui:IconNames.Warning}" Size="13" Foreground="{DynamicResource StatusFail}" VerticalAlignment="Center" IsVisible="{Binding HasWorkStripErrors}" />
                                                    </StackPanel>
                                                </Button>

                                                <!-- Tool-list level — one row per tool call -->
                                                <ItemsControl ItemsSource="{Binding ToolUses}"
                                                              IsVisible="{Binding IsWorkStripExpanded}"
                                                              Margin="0,4,0,0">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="vm:ToolUseViewModel">
                                                            <StackPanel IsVisible="{Binding !IsPendingConfirmation}">
                                                                <Button Command="{Binding $parent[ItemsControl].((vm:MessageViewModel)DataContext).ToggleToolDetailCommand}"
                                                                        CommandParameter="{Binding}"
                                                                        Padding="10,6"
                                                                        Margin="0,1"
                                                                        Background="{DynamicResource ToolUseBackground}"
                                                                        BorderThickness="0"
                                                                        HorizontalAlignment="Stretch"
                                                                        HorizontalContentAlignment="Left">
                                                                    <DockPanel LastChildFill="True">
                                                                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                                            <Border Width="7" Height="7" CornerRadius="4"
                                                                                    Background="{DynamicResource StatusPass}"
                                                                                    IsVisible="{Binding IsStatusDone}" />
                                                                            <Border Width="7" Height="7" CornerRadius="4"
                                                                                    Background="{DynamicResource StatusFail}"
                                                                                    IsVisible="{Binding IsStatusError}" />
                                                                            <Border Width="7" Height="7" CornerRadius="4"
                                                                                    Background="{DynamicResource StatusWarn}"
                                                                                    IsVisible="{Binding IsStatusRunning}" />
                                                                            <ctrl:SovrantIcon IconName="{x:Static ui:IconNames.Tool}" Size="12" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" />
                                                                            <TextBlock Text="{Binding ToolName}"
                                                                                       FontWeight="SemiBold" FontSize="12"
                                                                                       Foreground="{DynamicResource TextPrimary}" />
                                                                        </StackPanel>
                                                                        <TextBlock Text="{Binding Result}"
                                                                                   FontSize="11"
                                                                                   FontFamily="Consolas,Menlo,monospace"
                                                                                   Foreground="{DynamicResource TextMuted}"
                                                                                   TextTrimming="CharacterEllipsis"
                                                                                   MaxLines="1"
                                                                                   Margin="10,0,0,0" />
                                                                    </DockPanel>
                                                                </Button>

                                                                <!-- Full detail — only one row expanded at a time -->
                                                                <Border IsVisible="{Binding IsActiveDetail}"
                                                                        Padding="10,8,10,10"
                                                                        Background="{DynamicResource ToolUseBackground}">
                                                                    <StackPanel Spacing="4">
                                                                        <SelectableTextBlock Text="{Binding Result}"
                                                                                             TextWrapping="Wrap"
                                                                                             FontSize="11"
                                                                                             FontFamily="Consolas,Menlo,monospace"
                                                                                             Foreground="{DynamicResource TextSecondary}"
                                                                                             IsVisible="{Binding HasResult}" />

                                                                        <!-- Phase 66: Document artifact cards (one per generated doc) -->
                                                                        <ItemsControl ItemsSource="{Binding DocumentArtifacts}"
                                                                                      IsVisible="{Binding HasDocumentArtifacts}"
                                                                                      Margin="0,6,0,0">
                                                                            <ItemsControl.ItemTemplate>
                                                                                <DataTemplate DataType="vm:DocumentArtifactViewModel">
                                                                                    <Border Margin="0,3"
                                                                                            Padding="10,8"
                                                                                            CornerRadius="6"
                                                                                            Background="{DynamicResource SurfaceCard}"
                                                                                            BorderBrush="{DynamicResource SurfaceBorder}"
                                                                                            BorderThickness="1">
                                                                                        <DockPanel>
                                                                                            <ctrl:SovrantIcon IconName="{Binding Icon}" Size="20" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{DynamicResource TextSecondary}" />
                                                                                            <StackPanel DockPanel.Dock="Right"
                                                                                                        Orientation="Horizontal"
                                                                                                        Spacing="6"
                                                                                                        VerticalAlignment="Center">
                                                                                                <Button Content="Open"
                                                                                                        Command="{Binding OpenCommand}"
                                                                                                        Padding="8,3"
                                                                                                        CornerRadius="4"
                                                                                                        FontSize="11"
                                                                                                        Background="{DynamicResource BrandPrimary}"
                                                                                                        Foreground="White" />
                                                                                                <Button Content="Reveal"
                                                                                                        Command="{Binding RevealInFolderCommand}"
                                                                                                        Padding="8,3"
                                                                                                        CornerRadius="4"
                                                                                                        FontSize="11"
                                                                                                        Background="Transparent"
                                                                                                        BorderBrush="{DynamicResource SurfaceBorder}"
                                                                                                        BorderThickness="1"
                                                                                                        Foreground="{DynamicResource TextSecondary}"
                                                                                                        IsVisible="{Binding LocalPath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                                                                            </StackPanel>
                                                                                            <StackPanel Spacing="2">
                                                                                                <TextBlock Text="{Binding DisplayName}"
                                                                                                           FontSize="12"
                                                                                                           FontWeight="SemiBold"
                                                                                                           Foreground="{DynamicResource TextPrimary}"
                                                                                                           TextTrimming="CharacterEllipsis" />
                                                                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                                                                    <TextBlock Text="{Binding Format}"
                                                                                                               FontSize="10"
                                                                                                               Foreground="{DynamicResource TextMuted}" />
                                                                                                    <TextBlock Text="·"
                                                                                                               FontSize="10"
                                                                                                               Foreground="{DynamicResource TextMuted}"
                                                                                                               IsVisible="{Binding SizeText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                                                                                    <TextBlock Text="{Binding SizeText}"
                                                                                                               FontSize="10"
                                                                                                               Foreground="{DynamicResource TextMuted}" />
                                                                                                    <TextBlock Text="·"
                                                                                                               FontSize="10"
                                                                                                               Foreground="{DynamicResource TextMuted}"
                                                                                                               IsVisible="{Binding TemplateId, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                                                                                    <TextBlock Text="{Binding TemplateId}"
                                                                                                               FontSize="10"
                                                                                                               Foreground="{DynamicResource TextMuted}" />
                                                                                                </StackPanel>
                                                                                            </StackPanel>
                                                                                        </DockPanel>
                                                                                    </Border>
                                                                                </DataTemplate>
                                                                            </ItemsControl.ItemTemplate>
                                                                        </ItemsControl>
                                                                    </StackPanel>
                                                                </Border>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                            <!-- Phase 137 — one muted meta line: model · elapsed · Copy -->
                                            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2,0,0"
                                                        IsVisible="{Binding IsComplete}">
                                                <TextBlock Text="{Binding SenderLabel}" FontSize="11.5"
                                                           Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" />
                                                <TextBlock Text="·" FontSize="11.5" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"
                                                           IsVisible="{Binding ElapsedText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                                <TextBlock Text="{Binding ElapsedText}" FontSize="11.5"
                                                           Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"
                                                           IsVisible="{Binding ElapsedText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                                <TextBlock Text="·" FontSize="11.5" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" />
                                                <Button Classes="metaact" Content="Copy" ToolTip.Tip="Copy reply"
                                                        VerticalAlignment="Center" Click="OnCopyMessageButtonClick" />
                                            </StackPanel>
                                        </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</UserControl>
