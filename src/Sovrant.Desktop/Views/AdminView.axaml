<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Sovrant.Desktop.ViewModels"
             xmlns:conv="using:Sovrant.Desktop.Converters"
             xmlns:users="using:Sovrant.Runtime.Users"
             xmlns:ws="using:Sovrant.Runtime.Workspaces"
             x:Class="Sovrant.Desktop.Views.AdminView"
             x:DataType="vm:AdminViewModel"
             Background="{DynamicResource SurfaceBackground}">

    <UserControl.Resources>
        <conv:EqualityToBoolConverter x:Key="EqConv" />
    </UserControl.Resources>

    <ScrollViewer Padding="32,24">
        <StackPanel MaxWidth="800" Spacing="20">

            <!-- Header -->
            <DockPanel>
                <Button DockPanel.Dock="Right"
                        Content="Refresh"
                        Command="{Binding LoadCommand}"
                        Padding="16,8" CornerRadius="8"
                        Background="{DynamicResource SurfaceMuted}"
                        Foreground="{DynamicResource TextPrimary}"
                        FontWeight="SemiBold" />
                <TextBlock Text="Admin" FontSize="24" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimary}"
                           VerticalAlignment="Center" />
            </DockPanel>

            <!-- Status / Error banners -->
            <Border Padding="12,10" CornerRadius="8"
                    Background="{DynamicResource BrandPrimaryMuted}"
                    IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Text="{Binding Status}" FontSize="13"
                           Foreground="{DynamicResource BrandPrimary}" />
            </Border>

            <Border Padding="12,10" CornerRadius="8"
                    Background="#1FEF4444"
                    IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Text="{Binding Error}" FontSize="13"
                           Foreground="#EF4444" />
            </Border>

            <TextBlock Text="Loading…" FontSize="14"
                       Foreground="{DynamicResource TextSecondary}"
                       IsVisible="{Binding IsLoading}" />

            <!-- Tab bar -->
            <StackPanel Orientation="Horizontal" Spacing="4"
                        IsVisible="{Binding !IsLoading}">

                <Button Content="Users"
                        Command="{Binding SelectTabCommand}" CommandParameter="0"
                        Padding="14,6" CornerRadius="6" FontSize="13" FontWeight="SemiBold"
                        Background="{DynamicResource BrandPrimary}" Foreground="White"
                        IsVisible="{Binding IsUsersTab}" />
                <Button Content="Users"
                        Command="{Binding SelectTabCommand}" CommandParameter="0"
                        Padding="14,6" CornerRadius="6" FontSize="13" FontWeight="SemiBold"
                        Background="{DynamicResource SurfaceCard}" Foreground="{DynamicResource TextSecondary}"
                        IsVisible="{Binding !IsUsersTab}" />

                <Button Content="Registration"
                        Command="{Binding SelectTabCommand}" CommandParameter="1"
                        Padding="14,6" CornerRadius="6" FontSize="13" FontWeight="SemiBold"
                        Background="{DynamicResource BrandPrimary}" Foreground="White"
                        IsVisible="{Binding IsRegistrationTab}" />
                <Button Content="Registration"
                        Command="{Binding SelectTabCommand}" CommandParameter="1"
                        Padding="14,6" CornerRadius="6" FontSize="13" FontWeight="SemiBold"
                        Background="{DynamicResource SurfaceCard}" Foreground="{DynamicResource TextSecondary}"
                        IsVisible="{Binding !IsRegistrationTab}" />

                <Button Content="Projects"
                        Command="{Binding SelectTabCommand}" CommandParameter="2"
                        Padding="14,6" CornerRadius="6" FontSize="13" FontWeight="SemiBold"
                        Background="{DynamicResource BrandPrimary}" Foreground="White"
                        IsVisible="{Binding IsWorkspacesTab}" />
                <Button Content="Projects"
                        Command="{Binding SelectTabCommand}" CommandParameter="2"
                        Padding="14,6" CornerRadius="6" FontSize="13" FontWeight="SemiBold"
                        Background="{DynamicResource SurfaceCard}" Foreground="{DynamicResource TextSecondary}"
                        IsVisible="{Binding !IsWorkspacesTab}" />

                <Button Content="Password Reset"
                        Command="{Binding SelectTabCommand}" CommandParameter="3"
                        Padding="14,6" CornerRadius="6" FontSize="13" FontWeight="SemiBold"
                        Background="{DynamicResource BrandPrimary}" Foreground="White"
                        IsVisible="{Binding IsPasswordResetTab}" />
                <Button Content="Password Reset"
                        Command="{Binding SelectTabCommand}" CommandParameter="3"
                        Padding="14,6" CornerRadius="6" FontSize="13" FontWeight="SemiBold"
                        Background="{DynamicResource SurfaceCard}" Foreground="{DynamicResource TextSecondary}"
                        IsVisible="{Binding !IsPasswordResetTab}" />

            </StackPanel>

            <!-- ═══════════════════════════════════════════════ -->
            <!-- TAB 0: Users                                    -->
            <!-- ═══════════════════════════════════════════════ -->
            <StackPanel Spacing="12" IsVisible="{Binding IsUsersTab}">

                <ComboBox SelectedItem="{Binding UserFilter}"
                          Width="200" Padding="8,6" CornerRadius="8">
                    <ComboBox.Items>
                        <x:String>all</x:String>
                        <x:String>pending</x:String>
                        <x:String>active</x:String>
                        <x:String>inactive</x:String>
                    </ComboBox.Items>
                </ComboBox>

                <TextBlock Text="No users found."
                           FontSize="13" Foreground="{DynamicResource TextSecondary}"
                           IsVisible="{Binding !FilteredUsers.Count}" />

                <ItemsControl ItemsSource="{Binding FilteredUsers}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="users:User">
                            <Border Padding="14,10" CornerRadius="10" Margin="0,0,0,6"
                                    Background="{DynamicResource SurfaceMuted}"
                                    BorderBrush="{DynamicResource SurfaceBorder}"
                                    BorderThickness="1">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right"
                                                Orientation="Horizontal" Spacing="6"
                                                VerticalAlignment="Center">
                                        <Button Content="Approve"
                                                Command="{Binding $parent[ItemsControl].((vm:AdminViewModel)DataContext).ApproveCommand}"
                                                CommandParameter="{Binding}"
                                                IsVisible="{Binding Status, Converter={StaticResource EqConv}, ConverterParameter=pending}"
                                                Padding="10,5" CornerRadius="6" FontSize="12"
                                                Background="{DynamicResource BrandPrimary}"
                                                Foreground="White" />
                                        <Button Content="Disable"
                                                Command="{Binding $parent[ItemsControl].((vm:AdminViewModel)DataContext).DisableCommand}"
                                                CommandParameter="{Binding}"
                                                IsVisible="{Binding Status, Converter={StaticResource EqConv}, ConverterParameter=active}"
                                                Padding="10,5" CornerRadius="6" FontSize="12"
                                                Background="#EF4444"
                                                Foreground="White" />
                                        <Button Content="Reactivate"
                                                Command="{Binding $parent[ItemsControl].((vm:AdminViewModel)DataContext).ReactivateCommand}"
                                                CommandParameter="{Binding}"
                                                IsVisible="{Binding Status, Converter={StaticResource EqConv}, ConverterParameter=inactive}"
                                                Padding="10,5" CornerRadius="6" FontSize="12"
                                                Background="{DynamicResource SurfaceMuted}"
                                                Foreground="{DynamicResource TextPrimary}" />
                                    </StackPanel>
                                    <StackPanel Spacing="2">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{Binding Email}" FontWeight="SemiBold"
                                                       FontSize="14" Foreground="{DynamicResource TextPrimary}" />
                                            <Border Padding="6,2" CornerRadius="4"
                                                    Background="{DynamicResource SurfaceBorder}">
                                                <TextBlock Text="{Binding Status}" FontSize="11"
                                                           Foreground="{DynamicResource TextSecondary}" />
                                            </Border>
                                            <Border Padding="6,2" CornerRadius="4"
                                                    Background="{DynamicResource BrandPrimaryMuted}"
                                                    IsVisible="{Binding Role, Converter={StaticResource EqConv}, ConverterParameter=admin}">
                                                <TextBlock Text="admin" FontSize="11"
                                                           Foreground="{DynamicResource BrandPrimary}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding UserId}" FontSize="11"
                                                   Foreground="{DynamicResource TextMuted}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>

            <!-- ═══════════════════════════════════════════════ -->
            <!-- TAB 1: Registration                             -->
            <!-- ═══════════════════════════════════════════════ -->
            <StackPanel Spacing="12" IsVisible="{Binding IsRegistrationTab}">

                <TextBlock Text="Controls who can create new accounts."
                           FontSize="13" Foreground="{DynamicResource TextSecondary}" />

                <Border Padding="14,12" CornerRadius="10"
                        Background="{DynamicResource SurfaceMuted}"
                        BorderBrush="{DynamicResource SurfaceBorder}"
                        BorderThickness="1">
                    <DockPanel>
                        <CheckBox DockPanel.Dock="Right"
                                  IsChecked="{Binding RegistrationOpen}"
                                  Command="{Binding ToggleRegistrationCommand}"
                                  VerticalAlignment="Center" />
                        <StackPanel Spacing="2">
                            <TextBlock Text="Open registration" FontWeight="SemiBold"
                                       FontSize="14" Foreground="{DynamicResource TextPrimary}" />
                            <TextBlock Text="Allow new users to register. Closes automatically after the first user signs up."
                                       FontSize="12" Foreground="{DynamicResource TextSecondary}"
                                       TextWrapping="Wrap" MaxWidth="480" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Border Padding="14,12" CornerRadius="10"
                        Background="{DynamicResource SurfaceMuted}"
                        BorderBrush="{DynamicResource SurfaceBorder}"
                        BorderThickness="1">
                    <DockPanel>
                        <CheckBox DockPanel.Dock="Right"
                                  IsChecked="{Binding ApprovalRequired}"
                                  Command="{Binding ToggleApprovalCommand}"
                                  VerticalAlignment="Center" />
                        <StackPanel Spacing="2">
                            <TextBlock Text="Require admin approval" FontWeight="SemiBold"
                                       FontSize="14" Foreground="{DynamicResource TextPrimary}" />
                            <TextBlock Text="New accounts start as pending and cannot log in until an admin approves them."
                                       FontSize="12" Foreground="{DynamicResource TextSecondary}"
                                       TextWrapping="Wrap" MaxWidth="480" />
                        </StackPanel>
                    </DockPanel>
                </Border>

            </StackPanel>

            <!-- ═══════════════════════════════════════════════ -->
            <!-- TAB 2: Projects (Workspaces)                    -->
            <!-- ═══════════════════════════════════════════════ -->
            <StackPanel Spacing="12" IsVisible="{Binding IsWorkspacesTab}">

                <TextBlock Text="No projects found." FontSize="13"
                           Foreground="{DynamicResource TextSecondary}"
                           IsVisible="{Binding !AdminWorkspaces.Count}" />

                <ItemsControl ItemsSource="{Binding AdminWorkspaces}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="ws:Workspace">
                            <Border Padding="14,10" CornerRadius="10" Margin="0,0,0,4"
                                    Background="{DynamicResource SurfaceMuted}"
                                    BorderBrush="{DynamicResource SurfaceBorder}"
                                    BorderThickness="1">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right"
                                            Content="Delete"
                                            Command="{Binding $parent[ItemsControl].((vm:AdminViewModel)DataContext).DeleteWorkspaceCommand}"
                                            CommandParameter="{Binding}"
                                            IsVisible="{Binding Type, Converter={StaticResource EqConv}, ConverterParameter=Team}"
                                            Padding="10,5" CornerRadius="6" FontSize="12"
                                            Background="#EF4444" Foreground="White" />
                                    <StackPanel Spacing="2">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                       FontSize="14" Foreground="{DynamicResource TextPrimary}" />
                                            <Border Padding="6,2" CornerRadius="4"
                                                    Background="{DynamicResource SurfaceBorder}">
                                                <TextBlock Text="{Binding Type}" FontSize="11"
                                                           Foreground="{DynamicResource TextSecondary}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Slug}" FontSize="11"
                                                   FontFamily="Consolas,monospace"
                                                   Foreground="{DynamicResource TextMuted}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Create form -->
                <Border Padding="14,12" CornerRadius="10"
                        Background="{DynamicResource SurfaceMuted}"
                        BorderBrush="{DynamicResource SurfaceBorder}"
                        BorderThickness="1">
                    <StackPanel Spacing="8">
                        <TextBlock Text="New team project" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}" />
                        <TextBox Text="{Binding NewWorkspaceName}"
                                 Watermark="Name"
                                 FontSize="13" Padding="8,6" CornerRadius="6" />
                        <Button Content="Create"
                                Command="{Binding CreateWorkspaceCommand}"
                                HorizontalAlignment="Left"
                                Padding="16,7" CornerRadius="8"
                                Background="{DynamicResource BrandPrimary}"
                                Foreground="White" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>

            </StackPanel>

            <!-- ═══════════════════════════════════════════════ -->
            <!-- TAB 3: Password Reset                           -->
            <!-- ═══════════════════════════════════════════════ -->
            <StackPanel Spacing="12" IsVisible="{Binding IsPasswordResetTab}">

                <TextBlock Text="Generate a one-time reset token for a user. Share it out-of-band — expires in 24 hours."
                           FontSize="13" Foreground="{DynamicResource TextSecondary}" />

                <ComboBox ItemsSource="{Binding ActiveUsers}"
                          SelectedItem="{Binding SelectedResetUser}"
                          Width="320" Padding="8,6" CornerRadius="8"
                          PlaceholderText="— select user —">
                    <ComboBox.ItemTemplate>
                        <DataTemplate DataType="users:User">
                            <TextBlock Text="{Binding Email}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <Button Content="Generate reset token"
                        Command="{Binding GenerateResetTokenCommand}"
                        IsEnabled="{Binding SelectedResetUser, Converter={x:Static ObjectConverters.IsNotNull}}"
                        Padding="16,8" CornerRadius="8"
                        Background="{DynamicResource BrandPrimary}"
                        Foreground="White" FontWeight="SemiBold" />

                <Border Padding="14,12" CornerRadius="10"
                        Background="{DynamicResource SurfaceMuted}"
                        BorderBrush="{DynamicResource SurfaceBorder}"
                        BorderThickness="1"
                        IsVisible="{Binding ResetToken, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="One-time reset token (share securely):"
                                   FontSize="12" Foreground="{DynamicResource TextSecondary}" />
                        <SelectableTextBlock Text="{Binding ResetToken}"
                                             FontSize="12" FontFamily="Consolas,monospace"
                                             Foreground="{DynamicResource BrandPrimary}"
                                             TextWrapping="Wrap" />
                        <TextBlock Text="Expires in 24 hours. Select the token above to copy."
                                   FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                    </StackPanel>
                </Border>

            </StackPanel>

        </StackPanel>
    </ScrollViewer>

</UserControl>
