<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Sovrant.Desktop.ViewModels"
        xmlns:shared="using:Sovrant.Desktop.Views.Shared"
        x:Class="Sovrant.Desktop.Views.Dialogs.TemplateEditorDialog"
        x:DataType="vm:MarkdownEditorViewModel"
        Title="Edit template"
        Width="1100" Height="680"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceBackground}">

    <shared:MarkdownEditorView />
</Window>
