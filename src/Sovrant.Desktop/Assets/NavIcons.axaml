<ResourceDictionary xmlns="https://github.com/avaloniaui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Left-nav redesign — stroke-based line icons matching the approved
        mockup / Web's inline SVG exactly (same path data, viewBox 24x24,
        drawn with Stroke not Fill). Rendered via <Path Stroke=... Fill="Transparent">
        at each use site, StrokeThickness 1.9, StrokeLineCap/Join Round.
    -->
    <StreamGeometry x:Key="IconDashboard">M3,3 L10,3 L10,12 L3,12 Z M14,3 L21,3 L21,8 L14,8 Z M14,12 L21,12 L21,21 L14,21 Z M3,16 L10,16 L10,21 L3,21 Z</StreamGeometry>
    <StreamGeometry x:Key="IconChat">M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z</StreamGeometry>
    <StreamGeometry x:Key="IconKnowledge">M4 19.5A2.5 2.5 0 0 1 6.5 17H20 M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z</StreamGeometry>
    <StreamGeometry x:Key="IconAgents">M4 7 L20 7 L20 20 L4 20 Z M9 7V5a3 3 0 0 1 6 0v2 M9 13.01 L9 13 M15 13.01 L15 13 M9 17 L15 17</StreamGeometry>
    <StreamGeometry x:Key="IconProjects">M3 7.5A1.5 1.5 0 0 1 4.5 6H9l2 2.5h8.5A1.5 1.5 0 0 1 21 10v8a1.5 1.5 0 0 1-1.5 1.5h-15A1.5 1.5 0 0 1 3 18z</StreamGeometry>
    <StreamGeometry x:Key="IconAdmin">M12 2l8 3.5v6c0 5-3.4 8.9-8 10.5-4.6-1.6-8-5.5-8-10.5v-6z</StreamGeometry>

    <!-- Chat welcome-state suggestion icons — same conversion approach as above
         (V/H expanded to absolute L, arcs/relative curves kept verbatim; arc and
         relative-curve syntax already confirmed working via IconAdmin/IconChat). -->
    <StreamGeometry x:Key="IconSwarm">M21,16 L21,8 a2,2 0 0 0 -1,-1.7 l-7,-4 a2,2 0 0 0 -2,0 l-7,4 A2,2 0 0 0 3,8 L3,16 a2,2 0 0 0 1,1.7 l7,4 a2,2 0 0 0 2,0 l7,-4 A2,2 0 0 0 21,16 Z M3.3,7 L12,12 L20.7,7 M12,22 L12,12</StreamGeometry>
    <StreamGeometry x:Key="IconWorkflow">M23,4 L23,10 L17,10 M1,20 L1,14 L7,14 M3.5,9 a9,9 0 0 1 14.9,-3.4 L23,10 M1,14 l4.6,4.4 A9,9 0 0 0 20.5,15</StreamGeometry>
    <StreamGeometry x:Key="IconOrchestrate">M9,18 L15,12 L9,6</StreamGeometry>
    <StreamGeometry x:Key="IconConnect">M21.4,11.05 L12.25,20.2 a6,6 0 0 1 -8.49,-8.49 l9.2,-9.19 a4,4 0 0 1 5.65,5.66 l-9.2,9.19 a2,2 0 0 1 -2.83,-2.83 l8.49,-8.48</StreamGeometry>

    <!-- Privacy lock/unlock — used wherever a row toggles between private and public. -->
    <StreamGeometry x:Key="IconLock">M3,11 L21,11 L21,22 L3,22 Z M7,11 L7,7 A5,5 0 0 1 17,7 L17,11</StreamGeometry>
    <StreamGeometry x:Key="IconUnlock">M3,11 L21,11 L21,22 L3,22 Z M7,11 L7,7 A5,5 0 0 1 16.9,6</StreamGeometry>
</ResourceDictionary>
