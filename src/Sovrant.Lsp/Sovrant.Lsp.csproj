<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      CA1034  Nested types OK for LSP message types
      CA1812  Instantiated via DI or deserialization
      CA1031  Catch-all in read loop is intentional (stream recovery)
      CA1848  LoggerMessage delegates excessive for debug/info in client code
      CA1873  Logging arg evaluation OK in non-hot paths
    -->
    <NoWarn>CA1034;CA1812;CA1031;CA1848;CA1873;CA1054;CA1055;CA1056;CA1819</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.5" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Sovrant.Lsp.Tests" />
  </ItemGroup>

</Project>
