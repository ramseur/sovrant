@page "/admin/workspaces"
@using Sovrant.Runtime.Auth
@using Sovrant.Runtime.Mcp
@using Sovrant.Runtime.Providers
@using Sovrant.Runtime.Users
@using Sovrant.Runtime.Workspaces
@using Sovrant.Web.Services

@inject IUserService UserService
@inject IWorkspaceService WorkspaceService
@inject IWorkspaceSettingsStore WsSettings
@inject IProviderProfileStore ProfileStore
@inject IMcpServerStore McpServerStore
@inject WebSessionService Session
@inject NavigationManager Nav
@inject ActiveContextService ActiveContext

<div class="settings-page">
    <div class="diag-header">
        <h1>Workspaces</h1>
        <span class="item-count">@_workspaces.Count workspaces</span>
    </div>

    @if (!string.IsNullOrEmpty(_status))
    {
        <div class="status-message">@_status</div>
    }

    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="page-error-banner" role="alert">
            <span><SovrantIcon Name="alert" /></span>
            <span class="error-message">@_error</span>
        </div>
    }

    <div class="settings-section">
        <div class="form-field" style="margin-bottom:16px">
            <label>New team workspace</label>
            <div class="input-group">
                <input type="text" @bind="_newWsName" placeholder="Name..." />
                <button class="btn-primary btn-sm btn-inline-add" @onclick="CreateWorkspaceAsync">Create</button>
            </div>
        </div>

        @if (_wsLoading)
        {
            <p class="loading-row">Loading workspaces…</p>
        }
        else if (_workspaces.Count == 0)
        {
            <p class="text-secondary">No workspaces found.</p>
        }
        else
        {
            <div class="memory-list">
                @foreach (var w in _workspaces)
                {
                    <div class="memory-card">
                        <div class="memory-content">
                            <div class="memory-text">
                                <strong>@w.Name</strong>
                                <span class="outcome-badge @(w.Type == WorkspaceType.Personal ? "success" : "unknown")">@w.Type</span>
                            </div>
                            <div class="memory-meta">
                                <span class="text-muted text-sm">@w.Slug</span>
                                <span class="text-muted text-sm">@w.CreatedAt.LocalDateTime.ToString("d")</span>
                            </div>
                        </div>
                        <div class="memory-actions">
                            <button class="btn btn-sm btn-primary" @onclick="() => ToggleConfigureWorkspace(w)">Configure</button>
                            @if (w.Type != WorkspaceType.Personal)
                            {
                                <button class="btn btn-sm btn-danger" @onclick="() => RequestDeleteWorkspace(w)">Delete</button>
                            }
                        </div>
                    </div>
                }
            </div>
        }

        @if (_configWorkspace is not null)
        {
            <div class="admin-config-panel">
                <div class="config-panel-header">
                    <h4>Configure: @_configWorkspace.Name</h4>
                    <button class="btn btn-sm" @onclick="() => _configWorkspace = null"><SovrantIcon Name="x" /> Close</button>
                </div>

                <h5>General Settings</h5>
                <div class="form-group">
                    <label>Max Output Tokens</label>
                    <input type="number" @bind="_wsMaxTokens" min="256" max="128000" step="1000" />
                </div>
                <div class="form-group toggle-row">
                    <div>
                        <div class="toggle-title">Streaming</div>
                    </div>
                    <label class="toggle-switch">
                        <input type="checkbox" @bind="_wsStreaming" />
                        <span class="slider"></span>
                    </label>
                </div>
                <div class="form-group toggle-row">
                    <div>
                        <div class="toggle-title">Intent Routing</div>
                    </div>
                    <label class="toggle-switch">
                        <input type="checkbox" @bind="_wsIntentRouting" />
                        <span class="slider"></span>
                    </label>
                </div>
                <div class="form-group">
                    <label>Web Search Backend</label>
                    <select @bind="_wsWebSearchBackend">
                        <option>Auto</option>
                        <option>Brave</option>
                        <option>Firecrawl</option>
                        <option>Native</option>
                        <option>Off</option>
                    </select>
                </div>
                <button class="btn-primary btn-sm" @onclick="SaveWorkspaceGeneralAsync">Save General Settings</button>

                <h5>Members</h5>
                @if (_configMembers.Count == 0)
                {
                    <p class="text-secondary">No members.</p>
                }
                else
                {
                    @foreach (var m in _configMembers)
                    {
                        <div class="workspace-row">
                            <span>@m.DisplayName (@m.Role)</span>
                            <button class="btn btn-sm btn-danger" @onclick="() => RemoveMemberAsync(m)">Remove</button>
                        </div>
                    }
                }
                <div class="inline-form">
                    <input type="text" @bind="_newMemberEmail" placeholder="User email or ID" />
                    <select @bind="_newMemberRole">
                        <option>Member</option>
                        <option>Admin</option>
                    </select>
                    <button class="btn-primary btn-sm btn-inline-add" @onclick="AddMemberAsync">Add</button>
                </div>

                <h5>Providers</h5>
                <p class="text-sm text-muted" style="margin-bottom:8px">Select which configured providers are available in this workspace. <a href="/admin/providers">Manage providers →</a></p>
                @if (_allProfiles.Count == 0)
                {
                    <p class="text-secondary">No providers configured yet.</p>
                }
                else
                {
                    @foreach (var p in _allProfiles)
                    {
                        <div class="form-group toggle-row">
                            <div>
                                <div class="toggle-title">@p.Name</div>
                                <div class="text-sm text-muted">@p.ProviderKind</div>
                            </div>
                            <label class="toggle-switch">
                                <input type="checkbox" checked="@_enabledProfileIds.Contains(p.ProfileId)"
                                       @onchange="e => ToggleProvider(p.ProfileId, (bool)(e.Value ?? false))" />
                                <span class="slider"></span>
                            </label>
                        </div>
                    }
                    <button class="btn-primary btn-sm" style="margin-top:8px" @onclick="SaveWorkspaceProvidersAsync">Save Providers</button>
                }

                <h5>MCP Servers</h5>
                <p class="text-sm text-muted" style="margin-bottom:8px">Select which MCP servers are available in this workspace. <a href="/admin/integrations">Manage servers →</a></p>
                @if (_allMcpEntries.Count == 0)
                {
                    <p class="text-secondary">No MCP servers configured yet.</p>
                }
                else
                {
                    @foreach (var entry in _allMcpEntries)
                    {
                        <div class="form-group toggle-row">
                            <div>
                                <div class="toggle-title">@entry.Name</div>
                            </div>
                            <label class="toggle-switch">
                                <input type="checkbox" checked="@_enabledMcpIds.Contains(entry.Id)"
                                       @onchange="e => ToggleMcp(entry.Id, (bool)(e.Value ?? false))" />
                                <span class="slider"></span>
                            </label>
                        </div>
                    }
                    <button class="btn-primary btn-sm" style="margin-top:8px" @onclick="SaveWorkspaceMcpsAsync">Save MCP Servers</button>
                }
            </div>
        }
    </div>
</div>

<DeleteConfirmModal @ref="_deleteModal" />

@code {
    private DeleteConfirmModal _deleteModal = default!;
    private string _status = string.Empty;
    private string _error = string.Empty;

    private bool _wsLoading;
    private string _newWsName = string.Empty;
    private List<Workspace> _workspaces = [];

    private Workspace? _configWorkspace;
    private int _wsMaxTokens = 32000;
    private bool _wsStreaming = true;
    private bool _wsIntentRouting;
    private string _wsWebSearchBackend = "Auto";
    private string _newMemberEmail = string.Empty;
    private string _newMemberRole = "Member";
    private List<MemberRow> _configMembers = [];

    private sealed record MemberRow(string UserId, string DisplayName, WorkspaceRole Role);
    private List<ProviderProfile> _allProfiles = [];
    private HashSet<string> _enabledProfileIds = [];
    private List<McpServerEntry> _allMcpEntries = [];
    private HashSet<string> _enabledMcpIds = [];

    protected override async Task OnInitializedAsync()
    {
        if (!Session.IsAuthenticated || !Session.IsAdmin)
        {
            Nav.NavigateTo("/", forceLoad: false);
            return;
        }
        await LoadWorkspacesAsync();
    }

    private async Task LoadWorkspacesAsync()
    {
        _wsLoading = true;
        try { _workspaces = (await WorkspaceService.ListAllAsync().ConfigureAwait(false)).ToList(); }
        catch (Exception ex) { _error = $"Failed to load workspaces: {ex.Message}"; }
        finally { _wsLoading = false; }
    }

    private async Task CreateWorkspaceAsync()
    {
        var name = _newWsName.Trim();
        if (string.IsNullOrEmpty(name)) { _status = "Enter a name."; return; }
        var slug = name.ToLowerInvariant().Replace(' ', '-');
        try
        {
            await WorkspaceService.CreateTeamWorkspaceAsync(name, slug, Session.UserId!).ConfigureAwait(false);
            _newWsName = string.Empty;
            _status = $"Workspace '{name}' created.";
            await LoadWorkspacesAsync();
        }
        catch (Exception ex) { _error = $"Failed: {ex.Message}"; }
    }

    private void RequestDeleteWorkspace(Workspace w) =>
        _deleteModal.Show("Workspace", w.Name, () => DeleteWorkspaceAsync(w));

    private async Task DeleteWorkspaceAsync(Workspace w)
    {
        try
        {
            await WorkspaceService.DeleteAsync(w.WorkspaceId).ConfigureAwait(false);
            _status = $"'{w.Name}' deleted.";
            await LoadWorkspacesAsync();
        }
        catch (Exception ex) { _error = $"Cannot delete: {ex.Message}"; }
        StateHasChanged();
    }

    private async Task ToggleConfigureWorkspace(Workspace ws)
    {
        if (_configWorkspace?.WorkspaceId == ws.WorkspaceId) { _configWorkspace = null; return; }
        _configWorkspace = ws;
        var maxRaw = await WsSettings.GetAsync(ws.WorkspaceId, WorkspaceSettingsKeys.GeneralMaxTokens);
        _wsMaxTokens = int.TryParse(maxRaw, System.Globalization.NumberStyles.Integer,
            System.Globalization.CultureInfo.InvariantCulture, out var t) ? t : 32000;
        var streamRaw = await WsSettings.GetAsync(ws.WorkspaceId, WorkspaceSettingsKeys.GeneralStreaming);
        _wsStreaming = !string.Equals(streamRaw, "false", StringComparison.OrdinalIgnoreCase);
        var intentRaw = await WsSettings.GetAsync(ws.WorkspaceId, WorkspaceSettingsKeys.GeneralIntentRouting);
        _wsIntentRouting = string.Equals(intentRaw, "true", StringComparison.OrdinalIgnoreCase);
        var wsRaw = await WsSettings.GetAsync(ws.WorkspaceId, WorkspaceSettingsKeys.GeneralWebSearchBackend);
        _wsWebSearchBackend = string.IsNullOrEmpty(wsRaw) ? "Auto" : wsRaw;
        _configMembers = await LoadMemberRowsAsync(ws.WorkspaceId);
        _allProfiles = (await ProfileStore.ListAsync(Session.UserId!)).ToList();
        var enabledRaw = await WsSettings.GetAsync(ws.WorkspaceId, WorkspaceSettingsKeys.EnabledProviderProfileIds);
        _enabledProfileIds = string.IsNullOrEmpty(enabledRaw)
            ? []
            : [..enabledRaw.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)];

        var allEntries = await McpServerStore.GetAllEntriesAsync();
        _allMcpEntries = allEntries.OrderBy(e => e.Name, StringComparer.Ordinal).ToList();
        var mcpRaw = await WsSettings.GetAsync(ws.WorkspaceId, WorkspaceSettingsKeys.EnabledMcpServerIds);
        _enabledMcpIds = string.IsNullOrEmpty(mcpRaw)
            ? []
            : [..mcpRaw.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)];
    }

    private async Task SaveWorkspaceGeneralAsync()
    {
        if (_configWorkspace is null) return;
        var wsId = _configWorkspace.WorkspaceId;
        await WsSettings.SetAsync(wsId, WorkspaceSettingsKeys.GeneralMaxTokens, _wsMaxTokens.ToString(System.Globalization.CultureInfo.InvariantCulture));
        await WsSettings.SetAsync(wsId, WorkspaceSettingsKeys.GeneralStreaming, _wsStreaming ? "true" : "false");
        await WsSettings.SetAsync(wsId, WorkspaceSettingsKeys.GeneralIntentRouting, _wsIntentRouting ? "true" : "false");
        await WsSettings.SetAsync(wsId, WorkspaceSettingsKeys.GeneralWebSearchBackend, _wsWebSearchBackend);
        _status = "General settings saved.";
    }

    private async Task AddMemberAsync()
    {
        if (_configWorkspace is null || string.IsNullOrWhiteSpace(_newMemberEmail)) return;
        var allUsers = await UserService.ListAsync();
        var user = allUsers.FirstOrDefault(u =>
            string.Equals(u.Email, _newMemberEmail.Trim(), StringComparison.OrdinalIgnoreCase)
            || string.Equals(u.UserId, _newMemberEmail.Trim(), StringComparison.OrdinalIgnoreCase));
        if (user is null) { _status = $"User '{_newMemberEmail}' not found."; return; }
        var role = string.Equals(_newMemberRole, "Admin", StringComparison.OrdinalIgnoreCase)
            ? WorkspaceRole.Admin : WorkspaceRole.Member;
        await WorkspaceService.AddMemberAsync(_configWorkspace.WorkspaceId, user.UserId, role);
        _newMemberEmail = string.Empty;
        _configMembers = await LoadMemberRowsAsync(_configWorkspace.WorkspaceId);
        _status = $"{user.Email ?? user.UserId} added as {role}.";
    }

    private async Task RemoveMemberAsync(MemberRow member)
    {
        if (_configWorkspace is null) return;
        await WorkspaceService.RemoveMemberAsync(_configWorkspace.WorkspaceId, member.UserId);
        _configMembers = await LoadMemberRowsAsync(_configWorkspace.WorkspaceId);
        _status = $"{member.DisplayName} removed.";
    }

    private async Task<List<MemberRow>> LoadMemberRowsAsync(string workspaceId)
    {
        var members = await WorkspaceService.ListMembersAsync(workspaceId);
        var rows = new List<MemberRow>(members.Count);
        foreach (var m in members)
        {
            var user = await UserService.GetAsync(m.UserId);
            rows.Add(new MemberRow(
                UserId: m.UserId,
                DisplayName: user?.Email ?? m.UserId,
                Role: m.Role));
        }
        return rows;
    }

    private void ToggleProvider(string profileId, bool enabled)
    {
        if (enabled) _enabledProfileIds.Add(profileId);
        else _enabledProfileIds.Remove(profileId);
    }

    private async Task SaveWorkspaceProvidersAsync()
    {
        if (_configWorkspace is null) return;
        var value = string.Join(',', _enabledProfileIds);
        await WsSettings.SetAsync(_configWorkspace.WorkspaceId, WorkspaceSettingsKeys.EnabledProviderProfileIds, value);
        _status = "Provider availability saved.";
    }

    private void ToggleMcp(string id, bool enabled)
    {
        if (enabled) _enabledMcpIds.Add(id);
        else _enabledMcpIds.Remove(id);
    }

    private async Task SaveWorkspaceMcpsAsync()
    {
        if (_configWorkspace is null) return;
        var value = string.Join(',', _enabledMcpIds);
        await WsSettings.SetAsync(_configWorkspace.WorkspaceId, WorkspaceSettingsKeys.EnabledMcpServerIds, value);
        _status = "MCP server availability saved.";
        if (_configWorkspace.WorkspaceId == ActiveContext.WorkspaceId)
            ActiveContext.NotifyDataChanged();
    }
}
