@page "/admin/integrations"
@using System.Text.Json
@using Sovrant.Runtime.Auth
@using Sovrant.Runtime.Config
@using Sovrant.Runtime.Mcp
@using Sovrant.Runtime.Workspaces
@inject IJSRuntime JS
@inject NavigationManager Nav

<div class="master-detail">
    <div class="master-panel">
        <div class="master-header">
            <h1>Platform Integrations</h1>
            <div class="master-header-right">
                @if (_activeTab == "connected")
                {
                    <span class="item-count">@_filtered.Count</span>
                    <button class="btn-sm btn-outline" title="Refresh"
                            @onclick="LoadServersAsync"><SovrantIcon Name="refresh" /></button>
                }
            </div>
        </div>

        <!-- Tab bar -->
        <div style="display:flex;gap:4px;padding:0 12px 8px;">
            <button class="btn-sm @(_activeTab == "connected" ? "btn-primary" : "btn-outline")"
                    @onclick='() => SwitchTab("connected")'>Connected (@_servers.Count)</button>
            <button class="btn-sm @(_activeTab == "gallery" ? "btn-primary" : "btn-outline")"
                    @onclick='() => SwitchTab("gallery")'>Gallery</button>
        </div>

        @if (_activeTab == "gallery")
        {
            <!-- Gallery: catalog entries grouped by tier -->
            <div class="master-list" style="padding:0 4px;">
                @foreach (var catGroup in GetGalleryCards().GroupBy(c => c.Category))
                {
                    <div style="padding:6px 8px 2px;font-size:10px;font-weight:600;color:var(--text-muted);letter-spacing:.05em;">
                        @catGroup.Key.ToUpperInvariant()
                    </div>
                    @foreach (var card in catGroup)
                    {
                        var isActive = _selectedGroup is not null && _selectedGroup[0].Id == card.Id;
                        var isAnyConnected = (_selectedGroup?.Any(e => _isConnected(e.Id)) ?? false) || _isConnected(card.Id);
                        <button class="master-item @(isActive ? "active" : "")"
                                @onclick="() => SelectGalleryCard(card)">
                            <div class="item-title" style="display:flex;align-items:center;gap:6px;">
                                <span style="font-size:16px;line-height:1;"><SovrantIcon Name="@card.IconKey" /></span>
                                <span>@card.Name</span>
                                @if (isAnyConnected)
                                {
                                    <span class="status-dot connected" style="margin-left:2px;" title="Connected"></span>
                                }
                            </div>
                            <div class="item-subtitle" style="padding-left:26px;">@card.Description</div>
                        </button>
                    }
                }

            </div>
        }
        else
        {
            <!-- Connected: existing server list -->
            <div class="master-search">
                <input type="text" placeholder="Search servers..."
                       @bind="_search" @bind:event="oninput" @bind:after="ApplyFilter" />
            </div>

            <div class="master-list">
                @if (_filtered.Count == 0)
                {
                    <p class="text-secondary" style="padding:12px;">
                        @(string.IsNullOrWhiteSpace(_search) ? "No MCP servers configured." : "No matches.")
                    </p>
                }
                else
                {
                    @foreach (var s in _filtered)
                    {
                        <button class="master-item @(ReferenceEquals(s, _selected) ? "active" : "")"
                                @onclick="() => Select(s)">
                            <div class="item-title" style="display:flex;align-items:center;gap:8px;">
                                <span class="status-dot @(s.IsConnected ? "connected" : "warning")" style="flex-shrink:0;"></span>
                                <span>@s.Name</span>
                            </div>
                            <div class="item-subtitle" style="padding-left:16px;">
                                @s.Transport@(s.ToolCount > 0 ? $" • {s.ToolCount} tool{(s.ToolCount == 1 ? "" : "s")}" : "")
                            </div>
                        </button>
                    }
                }
            </div>

        }
    </div>

    <div class="detail-panel">
        @if (!string.IsNullOrEmpty(_status))
        {
            <div class="status-message" style="margin:16px 24px 0;">@_status</div>
        }

        @if (_activeTab == "gallery" && _catalogEntry is not null)
        {
            <!-- Gallery quick-connect panel -->
            <div class="detail-content">
                <div class="orch-detail-header">
                    <div>
                        <span style="font-size:36px;line-height:1;display:block;margin-bottom:8px;"><SovrantIcon Name="@_catalogEntry.IconKey" /></span>
                        <h2>@_catalogEntry.Name</h2>
                        <p class="text-secondary" style="margin:4px 0 0;">@_catalogEntry.Category</p>
                    </div>
                </div>

                @if (_selectedGroup?.Count > 1)
                {
                    <div style="display:flex;gap:4px;margin:12px 0 0;">
                        @for (int i = 0; i < _selectedGroup.Count; i++)
                        {
                            var idx = i;
                            var label = _selectedGroup[i].TabLabel ?? _selectedGroup[i].Name;
                            <button class="btn-sm @(_selectedGroupTab == idx ? "btn-primary" : "btn-outline")"
                                    @onclick="() => SelectGroupTab(idx)">@label</button>
                        }
                    </div>
                }

                <p style="margin:12px 0 20px;color:var(--text-secondary);">@_catalogEntry.Description</p>

                @if (_catalogEntry.Kind == IntegrationKind.LlmProvider)
                {
                    <div class="callout-card">
                        <strong>LLM Provider</strong> — Configure API keys and model selection in
                        <a href="/settings" style="color:var(--brand);">Settings → Models</a>.
                    </div>
                }
                else
                {
                    @if (_isConnected(_catalogEntry.Id))
                    {
                        <div class="callout-card" style="border-color:var(--status-ok);background:var(--surface-card);">
                            <strong><SovrantIcon Name="check" /> Already connected</strong> — Re-connect to update credentials.
                        </div>
                    }

                    @if (_catalogEntry.RequiresOAuth)
                    {
                        <!-- OAuth connect path -->
                        @if (_isOAuthWaiting)
                        {
                            <div class="callout-card" style="border-color:var(--brand);background:var(--surface-card);">
                                <strong><SovrantIcon Name="refresh" /> Waiting for authorization...</strong>
                                Browser opened — complete the login and return here. Times out after 2 min.
                            </div>
                        }

                        <div class="form-field">
                            <label>OAuth Client ID</label>
                            <input type="text" autocomplete="off" @bind="_galleryClientId"
                                   placeholder="Your OAuth app client ID" />
                        </div>

                        @if (_catalogEntry.NeedsEndpoint)
                        {
                            <div class="form-field">
                                <label>@_catalogEntry.EndpointLabel</label>
                                <input type="text" autocomplete="off" @bind="_galleryUrl" placeholder="" />
                            </div>
                        }

                        <button class="btn-primary" style="max-width:220px;" disabled="@_isOAuthConnecting"
                                @onclick="ConnectWithOAuthAsync">Connect with OAuth</button>

                        <p style="font-size:11px;color:var(--text-muted);margin-top:8px;">
                            Register an OAuth app with the provider to get a Client ID.
                            Sovrant will open your browser for authorization and handle the rest.
                        </p>
                    }
                    else
                    {
                        <!-- Standard API key / endpoint connect path -->
                        @if (_catalogEntry.NeedsApiKey)
                        {
                            <div class="form-field">
                                <label>@_catalogEntry.ApiKeyLabel</label>
                                <input type="password" autocomplete="new-password" @bind="_galleryApiKey"
                                       placeholder="Paste your key here" />
                            </div>
                        }
                        @if (_catalogEntry.NeedsEndpoint)
                        {
                            <div class="form-field">
                                <label>@_catalogEntry.EndpointLabel</label>
                                <input type="text" autocomplete="off" @bind="_galleryUrl" placeholder="" />
                            </div>
                        }

                        <button class="btn-primary" style="max-width:200px;"
                                @onclick="ConnectFromGalleryAsync">Connect</button>
                    }
                }
            </div>
        }
        else if (_activeTab == "gallery")
        {
            <div class="detail-empty">
                <span class="text-muted">Select an integration to connect it.</span>
            </div>
        }
        else if (_selected is not null)
        {
            <div class="detail-content">
                <div class="orch-detail-header">
                    <div>
                        <h2 style="display:flex;align-items:center;gap:10px;margin-bottom:4px;">
                            @_selected.Name
                            <span style="display:inline-flex;align-items:center;gap:5px;font-size:12px;font-weight:500;color:@(_selected.IsConnected ? "var(--status-pass)" : "var(--status-warn)");">
                                <span class="status-dot @(_selected.IsConnected ? "connected" : "warning")"></span>
                                @(_selected.IsConnected ? "Connected" : "Not connected")
                            </span>
                        </h2>
                        <p class="text-secondary" style="margin:0;">@_selected.Transport transport@(_selected.ToolCount > 0 ? $" • {_selected.ToolCount} tools" : "")</p>
                    </div>
                    <button class="btn-sm btn-danger" @onclick="() => RemoveServerAsync(_selected.Name)">Remove</button>
                </div>

                <div class="orch-detail-section">
                    <h3>Endpoint</h3>
                    <div class="gov-card">
                        @if (_selected.Url is not null)
                        {
                            <div class="gov-field-row">
                                <span>URL</span>
                                <span class="text-sm" style="font-family:Consolas,monospace;">@_selected.Url</span>
                            </div>
                        }
                        else
                        {
                            <div class="gov-field-row">
                                <span>Command</span>
                                <span class="text-sm" style="font-family:Consolas,monospace;">@_selected.Command</span>
                            </div>
                            @if (_selected.Args.Count > 0)
                            {
                                <div class="gov-field-row">
                                    <span>Arguments</span>
                                    <span class="text-sm" style="font-family:Consolas,monospace;">@string.Join(" ", _selected.Args)</span>
                                </div>
                            }
                        }
                    </div>
                </div>

                @if (_selected.Headers.Count > 0)
                {
                    <div class="orch-detail-section">
                        <h3>Headers</h3>
                        <div class="gov-card">
                            @foreach (var kv in _selected.Headers)
                            {
                                <div class="gov-field-row">
                                    <span>@kv.Key</span>
                                    <span class="text-sm" style="font-family:Consolas,monospace;">@MaskSecret(kv.Key, kv.Value)</span>
                                </div>
                            }
                        </div>
                    </div>
                }

                <div class="orch-detail-section">
                    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;">
                        <h3 style="margin:0;">Environment Variables</h3>
                        @if (!_editingEnv)
                        {
                            <button class="btn-sm btn-outline" @onclick="StartEditEnv">
                                @(_selected.EnvVars.Count > 0 ? "Edit" : "+ Add")
                            </button>
                        }
                    </div>
                    @if (_editingEnv)
                    {
                        @for (int i = 0; i < _envEdits.Count; i++)
                        {
                            var idx = i;
                            <div style="display:grid;grid-template-columns:1fr 2fr auto;gap:6px;margin-bottom:6px;align-items:center;">
                                <input type="text" autocomplete="off"
                                       @bind="_envEdits[idx].Key"
                                       placeholder="VARIABLE_NAME"
                                       style="font-family:Consolas,monospace;font-size:12px;" />
                                <input type="text" autocomplete="new-password"
                                       @bind="_envEdits[idx].Value"
                                       placeholder="value"
                                       style="font-family:Consolas,monospace;font-size:12px;" />
                                <button class="btn-sm btn-danger" style="padding:4px 8px;"
                                        @onclick="() => _envEdits.RemoveAt(idx)"><SovrantIcon Name="x" /></button>
                            </div>
                        }
                        <div style="display:flex;gap:8px;margin-top:4px;">
                            <button class="btn-sm btn-outline" @onclick="AddEnvRow">+ Add variable</button>
                            <button class="btn-primary btn-sm" @onclick="SaveEnvAsync">Save</button>
                            <button class="btn-sm btn-outline" @onclick="CancelEditEnv">Cancel</button>
                        </div>
                    }
                    else if (_selected.EnvVars.Count > 0)
                    {
                        <div class="gov-card">
                            @foreach (var kv in _selected.EnvVars)
                            {
                                <div class="gov-field-row">
                                    <span style="font-family:Consolas,monospace;font-size:12px;">@kv.Key</span>
                                    <span class="text-sm" style="font-family:Consolas,monospace;">@MaskSecret(kv.Key, kv.Value)</span>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-muted text-sm">No environment variables configured.</p>
                    }
                    @if (!string.IsNullOrEmpty(_envStatus))
                    {
                        <p class="text-sm" style="margin-top:6px;color:var(--text-secondary);">@_envStatus</p>
                    }
                </div>

                <div class="orch-detail-section">
                    <h3>Tools (@_selected.ToolCount)</h3>
                    @if (!_selected.IsConnected)
                    {
                        <p class="text-muted text-sm">Not connected — tools unavailable.</p>
                    }
                    else if (_selected.ToolList.Count == 0)
                    {
                        <p class="text-muted text-sm">Connected, but server reported no tools.</p>
                    }
                    else
                    {
                        <div class="gov-card">
                            @foreach (var t in _selected.ToolList)
                            {
                                <div class="gov-field-row">
                                    <span style="font-family:Consolas,monospace;">@t</span>
                                    <span></span>
                                </div>
                            }
                        </div>
                    }
                </div>

                <!-- Trust Rules -->
                <div class="orch-detail-section">
                    <h3>Trust Rules</h3>
                    <p class="text-muted text-sm" style="margin-bottom:10px;">
                        Rules control how tool calls are handled before execution.
                        Built-in defaults require confirmation for <code>delete_*</code>, <code>remove_*</code>, <code>bulk_*</code> and similar patterns.
                    </p>

                    @if (_trustRules.Count > 0)
                    {
                        <div class="gov-card" style="margin-bottom:12px;">
                            @foreach (var rule in _trustRules)
                            {
                                <div class="gov-field-row" style="align-items:center;">
                                    <span>
                                        <span style="font-family:Consolas,monospace;font-size:12px;">@rule.ToolPattern</span>
                                        @if (!string.IsNullOrEmpty(rule.Reason))
                                        {
                                            <span class="text-muted" style="font-size:11px;margin-left:6px;">— @rule.Reason</span>
                                        }
                                    </span>
                                    <span style="display:flex;align-items:center;gap:8px;">
                                        <span class="badge @(rule.Action == McpTrustAction.Block ? "badge-danger" : rule.Action == McpTrustAction.Allow ? "badge-success" : "badge-warning")"
                                              style="font-size:10px;padding:2px 7px;border-radius:10px;font-weight:600;">
                                            @rule.Action
                                        </span>
                                        @if (_canManageRules)
                                        {
                                            <button class="btn-sm btn-danger" style="padding:2px 8px;font-size:11px;"
                                                    @onclick="() => RemoveTrustRuleAsync(rule.RuleId)"><SovrantIcon Name="x" /></button>
                                        }
                                    </span>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-muted text-sm" style="margin-bottom:10px;">No custom rules — built-in defaults apply.</p>
                    }

                    @if (_canManageRules)
                    {
                        <div style="display:grid;grid-template-columns:1fr auto auto;gap:8px;align-items:end;">
                            <div class="form-field" style="margin:0;">
                                <label style="font-size:11px;">Tool Pattern (glob)</label>
                                <input type="text" @bind="_newRulePattern" placeholder="delete_* or *_remove" style="font-family:Consolas,monospace;font-size:12px;" />
                            </div>
                            <div class="form-field" style="margin:0;">
                                <label style="font-size:11px;">Action</label>
                                <select @bind="_newRuleAction" style="padding:6px 8px;border-radius:6px;border:1px solid var(--surface-border);background:var(--surface-card);color:var(--text-primary);font-size:12px;">
                                    <option value="Allow">Allow</option>
                                    <option value="RequireConfirmation">Require Confirmation</option>
                                    <option value="Block">Block</option>
                                </select>
                            </div>
                            <button class="btn-primary btn-sm" @onclick="AddTrustRuleAsync" style="margin-bottom:1px;">Add Rule</button>
                        </div>
                        <div class="form-field" style="margin-top:6px;">
                            <label style="font-size:11px;">Reason (optional — shown to agent on block/confirmation)</label>
                            <input type="text" @bind="_newRuleReason" placeholder="e.g. Bulk deletes require manager approval" />
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(_trustStatus))
                    {
                        <p class="text-sm" style="margin-top:6px;color:var(--text-secondary);">@_trustStatus</p>
                    }
                </div>
            </div>
        }
        else
        {
            <!-- Add Server form (Connected tab, nothing selected) -->
            <div class="detail-content">
                <div class="orch-detail-header">
                    <div><h2>Add MCP Server</h2></div>
                </div>

                <div style="display:flex;gap:4px;margin-bottom:20px;">
                    <button class="btn-sm @(_addMode == "json"   ? "btn-primary" : "btn-outline")"
                            @onclick='() => _addMode = "json"'>JSON</button>
                    <button class="btn-sm @(_addMode == "stdio"  ? "btn-primary" : "btn-outline")"
                            @onclick='() => _addMode = "stdio"'>stdio</button>
                    <button class="btn-sm @(_addMode == "http"   ? "btn-primary" : "btn-outline")"
                            @onclick='() => _addMode = "http"'>HTTP</button>
                </div>

                @if (_allWorkspaces.Count > 1)
                {
                    <div class="form-field" style="margin-bottom:16px;">
                        <label>Enable for workspaces (optional)</label>
                        <p class="text-sm text-muted" style="margin-bottom:6px;">Check workspaces that should have access to this server.</p>
                        @foreach (var ws in _allWorkspaces)
                        {
                            <div class="form-group toggle-row">
                                <div><div class="toggle-title">@ws.Name</div></div>
                                <label class="toggle-switch">
                                    <input type="checkbox" checked="@_addWorkspaceIds.Contains(ws.WorkspaceId)"
                                           @onchange="e => ToggleAddWorkspace(ws.WorkspaceId, (bool)(e.Value ?? false))" />
                                    <span class="slider"></span>
                                </label>
                            </div>
                        }
                    </div>
                }

                @if (_addMode == "json")
                {
                    <div class="form-field">
                        <label>Claude/Cursor JSON config</label>
                        <textarea rows="10" @bind="_jsonInput" placeholder="@_jsonPlaceholder"
                                  style="font-family:Consolas,monospace;font-size:12px;width:100%;resize:vertical;"></textarea>
                    </div>
                    <button class="btn-primary" @onclick="AddFromJsonAsync">Import</button>
                }
                else if (_addMode == "stdio")
                {
                    <div class="form-field">
                        <label>Name</label>
                        <input type="text" autocomplete="off" @bind="_newName" placeholder="my-server" />
                    </div>
                    <div class="form-field">
                        <label>Command</label>
                        <input type="text" autocomplete="off" @bind="_newCommand" placeholder="npx" />
                    </div>
                    <div class="form-field">
                        <label>Arguments (space-separated)</label>
                        <input type="text" @bind="_newArgs" placeholder="-y @@modelcontextprotocol/server-filesystem /tmp" />
                    </div>
                    <div class="form-field">
                        <label>Environment Variables (optional — one KEY=VALUE per line)</label>
                        <textarea rows="4" @bind="_newEnvVars"
                                  placeholder="GITHUB_PERSONAL_ACCESS_TOKEN=ghp_...&#10;DEBUG=false"
                                  style="font-family:Consolas,monospace;font-size:12px;width:100%;resize:vertical;"></textarea>
                    </div>
                    <button class="btn-primary" @onclick="AddStdioServerAsync">Add</button>
                }
                else
                {
                    <div class="form-field">
                        <label>Name</label>
                        <input type="text" autocomplete="off" @bind="_newName" placeholder="my-server" />
                    </div>
                    <div class="form-field">
                        <label>URL</label>
                        <input type="text" autocomplete="off" @bind="_newUrl" placeholder="https://mcp.example.com/sse" />
                    </div>
                    <div class="form-field">
                        <label>Bearer Token (optional)</label>
                        <input type="password" autocomplete="new-password" @bind="_newBearer" placeholder="sk-…" />
                    </div>
                    <div class="form-field">
                        <label>Extra Headers JSON (optional)</label>
                        <input type="text" @bind="_newHeadersJson"
                               placeholder="{&quot;X-My-Header&quot;: &quot;value&quot;}" />
                    </div>
                    <button class="btn-primary" @onclick="AddHttpServerAsync">Add</button>
                }
            </div>
        }
    </div>
</div>

@code {
    [Inject] private IMcpServerStore ServerStore { get; set; } = default!;
    [Inject] private McpClientRegistry McpRegistry { get; set; } = default!;
    [Inject] private McpToolRegistrar McpRegistrar { get; set; } = default!;
    [Inject] private McpOAuthService OAuthService { get; set; } = default!;
    [Inject] private IMcpTrustRuleStore TrustStore { get; set; } = default!;
    [Inject] private IPrincipalAccessor Principal { get; set; } = default!;
    [Inject] private IWorkspaceService WorkspaceSvc { get; set; } = default!;
    [Inject] private IWorkspaceSettingsStore WsSettings { get; set; } = default!;

    private string _activeTab = "connected";
    private string _addMode = "json";
    private string _newName = string.Empty;
    private string _newCommand = string.Empty;
    private string _newArgs = string.Empty;
    private string _newEnvVars = string.Empty;
    private string _newUrl = string.Empty;
    private string _newBearer = string.Empty;
    private string _newHeadersJson = string.Empty;
    private string _jsonInput = string.Empty;
    private string _status = string.Empty;
    private bool _editingEnv;
    private List<EnvEditRow> _envEdits = [];
    private string _envStatus = string.Empty;
    private string _search = string.Empty;
    private List<ServerView> _servers = [];
    private List<ServerView> _filtered = [];
    private ServerView? _selected;

    // Trust rules state
    private List<McpTrustRule> _trustRules = [];
    private string? _workspaceId;
    private bool _canManageRules;
    private string _newRulePattern = string.Empty;
    private string _newRuleAction = "RequireConfirmation";
    private string _newRuleReason = string.Empty;
    private string _trustStatus = string.Empty;

    // Workspace enablement picker for the Add form
    private List<Workspace> _allWorkspaces = [];
    private HashSet<string> _addWorkspaceIds = [];

    // Gallery state
    private CatalogEntry? _catalogEntry;
    private List<CatalogEntry>? _selectedGroup;
    private int _selectedGroupTab;
    private string _galleryApiKey = string.Empty;
    private string _galleryUrl = string.Empty;
    private string _galleryClientId = string.Empty;
    private bool _isOAuthWaiting;
    private bool _isOAuthConnecting;

    private const string _jsonPlaceholder = """
{
  "mcpServers": {
    "sitecore": {
      "command": "npx",
      "args": ["-y", "@antonytm/mcp-sitecore-server@latest"],
      "env": {
        "TRANSPORT": "stdio",
        "GRAPHQL_ENDPOINT": "https://your-sitecore-cm.dev",
        "GRAPHQL_API_KEY": "your-api-key",
        "ITEM_SERVICE_SERVER_URL": "https://your-sitecore-cm.dev",
        "ITEM_SERVICE_USERNAME": "admin",
        "ITEM_SERVICE_PASSWORD": "your-password"
      }
    }
  }
}
""";

    protected override async Task OnInitializedAsync()
    {
        if (!Principal.IsAdmin)
        {
            Nav.NavigateTo("/", forceLoad: false);
            return;
        }

        var uid = Principal.UserId;
        if (uid is not null)
        {
            var ws = await WorkspaceSvc.GetPersonalAsync(uid).ConfigureAwait(false);
            _workspaceId = ws?.WorkspaceId ?? Principal.WorkspaceId;
        }
        else
        {
            _workspaceId = Principal.WorkspaceId;
        }
        _canManageRules = true; // personal workspace — user is always owner
        _allWorkspaces = (await WorkspaceSvc.ListAllAsync().ConfigureAwait(false)).ToList();
        await LoadServersAsync().ConfigureAwait(false);
    }

    private void SwitchTab(string tab)
    {
        _activeTab = tab;
        _catalogEntry = null;
        _selectedGroup = null;
        _selectedGroupTab = 0;
        _selected = null;
        _status = string.Empty;
    }

    private IEnumerable<CatalogEntry> GetGalleryCards()
    {
        var seen = new HashSet<string>(StringComparer.Ordinal);
        foreach (var entry in IntegrationCatalog.All)
        {
            var key = entry.GroupName ?? entry.Id;
            if (seen.Add(key))
                yield return entry;
        }
    }

    private List<CatalogEntry> GetGroupFor(CatalogEntry representative) =>
        representative.GroupName is { } gn
            ? IntegrationCatalog.All.Where(e => e.GroupName == gn).ToList()
            : [representative];

    private void SelectGalleryCard(CatalogEntry representative)
    {
        _selectedGroup = GetGroupFor(representative);
        _selectedGroupTab = 0;
        _catalogEntry = _selectedGroup[0];
        _galleryApiKey = string.Empty;
        _galleryUrl = string.Empty;
        _galleryClientId = string.Empty;
        _isOAuthWaiting = false;
        _status = string.Empty;
    }

    private void SelectGroupTab(int idx)
    {
        if (_selectedGroup is null || idx >= _selectedGroup.Count) return;
        _selectedGroupTab = idx;
        _catalogEntry = _selectedGroup[idx];
        _galleryApiKey = string.Empty;
        _galleryUrl = string.Empty;
        _galleryClientId = string.Empty;
    }

    private bool _isConnected(string entryId) =>
        _servers.Any(s => s.Name == entryId && s.IsConnected);

    private async Task ConnectFromGalleryAsync()
    {
        if (_catalogEntry is null || _catalogEntry.Kind == IntegrationKind.LlmProvider) return;

        var entry = _catalogEntry;
        if (entry.NeedsApiKey && string.IsNullOrWhiteSpace(_galleryApiKey))
        {
            _status = $"{entry.ApiKeyLabel} is required.";
            return;
        }
        if (entry.NeedsEndpoint && string.IsNullOrWhiteSpace(_galleryUrl))
        {
            _status = $"{entry.EndpointLabel} is required.";
            return;
        }

        try
        {
            var config = BuildConfig(entry, _galleryApiKey.Trim(), _galleryUrl.Trim());
            await ServerStore.UpsertAsync(entry.Id, config).ConfigureAwait(false);
            await ConnectAndRefreshAsync(entry.Id, config).ConfigureAwait(false);
            _activeTab = "connected";
            _selected = _servers.FirstOrDefault(s => s.Name == entry.Id);
        }
        catch (Exception ex)
        {
            _status = $"Failed: {ex.Message}";
        }
    }

    private async Task ConnectWithOAuthAsync()
    {
        if (_catalogEntry is null || _catalogEntry.Kind == IntegrationKind.LlmProvider) return;

        var entry = _catalogEntry;
        if (string.IsNullOrWhiteSpace(_galleryClientId))
        {
            _status = "OAuth Client ID is required.";
            return;
        }
        if (entry.NeedsEndpoint && string.IsNullOrWhiteSpace(_galleryUrl))
        {
            _status = $"{entry.EndpointLabel} is required.";
            return;
        }

        _isOAuthConnecting = true;
        _status = string.Empty;
        StateHasChanged();

        try
        {
            var urlStr = !string.IsNullOrEmpty(entry.EndpointTemplate) ? entry.EndpointTemplate : _galleryUrl.Trim();
            Uri.TryCreate(urlStr, UriKind.Absolute, out var url);

            var oauthConfig = new McpOAuthConfig
            {
                ClientId = _galleryClientId.Trim(),
                AuthorizationUrl = entry.OAuthAuthorizationUrl,
                TokenUrl = entry.OAuthTokenUrl,
                Scopes = (IReadOnlyList<string>?)entry.OAuthScopes ?? [],
            };

            var config = new McpServerConfig { Url = url, OAuthConfig = oauthConfig };
            await ServerStore.UpsertAsync(entry.Id, config).ConfigureAwait(false);

            var redirectUri = Nav.BaseUri.TrimEnd('/') + "/v1/mcp/auth/callback";
            var authUrl = await OAuthService.GenerateAuthorizationUrlAsync(
                entry.Id, new Uri(redirectUri)).ConfigureAwait(false);

            await JS.InvokeVoidAsync("open", authUrl, "_blank").ConfigureAwait(false);

            _isOAuthWaiting = true;
            StateHasChanged();

            // Poll until the server appears as connected (token written by callback).
            using var cts = new CancellationTokenSource(TimeSpan.FromMinutes(2));
            while (!cts.IsCancellationRequested)
            {
                await Task.Delay(2000, cts.Token).ConfigureAwait(false);
                var stored = await ServerStore.GetAsync(entry.Id).ConfigureAwait(false);
                if (stored?.Headers.ContainsKey("Authorization") == true)
                {
                    await InvokeAsync(async () =>
                    {
                        _isOAuthWaiting = false;
                        _isOAuthConnecting = false;
                        _activeTab = "connected";
                        await LoadServersAsync().ConfigureAwait(false);
                        _selected = _servers.FirstOrDefault(s => s.Name == entry.Id);
                        _status = $"Connected to '{entry.Name}' via OAuth.";
                        StateHasChanged();
                    }).ConfigureAwait(false);
                    return;
                }
            }

            _isOAuthWaiting = false;
            _status = "Authorization timed out. Please try again.";
        }
        catch (OperationCanceledException)
        {
            _isOAuthWaiting = false;
            _status = "Authorization timed out. Please try again.";
        }
        catch (Exception ex)
        {
            _isOAuthWaiting = false;
            _status = $"OAuth failed: {ex.Message}";
        }
        finally
        {
            _isOAuthConnecting = false;
            StateHasChanged();
        }
    }

    private static McpServerConfig BuildConfig(CatalogEntry entry, string apiKey, string endpoint)
    {
        if (entry.Kind == IntegrationKind.McpStdio)
        {
            var env = new Dictionary<string, string>(StringComparer.Ordinal);
            if (!string.IsNullOrEmpty(entry.ApiKeyEnvVar) && !string.IsNullOrEmpty(apiKey))
                env[entry.ApiKeyEnvVar] = apiKey;

            var args = (entry.DefaultArgs ?? (IReadOnlyList<string>)[])
                .Select(a => a
                    .Replace("{ENDPOINT}", endpoint, StringComparison.Ordinal)
                    .Replace("{API_KEY}", apiKey, StringComparison.Ordinal))
                .ToArray();

            return new McpServerConfig { Command = entry.DefaultCommand ?? string.Empty, Args = args, Env = env };
        }
        else
        {
            var headers = new Dictionary<string, string>(StringComparer.Ordinal);
            if (!string.IsNullOrEmpty(entry.ApiKeyHeader) && !string.IsNullOrEmpty(apiKey))
                headers[entry.ApiKeyHeader] = entry.ApiKeyHeader == "Authorization"
                    ? $"Bearer {apiKey}"
                    : apiKey;

            var urlStr = !string.IsNullOrEmpty(entry.EndpointTemplate)
                ? entry.EndpointTemplate.Replace("{API_KEY}", apiKey, StringComparison.Ordinal)
                : endpoint;

            Uri.TryCreate(urlStr, UriKind.Absolute, out var url);
            return new McpServerConfig { Url = url, Headers = headers };
        }
    }

    private async Task LoadServersAsync()
    {
        var servers = new List<ServerView>();
        var stored = await ServerStore.GetAllAsync().ConfigureAwait(false);

        var toolsByServer = McpRegistry.ToolToServer
            .GroupBy(kv => kv.Value, StringComparer.Ordinal)
            .ToDictionary(g => g.Key, g => g.Select(kv => kv.Key).OrderBy(n => n, StringComparer.OrdinalIgnoreCase).ToList(), StringComparer.Ordinal);

        foreach (var kv in stored)
        {
            var isConnected = McpRegistry.Clients.ContainsKey(kv.Key);
            var tools = isConnected && toolsByServer.TryGetValue(kv.Key, out var t) ? t : [];
            servers.Add(new ServerView
            {
                Name = kv.Key,
                Command = kv.Value.Command,
                Args = kv.Value.Args.ToList(),
                Url = kv.Value.Url,
                Transport = kv.Value.Url is not null ? "HTTP" : "stdio",
                IsConnected = isConnected,
                ToolCount = tools.Count,
                ToolList = tools,
                EnvVars = kv.Value.Env.ToDictionary(e => e.Key, e => e.Value),
                Headers = kv.Value.Headers.ToDictionary(e => e.Key, e => e.Value),
            });
        }
        _servers = servers;
        if (_selected is not null)
            _selected = _servers.FirstOrDefault(s => s.Name == _selected.Name);
        ApplyFilter();
    }

    private void ApplyFilter()
    {
        if (string.IsNullOrWhiteSpace(_search))
        {
            _filtered = _servers;
            return;
        }
        var s = _search.Trim();
        _filtered = _servers.Where(srv =>
            srv.Name.Contains(s, StringComparison.OrdinalIgnoreCase) ||
            srv.Transport.Contains(s, StringComparison.OrdinalIgnoreCase)
        ).ToList();
    }

    private void Select(ServerView item)
    {
        _selected = item;
        _trustRules = [];
        _trustStatus = string.Empty;
        _editingEnv = false;
        _envEdits = [];
        _envStatus = string.Empty;
        _ = LoadTrustRulesAsync(item.Name);
    }

    private async Task LoadTrustRulesAsync(string serverName)
    {
        if (_workspaceId is null) return;
        _trustRules = (await TrustStore.GetRulesAsync(_workspaceId, serverName).ConfigureAwait(false)).ToList();
        await InvokeAsync(StateHasChanged).ConfigureAwait(false);
    }

    private async Task AddTrustRuleAsync()
    {
        if (string.IsNullOrWhiteSpace(_newRulePattern) || _selected is null || _workspaceId is null)
        {
            _trustStatus = "Tool pattern is required.";
            return;
        }
        if (!Enum.TryParse<McpTrustAction>(_newRuleAction, out _))
        {
            _trustStatus = "Invalid action.";
            return;
        }
        var now = DateTimeOffset.UtcNow;
        var rule = new McpTrustRule(
            RuleId: Guid.NewGuid().ToString("N"),
            WorkspaceId: _workspaceId,
            ServerName: _selected.Name,
            ToolPattern: _newRulePattern.Trim(),
            Action: Enum.Parse<McpTrustAction>(_newRuleAction),
            Reason: string.IsNullOrWhiteSpace(_newRuleReason) ? null : _newRuleReason.Trim(),
            CreatedAt: now,
            UpdatedAt: now);
        await TrustStore.UpsertAsync(rule).ConfigureAwait(false);
        _newRulePattern = string.Empty;
        _newRuleReason = string.Empty;
        _trustStatus = "Rule added.";
        await LoadTrustRulesAsync(_selected.Name).ConfigureAwait(false);
    }

    private async Task RemoveTrustRuleAsync(string ruleId)
    {
        if (_workspaceId is null || _selected is null) return;
        await TrustStore.DeleteAsync(ruleId, _workspaceId).ConfigureAwait(false);
        _trustStatus = "Rule removed.";
        await LoadTrustRulesAsync(_selected.Name).ConfigureAwait(false);
    }

    private async Task ConnectAndRefreshAsync(string name, McpServerConfig config)
    {
        _status = $"Connecting to '{name}'…";
        StateHasChanged();
        try
        {
            await McpRegistrar.ReconnectServerAsync(name, config).ConfigureAwait(false);
            var toolCount = McpRegistry.ToolToServer.Count(kvp => kvp.Value == name);
            _status = $"Connected to '{name}' ({toolCount} tool{(toolCount == 1 ? "" : "s")}).";
        }
        catch (Exception ex)
        {
            _status = $"Failed to connect to '{name}': {ex.Message}";
        }
        await LoadServersAsync().ConfigureAwait(false);
        _selected = _servers.FirstOrDefault(s => s.Name == name);
    }

    private async Task AddStdioServerAsync()
    {
        if (string.IsNullOrWhiteSpace(_newName) || string.IsNullOrWhiteSpace(_newCommand))
        {
            _status = "Name and command are required."; return;
        }
        try
        {
            var args = string.IsNullOrWhiteSpace(_newArgs)
                ? Array.Empty<string>()
                : _newArgs.Split(' ', StringSplitOptions.RemoveEmptyEntries);

            var name = _newName.Trim();
            var config = new McpServerConfig
            {
                Command = _newCommand.Trim(),
                Args = args,
                Env = ParseEnvVarLines(_newEnvVars),
            };
            await ServerStore.UpsertAsync(name, config).ConfigureAwait(false);
            await PropagateToWorkspacesAsync([name]).ConfigureAwait(false);
            ResetForm();
            await ConnectAndRefreshAsync(name, config).ConfigureAwait(false);
        }
        catch (Exception ex) { _status = $"Failed: {ex.Message}"; }
    }

    private async Task AddHttpServerAsync()
    {
        if (string.IsNullOrWhiteSpace(_newName) || string.IsNullOrWhiteSpace(_newUrl))
        {
            _status = "Name and URL are required."; return;
        }
        if (!Uri.TryCreate(_newUrl.Trim(), UriKind.Absolute, out var url)
            || (url.Scheme != "http" && url.Scheme != "https"))
        {
            _status = "URL must be an absolute http(s) URL."; return;
        }
        try
        {
            var headers = new Dictionary<string, string>(StringComparer.Ordinal);
            if (!string.IsNullOrWhiteSpace(_newHeadersJson))
            {
                var parsed = JsonSerializer.Deserialize<Dictionary<string, string>>(_newHeadersJson);
                if (parsed is not null)
                    foreach (var kv in parsed) headers[kv.Key] = kv.Value;
            }
            if (!string.IsNullOrWhiteSpace(_newBearer))
                headers["Authorization"] = $"Bearer {_newBearer.Trim()}";

            var name = _newName.Trim();
            var config = new McpServerConfig { Url = url, Headers = headers };
            await ServerStore.UpsertAsync(name, config).ConfigureAwait(false);
            await PropagateToWorkspacesAsync([name]).ConfigureAwait(false);
            ResetForm();
            await ConnectAndRefreshAsync(name, config).ConfigureAwait(false);
        }
        catch (Exception ex) { _status = $"Failed: {ex.Message}"; }
    }

    private async Task AddFromJsonAsync()
    {
        if (string.IsNullOrWhiteSpace(_jsonInput))
        {
            _status = "Paste a JSON config first."; return;
        }
        try
        {
            var entries = McpJsonParser.Parse(_jsonInput);
            if (entries.Count == 0)
            {
                _status = "No valid mcpServers entries found."; return;
            }
            foreach (var (name, config) in entries)
                await ServerStore.UpsertAsync(name, config).ConfigureAwait(false);
            await PropagateToWorkspacesAsync(entries.Keys).ConfigureAwait(false);

            var envCount = entries.Values.Sum(c => c.Env.Count);
            var names = string.Join(", ", entries.Keys);
            _status = envCount > 0
                ? $"Imported: {names} ({envCount} env var{(envCount == 1 ? "" : "s")})."
                : $"Imported: {names}.";
            _jsonInput = string.Empty;
            foreach (var (name, config) in entries)
                await ConnectAndRefreshAsync(name, config).ConfigureAwait(false);
        }
        catch (Exception ex) { _status = $"Failed: {ex.Message}"; }
    }

    private void ResetForm()
    {
        _newName = _newCommand = _newArgs = _newEnvVars = _newUrl = _newBearer = _newHeadersJson = string.Empty;
    }

    private void ToggleAddWorkspace(string wsId, bool enabled)
    {
        if (enabled) _addWorkspaceIds.Add(wsId);
        else _addWorkspaceIds.Remove(wsId);
    }

    private async Task PropagateToWorkspacesAsync(IEnumerable<string> serverNames)
    {
        if (_addWorkspaceIds.Count == 0) return;
        foreach (var name in serverNames)
        {
            var entry = await ServerStore.GetEntryAsync(name).ConfigureAwait(false);
            if (entry is null) continue;
            foreach (var wsId in _addWorkspaceIds)
            {
                var raw = await WsSettings.GetAsync(wsId, WorkspaceSettingsKeys.EnabledMcpServerIds).ConfigureAwait(false);
                var ids = new HashSet<string>(
                    (raw ?? string.Empty).Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries),
                    StringComparer.Ordinal);
                ids.Add(entry.Id);
                await WsSettings.SetAsync(wsId, WorkspaceSettingsKeys.EnabledMcpServerIds, string.Join(',', ids)).ConfigureAwait(false);
            }
        }
        _addWorkspaceIds.Clear();
    }

    // ── Env var editor ────────────────────────────────────────────────────────

    private void StartEditEnv()
    {
        _envEdits = (_selected?.EnvVars ?? [])
            .Select(kv => new EnvEditRow { Key = kv.Key, Value = kv.Value })
            .ToList();
        _envStatus = string.Empty;
        _editingEnv = true;
    }

    private void AddEnvRow() => _envEdits.Add(new EnvEditRow());

    private void CancelEditEnv()
    {
        _editingEnv = false;
        _envEdits = [];
        _envStatus = string.Empty;
    }

    private async Task SaveEnvAsync()
    {
        if (_selected is null) return;
        try
        {
            var current = await ServerStore.GetAsync(_selected.Name).ConfigureAwait(false);
            if (current is null) { _envStatus = "Server not found."; return; }

            var newEnv = _envEdits
                .Where(r => !string.IsNullOrWhiteSpace(r.Key))
                .ToDictionary(r => r.Key.Trim(), r => r.Value, StringComparer.Ordinal);

            var updated = new McpServerConfig
            {
                Command = current.Command,
                Args = current.Args,
                Env = newEnv,
                OAuthConfig = current.OAuthConfig,
                Url = current.Url,
                Headers = current.Headers,
            };
            await ServerStore.UpsertAsync(_selected.Name, updated).ConfigureAwait(false);
            _editingEnv = false;
            _envEdits = [];
            _envStatus = $"{newEnv.Count} variable{(newEnv.Count == 1 ? "" : "s")} saved.";
            await LoadServersAsync().ConfigureAwait(false);
        }
        catch (Exception ex) { _envStatus = $"Failed: {ex.Message}"; }
    }

    private static Dictionary<string, string> ParseEnvVarLines(string text)
    {
        var result = new Dictionary<string, string>(StringComparer.Ordinal);
        if (string.IsNullOrWhiteSpace(text)) return result;
        foreach (var line in text.Split('\n', StringSplitOptions.RemoveEmptyEntries))
        {
            var trimmed = line.Trim();
            if (trimmed.Length == 0 || trimmed.StartsWith('#')) continue;
            var eq = trimmed.IndexOf('=', StringComparison.Ordinal);
            if (eq <= 0) continue;
            result[trimmed[..eq].Trim()] = trimmed[(eq + 1)..];
        }
        return result;
    }

    private sealed class EnvEditRow
    {
        public string Key { get; set; } = string.Empty;
        public string Value { get; set; } = string.Empty;
    }

    private async Task RemoveServerAsync(string name)
    {
        try
        {
            await ServerStore.DeleteAsync(name).ConfigureAwait(false);
            _selected = null;
            _status = $"Server '{name}' removed.";
            await LoadServersAsync().ConfigureAwait(false);
        }
        catch (Exception ex) { _status = $"Failed: {ex.Message}"; }
    }

    private static string MaskSecret(string key, string value)
    {
        var upper = key.ToUpperInvariant();
        if (upper.Contains("KEY") || upper.Contains("SECRET") || upper.Contains("TOKEN") || upper.Contains("AUTH"))
            return value.Length > 6 ? string.Concat(value.AsSpan(0, 4), "****") : "****";
        return value;
    }

    private sealed class ServerView
    {
        public string Name { get; init; } = string.Empty;
        public string Command { get; init; } = string.Empty;
        public List<string> Args { get; init; } = [];
        public Uri? Url { get; init; }
        public string Transport { get; init; } = "stdio";
        public bool IsConnected { get; init; }
        public int ToolCount { get; init; }
        public List<string> ToolList { get; init; } = [];
        public Dictionary<string, string> EnvVars { get; init; } = [];
        public Dictionary<string, string> Headers { get; init; } = [];
    }
