@page "/admin/system-integrations"
@using Sovrant.Api.Auth
@using Sovrant.Runtime.Config
@using Sovrant.Runtime.Mcp
@using Sovrant.Storage.Postgres
@using Sovrant.Web.Services

@inject IHttpClientFactory Http
@inject BootstrapConfig Bootstrap
@inject WebSessionService Session
@inject NavigationManager Nav

<div class="settings-page">
    <div class="diag-header">
        <h1>System Integrations</h1>
        <span class="page-subtitle">Platform-level integrations that control how Sovrant stores and manages data.</span>
    </div>

    <!-- Active backend pill -->
    <div class="sys-int-backend-pill">
        <div>
            <div class="sys-int-backend-label">ACTIVE DATABASE BACKEND</div>
            <div class="text-secondary" style="font-size:12px;margin-top:2px;">Change the backend only after initializing the schema and optionally migrating data.</div>
        </div>
        <div style="display:flex;align-items:center;gap:8px;">
            <span class="status-dot connected"></span>
            <span class="sys-int-backend-value @ActiveBackendClass">@ActiveBackendLabel</span>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(_statusMessage))
    {
        <div class="status-message">@_statusMessage</div>
    }
    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="page-error-banner" role="alert">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12" y2="17.01"/></svg>
            <span class="error-message">@_errorMessage</span>
        </div>
    }

    <!-- PostgreSQL card -->
    <div class="sys-int-card">
        <div class="sys-int-card-header">
            <div class="sys-int-card-title">
                <span class="sys-int-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.7l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.7l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.3 7 12 12 20.7 7"/><line x1="12" y1="22" x2="12" y2="12"/></svg></span>
                <span class="sys-int-name">PostgreSQL</span>
                <div class="sys-int-status-pill" style="margin-left:auto;">
                    <span class="status-dot @(_pgConnectionOk ? "connected" : "warning")"></span>
                    <span class="sys-int-status-label @(_pgConnectionOk ? "status-connected" : "status-warn")">@PgConnectionStatusLabel</span>
                </div>
            </div>
            <p class="sys-int-desc">Self-hosted PostgreSQL database for full data ownership and control.</p>
        </div>

        <div class="settings-section">
            <div class="settings-field">
                <label class="settings-label">Connection String</label>
                <input class="settings-input" type="text"
                       placeholder="Host=localhost;Database=sovrant;Username=postgres;Password=…"
                       autocomplete="off"
                       @bind="_pgConnectionUrl" />
                <span class="settings-hint">Npgsql connection string. The target database must already exist; Sovrant creates its own tables on schema init.</span>
            </div>

            <button class="btn-secondary" @onclick="TestPgConnectionAsync" disabled="@_isBusy">
                @(_pgIsTesting ? "Testing…" : "Test Connection")
            </button>
        </div>

        @if (_pgConnectionOk)
        {
            <div class="sys-int-section">
                <div class="sys-int-section-label">DATABASE SCHEMA</div>
                <p class="sys-int-section-desc">
                    Initialize the Sovrant schema in your PostgreSQL database before switching backends.
                    Safe to run multiple times (idempotent). The Supabase Auth Extension is not applied here.
                </p>
                <button class="btn-secondary" @onclick="InitializePgSchemaAsync" disabled="@_isBusy">
                    @(_pgIsInitializingSchema ? "Initializing…" : "Initialize Schema")
                </button>
            </div>

            @if (_pgSchemaReady && !_isPostgresActive)
            {
                <div class="sys-int-section">
                    <div class="sys-int-section-label">MIGRATE EXISTING DATA</div>
                    <p class="sys-int-section-desc">
                        Copy all data from the local SQLite database to PostgreSQL. The local database is kept
                        as a fallback until you explicitly switch backends.
                    </p>
                    <button class="btn-secondary" @onclick="MigratePgDataAsync" disabled="@_isBusy">
                        @(_pgIsMigrating ? "Migrating…" : "Migrate Data from SQLite")
                    </button>
                </div>
            }

            @if (_pgSchemaReady)
            {
                <div class="sys-int-section">
                    <div class="sys-int-section-label">ACTIVE BACKEND</div>
                    @if (!_isPostgresActive)
                    {
                        <button class="btn-primary" @onclick="SwitchToPostgresAsync">Switch to PostgreSQL</button>
                    }
                    else
                    {
                        <button class="btn-danger" @onclick="RevertToSqliteAsync">Revert to SQLite</button>
                        <p class="settings-hint">A restart is required for the backend switch to take effect.</p>
                    }
                </div>
            }
        }
    </div>

    <!-- Supabase card -->
    <div class="sys-int-card">
        <div class="sys-int-card-header">
            <div class="sys-int-card-title">
                <span class="sys-int-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.7l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.7l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.3 7 12 12 20.7 7"/><line x1="12" y1="22" x2="12" y2="12"/></svg></span>
                <span class="sys-int-name">Supabase</span>
                <div class="sys-int-status-pill" style="margin-left:auto;">
                    <span class="status-dot @(_connectionOk ? "connected" : "warning")"></span>
                    <span class="sys-int-status-label @(_connectionOk ? "status-connected" : "status-warn")">@ConnectionStatusLabel</span>
                </div>
            </div>
            <p class="sys-int-desc">PostgreSQL-backed storage via your Supabase project, with built-in auth and row-level security.</p>
        </div>

        <div class="settings-section">
            <div class="settings-field">
                <label class="settings-label">Project URL</label>
                <input class="settings-input" type="text"
                       placeholder="https://your-project.supabase.co"
                       autocomplete="off"
                       @bind="_projectUrl" />
            </div>
            <div class="settings-field">
                <label class="settings-label">Service Role Key</label>
                <input class="settings-input" type="password"
                       placeholder="eyJ…"
                       autocomplete="new-password"
                       @bind="_serviceRoleKey" />
                <span class="settings-hint">Found in Supabase → Project Settings → API → service_role key.</span>
            </div>

            <button class="btn-secondary" @onclick="TestConnectionAsync" disabled="@_isBusy">
                @(_isTesting ? "Testing…" : "Test Connection")
            </button>
        </div>

        @if (_connectionOk)
        {
            <div class="sys-int-section">
                <div class="sys-int-section-label">DATABASE SCHEMA</div>
                <p class="sys-int-section-desc">
                    Initialize the Sovrant schema in your Supabase project before switching backends.
                    Safe to run multiple times (idempotent).
                </p>
                <button class="btn-secondary" @onclick="InitializeSchemaAsync" disabled="@_isBusy">
                    @(_isInitializingSchema ? "Initializing…" : "Initialize Schema")
                </button>
            </div>

            @if (_schemaReady && !_isSupabaseActive)
            {
                <div class="sys-int-section">
                    <div class="sys-int-section-label">MIGRATE EXISTING DATA</div>
                    <p class="sys-int-section-desc">
                        Copy all data from the local SQLite database to Supabase. The local database is kept
                        as a fallback until you explicitly switch backends.
                    </p>
                    <button class="btn-secondary" @onclick="MigrateDataAsync" disabled="@_isBusy">
                        @(_isMigrating ? "Migrating…" : "Migrate Data from SQLite")
                    </button>
                </div>
            }

            @if (_schemaReady)
            {
                <div class="sys-int-section">
                    <div class="sys-int-section-label">ACTIVE BACKEND</div>
                    @if (!_isSupabaseActive)
                    {
                        <button class="btn-primary" @onclick="SwitchBackendAsync">Switch to Supabase</button>
                    }
                    else
                    {
                        <button class="btn-danger" @onclick="RevertToSqliteAsync">Revert to SQLite</button>
                        <p class="settings-hint">A restart is required for the backend switch to take effect.</p>
                    }
                </div>
            }
        }
    </div>
</div>

@code {
    private ICredentialStore? _bootstrapStore;

    // ── Supabase state ──────────────────────────────────────────────────────
    private string _projectUrl = string.Empty;
    private string _serviceRoleKey = string.Empty;
    private bool _connectionOk;
    private bool _schemaReady;
    private bool _isSupabaseActive;
    private bool _isTesting;
    private bool _isInitializingSchema;
    private bool _isMigrating;

    // ── Postgres state ──────────────────────────────────────────────────────
    private string _pgConnectionUrl = string.Empty;
    private bool _pgConnectionOk;
    private bool _pgSchemaReady;
    private bool _isPostgresActive;
    private bool _pgIsTesting;
    private bool _pgIsInitializingSchema;
    private bool _pgIsMigrating;

    // ── Shared ──────────────────────────────────────────────────────────────
    private string _statusMessage = string.Empty;
    private string _errorMessage = string.Empty;

    private bool _isBusy => _isTesting || _isInitializingSchema || _isMigrating
                         || _pgIsTesting || _pgIsInitializingSchema || _pgIsMigrating;

    private string ConnectionStatusLabel   => _connectionOk ? "Connected" : (_isTesting ? "Testing…" : "Not configured");
    private string PgConnectionStatusLabel => _pgConnectionOk ? "Connected" : (_pgIsTesting ? "Testing…" : "Not configured");
    private string ActiveBackendLabel      => _isSupabaseActive ? "Supabase (PostgreSQL)" : _isPostgresActive ? "PostgreSQL (standalone)" : "SQLite (local)";
    private string ActiveBackendClass      => _isSupabaseActive ? "active-supabase" : _isPostgresActive ? "active-postgres" : "active-sqlite";

    protected override async Task OnInitializedAsync()
    {
        if (!Session.IsAdmin) { Nav.NavigateTo("/", forceLoad: false); return; }

        _bootstrapStore  = Sovrant.Runtime.ServiceCollectionExtensions.CreateBootstrapCredentialStore(Bootstrap);
        _projectUrl      = await _bootstrapStore.RetrieveAsync(CredentialKeys.SupabaseProjectUrl) ?? string.Empty;
        _serviceRoleKey  = await _bootstrapStore.RetrieveAsync(CredentialKeys.SupabaseServiceRoleKey) ?? string.Empty;
        _pgConnectionUrl = await _bootstrapStore.RetrieveAsync(CredentialKeys.PostgresConnectionUrl) ?? string.Empty;
        var backend      = await _bootstrapStore.RetrieveAsync(CredentialKeys.DatabaseBackend) ?? "sqlite";
        _isSupabaseActive = backend == "supabase";
        _isPostgresActive = backend == "postgres";

        if (!string.IsNullOrEmpty(_projectUrl) && !string.IsNullOrEmpty(_serviceRoleKey))
        {
            _connectionOk = true;
            await CheckSchemaVersionAsync();
        }

        if (!string.IsNullOrEmpty(_pgConnectionUrl))
        {
            _pgConnectionOk = true;
            await CheckPgSchemaVersionAsync();
        }
    }

    // ── PostgreSQL methods ──────────────────────────────────────────────────

    private async Task TestPgConnectionAsync()
    {
        _statusMessage = string.Empty;
        _errorMessage  = string.Empty;

        if (string.IsNullOrWhiteSpace(_pgConnectionUrl))
        {
            _errorMessage = "Enter a connection string first.";
            return;
        }

        _pgIsTesting = true;
        try
        {
            var ok = await ServiceCollectionExtensions.CanConnectAsync(_pgConnectionUrl);
            if (ok)
            {
                _pgConnectionOk = true;
                _statusMessage = "Connection successful.";
                await _bootstrapStore!.StoreAsync(CredentialKeys.PostgresConnectionUrl, _pgConnectionUrl);
                await CheckPgSchemaVersionAsync();
            }
            else
            {
                _pgConnectionOk = false;
                _errorMessage = "Connection failed. Check the connection string and ensure PostgreSQL is running.";
            }
        }
        catch (Exception ex)
        {
            _pgConnectionOk = false;
            _errorMessage = $"Connection failed: {ex.Message}";
        }
        finally { _pgIsTesting = false; }
    }

    private async Task InitializePgSchemaAsync()
    {
        _statusMessage = string.Empty;
        _errorMessage  = string.Empty;
        _pgIsInitializingSchema = true;
        try
        {
            await ServiceCollectionExtensions.InitializeBaseSchemaAsync(_pgConnectionUrl);
            await CheckPgSchemaVersionAsync();
            _statusMessage = "Schema initialized successfully.";
        }
        catch (Exception ex)
        {
            _errorMessage = $"Schema initialization failed: {ex.Message}";
        }
        finally { _pgIsInitializingSchema = false; }
    }

    private async Task MigratePgDataAsync()
    {
        _statusMessage = string.Empty;
        _errorMessage  = string.Empty;
        _pgIsMigrating = true;
        try
        {
            var home       = Environment.GetFolderPath(Environment.SpecialFolder.UserProfile);
            var sqlitePath = Bootstrap.DbPath ?? Path.Combine(home, ".sovrant", "data", "sovrant.db");

            if (!File.Exists(sqlitePath))
            {
                _errorMessage = $"SQLite database not found at {sqlitePath}.";
                return;
            }

            var factory  = ServiceCollectionExtensions.CreateConnectionFactory(_pgConnectionUrl);
            var migrator = new SqliteToPostgresMigrator(factory, sqlitePath);

            MigrationResult? result = null;
            var prog = new Progress<MigrationProgress>(p =>
            {
                _statusMessage = string.IsNullOrEmpty(p.Message)
                    ? $"{p.Stage}: {p.Done}/{p.Total}"
                    : p.Message;
                InvokeAsync(StateHasChanged);
            });

            result = await migrator.MigrateAsync(prog);
            _statusMessage = $"Migration complete — {result.SessionsCopied} sessions, " +
                             $"{result.EntriesCopied} entries, {result.CredentialsCopied} credentials copied.";
        }
        catch (Exception ex)
        {
            _errorMessage = $"Migration failed: {ex.Message}";
        }
        finally { _pgIsMigrating = false; }
    }

    private async Task SwitchToPostgresAsync()
    {
        await _bootstrapStore!.StoreAsync(CredentialKeys.DatabaseBackend, "postgres");
        _isPostgresActive = true;
        _isSupabaseActive = false;
        _statusMessage = "Switched to PostgreSQL. Restart Sovrant for the change to take effect.";
    }

    private async Task CheckPgSchemaVersionAsync()
    {
        try
        {
            var initializer = ServiceCollectionExtensions.CreateSchemaInitializer(_pgConnectionUrl);
            var version     = await initializer.GetSchemaVersionAsync();
            _pgSchemaReady  = version.HasValue;
        }
        catch
        {
            _pgSchemaReady = false;
        }
    }

    // ── Supabase methods ────────────────────────────────────────────────────

    private async Task TestConnectionAsync()
    {
        _statusMessage = string.Empty;
        _errorMessage  = string.Empty;

        if (string.IsNullOrWhiteSpace(_projectUrl) || string.IsNullOrWhiteSpace(_serviceRoleKey))
        {
            _errorMessage = "Enter a Project URL and Service Role Key first.";
            return;
        }

        _isTesting = true;
        try
        {
            var url = _projectUrl.TrimEnd('/') + "/rest/v1/";
            using var client = Http.CreateClient();
            client.DefaultRequestHeaders.Add("apikey", _serviceRoleKey);
            client.DefaultRequestHeaders.Add("Authorization", $"Bearer {_serviceRoleKey}");
            client.Timeout = TimeSpan.FromSeconds(10);

            var response = await client.GetAsync(url);
            if ((int)response.StatusCode != 401)
            {
                _connectionOk = true;
                _statusMessage = "Connection successful.";
                await _bootstrapStore!.StoreAsync(CredentialKeys.SupabaseProjectUrl, _projectUrl);
                await _bootstrapStore!.StoreAsync(CredentialKeys.SupabaseServiceRoleKey, _serviceRoleKey);
                await CheckSchemaVersionAsync();
            }
            else
            {
                _connectionOk = false;
                _errorMessage = "Connection failed: invalid key (HTTP 401).";
            }
        }
        catch (Exception ex)
        {
            _connectionOk = false;
            _errorMessage = $"Connection failed: {ex.Message}";
        }
        finally { _isTesting = false; }
    }

    private async Task InitializeSchemaAsync()
    {
        _statusMessage = string.Empty;
        _errorMessage  = string.Empty;
        _isInitializingSchema = true;
        try
        {
            var connStr     = ServiceCollectionExtensions.BuildSupabaseConnectionString(_projectUrl, _serviceRoleKey);
            var initializer = ServiceCollectionExtensions.CreateSchemaInitializer(connStr);
            await initializer.InitializeAsync();
            await CheckSchemaVersionAsync();
            _statusMessage = "Schema initialized successfully.";
        }
        catch (Exception ex)
        {
            _errorMessage = $"Schema initialization failed: {ex.Message}";
        }
        finally { _isInitializingSchema = false; }
    }

    private async Task MigrateDataAsync()
    {
        _statusMessage = string.Empty;
        _errorMessage  = string.Empty;
        _isMigrating   = true;
        try
        {
            var home       = Environment.GetFolderPath(Environment.SpecialFolder.UserProfile);
            var sqlitePath = Bootstrap.DbPath ?? Path.Combine(home, ".sovrant", "data", "sovrant.db");

            if (!File.Exists(sqlitePath))
            {
                _errorMessage = $"SQLite database not found at {sqlitePath}.";
                return;
            }

            var connStr  = ServiceCollectionExtensions.BuildSupabaseConnectionString(_projectUrl, _serviceRoleKey);
            var factory  = ServiceCollectionExtensions.CreateConnectionFactory(connStr);
            var migrator = new SqliteToPostgresMigrator(factory, sqlitePath);

            MigrationResult? result = null;
            var prog = new Progress<MigrationProgress>(p =>
            {
                _statusMessage = string.IsNullOrEmpty(p.Message)
                    ? $"{p.Stage}: {p.Done}/{p.Total}"
                    : p.Message;
                InvokeAsync(StateHasChanged);
            });

            result = await migrator.MigrateAsync(prog);
            _statusMessage = $"Migration complete — {result.SessionsCopied} sessions, " +
                             $"{result.EntriesCopied} entries, {result.CredentialsCopied} credentials copied.";
        }
        catch (Exception ex)
        {
            _errorMessage = $"Migration failed: {ex.Message}";
        }
        finally { _isMigrating = false; }
    }

    private async Task SwitchBackendAsync()
    {
        await _bootstrapStore!.StoreAsync(CredentialKeys.DatabaseBackend, "supabase");
        _isSupabaseActive = true;
        _isPostgresActive = false;
        _statusMessage = "Switched to Supabase. Restart Sovrant for the change to take effect.";
    }

    private async Task RevertToSqliteAsync()
    {
        await _bootstrapStore!.StoreAsync(CredentialKeys.DatabaseBackend, "sqlite");
        _isSupabaseActive = false;
        _isPostgresActive = false;
        _statusMessage = "Reverted to SQLite. Restart Sovrant for the change to take effect.";
    }

    private async Task CheckSchemaVersionAsync()
    {
        try
        {
            var connStr     = ServiceCollectionExtensions.BuildSupabaseConnectionString(_projectUrl, _serviceRoleKey);
            var initializer = ServiceCollectionExtensions.CreateSchemaInitializer(connStr);
            var version     = await initializer.GetSchemaVersionAsync();
            _schemaReady    = version.HasValue;
        }
        catch
        {
            _schemaReady = false;
        }
    }
}
