@page "/documents"
@using System.Globalization
@using System.Text
@using System.Text.Json
@using Sovrant.Runtime.Artifacts
@using Sovrant.Runtime.Documents
@using Sovrant.Runtime.Documents.Templates
@using Sovrant.Runtime.Knowledge
@using Sovrant.Runtime.Workspaces
@using Sovrant.Web.Services
@using SovrantDocumentFormat = Sovrant.Runtime.Documents.DocumentFormat

@if (_editing is not null)
{
    <div class="detail-content" style="padding:0; height:100%;">
        <MarkdownEditor Value="@_editing.Source"
                        Title="@_editing.Slug"
                        ReadOnly="false"
                        OnSave="HandleSaveAsync"
                        OnCancel="@(() => { CancelEdit(); return Task.CompletedTask; })" />
        @if (!string.IsNullOrEmpty(_editError))
        {
            <div class="text-danger" style="padding:8px 16px; white-space:pre-wrap;">@_editError</div>
        }
    </div>
}
else
{
<MasterDetailLayout TItem="TemplateItem"
                    Title="Documents"
                    ItemCount="@_filtered.Count"
                    Items="@_filtered"
                    SelectedItem="@_selected"
                    EmptyMessage="No templates registered."
                    OnRefresh="Load"
                    OnItemSelected="SelectItem"
                    OnSearch="Search">
    <FooterTemplate>
        <a class="btn-outline btn-sm" href="/documents/templates">User templates →</a>
    </FooterTemplate>
    <ItemTemplate>
        <div class="item-title">@context.Name</div>
        <div class="item-subtitle">@context.Industry &middot; @FormatName(context.DefaultFormat)</div>
    </ItemTemplate>
    <DetailTemplate>
        <div class="detail-content">
            <div style="display:flex; justify-content:space-between; align-items:center; gap:12px; margin-bottom:4px;">
                <h2 style="margin:0;">@context.Name</h2>
                @if (Session.IsAdmin)
                {
                    <div style="display:flex;gap:8px;">
                        <button class="btn-outline btn-sm" @onclick="@(() => StartEditAsync(context))">Edit</button>
                        @if (context.HasUserOverride)
                        {
                            <button class="btn-outline btn-sm" style="color:var(--color-danger,#ef4444);" @onclick="@(() => RevertAsync(context))">Revert</button>
                        }
                    </div>
                }
            </div>
            <div class="detail-meta">
                <span><code>@context.Id</code></span>
                <span>@context.Industry</span>
                <span>Default format: @FormatName(context.DefaultFormat)</span>
            </div>
            @if (!string.IsNullOrEmpty(context.Description))
            {
                <p class="text-secondary">@context.Description</p>
            }

            <!-- Primary action: chat to create -->
            <button class="btn-primary doc-chat-btn"
                    @onclick="() => ChatToCreate(context)">
                💬 Chat to create this document
            </button>
            <p class="text-muted text-sm" style="margin:4px 0 16px;">
                The AI will ask for the information it needs and generate the document for you.
            </p>

            <!-- Advanced: fill manually with JSON -->
            <details class="doc-advanced">
                <summary class="doc-advanced-toggle">Advanced: fill manually with JSON</summary>
                <div style="margin-top:12px;">
                    <div class="render-controls" style="display:flex; gap:12px; align-items:center; margin-bottom:8px;">
                        <label>Format:
                            <select @bind="_formatChoice">
                                <option value="">(default: @FormatName(context.DefaultFormat))</option>
                                <option value="markdown">Markdown</option>
                                <option value="pdf">PDF</option>
                                <option value="structured_pdf">Structured PDF</option>
                                <option value="word">Word</option>
                                <option value="excel">Excel</option>
                                <option value="powerpoint">PowerPoint</option>
                            </select>
                        </label>
                        <button class="btn-secondary btn-sm" @onclick="RenderAsync" disabled="@_busy">
                            @(_busy ? "Generating..." : "Generate")
                        </button>
                    </div>
                    <MarkdownEditor @bind-Value="_jsonInput"
                                    Language="json"
                                    RequireFrontmatter="false"
                                    MinHeight="220px" />

                    @if (!string.IsNullOrEmpty(_error))
                    {
                        <div class="text-danger" style="margin-top:8px; white-space:pre-wrap;">@_error</div>
                    }

                    @if (_lastResult is not null)
                    {
                        <div class="render-result" style="margin-top:12px; padding:12px; border:1px solid var(--border,#333); border-radius:6px;">
                            <div><strong>Generated:</strong> <code>@_lastResult.RelativePath</code></div>
                            <div>@_lastResult.SizeBytes bytes &middot; @_lastResult.ContentType</div>
                            @if (_lastResult.AccessUrl is not null)
                            {
                                <div style="margin-top:8px;">
                                    <a class="btn-outline btn-sm" href="@_lastResult.AccessUrl" target="_blank">Open artifact</a>
                                </div>
                            }
                        </div>
                    }
                </div>
            </details>

            <h3 style="margin-top:20px;">Fields</h3>
            @if (context.Fields.Count > 0)
            {
                <table class="provider-table">
                    <thead>
                        <tr><th>Name</th><th>Type</th><th>Required</th><th>Description</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var f in context.Fields)
                        {
                            <tr>
                                <td><code>@f.Name</code></td>
                                <td>@FieldTypeName(f.Type)</td>
                                <td>@(f.Required ? "Yes" : "")</td>
                                <td>@(f.Description ?? string.Empty)</td>
                            </tr>
                            @if (f.ItemFields is { Count: > 0 })
                            {
                                @foreach (var nf in f.ItemFields)
                                {
                                    <tr>
                                        <td style="padding-left:24px;"><code>@nf.Name</code></td>
                                        <td>@FieldTypeName(nf.Type)</td>
                                        <td>@(nf.Required ? "Yes" : "")</td>
                                        <td>@(nf.Description ?? string.Empty)</td>
                                    </tr>
                                }
                            }
                        }
                    </tbody>
                </table>
            }
        </div>
    </DetailTemplate>
</MasterDetailLayout>
}

@code {
    [Inject] private ITemplateRegistry Registry { get; set; } = default!;
    [Inject] private IDocumentGeneratorRegistry Generators { get; set; } = default!;
    [Inject] private IKnowledgeStore Store { get; set; } = default!;
    [Inject] private ActiveContextService ActiveContext { get; set; } = default!;
    [Inject] private NavigationManager Nav { get; set; } = default!;
    [Inject] private ChatSeedService ChatSeed { get; set; } = default!;
    [Inject] private WebSessionService Session { get; set; } = default!;

    private List<TemplateItem> _all = [];
    private List<TemplateItem> _filtered = [];
    private TemplateItem? _selected;
    private string _search = string.Empty;

    private string _jsonInput = string.Empty;
    private string _formatChoice = string.Empty;
    private DocumentResult? _lastResult;
    private string _error = string.Empty;
    private bool _busy;

    private EditorState? _editing;
    private string _editError = string.Empty;
    private string? _carriedFieldsJson;

    protected override void OnInitialized() => Load();

    private void Load()
    {
        HashSet<string> overrideSlugs;
        try
        {
            var overlays = Store.GetAllAsync("document-templates", KnowledgeScope.Global)
                                .GetAwaiter().GetResult();
            overrideSlugs = new HashSet<string>(overlays.Select(o => o.Slug), StringComparer.OrdinalIgnoreCase);
        }
        catch
        {
            overrideSlugs = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        }

        _all = Registry.All
            .OrderBy(t => t.Industry, StringComparer.OrdinalIgnoreCase)
            .ThenBy(t => t.Id, StringComparer.OrdinalIgnoreCase)
            .Select(t => new TemplateItem
            {
                Id = t.Id,
                Name = t.Name,
                Industry = t.Industry,
                Description = t.Description,
                DefaultFormat = t.DefaultFormat,
                Fields = t.Fields,
                HasUserOverride = overrideSlugs.Contains(t.Id),
            })
            .ToList();
        ApplyFilter();
    }

    private async Task StartEditAsync(TemplateItem item)
    {
        if (!Session.IsAdmin) return;
        var page = await Store.GetEffectiveAsync("document-templates", item.Id);
        if (page is null) return;
        _carriedFieldsJson = page.FieldsJson;
        _editError = string.Empty;
        _editing = new EditorState { Slug = item.Id, Source = ReconstructTemplateMarkdown(page) };
    }

    private async Task HandleSaveAsync(string markdown)
    {
        if (_editing is null || !Session.IsAdmin) return;
        var slug = _editing.Slug;
        var (name, description, industry, defaultFormat, filenameTemplate, body) = ParseTemplateMarkdown(markdown);
        var now = DateTimeOffset.UtcNow;
        try
        {
            await Store.UpsertAsync(new KnowledgePage(
                KnowledgeId:      $"doctpl_global_{slug}",
                Kind:             "document-templates",
                Slug:             slug,
                Name:             string.IsNullOrWhiteSpace(name) ? slug : name,
                Description:      description,
                Tier:             "User",
                Body:             body,
                WorkspaceId:      KnowledgeScope.Global,
                CreatedAt:        now,
                UpdatedAt:        now,
                Industry:         industry,
                DefaultFormat:    defaultFormat,
                FieldsJson:       _carriedFieldsJson,
                FilenameTemplate: string.IsNullOrWhiteSpace(filenameTemplate) ? null : filenameTemplate));

            Registry.Reload();
            CancelEdit();
            Load();
        }
        catch (Exception ex)
        {
            _editError = $"Failed to save: {ex.Message}";
        }
    }

    private async Task RevertAsync(TemplateItem item)
    {
        if (!Session.IsAdmin) return;
        await Store.DeleteAsync("document-templates", item.Id, KnowledgeScope.Global);
        Registry.Reload();
        Load();
    }

    private void CancelEdit()
    {
        _editing = null;
        _editError = string.Empty;
        _carriedFieldsJson = null;
    }

    private void ChatToCreate(TemplateItem template)
    {
        ChatSeed.Set($"I'd like to create a {template.Name} document. Please help me fill in the required information.");
        Nav.NavigateTo("/chat");
    }

    private Task SelectItem(TemplateItem item)
    {
        _selected = item;
        _jsonInput = string.Empty;
        _formatChoice = string.Empty;
        _lastResult = null;
        _error = string.Empty;
        return Task.CompletedTask;
    }

    private void Search(string text) { _search = text; ApplyFilter(); }

    private void ApplyFilter()
    {
        _filtered = string.IsNullOrWhiteSpace(_search)
            ? _all
            : _all.Where(t =>
                t.Id.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
                t.Name.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
                t.Industry.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
                (t.Description ?? string.Empty).Contains(_search, StringComparison.OrdinalIgnoreCase)
            ).ToList();
    }

    private async Task RenderAsync()
    {
        if (_selected is null) return;
        _error = string.Empty;
        _lastResult = null;
        _busy = true;
        try
        {
            if (!Registry.TryResolve(_selected.Id, out var template) || template is null)
            {
                _error = $"Template not found: {_selected.Id}";
                return;
            }

            JsonDocument data;
            try
            {
                data = JsonDocument.Parse(string.IsNullOrWhiteSpace(_jsonInput) ? "{}" : _jsonInput);
            }
            catch (JsonException ex)
            {
                _error = $"Invalid JSON: {ex.Message}";
                return;
            }

            TemplateRenderResult rendered;
            try
            {
                rendered = template.Render(data.RootElement);
            }
            catch (TemplateValidationException ex)
            {
                _error = ex.Message;
                return;
            }
            finally
            {
                data.Dispose();
            }

            var format = rendered.Format;
            if (!string.IsNullOrWhiteSpace(_formatChoice) && TryParseFormat(_formatChoice, out var overridden))
                format = overridden;

            var workspaceId = string.IsNullOrWhiteSpace(ActiveContext.WorkspaceId)
                ? WorkspaceIdentity.DefaultPersonal() : ActiveContext.WorkspaceId;
            var projectId = string.IsNullOrWhiteSpace(ActiveContext.ProjectId)
                ? ArtifactScope.DefaultProjectId : ActiveContext.ProjectId;

            var scope = new ArtifactScope
            {
                WorkspaceId = workspaceId,
                ProjectId = projectId,
                RunId = $"web-{DateTime.UtcNow:yyyyMMddHHmmss}-{Guid.NewGuid():N}".Substring(0, 40),
            };

            var request = new DocumentRequest
            {
                Format = format,
                Body = rendered.Body,
                Title = rendered.Title ?? template.Name,
                FileName = rendered.DefaultFileName,
                Scope = scope,
            };

            var generator = Generators.Resolve(format);
            _lastResult = await generator.GenerateAsync(request, CancellationToken.None);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private static string ReconstructTemplateMarkdown(KnowledgePage p)
    {
        var ic = CultureInfo.InvariantCulture;
        var sb = new StringBuilder();
        sb.AppendLine("---");
        sb.AppendLine(string.Create(ic, $"name: {p.Name}"));
        if (!string.IsNullOrWhiteSpace(p.Description))
            sb.AppendLine(string.Create(ic, $"description: {p.Description}"));
        if (!string.IsNullOrWhiteSpace(p.Industry))
            sb.AppendLine(string.Create(ic, $"industry: {p.Industry}"));
        if (!string.IsNullOrWhiteSpace(p.DefaultFormat))
            sb.AppendLine(string.Create(ic, $"default_format: {p.DefaultFormat}"));
        if (!string.IsNullOrWhiteSpace(p.FilenameTemplate))
            sb.AppendLine(string.Create(ic, $"filename_template: {p.FilenameTemplate}"));
        sb.AppendLine("---");
        sb.AppendLine();
        sb.Append(p.Body);
        return sb.ToString();
    }

    private static (string Name, string Description, string Industry, string DefaultFormat, string FilenameTemplate, string Body)
        ParseTemplateMarkdown(string markdown)
    {
        var meta = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
        var body = markdown;

        if (markdown.StartsWith("---", StringComparison.Ordinal))
        {
            var end = markdown.IndexOf("\n---", 3, StringComparison.Ordinal);
            if (end >= 0)
            {
                var fm = markdown.Substring(3, end - 3);
                body = markdown[(end + 4)..].TrimStart('\r', '\n');
                foreach (var line in fm.Split('\n'))
                {
                    var colon = line.IndexOf(':', StringComparison.Ordinal);
                    if (colon < 0) continue;
                    meta[line[..colon].Trim()] = line[(colon + 1)..].Trim();
                }
            }
        }

        meta.TryGetValue("name", out var name);
        meta.TryGetValue("description", out var description);
        meta.TryGetValue("industry", out var industry);
        meta.TryGetValue("default_format", out var defaultFormat);
        meta.TryGetValue("filename_template", out var filenameTemplate);

        return (name?.Trim() ?? string.Empty,
                description?.Trim() ?? string.Empty,
                string.IsNullOrWhiteSpace(industry) ? "general" : industry.Trim(),
                string.IsNullOrWhiteSpace(defaultFormat) ? "markdown" : defaultFormat.Trim(),
                filenameTemplate?.Trim() ?? string.Empty,
                body);
    }

    private static string FormatName(SovrantDocumentFormat format) => format switch
    {
        SovrantDocumentFormat.Markdown => "Markdown",
        SovrantDocumentFormat.Pdf => "PDF",
        SovrantDocumentFormat.StructuredPdf => "Structured PDF",
        SovrantDocumentFormat.Word => "Word",
        SovrantDocumentFormat.Excel => "Excel",
        SovrantDocumentFormat.PowerPoint => "PowerPoint",
        _ => format.ToString(),
    };

    private static string FieldTypeName(TemplateFieldType type) => type switch
    {
        TemplateFieldType.String => "string",
        TemplateFieldType.Text => "text",
        TemplateFieldType.Integer => "integer",
        TemplateFieldType.Decimal => "decimal",
        TemplateFieldType.Currency => "currency",
        TemplateFieldType.Date => "date",
        TemplateFieldType.Boolean => "boolean",
        TemplateFieldType.StringArray => "string[]",
        TemplateFieldType.ObjectArray => "object[]",
        _ => type.ToString(),
    };

    private static bool TryParseFormat(string raw, out SovrantDocumentFormat format)
    {
        switch (raw.Trim().ToUpperInvariant())
        {
            case "MARKDOWN":
            case "MD":
                format = SovrantDocumentFormat.Markdown; return true;
            case "PDF":
                format = SovrantDocumentFormat.Pdf; return true;
            case "STRUCTURED_PDF":
            case "SPDF":
                format = SovrantDocumentFormat.StructuredPdf; return true;
            case "WORD":
            case "DOCX":
                format = SovrantDocumentFormat.Word; return true;
            case "EXCEL":
            case "XLSX":
                format = SovrantDocumentFormat.Excel; return true;
            case "POWERPOINT":
            case "PPTX":
                format = SovrantDocumentFormat.PowerPoint; return true;
            default:
                format = default;
                return false;
        }
    }

    private sealed class TemplateItem
    {
        public string Id { get; init; } = string.Empty;
        public string Name { get; init; } = string.Empty;
        public string Industry { get; init; } = string.Empty;
        public string? Description { get; init; }
        public SovrantDocumentFormat DefaultFormat { get; init; }
        public IReadOnlyList<TemplateField> Fields { get; init; } = Array.Empty<TemplateField>();
        public bool HasUserOverride { get; init; }
    }

    private sealed class EditorState
    {
        public string Slug { get; init; } = string.Empty;
        public string Source { get; init; } = string.Empty;
    }
}
