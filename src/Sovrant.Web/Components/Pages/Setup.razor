@page "/setup"
@using Sovrant.Runtime.Config
@using Sovrant.Web.Adapters
@using System.Text.Json
@using System.Text.Json.Serialization

<div class="setup-backdrop">
    <div class="setup-card">
        <div class="setup-icon">&#9889;</div>
        <h1>Welcome to Sovrant</h1>
        <p class="text-secondary">Connect a provider to get started. You can switch models anytime from the sidebar.</p>

        <form autocomplete="off" @onsubmit:preventDefault>
        <div class="form-field">
            <label>Provider</label>
            <select @bind="_provider" @bind:after="OnProviderChanged">
                @foreach (var p in Providers)
                {
                    <option value="@p">@p</option>
                }
            </select>
        </div>

        <div class="form-field">
            <label>API Key</label>
            <input type="password" @bind="_apiKey" placeholder="sk-..." autocomplete="off" data-lpignore="true" data-1p-ignore />
        </div>

        <div class="form-field">
            <label>Base URL</label>
            <input type="text" @bind="_baseUrl" placeholder="Auto-filled from provider" />
            <span class="text-muted text-sm">Auto-filled when you select a provider. Edit for custom endpoints.</span>
        </div>

        <button class="btn-primary" @onclick="SaveAsync" disabled="@_saving">
            @(_saving ? "Saving..." : "Get Started")
        </button>
        </form>

        @if (!string.IsNullOrEmpty(_status))
        {
            <div class="status-message" style="margin-top:12px;">@_status</div>
        }
    </div>
</div>

@code {
    [Inject] private NavigationManager Nav { get; set; } = default!;
    [Inject] private SovrantConfig Config { get; set; } = default!;
    [Inject] private MutableAuthProvider AuthProvider { get; set; } = default!;

    private string _provider = "OpenAI";
    private string _apiKey = string.Empty;
    private string _baseUrl = "https://api.openai.com/v1";
    private string _status = string.Empty;
    private bool _saving;

    private static readonly string SettingsPath = Path.Combine(
        Environment.GetFolderPath(Environment.SpecialFolder.UserProfile), ".sovrant", "settings.json");
    private static readonly string ProfilesPath = Path.Combine(
        Environment.GetFolderPath(Environment.SpecialFolder.UserProfile), ".sovrant", "providers.json");

    private static readonly JsonSerializerOptions JsonOpts = new()
    {
        WriteIndented = true,
        DefaultIgnoreCondition = JsonIgnoreCondition.WhenWritingNull,
    };

    private static readonly string[] Providers =
        ["OpenAI", "OpenRouter", "DeepSeek", "Groq", "Mistral", "Together AI", "Google", "Azure OpenAI", "Ollama", "LM Studio", "Custom"];

    private static readonly Dictionary<string, string> ProviderBaseUrls = new(StringComparer.Ordinal)
    {
        ["OpenAI"] = "https://api.openai.com/v1",
        ["OpenRouter"] = "https://openrouter.ai/api/v1",
        ["DeepSeek"] = "https://api.deepseek.com/v1",
        ["Groq"] = "https://api.groq.com/openai/v1",
        ["Mistral"] = "https://api.mistral.ai/v1",
        ["Together AI"] = "https://api.together.xyz/v1",
        ["Ollama"] = "http://localhost:11434/v1",
        ["LM Studio"] = "http://localhost:1234/v1",
        ["Google"] = "https://generativelanguage.googleapis.com/v1beta/openai",
        ["Azure OpenAI"] = "",
        ["Custom"] = "",
    };

    // Default model per provider — used as initial model when none is configured yet.
    private static readonly Dictionary<string, string> DefaultModels = new(StringComparer.Ordinal)
    {
        ["OpenAI"] = "gpt-4o",
        ["OpenRouter"] = "google/gemma-4-27b-it:free",
        ["DeepSeek"] = "deepseek-chat",
        ["Groq"] = "llama-3.3-70b-versatile",
        ["Mistral"] = "mistral-large-latest",
        ["Together AI"] = "meta-llama/Llama-3.3-70B-Instruct-Turbo",
        ["Google"] = "gemini-2.5-flash",
        ["Azure OpenAI"] = "gpt-4o",
    };

    protected override void OnInitialized()
    {
        if (!string.IsNullOrWhiteSpace(Config.ApiKey))
        {
            Nav.NavigateTo("/");
            return;
        }
    }

    private void OnProviderChanged()
    {
        if (ProviderBaseUrls.TryGetValue(_provider, out var url))
            _baseUrl = url;
    }

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(_apiKey)) { _status = "API key is required."; return; }
        _saving = true;
        _status = string.Empty;
        try
        {
            var dir = Path.GetDirectoryName(SettingsPath)!;
            Directory.CreateDirectory(dir);

            // Pick a sensible default model for the provider.
            var defaultModel = DefaultModels.GetValueOrDefault(_provider, "gpt-4o");

            // Save to settings.json
            Dictionary<string, object?> existing = [];
            if (File.Exists(SettingsPath))
                existing = JsonSerializer.Deserialize<Dictionary<string, object?>>(await File.ReadAllTextAsync(SettingsPath)) ?? [];

            existing["Provider"] = _provider;
            existing["Model"] = defaultModel;
            existing["ApiKey"] = _apiKey.Trim();
            if (!string.IsNullOrWhiteSpace(_baseUrl)) existing["BaseUrl"] = _baseUrl.Trim();

            await File.WriteAllTextAsync(SettingsPath, JsonSerializer.Serialize(existing, JsonOpts));

            // Also save as the first provider profile in providers.json
            var profiles = new List<Dictionary<string, object>>
            {
                new()
                {
                    ["Name"] = _provider,
                    ["Provider"] = _provider,
                    ["ApiKey"] = _apiKey.Trim(),
                    ["BaseUrl"] = _baseUrl.Trim(),
                    ["MaxTokens"] = 32000,
                }
            };
            // Merge with any existing profiles.
            if (File.Exists(ProfilesPath))
            {
                try
                {
                    var existingProfiles = JsonSerializer.Deserialize<List<Dictionary<string, object>>>(
                        await File.ReadAllTextAsync(ProfilesPath)) ?? [];
                    foreach (var p in existingProfiles)
                    {
                        if (p.TryGetValue("Provider", out var prov) && prov?.ToString() != _provider)
                            profiles.Add(p);
                    }
                }
                catch { /* ignore parse errors */ }
            }
            await File.WriteAllTextAsync(ProfilesPath, JsonSerializer.Serialize(profiles, JsonOpts));

            // Hot-swap runtime config
            Config.Model = defaultModel;
            Config.ApiKey = _apiKey.Trim();
            Environment.SetEnvironmentVariable("LLM_API_KEY", _apiKey.Trim());
            Environment.SetEnvironmentVariable("LLM_MODEL", defaultModel);
            AuthProvider.ApiKey = _apiKey.Trim();
            if (!string.IsNullOrWhiteSpace(_baseUrl))
            {
                var parsed = new Uri(_baseUrl.Trim());
                Config.BaseUrl = parsed;
                AuthProvider.BaseUrl = parsed;
                Environment.SetEnvironmentVariable("LLM_BASE_URL", _baseUrl.Trim());
            }
            if (_baseUrl.Contains("openrouter", StringComparison.OrdinalIgnoreCase))
                Environment.SetEnvironmentVariable("OPENROUTER_API_KEY", _apiKey.Trim());

            Nav.NavigateTo("/");
        }
        catch (Exception ex) { _status = $"Failed to save: {ex.Message}"; }
        finally { _saving = false; }
    }
}
