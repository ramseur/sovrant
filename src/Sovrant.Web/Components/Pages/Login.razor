@page "/login"
@layout Layout.LoginLayout
@using Sovrant.Runtime
@using Sovrant.Runtime.Auth
@using Sovrant.Runtime.Mcp
@using Sovrant.Web.Auth
@using Sovrant.Web.Services
@inject IIdentityService IdentityService
@inject WebSessionService Session
@inject NavigationManager Nav
@inject IServiceProvider Services

@* Phase 140 — first-run admin sign-up (from Rahul Singh's issue #27): with no accounts yet, the
   first account created becomes the administrator; success uses the success style, not errors.
   Phase 145 — embedded mode signs in per browser: the form posts to /auth/login or /auth/register,
   which set an HttpOnly cookie (a Blazor circuit can't). Messages come back in the query string.
   Remote mode keeps the in-page flow until Phase 145 Part C. *@
<div class="login-card">
    <div class="login-title">Sovrant</div>

    @if (_firstRun)
    {
        <div class="login-sub" style="margin-bottom:4px">Welcome! Let's set up your server.</div>
        <div class="login-info">
            <strong>First-time setup</strong> — no accounts exist yet. The first account you create becomes the
            <strong>administrator</strong>, with full control over registration, approvals, providers and workspaces.
        </div>
    }
    else
    {
        <div class="login-sub" style="margin-bottom:8px">Sign in to continue.</div>
    }

    @if (_warning is not null)
    {
        <div class="login-warn"><SovrantIcon Name="@IconNames.Warning" Size="15" /><span>@_warning</span></div>
    }
    @if (_infoMessage is not null)
    {
        <div class="login-success"><SovrantIcon Name="@IconNames.Done" Size="15" />@_infoMessage</div>
    }
    @if (_errorMessage is not null)
    {
        <div class="login-error">@_errorMessage</div>
    }

    @if (!Program.IsRemoteMode)
    {
        <form class="login-form" method="post" action="@(_firstRun ? "/auth/register" : "/auth/login")"
              onsubmit="this.classList.add('busy')">
            <AntiforgeryToken />
            <div class="login-field">
                <label class="login-label" for="login-email">Email</label>
                <input id="login-email" class="login-input" type="email" name="email" value="@_email"
                       placeholder="you@example.com" autocomplete="username" required />
            </div>
            <div class="login-field">
                <label class="login-label" for="login-password">Password</label>
                <input id="login-password" class="login-input" type="password" name="password"
                       placeholder="@(_firstRun ? "Choose a password" : "Password")"
                       autocomplete="@(_firstRun ? "new-password" : "current-password")" required />
            </div>

            @if (!_firstRun && _rememberText is not null)
            {
                <label class="login-remember">
                    <input type="checkbox" name="remember" />
                    Keep me signed in on this browser for @_rememberText
                </label>
                <div class="login-hint">Otherwise you're signed out after @_idleText without activity, or @_maxText at most. Leave this off on a shared computer.</div>
            }

            @if (_firstRun)
            {
                <button class="login-btn" type="submit">Create administrator account</button>
            }
            else
            {
                <button class="login-btn" type="submit">Sign in</button>
                @if (_registrationOpen)
                {
                    <div class="login-divider"></div>
                    <div class="login-sub">Don't have an account?</div>
                    <button class="login-btn login-btn-secondary" type="submit" formaction="/auth/register">Create account</button>
                    @if (_approvalRequired)
                    {
                        <div class="login-note">New accounts need administrator approval before first sign-in.</div>
                    }
                }
            }
            <div class="login-status" role="status" aria-live="polite">
                <span class="login-spinner" aria-hidden="true"></span>@(_firstRun ? "Creating your administrator account…" : "Signing you in…")
            </div>
        </form>
    }
    else
    {
        <div class="login-field">
            <label class="login-label">Email</label>
            <input class="login-input" type="email" @bind="_email" @bind:event="oninput" placeholder="you@example.com" disabled="@_busy" />
        </div>
        <div class="login-field">
            <label class="login-label">Password</label>
            <input class="login-input" type="password" @bind="_password" @bind:event="oninput"
                   placeholder="@(_firstRun ? "Choose a password" : "Password")" disabled="@_busy" @onkeydown="OnKeyDown" />
        </div>
        @if (_firstRun)
        {
            <button class="login-btn" @onclick="RemoteRegisterAsync" disabled="@_busy">Create administrator account</button>
        }
        else
        {
            <button class="login-btn" @onclick="RemoteLoginAsync" disabled="@_busy">Sign in</button>
            @if (_registrationOpen)
            {
                <div class="login-divider"></div>
                <div class="login-sub">Don't have an account?</div>
                <button class="login-btn login-btn-secondary" @onclick="RemoteRegisterAsync" disabled="@_busy">Create account</button>
                @if (_approvalRequired)
                {
                    <div class="login-note">New accounts need administrator approval before first sign-in.</div>
                }
            }
        }
        @if (_busy)
        {
            <div class="login-status" role="status" aria-live="polite">
                <span class="login-spinner" aria-hidden="true"></span>@_busyLabel
            </div>
        }
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "error")] public string? Error { get; set; }
    [SupplyParameterFromQuery(Name = "info")] public string? Info { get; set; }
    [SupplyParameterFromQuery(Name = "reason")] public string? Reason { get; set; }
    [SupplyParameterFromQuery(Name = "email")] public string? EmailParam { get; set; }

    private string _email = string.Empty;
    private string _password = string.Empty;
    private string? _errorMessage;
    private string? _infoMessage;
    private string? _warning;
    private string _busyLabel = string.Empty;
    private bool _busy;
    private bool _registrationOpen;
    private bool _firstRun;
    private bool _approvalRequired;
    private string? _rememberText;
    private string _idleText = "1 hour";
    private string _maxText = "12 hours";

    protected override async Task OnInitializedAsync()
    {
        if (Session.IsAuthenticated)
        {
            Nav.NavigateTo("/dashboard", forceLoad: true); // already signed in → Home
            return;
        }

        _email = EmailParam ?? string.Empty;
        _errorMessage = string.IsNullOrWhiteSpace(Error) ? null : Error;
        _infoMessage = Info switch
        {
            "approval" => "Account created. An administrator must approve it before you can sign in.",
            "signedout" => "You're signed out.",
            _ => null,
        };

        if (Services.GetService<WebSignInPolicySource>()?.Current is { } policy)
        {
            // Phase 145 A7: the admin's settings; no checkbox when "Keep me signed in" is turned off.
            _rememberText = policy.RememberAllowed ? WebSignInSettings.Describe(policy.RememberLifetime) : null;
            _idleText = WebSignInSettings.Describe(policy.IdleTimeout);
            _maxText = WebSignInSettings.Describe(policy.AbsoluteLifetime);
            _warning = (Reason ?? Session.SignedOutReason) switch
            {
                WebAuth.ReasonTimedOut => $"You were signed out after {_idleText} without activity. Sign in again to pick up where you left off.",
                WebAuth.ReasonRevoked => "An administrator signed you out of this browser. Sign in again, or ask them if you didn't expect this.",
                _ => null,
            };
        }

        _firstRun = await IdentityService.IsFirstRunAsync().ConfigureAwait(false);
        _registrationOpen = await IdentityService.IsRegistrationOpenAsync().ConfigureAwait(false);
        _approvalRequired = !_firstRun && _registrationOpen
            && await IdentityService.IsApprovalRequiredAsync().ConfigureAwait(false);
    }

    // ── Remote mode (until Phase 145 Part C): one process-wide sign-in, in-page ─────────────

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key != "Enter") return;
        if (_firstRun) await RemoteRegisterAsync();
        else await RemoteLoginAsync();
    }

    private bool ValidateInput()
    {
        _errorMessage = null;
        _infoMessage = null;
        if (string.IsNullOrWhiteSpace(_email) || string.IsNullOrWhiteSpace(_password))
        {
            _errorMessage = "Email and password are required.";
            return false;
        }
        return true;
    }

    private async Task RemoteLoginAsync()
    {
        if (!ValidateInput()) return;
        _busy = true;
        _busyLabel = "Signing you in…";
        try
        {
            var result = await IdentityService.LoginAsync(_email, _password).ConfigureAwait(false);
            if (!result.Success || result.Token is null)
            {
                _errorMessage = result.Error ?? "Login failed.";
                return;
            }
            RemoteSignIn(result.Token, result.UserId!, result.Role);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task RemoteRegisterAsync()
    {
        if (!ValidateInput()) return;
        _busy = true;
        _busyLabel = _firstRun ? "Creating your administrator account…" : "Creating your account…";
        try
        {
            var result = await IdentityService.RegisterAsync(_email, _password).ConfigureAwait(false);
            if (!result.Success)
            {
                _errorMessage = result.Error ?? "Registration failed.";
                return;
            }
            if (result.IsPendingApproval)
            {
                _infoMessage = "Account created. An administrator must approve it before you can sign in.";
                return;
            }
            RemoteSignIn(result.Token!, result.UserId!, result.Role);
        }
        finally
        {
            _busy = false;
        }
    }

    private void RemoteSignIn(string token, string userId, string? role)
    {
        // Not saved: a saved token used to be restored for every visitor after a restart.
        if (Services.GetService<Sovrant.Client.Remote.SovrantRemoteOptions>() is { } remote)
            remote.ApiToken = token;
        Session.SignIn(userId, role ?? "user", _email.Trim());
        // Phase 141: every sign-in lands on Home.
        Nav.NavigateTo("/dashboard", forceLoad: true);
    }
}
