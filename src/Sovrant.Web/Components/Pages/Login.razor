@page "/login"
@layout Layout.LoginLayout
@using Sovrant.Runtime
@using Sovrant.Runtime.Auth
@using Sovrant.Runtime.Mcp
@using Sovrant.Runtime.Onboarding
@using Sovrant.Web.Services
@inject IIdentityService IdentityService
@inject ICredentialStore CredentialStore
@inject WebSessionService Session
@inject OnboardingService Onboarding
@inject NavigationManager Nav
@inject IServiceProvider Services

@* Phase 140 — first-run admin sign-up (from Rahul Singh's issue #27): with no accounts yet, the
   first account created becomes the administrator; success uses the success style, not errors. *@
<div class="login-card">
    <div class="login-title">Sovrant</div>

    @if (_firstRun)
    {
        <div class="login-sub" style="margin-bottom:4px">Welcome! Let's set up your server.</div>
        <div class="login-info">
            <strong>First-time setup</strong> — no accounts exist yet. The first account you create becomes the
            <strong>administrator</strong>, with full control over registration, approvals, providers and workspaces.
        </div>
    }
    else
    {
        <div class="login-sub" style="margin-bottom:8px">Sign in to continue.</div>
    }

    @if (_infoMessage is not null)
    {
        <div class="login-success"><SovrantIcon Name="@IconNames.Done" Size="15" />@_infoMessage</div>
    }
    @if (_errorMessage is not null)
    {
        <div class="login-error">@_errorMessage</div>
    }

    <div class="login-field">
        <label class="login-label">Email</label>
        <input class="login-input"
               type="email"
               @bind="_email"
               @bind:event="oninput"
               placeholder="you@example.com"
               disabled="@_busy" />
    </div>

    <div class="login-field">
        <label class="login-label">Password</label>
        <input class="login-input"
               type="password"
               @bind="_password"
               @bind:event="oninput"
               placeholder="@(_firstRun ? "Choose a password" : "Password")"
               disabled="@_busy"
               @onkeydown="OnKeyDown" />
    </div>

    @if (_firstRun)
    {
        <button class="login-btn" @onclick="RegisterAsync" disabled="@_busy">Create administrator account</button>
    }
    else
    {
        <button class="login-btn" @onclick="LoginAsync" disabled="@_busy">Sign in</button>

        @if (_registrationOpen)
        {
            <div class="login-divider"></div>
            <div class="login-sub">Don't have an account?</div>
            <button class="login-btn login-btn-secondary" @onclick="RegisterAsync" disabled="@_busy">Create account</button>
            @if (_approvalRequired)
            {
                <div class="login-note">New accounts need administrator approval before first sign-in.</div>
            }
        }
    }

    @if (_busy)
    {
        <div class="login-status" role="status" aria-live="polite">
            <span class="login-spinner" aria-hidden="true"></span>@_busyLabel
        </div>
    }
</div>

@code {
    private const string StoredTokenKey = "sovrant.web.auth_token";

    private string _email = string.Empty;
    private string _password = string.Empty;
    private string? _errorMessage;
    private string? _infoMessage;
    private string _busyLabel = string.Empty;
    private bool _busy;
    private bool _registrationOpen;
    private bool _firstRun;
    private bool _approvalRequired;

    protected override async Task OnInitializedAsync()
    {
        if (Session.IsAuthenticated)
        {
            Nav.NavigateTo("/", forceLoad: true);
            return;
        }
        _firstRun = await IdentityService.IsFirstRunAsync().ConfigureAwait(false);
        _registrationOpen = await IdentityService.IsRegistrationOpenAsync().ConfigureAwait(false);
        _approvalRequired = !_firstRun && _registrationOpen
            && await IdentityService.IsApprovalRequiredAsync().ConfigureAwait(false);
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key != "Enter") return;
        // On first run there's nobody to sign in as yet: Enter creates the administrator.
        if (_firstRun) await RegisterAsync();
        else await LoginAsync();
    }

    private bool ValidateInput()
    {
        _errorMessage = null;
        _infoMessage = null;
        if (string.IsNullOrWhiteSpace(_email) || string.IsNullOrWhiteSpace(_password))
        {
            _errorMessage = "Email and password are required.";
            return false;
        }
        return true;
    }

    private async Task LoginAsync()
    {
        if (!ValidateInput()) return;
        _busy = true;
        _busyLabel = "Signing you in…";
        try
        {
            var result = await IdentityService.LoginAsync(_email, _password).ConfigureAwait(false);
            if (!result.Success || result.Token is null)
            {
                _errorMessage = result.Error ?? "Login failed.";
                return;
            }
            await SignInAndGoAsync(result.Token, result.UserId!, result.Role).ConfigureAwait(false);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task RegisterAsync()
    {
        if (!ValidateInput()) return;
        _busy = true;
        _busyLabel = _firstRun ? "Creating your administrator account…" : "Creating your account…";
        try
        {
            var result = await IdentityService.RegisterAsync(_email, _password).ConfigureAwait(false);
            if (!result.Success)
            {
                _errorMessage = result.Error ?? "Registration failed.";
                return;
            }
            if (result.IsPendingApproval)
            {
                _infoMessage = "Account created. An administrator must approve it before you can sign in.";
                return;
            }
            // Honor the role the identity service assigned. Only the first registrant
            // is "admin"; everyone else is "user" and must not inherit admin powers
            // just because they happened to register through this form.
            await SignInAndGoAsync(result.Token!, result.UserId!, result.Role).ConfigureAwait(false);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SignInAndGoAsync(string token, string userId, string? role)
    {
        await CredentialStore.StoreAsync(StoredTokenKey, token).ConfigureAwait(false);
        Program.SetUserId(userId);
        Session.SignIn(userId, role ?? "user", _email.Trim());
        if (!Program.IsRemoteMode)
            _ = Task.Run(async () =>
            {
                await Program.SeedUserAndWorkspaceAsync(Services, userId).ConfigureAwait(false);
                await Services.ApplyUserPreferencesForUserAsync(userId).ConfigureAwait(false);
            });
        // Phase 140: a user's first sign-in lands on the Welcome page.
        var target = await Onboarding.HasSeenWelcomeAsync(userId).ConfigureAwait(false) ? "/" : "/welcome";
        Nav.NavigateTo(target, forceLoad: true);
    }
}
