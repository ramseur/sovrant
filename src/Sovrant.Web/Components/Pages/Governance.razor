@page "/governance"
@using Sovrant.Runtime.Governance
@using Sovrant.Runtime.Workspaces
@using Sovrant.Web.Services
@inject IWorkspaceSettingsStore SettingsStore
@inject LiveSettingsRegistry LiveSettings
@inject WebSessionService Session
@inject NavigationManager Nav

<div class="settings-page">
    <h1>Governance</h1>

    @if (!string.IsNullOrEmpty(_status))
    {
        <div class="status-message">@_status</div>
    }

    <!-- Level + Audit card -->
    <div class="gov-card">
        <div class="gov-field-row">
            <div>
                <span class="gov-field-label">Governance Level</span>
                <EnvLockNote Variable="@Lock(Sovrant.Runtime.Workspaces.WorkspaceSettingsKeys.GovernanceLevel)" />
            </div>
            <select class="gov-field-input" @bind="_level" disabled="@Locked(Sovrant.Runtime.Workspaces.WorkspaceSettingsKeys.GovernanceLevel)">
                <option value="permissive">Permissive</option>
                <option value="standard">Standard</option>
                <option value="strict">Strict</option>
            </select>
        </div>

        <div class="toggle-card toggle-card-bare">
            <div>
                <div class="toggle-title">Audit Logging</div>
                <div class="toggle-desc">Log all agent actions for audit trail</div>
                <EnvLockNote Variable="@Lock(Sovrant.Runtime.Workspaces.WorkspaceSettingsKeys.GovernanceAuditLog)" />
            </div>
            <label class="switch">
                <input type="checkbox" @bind="_auditLog" disabled="@Locked(Sovrant.Runtime.Workspaces.WorkspaceSettingsKeys.GovernanceAuditLog)" />
                <span class="slider"></span>
            </label>
        </div>

        <div class="toggle-card toggle-card-bare">
            <div>
                <div class="toggle-title">Allow file and shell tools on this server</div>
                <div class="toggle-desc">Read, write, search and run commands on this server — for everyone, admins included. These tools run as the server's own account with no folder limits, so an agent could reach other people's files, the database and the server's settings. Leave off unless this server is used by one trusted team.</div>
                <EnvLockNote Variable="@Lock(Sovrant.Runtime.Workspaces.WorkspaceSettingsKeys.GovernanceHostFileTools)" />
            </div>
            <label class="switch">
                <input type="checkbox" @bind="_hostFileTools" disabled="@Locked(Sovrant.Runtime.Workspaces.WorkspaceSettingsKeys.GovernanceHostFileTools)" />
                <span class="slider"></span>
            </label>
        </div>
        <div class="toggle-card toggle-card-bare">
            <div>
                <div class="toggle-title">Let members use file and shell tools</div>
                <div class="toggle-desc">Only applies when file and shell tools are allowed on this server. Off: only admins can use them.</div>
                <EnvLockNote Variable="@Lock(Sovrant.Runtime.Workspaces.WorkspaceSettingsKeys.GovernanceMemberFileTools)" />
            </div>
            <label class="switch">
                <input type="checkbox" @bind="_memberFileTools" disabled="@(!_hostFileTools || Locked(Sovrant.Runtime.Workspaces.WorkspaceSettingsKeys.GovernanceMemberFileTools))" />
                <span class="slider"></span>
            </label>
        </div>
    </div>

    <!-- Blocked Commands -->
    <h2>Blocked Commands</h2>
    <EnvLockNote Variable="@Lock(Sovrant.Runtime.Workspaces.WorkspaceSettingsKeys.GovernanceBlockedCommands)" />
    <div class="input-group input-group-tight">
        <input type="text" @bind="_newBlockedCmd" placeholder="e.g. rm -rf /" disabled="@Locked(Sovrant.Runtime.Workspaces.WorkspaceSettingsKeys.GovernanceBlockedCommands)" />
        <button class="btn-primary btn-inline-add" @onclick="AddBlockedCommand" disabled="@Locked(Sovrant.Runtime.Workspaces.WorkspaceSettingsKeys.GovernanceBlockedCommands)">Add</button>
    </div>
    @if (_blockedCommands.Count == 0)
    {
        <p class="text-muted text-sm">No blocked commands configured</p>
    }
    @foreach (var cmd in _blockedCommands)
    {
        <div class="gov-item gov-item-danger">
            <code class="gov-item-text gov-text-danger">@cmd</code>
            <button class="btn-sm btn-danger" @onclick="() => _blockedCommands.Remove(cmd)" disabled="@Locked(Sovrant.Runtime.Workspaces.WorkspaceSettingsKeys.GovernanceBlockedCommands)">Remove</button>
        </div>
    }

    <!-- Protected Files -->
    <h2 class="mt-16">Protected Files</h2>
    <EnvLockNote Variable="@Lock(Sovrant.Runtime.Workspaces.WorkspaceSettingsKeys.GovernanceProtectedFiles)" />
    <div class="input-group input-group-tight">
        <input type="text" @bind="_newProtectedFile" placeholder="e.g. .env, credentials.json" disabled="@Locked(Sovrant.Runtime.Workspaces.WorkspaceSettingsKeys.GovernanceProtectedFiles)" />
        <button class="btn-primary btn-inline-add" @onclick="AddProtectedFile" disabled="@Locked(Sovrant.Runtime.Workspaces.WorkspaceSettingsKeys.GovernanceProtectedFiles)">Add</button>
    </div>
    @if (_protectedFiles.Count == 0)
    {
        <p class="text-muted text-sm">No protected files configured</p>
    }
    @foreach (var f in _protectedFiles)
    {
        <div class="gov-item gov-item-warn">
            <code class="gov-item-text gov-text-warn">@f</code>
            <button class="btn-sm btn-danger" @onclick="() => _protectedFiles.Remove(f)" disabled="@Locked(Sovrant.Runtime.Workspaces.WorkspaceSettingsKeys.GovernanceProtectedFiles)">Remove</button>
        </div>
    }

    <!-- Secret Patterns -->
    <h2 class="mt-16">Secret Detection Patterns</h2>
    <EnvLockNote Variable="@Lock(Sovrant.Runtime.Workspaces.WorkspaceSettingsKeys.GovernanceSecretPatterns)" />
    <div class="input-group input-group-tight">
        <input type="text" @bind="_newSecretPattern" placeholder="e.g. sk-[a-zA-Z0-9]+" disabled="@Locked(Sovrant.Runtime.Workspaces.WorkspaceSettingsKeys.GovernanceSecretPatterns)" />
        <button class="btn-primary btn-inline-add" @onclick="AddSecretPattern" disabled="@Locked(Sovrant.Runtime.Workspaces.WorkspaceSettingsKeys.GovernanceSecretPatterns)">Add</button>
    </div>
    @if (_secretPatterns.Count == 0)
    {
        <p class="text-muted text-sm">No custom secret patterns (built-in patterns active)</p>
    }
    @foreach (var p in _secretPatterns)
    {
        <div class="gov-item gov-item-default">
            <code class="gov-item-text">@p</code>
            <button class="btn-sm btn-danger" @onclick="() => _secretPatterns.Remove(p)" disabled="@Locked(Sovrant.Runtime.Workspaces.WorkspaceSettingsKeys.GovernanceSecretPatterns)">Remove</button>
        </div>
    }

    <button class="btn-primary" style="max-width:200px;margin-top:20px;" @onclick="SaveConfigAsync">Save Configuration</button>
    <p class="text-muted text-sm">Stored in the workspace settings database.</p>
</div>

@code {
    private string _level = "standard";
    private bool _auditLog = true;
    private bool _memberFileTools;
    private bool _hostFileTools;
    private List<string> _blockedCommands = [];
    private List<string> _protectedFiles = [];
    private List<string> _secretPatterns = [];
    private string _newBlockedCmd = string.Empty;
    private string _newProtectedFile = string.Empty;
    private string _newSecretPattern = string.Empty;
    private string _status = string.Empty;

    // Phase 148: settings the server's environment sets while SOVRANT_ENV_OVERRIDE is on.
    private static string? Lock(string key) => Sovrant.Runtime.Config.EnvBackedSettings.LockedBy(key);
    private static bool Locked(string key) => Lock(key) is not null;

    protected override void OnInitialized()
    {
        if (!Session.IsAdmin) { Nav.NavigateTo("/", forceLoad: false); return; }
        var config = GovernanceConfig.Load(SettingsStore);
        _level = config.GovernanceLevelName;
        _auditLog = config.AuditLog;
        _memberFileTools = config.MemberFileTools;
        _hostFileTools = config.HostFileTools;
        _blockedCommands = [.. config.BlockedCommands];
        _protectedFiles = [.. config.ProtectedFiles];
        _secretPatterns = [.. config.SecretPatterns];
    }

    private void AddBlockedCommand()
    {
        if (!string.IsNullOrWhiteSpace(_newBlockedCmd) && !_blockedCommands.Contains(_newBlockedCmd.Trim()))
        {
            _blockedCommands.Add(_newBlockedCmd.Trim());
            _newBlockedCmd = string.Empty;
        }
    }

    private void AddProtectedFile()
    {
        if (!string.IsNullOrWhiteSpace(_newProtectedFile) && !_protectedFiles.Contains(_newProtectedFile.Trim()))
        {
            _protectedFiles.Add(_newProtectedFile.Trim());
            _newProtectedFile = string.Empty;
        }
    }

    private void AddSecretPattern()
    {
        if (!string.IsNullOrWhiteSpace(_newSecretPattern) && !_secretPatterns.Contains(_newSecretPattern.Trim()))
        {
            _secretPatterns.Add(_newSecretPattern.Trim());
            _newSecretPattern = string.Empty;
        }
    }

    private async Task SaveConfigAsync()
    {
        try
        {
            var config = new GovernanceConfig { GovernanceLevelName = _level, AuditLog = _auditLog, MemberFileTools = _memberFileTools, HostFileTools = _hostFileTools };
            foreach (var c in _blockedCommands) config.BlockedCommands.Add(c);
            foreach (var f in _protectedFiles) config.ProtectedFiles.Add(f);
            foreach (var p in _secretPatterns) config.SecretPatterns.Add(p);

            await config.SaveToStoreAsync(SettingsStore);
            LiveSettings.ReloadAll();
            _status = "Governance config saved.";
        }
        catch (Exception ex) { _status = $"Save failed: {ex.Message}"; }
    }
}
