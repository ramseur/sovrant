@page "/orchestration"
@using Sovrant.Agents.Models
@using Sovrant.Agents.Orchestration
@using Sovrant.Agents.Teams
@using Sovrant.Agents.Swarm
@using Sovrant.Agents.Templates
@using Sovrant.Web.Services

<div class="master-detail">
    <div class="master-panel">
        <div class="master-header">
            <h1>Orchestration</h1>
            <div class="master-header-right">
                <span class="item-count">@_filtered.Count</span>
                <button class="btn-sm btn-outline" title="Swarm defaults"
                        @onclick="ToggleSwarmConfig">&#x2699;</button>
                <button class="btn-sm btn-primary" title="New team"
                        @onclick="StartCreate">+ New</button>
            </div>
        </div>

        <div class="master-search">
            <input type="text" placeholder="Search teams..."
                   @bind="_search" @bind:event="oninput" @bind:after="ApplyFilter" />
        </div>

        <div class="master-list">
            @if (_filtered.Count == 0)
            {
                <p class="text-secondary" style="padding:12px;">@EmptyMessage()</p>
            }
            else
            {
                @foreach (var item in _filtered)
                {
                    <button class="master-item @(ReferenceEquals(item, _selected) && !_showSwarmConfig ? "active" : "")"
                            @onclick="() => Select(item)">
                        <div class="item-title">
                            <span class="orch-shape-badge shape-@item.RunMode.ToString().ToLowerInvariant()">
                                @ModeIcon(item.RunMode) @item.RunMode
                            </span>
                            <span>@item.Name</span>
                        </div>
                        <div class="item-subtitle">@item.Subtitle</div>
                    </button>
                }
            }
        </div>
    </div>

    <div class="detail-panel">
        @if (!string.IsNullOrEmpty(_status))
        {
            <div class="status-message" style="margin:16px 24px 0;">@_status</div>
        }

        @if (_isCreating)
        {
            <!-- ── New Team form ──────────────────────────────────── -->
            <div class="detail-content">
                <div class="orch-detail-header">
                    <h2>New Team</h2>
                    <button class="btn-sm btn-outline" @onclick="CancelCreate">Cancel</button>
                </div>
                <div class="gov-card" style="max-width:520px;">
                    <div class="gov-field-row">
                        <span>Name</span>
                        <input type="text" class="gov-field-input" placeholder="my-team"
                               @bind="_createName" @bind:event="oninput" />
                    </div>
                    <div class="gov-field-row">
                        <span>Description</span>
                        <input type="text" class="gov-field-input" placeholder="Optional"
                               @bind="_createDescription" @bind:event="oninput" />
                    </div>
                    <div class="gov-field-row">
                        <span>Run Mode</span>
                        <select class="gov-field-input" @bind="_createRunMode">
                            <option value="@TeamRunMode.Sequential">Sequential</option>
                            <option value="@TeamRunMode.Parallel">Parallel</option>
                            <option value="@TeamRunMode.Swarm">Swarm</option>
                        </select>
                    </div>
                </div>
                <div style="display:flex;gap:8px;margin-top:12px;">
                    <button class="btn-primary" style="max-width:160px;"
                            disabled="@(string.IsNullOrWhiteSpace(_createName))"
                            @onclick="ConfirmCreate">Create Team</button>
                    <button class="btn-outline btn-sm" @onclick="CancelCreate">Cancel</button>
                </div>
            </div>
        }
        else if (_showSwarmConfig)
        {
            <div class="detail-content">
                <div class="orch-detail-header">
                    <div>
                        <span class="orch-shape-badge shape-swarm">&#x1F41D; Defaults</span>
                        <h2>Swarm Defaults</h2>
                        <p class="text-secondary" style="margin:4px 0 0;">
                            Default run settings inherited by new teams. Per-team overrides live on each team's detail pane.
                        </p>
                    </div>
                    <button class="btn-sm btn-outline" @onclick="ToggleSwarmConfig">Close</button>
                </div>

                <div class="gov-card">
                    <div class="toggle-card" style="border:none;padding:0;">
                        <div>
                            <div class="toggle-title">Swarm Enabled</div>
                            <div class="toggle-desc">Enable swarm orchestrator for parallel agent execution</div>
                        </div>
                        <label class="switch">
                            <input type="checkbox" @bind="_swarmEnabled" />
                            <span class="slider"></span>
                        </label>
                    </div>

                    <div class="toggle-card" style="border:none;padding:0;">
                        <div>
                            <div class="toggle-title">Quality Gate</div>
                            <div class="toggle-desc">Run quality review after execution</div>
                        </div>
                        <label class="switch">
                            <input type="checkbox" @bind="_swarmQualityGate" />
                            <span class="slider"></span>
                        </label>
                    </div>

                    <div class="gov-field-row">
                        <span>Max Concurrent Agents</span>
                        <input type="number" class="gov-field-input" @bind="_swarmMaxConcurrent" min="1" max="16" />
                    </div>

                    <div class="gov-field-row">
                        <span>Token Budget</span>
                        <input type="number" class="gov-field-input" @bind="_swarmMaxTokenBudget" min="10000" step="50000" />
                    </div>

                    <div class="gov-field-row">
                        <span>Task Timeout (seconds)</span>
                        <input type="number" class="gov-field-input" @bind="_swarmTimeout" min="30" max="3600" />
                    </div>

                    <div class="gov-field-row">
                        <span>Permissions</span>
                        <select class="gov-field-input" @bind="_swarmPermissions">
                            <option value="ask">Ask</option>
                            <option value="accept-edits">Accept Edits</option>
                            <option value="yolo">Auto-Accept All</option>
                        </select>
                    </div>
                </div>

                <button class="btn-primary" style="max-width:200px;margin-top:12px;"
                        @onclick="SaveSwarmConfig">Save Defaults</button>
                <p class="text-muted text-sm">Defaults persisted to the database.</p>
            </div>
        }
        else if (_selected is not null)
        {
            <div class="detail-content">
                <div class="orch-detail-header">
                    <div>
                        <span class="orch-shape-badge shape-@_selected.RunMode.ToString().ToLowerInvariant()">
                            @ModeIcon(_selected.RunMode) @_selected.RunMode
                        </span>
                        <h2>@_selected.Name</h2>
                        @if (!string.IsNullOrEmpty(_selected.Description))
                        {
                            <p class="text-secondary" style="margin:4px 0 0;">@_selected.Description</p>
                        }
                    </div>
                    <button class="btn-sm btn-danger" @onclick="() => RemoveTeam(_selected.TeamId)">Delete</button>
                </div>

                <!-- ── Run card ───────────────────────────────────────── -->
                <div class="orch-detail-section">
                    <h3>Run</h3>
                    <div class="gov-card" style="max-width:600px;">
                        <textarea class="gov-field-input" rows="3"
                                  placeholder="Describe the goal or task for this team…"
                                  style="width:100%;resize:vertical;"
                                  @bind="_runGoal" @bind:event="oninput"></textarea>
                        <div style="display:flex;gap:12px;align-items:center;margin-top:8px;">
                            <button class="btn-primary"
                                    disabled="@(_isRunning || string.IsNullOrWhiteSpace(_runGoal))"
                                    @onclick="RunTeamAsync">
                                @(_isRunning ? "Running…" : "Run Team")
                            </button>
                            <span class="text-muted text-sm">@_runStatus</span>
                        </div>
                        @if (!string.IsNullOrEmpty(_runOutput))
                        {
                            <div class="orch-run-output">
                                <pre style="white-space:pre-wrap;font-size:12px;margin:0;">@_runOutput</pre>
                            </div>
                        }
                    </div>
                </div>

                <!-- ── Run Profile ───────────────────────────────────── -->
                <div class="orch-detail-section">
                    <h3>Run Profile</h3>
                    <div class="gov-card">
                        <div class="gov-field-row">
                            <span>Run Mode</span>
                            <select class="gov-field-input" @bind="_selected.RunMode">
                                <option value="@TeamRunMode.Sequential">Sequential</option>
                                <option value="@TeamRunMode.Parallel">Parallel</option>
                                <option value="@TeamRunMode.Swarm">Swarm</option>
                            </select>
                        </div>

                        <div class="gov-field-row">
                            <span>Max Concurrent</span>
                            <input type="number" class="gov-field-input"
                                   @bind="_selected.MaxConcurrent" min="1" max="16" />
                        </div>

                        <div class="toggle-card" style="border:none;padding:0;">
                            <div>
                                <div class="toggle-title">File Locks</div>
                                <div class="toggle-desc">Serialize concurrent writes to the same file</div>
                            </div>
                            <label class="switch">
                                <input type="checkbox" @bind="_selected.FileLocksEnabled" />
                                <span class="slider"></span>
                            </label>
                        </div>

                        <div class="toggle-card" style="border:none;padding:0;">
                            <div>
                                <div class="toggle-title">Quality Gate</div>
                                <div class="toggle-desc">Post-run review + optional retry</div>
                            </div>
                            <label class="switch">
                                <input type="checkbox" @bind="_selected.QualityGateEnabled" />
                                <span class="slider"></span>
                            </label>
                        </div>

                        @if (_selected.QualityGateEnabled)
                        {
                            <div class="gov-field-row">
                                <span>Quality Threshold (0–10)</span>
                                <input type="number" class="gov-field-input"
                                       @bind="_selected.QualityGateThreshold" min="0" max="10" />
                            </div>
                        }

                        <div class="gov-field-row">
                            <span>Decomposition</span>
                            <select class="gov-field-input" @bind="_selected.DecompositionMode">
                                <option value="@TeamDecompositionMode.Off">Off</option>
                                <option value="@TeamDecompositionMode.RoleAware">RoleAware</option>
                                <option value="@TeamDecompositionMode.Open">Open</option>
                            </select>
                        </div>
                    </div>

                    <button class="btn-primary" style="max-width:180px;margin-top:12px;"
                            @onclick="() => SaveTeamProfile(_selected)">Save Profile</button>
                </div>

                <!-- ── Members ───────────────────────────────────────── -->
                <div class="orch-detail-section">
                    <h3>Members</h3>
                    @if (_selected.Members.Count == 0)
                    {
                        <p class="text-muted text-sm">No members.</p>
                    }
                    else
                    {
                        @foreach (var m in _selected.Members)
                        {
                            <div class="ma-member-card">
                                <div class="ma-member-info">
                                    <div>
                                        <span class="ma-member-name">@m.Name</span>
                                        <span class="ma-role-badge">@m.Role</span>
                                    </div>
                                    <div class="ma-member-meta">
                                        @if (!string.IsNullOrEmpty(m.Model))
                                        {
                                            <span>@m.Model</span>
                                        }
                                        <span>@m.ToolsSummary</span>
                                    </div>
                                </div>
                                <button class="btn-sm btn-danger" @onclick="() => RemoveMember(m.Id)">X</button>
                            </div>
                        }
                    }

                    @if (_isAddingMember)
                    {
                        <!-- ── Add Member inline form ────────────────── -->
                        <div class="gov-card" style="margin-top:12px;max-width:520px;">
                            <div class="gov-field-row">
                                <span>From Agent Template</span>
                                <select class="gov-field-input" @bind="_addMemberTemplate"
                                        @bind:after="OnTemplateSelected">
                                    <option value="">— custom —</option>
                                    @foreach (var t in _agentTemplates)
                                    {
                                        <option value="@t.Name">@t.Name</option>
                                    }
                                </select>
                            </div>
                            <div class="gov-field-row">
                                <span>Name</span>
                                <input type="text" class="gov-field-input"
                                       placeholder="member-name"
                                       @bind="_addMemberName" @bind:event="oninput" />
                            </div>
                            <div class="gov-field-row">
                                <span>Role</span>
                                <select class="gov-field-input" @bind="_addMemberRole">
                                    @foreach (var r in Enum.GetNames<AgentRole>())
                                    {
                                        <option value="@r">@r</option>
                                    }
                                </select>
                            </div>
                            <div style="display:flex;gap:8px;margin-top:8px;">
                                <button class="btn-primary"
                                        disabled="@(string.IsNullOrWhiteSpace(_addMemberName))"
                                        @onclick="ConfirmAddMember">Add</button>
                                <button class="btn-outline btn-sm"
                                        @onclick="CancelAddMember">Cancel</button>
                            </div>
                        </div>
                    }
                    else
                    {
                        <button class="btn-outline btn-sm" style="margin-top:10px;"
                                @onclick="StartAddMember">+ Add Member</button>
                    }
                </div>
            </div>
        }
        else
        {
            <div class="detail-empty">
                <span class="text-muted">Select a team to view details</span>
            </div>
        }
    </div>
</div>

@code {
    [Inject] private ITeamRegistry TeamRegistry { get; set; } = default!;
    [Inject] private ISwarmConfigStore SwarmConfigStore { get; set; } = default!;
    [Inject] private IAgentOrchestrator Orchestrator { get; set; } = default!;
    [Inject] private AgentTemplateRegistry TemplateRegistry { get; set; } = default!;
    [Inject] private ActiveContextService ActiveContext { get; set; } = default!;

    private string _search = string.Empty;
    private string _status = string.Empty;
    private bool _showSwarmConfig;

    private List<TeamItem> _all = [];
    private List<TeamItem> _filtered = [];
    private TeamItem? _selected;

    // ── Create team state ─────────────────────────────────────────────────
    private bool _isCreating;
    private string _createName = string.Empty;
    private string _createDescription = string.Empty;
    private TeamRunMode _createRunMode = TeamRunMode.Parallel;

    // ── Add member state ──────────────────────────────────────────────────
    private bool _isAddingMember;
    private string _addMemberTemplate = string.Empty;
    private string _addMemberName = string.Empty;
    private string _addMemberRole = nameof(AgentRole.General);
    private List<AgentTemplate> _agentTemplates = [];

    // ── Run state ─────────────────────────────────────────────────────────
    private string _runGoal = string.Empty;
    private bool _isRunning;
    private string _runStatus = string.Empty;
    private string _runOutput = string.Empty;

    // ── Swarm config ──────────────────────────────────────────────────────
    private bool _swarmEnabled;
    private bool _swarmQualityGate = true;
    private int _swarmMaxConcurrent = 4;
    private int _swarmMaxTokenBudget = 500_000;
    private int _swarmTimeout = 300;
    private string _swarmPermissions = "ask";

    protected override async Task OnInitializedAsync()
    {
        await LoadSwarmConfigAsync().ConfigureAwait(false);
        _agentTemplates = TemplateRegistry.All.ToList();
        LoadAll();
    }

    // ── Create team ───────────────────────────────────────────────────────

    private void StartCreate()
    {
        _isCreating = true;
        _showSwarmConfig = false;
        _createName = string.Empty;
        _createDescription = string.Empty;
        _createRunMode = TeamRunMode.Parallel;
        _status = string.Empty;
    }

    private void CancelCreate() => _isCreating = false;

    private void ConfirmCreate()
    {
        var name = _createName.Trim();
        if (string.IsNullOrEmpty(name)) return;

        var team = new TeamInfo(
            Id: $"team-{Guid.NewGuid():N}",
            WorkspaceId: ActiveContext.WorkspaceId,
            ProjectId: string.IsNullOrEmpty(ActiveContext.ProjectId) ? null : ActiveContext.ProjectId,
            Name: name,
            Description: string.IsNullOrEmpty(_createDescription) ? null : _createDescription.Trim(),
            Origin: "ui",
            CreatedBy: Program.SovrantUserId,
            CreatedAt: DateTimeOffset.UtcNow)
        {
            RunMode = _createRunMode,
        };

        TeamRegistry.CreateTeam(team);
        _isCreating = false;
        _status = $"Created team '{name}'.";
        LoadAll();
        _selected = _all.FirstOrDefault(t => t.TeamId == team.Id);
    }

    // ── Add member ────────────────────────────────────────────────────────

    private void StartAddMember()
    {
        _isAddingMember = true;
        _addMemberTemplate = string.Empty;
        _addMemberName = string.Empty;
        _addMemberRole = nameof(AgentRole.General);
    }

    private void CancelAddMember() => _isAddingMember = false;

    private void OnTemplateSelected()
    {
        if (string.IsNullOrEmpty(_addMemberTemplate)) return;
        var t = TemplateRegistry.TryGet(_addMemberTemplate);
        if (t is null) return;
        _addMemberName = t.Name;
        _addMemberRole = t.Role.ToString();
    }

    private void ConfirmAddMember()
    {
        if (_selected is null || string.IsNullOrWhiteSpace(_addMemberName)) return;

        var template = string.IsNullOrEmpty(_addMemberTemplate) ? null : TemplateRegistry.TryGet(_addMemberTemplate);

        if (!Enum.TryParse<AgentRole>(_addMemberRole, out var role)) role = AgentRole.General;

        var member = new TeamMemberInfo
        {
            Id = $"member-{Guid.NewGuid():N}",
            Name = _addMemberName.Trim(),
            Role = role,
            SystemPrompt = template?.SystemPrompt ?? $"You are a {_addMemberRole} agent.",
            AllowedTools = template?.AllowedTools,
            TeamId = _selected.TeamId,
            WorkspaceId = ActiveContext.WorkspaceId,
            Template = string.IsNullOrEmpty(_addMemberTemplate) ? null : _addMemberTemplate,
            CreatedBy = Program.SovrantUserId,
        };

        TeamRegistry.RegisterMember(member);
        _isAddingMember = false;
        _status = $"Added '{member.Name}' to team.";
        LoadAll();
    }

    // ── Run ───────────────────────────────────────────────────────────────

    private async Task RunTeamAsync()
    {
        if (_selected is null || string.IsNullOrWhiteSpace(_runGoal) || _isRunning) return;

        _isRunning = true;
        _runStatus = "Starting…";
        _runOutput = string.Empty;
        StateHasChanged();

        try
        {
            var request = new EnsembleRunRequest
            {
                Goal = _runGoal,
                TeamId = _selected.TeamId,
                WorkspaceId = ActiveContext.WorkspaceId,
                UserId = Program.SovrantUserId,
                Permissions = "ask",
            };

            var result = await Orchestrator.RunAsync(request).ConfigureAwait(false);
            var sr = result.SwarmResult;
            _runStatus = sr.Status.ToString();
            _runOutput = string.IsNullOrEmpty(sr.CombinedOutput)
                ? "(no output)"
                : sr.CombinedOutput;
        }
        catch (Exception ex)
        {
            _runStatus = "Failed";
            _runOutput = ex.Message;
        }
        finally
        {
            _isRunning = false;
            await InvokeAsync(StateHasChanged).ConfigureAwait(false);
        }
    }

    // ── Existing helpers ──────────────────────────────────────────────────

    private void LoadAll()
    {
        var items = new List<TeamItem>();

        foreach (var t in TeamRegistry.ListTeams())
        {
            var members = TeamRegistry.GetTeamMembers(t.Id).Select(ToView).ToList();
            items.Add(new TeamItem
            {
                TeamId = t.Id,
                Name = t.Name,
                Description = t.Description ?? string.Empty,
                Subtitle = members.Count == 1 ? "1 agent" : $"{members.Count} agents",
                Members = members,
                RunMode = t.RunMode,
                MaxConcurrent = t.MaxConcurrent,
                FileLocksEnabled = t.FileLocksEnabled,
                QualityGateEnabled = t.QualityGateEnabled,
                QualityGateThreshold = t.QualityGateThreshold,
                DecompositionMode = t.DecompositionMode,
            });
        }

        _all = items;
        if (_selected is not null)
            _selected = _all.FirstOrDefault(i => i.TeamId == _selected.TeamId);
        ApplyFilter();
    }

    private void ApplyFilter()
    {
        if (string.IsNullOrWhiteSpace(_search)) { _filtered = _all; return; }
        var s = _search.Trim();
        _filtered = _all.Where(i =>
            i.Name.Contains(s, StringComparison.OrdinalIgnoreCase) ||
            i.Description.Contains(s, StringComparison.OrdinalIgnoreCase)
        ).ToList();
    }

    private void Select(TeamItem item)
    {
        _showSwarmConfig = false;
        _isCreating = false;
        _isAddingMember = false;
        _runGoal = string.Empty;
        _runStatus = string.Empty;
        _runOutput = string.Empty;
        _selected = item;
    }

    private void ToggleSwarmConfig()
    {
        _showSwarmConfig = !_showSwarmConfig;
        if (_showSwarmConfig) { _selected = null; _isCreating = false; }
    }

    private void RemoveTeam(string id)
    {
        TeamRegistry.RemoveTeam(id);
        _status = "Team removed.";
        _selected = null;
        LoadAll();
    }

    private void RemoveMember(string id)
    {
        TeamRegistry.RemoveMember(id);
        _status = "Member removed.";
        LoadAll();
    }

    private void SaveTeamProfile(TeamItem team)
    {
        var profile = new TeamRunProfile(
            team.RunMode, team.MaxConcurrent, team.FileLocksEnabled,
            team.QualityGateEnabled, team.QualityGateThreshold, team.DecompositionMode);

        if (TeamRegistry.UpdateTeamRunProfile(team.TeamId, profile))
        {
            _status = $"Saved run profile for '{team.Name}'.";
            LoadAll();
        }
        else
        {
            _status = $"Could not save '{team.Name}' — team not found.";
        }
    }

    private async Task LoadSwarmConfigAsync()
    {
        var config = await SwarmConfigStore.GetAsync().ConfigureAwait(false);
        _swarmEnabled = config.Enabled;
        _swarmQualityGate = config.QualityGateEnabled;
        _swarmMaxConcurrent = config.MaxConcurrent;
        _swarmMaxTokenBudget = config.MaxTokenBudget;
        _swarmTimeout = config.TaskTimeoutSeconds;
        _swarmPermissions = config.Permissions;
    }

    private async Task SaveSwarmConfig()
    {
        try
        {
            var config = new SwarmConfig
            {
                Enabled            = _swarmEnabled,
                QualityGateEnabled = _swarmQualityGate,
                MaxConcurrent      = _swarmMaxConcurrent,
                MaxTokenBudget     = _swarmMaxTokenBudget,
                TaskTimeoutSeconds = _swarmTimeout,
                Permissions        = _swarmPermissions,
            };
            await SwarmConfigStore.SetAsync(string.Empty, config).ConfigureAwait(false);
            _status = "Swarm defaults saved.";
            LoadAll();
        }
        catch (Exception ex) { _status = $"Save failed: {ex.Message}"; }
    }

    private static MemberView ToView(TeamMemberInfo m) => new()
    {
        Id = m.Id,
        Name = m.Name,
        Role = m.Role.ToString(),
        Model = m.Model ?? string.Empty,
        ToolsSummary = BuildToolsSummary(m.AllowedTools),
    };

    private static string BuildToolsSummary(IReadOnlyList<string>? tools)
    {
        if (tools is null || tools.Count == 0) return "All tools";
        if (tools.Count <= 3) return string.Join(", ", tools);
        return $"{string.Join(", ", tools.Take(3))} +{tools.Count - 3} more";
    }

    private static string ModeIcon(TeamRunMode mode) => mode switch
    {
        TeamRunMode.Sequential => "\U0001F465",
        TeamRunMode.Parallel => "\u26A1",
        TeamRunMode.Swarm => "\U0001F41D",
        _ => string.Empty,
    };

    private string EmptyMessage() =>
        string.IsNullOrWhiteSpace(_search) ? "No teams yet. Click + New to create one." : "No matches.";

    private sealed class TeamItem
    {
        public string TeamId { get; init; } = string.Empty;
        public string Name { get; init; } = string.Empty;
        public string Description { get; init; } = string.Empty;
        public string Subtitle { get; init; } = string.Empty;
        public List<MemberView> Members { get; init; } = [];
        public TeamRunMode RunMode { get; set; } = TeamRunMode.Parallel;
        public int MaxConcurrent { get; set; } = 4;
        public bool FileLocksEnabled { get; set; }
        public bool QualityGateEnabled { get; set; }
        public int QualityGateThreshold { get; set; } = 7;
        public TeamDecompositionMode DecompositionMode { get; set; } = TeamDecompositionMode.Off;
    }

    private sealed class MemberView
    {
        public string Id { get; init; } = string.Empty;
        public string Name { get; init; } = string.Empty;
        public string Role { get; init; } = string.Empty;
        public string Model { get; init; } = string.Empty;
        public string ToolsSummary { get; init; } = string.Empty;
    }
}
