@page "/orchestration"
@using Sovrant.Agents.Teams
@using Sovrant.Agents.Swarm
@using System.Text.Json

<div class="master-detail">
    <div class="master-panel">
        <div class="master-header">
            <h1>Orchestration</h1>
            <div class="master-header-right">
                <span class="item-count">@_filtered.Count</span>
                <button class="btn-sm btn-outline" title="Swarm configuration"
                        @onclick="ToggleSwarmConfig">&#x2699;</button>
                <button class="btn-sm btn-primary" title="New orchestration"
                        @onclick="HintNew">+ New</button>
            </div>
        </div>

        <div class="orch-filter-row">
            @foreach (var chip in _chips)
            {
                <button class="orch-chip @(chip.Key == _activeFilter ? "active" : "")"
                        @onclick="() => SetFilter(chip.Key)">
                    @chip.Label
                    <span class="orch-chip-count">@ChipCount(chip.Key)</span>
                </button>
            }
        </div>

        <div class="master-search">
            <input type="text" placeholder="Search orchestrations..."
                   @bind="_search" @bind:event="oninput" @bind:after="ApplyFilter" />
        </div>

        <div class="master-list">
            @if (_filtered.Count == 0)
            {
                <p class="text-secondary" style="padding:12px;">@EmptyMessage()</p>
            }
            else
            {
                @foreach (var item in _filtered)
                {
                    <button class="master-item @(ReferenceEquals(item, _selected) && !_showSwarmConfig ? "active" : "")"
                            @onclick="() => Select(item)">
                        <div class="item-title">
                            <span class="orch-shape-badge shape-@item.Shape.ToString().ToLowerInvariant()">
                                @ShapeIcon(item.Shape) @item.Shape
                            </span>
                            <span>@item.Name</span>
                        </div>
                        <div class="item-subtitle">@item.Subtitle</div>
                    </button>
                }
            }
        </div>
    </div>

    <div class="detail-panel">
        @if (!string.IsNullOrEmpty(_status))
        {
            <div class="status-message" style="margin:16px 24px 0;">@_status</div>
        }

        @if (_showSwarmConfig)
        {
            <div class="detail-content">
                <div class="orch-detail-header">
                    <div>
                        <span class="orch-shape-badge shape-swarm">&#x1F41D; Swarm</span>
                        <h2>Swarm Configuration</h2>
                        <p class="text-secondary" style="margin:4px 0 0;">
                            Global settings for how swarm orchestration decomposes and executes tasks.
                        </p>
                    </div>
                    <button class="btn-sm btn-outline" @onclick="ToggleSwarmConfig">Close</button>
                </div>

                <div class="gov-card">
                    <div class="toggle-card" style="border:none;padding:0;">
                        <div>
                            <div class="toggle-title">Swarm Enabled</div>
                            <div class="toggle-desc">Enable swarm orchestrator for parallel agent execution</div>
                        </div>
                        <label class="switch">
                            <input type="checkbox" @bind="_swarmEnabled" />
                            <span class="slider"></span>
                        </label>
                    </div>

                    <div class="toggle-card" style="border:none;padding:0;">
                        <div>
                            <div class="toggle-title">Quality Gate</div>
                            <div class="toggle-desc">Run quality review after execution</div>
                        </div>
                        <label class="switch">
                            <input type="checkbox" @bind="_swarmQualityGate" />
                            <span class="slider"></span>
                        </label>
                    </div>

                    <div class="gov-field-row">
                        <span>Max Concurrent Agents</span>
                        <input type="number" class="gov-field-input" @bind="_swarmMaxConcurrent" min="1" max="16" />
                    </div>

                    <div class="gov-field-row">
                        <span>Token Budget</span>
                        <input type="number" class="gov-field-input" @bind="_swarmMaxTokenBudget" min="10000" step="50000" />
                    </div>

                    <div class="gov-field-row">
                        <span>Task Timeout (seconds)</span>
                        <input type="number" class="gov-field-input" @bind="_swarmTimeout" min="30" max="3600" />
                    </div>

                    <div class="gov-field-row">
                        <span>Permissions</span>
                        <select class="gov-field-input" @bind="_swarmPermissions">
                            <option value="ask">Ask</option>
                            <option value="accept-edits">Accept Edits</option>
                            <option value="yolo">Auto-Accept All</option>
                        </select>
                    </div>
                </div>

                <button class="btn-primary" style="max-width:200px;margin-top:12px;"
                        @onclick="SaveSwarmConfig">Save Configuration</button>
                <p class="text-muted text-sm">Configuration saved to .sovrant/swarm.json</p>
            </div>
        }
        else if (_selected is not null)
        {
            <div class="detail-content">
                <div class="orch-detail-header">
                    <div>
                        <span class="orch-shape-badge shape-@_selected.Shape.ToString().ToLowerInvariant()">
                            @ShapeIcon(_selected.Shape) @_selected.Shape
                        </span>
                        <h2>@_selected.Name</h2>
                        @if (!string.IsNullOrEmpty(_selected.Description))
                        {
                            <p class="text-secondary" style="margin:4px 0 0;">@_selected.Description</p>
                        }
                    </div>
                    @if (_selected.TeamId is { } teamId)
                    {
                        <button class="btn-sm btn-danger" @onclick="() => RemoveTeam(teamId)">Delete</button>
                    }
                </div>

                @if (_selected.Shape is OrchShape.Single or OrchShape.Team)
                {
                    <div class="orch-detail-section">
                        <h3>Members</h3>
                        @if (_selected.Members.Count == 0)
                        {
                            <p class="text-muted text-sm">No members.</p>
                        }
                        else
                        {
                            @foreach (var m in _selected.Members)
                            {
                                <div class="ma-member-card">
                                    <div class="ma-member-info">
                                        <div>
                                            <span class="ma-member-name">@m.Name</span>
                                            <span class="ma-role-badge">@m.Role</span>
                                        </div>
                                        <div class="ma-member-meta">
                                            @if (!string.IsNullOrEmpty(m.Model))
                                            {
                                                <span>@m.Model</span>
                                            }
                                            <span>@m.ToolsSummary</span>
                                        </div>
                                    </div>
                                    <button class="btn-sm btn-danger" @onclick="() => RemoveMember(m.Id)">X</button>
                                </div>
                            }
                        }
                    </div>
                }
                else if (_selected.Shape == OrchShape.Swarm)
                {
                    <div class="orch-detail-section">
                        <h3>Configuration</h3>
                        <div class="gov-card">
                            <div class="gov-field-row">
                                <span>Status</span>
                                <span>@(_swarmEnabled ? "Enabled" : "Disabled")</span>
                            </div>
                            <div class="gov-field-row">
                                <span>Max Concurrent Agents</span>
                                <span>@_swarmMaxConcurrent</span>
                            </div>
                            <div class="gov-field-row">
                                <span>Token Budget</span>
                                <span>@_swarmMaxTokenBudget.ToString("N0")</span>
                            </div>
                            <div class="gov-field-row">
                                <span>Task Timeout</span>
                                <span>@_swarmTimeout s</span>
                            </div>
                            <div class="gov-field-row">
                                <span>Permissions</span>
                                <span>@_swarmPermissions</span>
                            </div>
                            <div class="gov-field-row">
                                <span>Quality Gate</span>
                                <span>@(_swarmQualityGate ? "On" : "Off")</span>
                            </div>
                        </div>
                        <button class="btn-sm btn-outline" style="margin-top:12px;"
                                @onclick="ToggleSwarmConfig">Edit configuration</button>
                    </div>
                }
                else
                {
                    <div class="orch-detail-section">
                        <div class="claws-placeholder">
                            <div class="claws-icon">@ShapeIcon(_selected.Shape)</div>
                            <h2>@_selected.Shape</h2>
                            <p class="text-secondary">
                                @ShapeDescription(_selected.Shape)
                            </p>
                            <span class="claws-coming-soon">COMING SOON</span>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="detail-empty">
                <span class="text-muted">Select an orchestration to view details</span>
            </div>
        }
    </div>
</div>

@code {
    [Inject] private ITeamRegistry TeamRegistry { get; set; } = default!;

    private enum OrchShape { Single, Team, Swarm, Claw, Autonomous }

    private sealed record Chip(string Key, string Label);

    private static readonly Chip[] _chips =
    {
        new("all", "All"),
        new("single", "Single"),
        new("team", "Team"),
        new("swarm", "Swarm"),
        new("claw", "Claw"),
        new("autonomous", "Autonomous"),
    };

    private string _activeFilter = "all";
    private string _search = string.Empty;
    private string _status = string.Empty;
    private bool _showSwarmConfig;

    private List<OrchItem> _all = [];
    private List<OrchItem> _filtered = [];
    private OrchItem? _selected;

    private bool _swarmEnabled;
    private bool _swarmQualityGate = true;
    private int _swarmMaxConcurrent = 4;
    private int _swarmMaxTokenBudget = 500_000;
    private int _swarmTimeout = 300;
    private string _swarmPermissions = "ask";

    protected override void OnInitialized()
    {
        LoadSwarmConfig();
        LoadAll();
    }

    private void LoadAll()
    {
        var items = new List<OrchItem>();

        var teams = TeamRegistry.ListTeams();
        var allMembers = TeamRegistry.GetAllMembers().ToList();
        var assigned = new HashSet<string>(StringComparer.Ordinal);

        foreach (var t in teams)
        {
            var members = TeamRegistry.GetTeamMembers(t.Id).Select(ToView).ToList();
            foreach (var m in members) assigned.Add(m.Id);

            var shape = members.Count <= 1 ? OrchShape.Single : OrchShape.Team;
            items.Add(new OrchItem
            {
                Shape = shape,
                TeamId = t.Id,
                Name = t.Name,
                Description = t.Description ?? string.Empty,
                Subtitle = SubtitleFor(shape, members.Count),
                Members = members,
            });
        }

        var unassigned = allMembers.Where(m => !assigned.Contains(m.Id)).Select(ToView).ToList();
        foreach (var m in unassigned)
        {
            items.Add(new OrchItem
            {
                Shape = OrchShape.Single,
                TeamId = null,
                Name = m.Name,
                Description = $"Unassigned {m.Role.ToLowerInvariant()}",
                Subtitle = m.Model is { Length: > 0 } mm ? mm : "No team",
                Members = [m],
            });
        }

        items.Add(new OrchItem
        {
            Shape = OrchShape.Swarm,
            TeamId = null,
            Name = "Swarm Orchestrator",
            Description = _swarmEnabled ? "Parallel agent execution" : "Disabled",
            Subtitle = _swarmEnabled
                ? $"Max {_swarmMaxConcurrent} concurrent · {_swarmPermissions}"
                : "Swarm disabled",
            Members = [],
        });

        _all = items;
        if (_selected is not null)
        {
            _selected = _all.FirstOrDefault(i =>
                i.Shape == _selected.Shape && i.TeamId == _selected.TeamId && i.Name == _selected.Name);
        }
        ApplyFilter();
    }

    private void ApplyFilter()
    {
        IEnumerable<OrchItem> q = _all;
        if (_activeFilter != "all")
            q = q.Where(i => i.Shape.ToString().Equals(_activeFilter, StringComparison.OrdinalIgnoreCase));

        if (!string.IsNullOrWhiteSpace(_search))
        {
            var s = _search.Trim();
            q = q.Where(i =>
                i.Name.Contains(s, StringComparison.OrdinalIgnoreCase) ||
                i.Description.Contains(s, StringComparison.OrdinalIgnoreCase));
        }

        _filtered = q.ToList();
    }

    private void SetFilter(string key)
    {
        _activeFilter = key;
        ApplyFilter();
    }

    private int ChipCount(string key)
    {
        if (key == "all") return _all.Count;
        return _all.Count(i => i.Shape.ToString().Equals(key, StringComparison.OrdinalIgnoreCase));
    }

    private void Select(OrchItem item)
    {
        _showSwarmConfig = false;
        _selected = item;
    }

    private void ToggleSwarmConfig()
    {
        _showSwarmConfig = !_showSwarmConfig;
        if (_showSwarmConfig) _selected = null;
    }

    private void HintNew()
    {
        _status = "New orchestration picker coming soon. Use /team create in chat to add a team.";
    }

    private void RemoveTeam(string id)
    {
        TeamRegistry.RemoveTeam(id);
        _status = "Team removed.";
        _selected = null;
        LoadAll();
    }

    private void RemoveMember(string id)
    {
        TeamRegistry.RemoveMember(id);
        _status = "Member removed.";
        LoadAll();
    }

    private void LoadSwarmConfig()
    {
        var config = SwarmConfigLoader.Load();
        _swarmEnabled = config.Enabled;
        _swarmQualityGate = config.QualityGateEnabled;
        _swarmMaxConcurrent = config.MaxConcurrent;
        _swarmMaxTokenBudget = config.MaxTokenBudget;
        _swarmTimeout = config.TaskTimeoutSeconds;
        _swarmPermissions = config.Permissions;
    }

    private void SaveSwarmConfig()
    {
        try
        {
            var path = Path.Combine(Directory.GetCurrentDirectory(), ".sovrant", "swarm.json");
            Directory.CreateDirectory(Path.GetDirectoryName(path)!);
            var config = new SwarmConfig
            {
                Enabled = _swarmEnabled,
                MaxConcurrent = _swarmMaxConcurrent,
                MaxTokenBudget = _swarmMaxTokenBudget,
                TaskTimeoutSeconds = _swarmTimeout,
                Permissions = _swarmPermissions,
            };
            var json = JsonSerializer.Serialize(config, new JsonSerializerOptions { WriteIndented = true });
            File.WriteAllText(path, json);
            _status = "Swarm config saved.";
            LoadAll();
        }
        catch (Exception ex) { _status = $"Save failed: {ex.Message}"; }
    }

    private static MemberView ToView(TeamMemberInfo m) => new()
    {
        Id = m.Id,
        Name = m.Name,
        Role = m.Role.ToString(),
        Model = m.Model ?? string.Empty,
        ToolsSummary = BuildToolsSummary(m.AllowedTools),
    };

    private static string BuildToolsSummary(IReadOnlyList<string>? tools)
    {
        if (tools is null || tools.Count == 0) return "All tools";
        if (tools.Count <= 3) return string.Join(", ", tools);
        return $"{string.Join(", ", tools.Take(3))} +{tools.Count - 3} more";
    }

    private static string SubtitleFor(OrchShape shape, int memberCount) => shape switch
    {
        OrchShape.Single => memberCount == 1 ? "1 agent" : "Empty",
        OrchShape.Team => $"{memberCount} agents",
        _ => string.Empty,
    };

    private static string ShapeIcon(OrchShape shape) => shape switch
    {
        OrchShape.Single => "\U0001F464",
        OrchShape.Team => "\U0001F465",
        OrchShape.Swarm => "\U0001F41D",
        OrchShape.Claw => "\U0001F99E",
        OrchShape.Autonomous => "\U0001F916",
        _ => string.Empty,
    };

    private static string ShapeDescription(OrchShape shape) => shape switch
    {
        OrchShape.Claw =>
            "Autonomous agent frameworks like Open Claw and Hermes that connect via MCP integrations. " +
            "Configure an MCP server on the Integrations page to bring one online.",
        OrchShape.Autonomous =>
            "Self-directed agent systems that plan, act, and loop without turn-by-turn instruction. " +
            "Register one to appear here for monitoring and control.",
        _ => string.Empty,
    };

    private string EmptyMessage() => _activeFilter switch
    {
        "claw" => "No claws registered. Connect one via Integrations → MCP.",
        "autonomous" => "No autonomous systems registered yet.",
        "team" => "No teams yet. Use /team create in chat to set one up.",
        "single" => "No single-agent orchestrations.",
        _ => string.IsNullOrWhiteSpace(_search) ? "No orchestrations yet." : "No matches.",
    };

    private sealed class OrchItem
    {
        public OrchShape Shape { get; init; }
        public string? TeamId { get; init; }
        public string Name { get; init; } = string.Empty;
        public string Description { get; init; } = string.Empty;
        public string Subtitle { get; init; } = string.Empty;
        public List<MemberView> Members { get; init; } = [];
    }

    private sealed class MemberView
    {
        public string Id { get; init; } = string.Empty;
        public string Name { get; init; } = string.Empty;
        public string Role { get; init; } = string.Empty;
        public string Model { get; init; } = string.Empty;
        public string ToolsSummary { get; init; } = string.Empty;
    }
}
