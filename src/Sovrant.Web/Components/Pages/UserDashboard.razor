@page "/dashboard"
@using System.Globalization
@using Sovrant.Runtime.UserDashboard
@using Sovrant.Runtime.Workflows
@using Sovrant.Runtime.Storage
@using Sovrant.Runtime.Session
@using Sovrant.Runtime.Governance
@using Sovrant.Runtime.Onboarding
@using Sovrant.Runtime.Config
@inject SovrantConfig Config
@using Sovrant.Web.Services
@inject OnboardingService Onboarding
@inject ActiveContextService ActiveContext
@inject IJSRuntime JS
@inject WebSessionService Session
@inject UserDashboardAggregator Aggregator
@inject IWorkflowStore WorkflowStore
@inject IAgentRunStore RunStore
@inject ISessionStore SessionStore
@inject IAuditStore AuditStore
@inject NavigationManager Nav
@implements IDisposable

@* Phase 141 — Home: the Dashboard and Phase 140's Welcome in one place. Greeting + Get started pill,
   your activity, then the Get started checklist and What Sovrant can do (docs/design/web.html → Home). *@
<div class="settings-page cc-page home-page">
    <div class="diag-header">
        <div>
            <h1>@_greeting</h1>
            <p class="text-secondary cc-subtitle">@OnboardingService.Tagline</p>
            <p class="text-secondary cc-subtitle">
                Your activity across every workspace you belong to — plus your teammates' public activity.
                <button type="button" class="btn-link cc-help-toggle" @onclick="() => _showHelp = !_showHelp">
                    @(_showHelp ? "Hide guide" : "What are these?")
                </button>
            </p>
        </div>
        <div class="diag-header-right">
            @if (_state is not null)
            {
                <span class="text-muted text-sm">Last updated: @_state.GeneratedAt.LocalDateTime.ToString("MMM d, h:mm tt", CultureInfo.InvariantCulture)</span>
            }
            @if (_guide is { } g && g.DoneCount < g.Checklist.Count)
            {
                <button class="home-pill" @onclick="ScrollToChecklistAsync" title="Jump to Get started">
                    <span class="home-ring" style="--p:@(Percent(g))"></span>Get started · @g.DoneCount of @g.Checklist.Count
                </button>
            }
            <button class="btn-secondary" @onclick="LoadAsync" disabled="@_loading">@(_loading ? "Refreshing…" : "Refresh")</button>
        </div>
    </div>

    @if (_showHelp)
    {
        <div class="cc-help-panel">
            <dl class="cc-help-grid">
                <dt>Workflows</dt>
                <dd>Long-running goals you own across all workspaces. A workflow decomposes into team runs and agent runs until the goal is complete.</dd>

                <dt>Team runs</dt>
                <dd>Team executions you kicked off — a group of agents running together under a sequential, parallel, or swarm profile.</dd>

                <dt>Agent runs</dt>
                <dd>Solo agent runs you launched directly from the Agents page, or as individual members of a team run.</dd>

                <dt>Sessions</dt>
                <dd>Chat conversations you started. Private sessions are only visible to you; public ones are visible to workspace admins.</dd>

                <dt>Shared</dt>
                <dd>Your own items you've made public — workflows, runs, and sessions with the privacy toggle set to public. These are visible to workspace admins and teammates.</dd>

                <dt>Claws</dt>
                <dd>External MCP systems Sovrant is connected to (n8n, Zapier, custom servers). Sovrant monitors and steers them from the Command Center.</dd>
            </dl>
        </div>
    }

    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="page-error-banner" role="alert">
            <SovrantIcon Name="@IconNames.Warning" Size="15" StrokeWidth="2" />
            <span class="error-message">@_error</span>
        </div>
    }

    <div class="cc-stat-row">
        <CcStat Label="Workflows" Value="@(_state?.OwnWorkflows ?? 0)"
                Tooltip="Long-running goals you own." />
        <CcStat Label="Team runs" Value="@(_state?.OwnTeamRuns ?? 0)"
                Tooltip="Team executions you kicked off." />
        <CcStat Label="Agent runs" Value="@(_state?.OwnAgentRuns ?? 0)"
                Tooltip="Solo agent runs you launched." />
        <CcStat Label="Sessions" Value="@(_state?.OwnSessions ?? 0)"
                Tooltip="Chat conversations you started." />
        <CcStat Label="Shared" Value="@(_state?.OthersPublicRows ?? 0)"
                Tooltip="Your items you've made public — visible to workspace teammates." />
        <CcStat Label="Claws" Value="@(_state?.Claws ?? 0)"
                Tooltip="External MCP systems Sovrant is connected to." />
    </div>

    @if (_state is null && _loading)
    {
        <div class="cc-empty"><p class="text-secondary">Loading…</p></div>
    }
    else if (_state is null || _state.Rows.Count == 0)
    {
        <div class="cc-empty">
            <h2>Nothing yet</h2>
            <p class="text-secondary">
                Start a chat or run an agent template — your activity (and your teammates' public activity)
                will appear here.
            </p>
            <div class="cc-empty-actions">
                <a href="/" class="btn-primary">New chat</a>
                <a href="/agents" class="btn-outline">Run an agent</a>
            </div>
        </div>
    }
    else
    {
        <div class="cc-grid cc-grid-dashboard">
            <div class="cc-grid-header">
                <div class="cc-col-kind">Kind</div>
                <div class="cc-col-privacy"></div>
                <div class="cc-col-title">Title</div>
                <div class="cc-col-status">Status</div>
                <div class="cc-col-owner">Owner</div>
                <div class="cc-col-when">Last activity</div>
                <div class="cc-col-cost">Cost</div>
            </div>
            @foreach (var row in _state.Rows.Skip(_dashPage * PageSize).Take(PageSize))
            {
                <a class="cc-grid-row" href="@(row.DetailRoute ?? "#")">
                    <div class="cc-col-kind">
                        <span class="cc-kind-pill cc-kind-@(row.Kind)">@row.Kind</span>
                    </div>
                    <div class="cc-col-privacy">
                        @if (row.IsOwn)
                        {
                            <button class="privacy-toggle-mini @(row.IsPrivate ? "private" : "public")"
                                    title="@(row.IsPrivate ? "Private — only you can see this. Click to make public." : "Public — visible to workspace admins. Click to make private.")"
                                    @onclick="@(() => TogglePrivacyAsync(row))"
                                    @onclick:stopPropagation="true"
                                    @onclick:preventDefault="true">
                                @if (row.IsPrivate)
                                {
                                    <SovrantIcon Name="@IconNames.Private" Size="12" StrokeWidth="2" />
                                }
                                else
                                {
                                    <SovrantIcon Name="@IconNames.Public" Size="12" StrokeWidth="2" />
                                }
                            </button>
                        }
                        else if (row.IsPrivate)
                        {
                            <span class="cc-badge-private" title="Private — only visible to you">
                                <SovrantIcon Name="@IconNames.Private" Size="12" StrokeWidth="2" />
                            </span>
                        }
                    </div>
                    <div class="cc-col-title">
                        <span class="cc-title-text">@row.Title</span>
                        @if (!string.IsNullOrEmpty(row.Preview))
                        {
                            <div class="cc-preview text-muted text-sm">@row.Preview</div>
                        }
                    </div>
                    <div class="cc-col-status">
                        <span class="cc-status cc-status-@row.Status.ToLowerInvariant()">@row.Status</span>
                    </div>
                    <div class="cc-col-owner text-sm text-muted">@(row.OwnerLabel ?? "—")</div>
                    <div class="cc-col-when text-sm text-muted">@FormatRelative(row.LastActivity)</div>
                    <div class="cc-col-cost text-sm text-muted">@(row.CostUsd is null ? "—" : $"${row.CostUsd:F4}")</div>
                </a>
            }
        </div>
        @if (_state.Rows.Count > PageSize)
        {
            <div class="cc-pager">
                <button class="btn-secondary cc-pager-btn" disabled="@(_dashPage == 0)" @onclick="() => _dashPage--">← Prev</button>
                <span class="text-muted text-sm">@(_dashPage * PageSize + 1)–@(Math.Min((_dashPage + 1) * PageSize, _state.Rows.Count)) of @_state.Rows.Count</span>
                <button class="btn-secondary cc-pager-btn" disabled="@((_dashPage + 1) * PageSize >= _state.Rows.Count)" @onclick="() => _dashPage++">Next →</button>
            </div>
        }
    }

    @if (_guide is { } guide)
    {
        var complete = guide.DoneCount == guide.Checklist.Count;
        @if (!complete)
        {
            <section class="home-sec" id="get-started">
                <div class="home-sec-head">
                    <h3>@(guide.IsAdmin ? "Get started: set up your server" : "Get started")</h3>
                    <span>@guide.DoneCount of @guide.Checklist.Count done</span>
                </div>
                <div class="wel-check">
                    <div class="wel-bar"><i style="width:@(Percent(guide))%"></i></div>
                    @foreach (var item in guide.Checklist)
                    {
                        <div class="wel-item @(item.Done ? "done" : "")">
                            <span class="wel-tick">@if (item.Done) { <SovrantIcon Name="@IconNames.Allow" Size="12" StrokeWidth="3" /> }</span>
                            <span class="wel-item-text">@item.Title<span>@item.Subtitle</span></span>
                            @if (item.Done)
                            {
                                <span class="wel-ok">Done</span>
                            }
                            else if (LinkFor(item.Target) is { } itemHref)
                            {
                                <a class="wel-act" href="@itemHref">@item.ActionLabel →</a>
                            }
                        </div>
                    }
                </div>
            </section>
        }
        else if (!_dismissed)
        {
            <section class="home-sec" id="get-started">
                <div class="home-allset">
                    <span class="home-allset-tick"><SovrantIcon Name="@IconNames.Allow" Size="12" StrokeWidth="3" /></span>
                    <span class="home-allset-text"><b>All set</b> — you've finished getting started.</span>
                    <button class="btn-secondary btn-sm" @onclick="DismissAsync">Dismiss</button>
                </div>
            </section>
        }

        <section class="home-sec">
            <div class="home-sec-head"><h3>What Sovrant can do</h3></div>
            <div class="wel-grid home-grid">
                @foreach (var area in guide.Areas)
                {
                    if (LinkFor(area.Target) is { } href)
                    {
                        <a class="wel-card" href="@href">
                            <span class="wel-icon"><SovrantIcon Name="@area.IconName" Size="18" /></span>
                            <b>@area.Title</b>
                            <span class="wel-desc">@area.Description</span>
                            <span class="wel-go">@area.ActionLabel →</span>
                        </a>
                    }
                    else
                    {
                        <div class="wel-card managed">
                            <span class="wel-icon"><SovrantIcon Name="@area.IconName" Size="18" /></span>
                            <b>@area.Title</b>
                            <span class="wel-desc">@area.Description</span>
                            <span class="wel-managed">Managed by your admin</span>
                        </div>
                    }
                }
            </div>
        </section>
    }
</div>

@code {
    // Phase 141 — Home's greeting and the guide below the activity.
    private WelcomeContent? _guide;
    private bool _firstVisit;
    private bool _dismissed;
    private string _greeting = "Home";
    private int? _localHour;

    private static int Percent(WelcomeContent g) =>
        g.Checklist.Count == 0 ? 0 : (int)Math.Round(100.0 * g.DoneCount / g.Checklist.Count);

    private void UpdateGreeting() =>
        _greeting = _firstVisit || _localHour is not null
            ? OnboardingService.Greeting(OnboardingService.DisplayName(Session.Email ?? Session.UserId), _firstVisit, _localHour ?? 12)
            : $"Welcome back, {OnboardingService.DisplayName(Session.Email ?? Session.UserId)}";

    private async Task LoadGuideAsync()
    {
        var userId = Session.UserId;
        if (string.IsNullOrEmpty(userId)) return;
        _guide = await Onboarding.GetWelcomeAsync(userId, Session.IsAdmin, ActiveContext.WorkspaceId);
        _dismissed = await Onboarding.IsGetStartedDismissedAsync(userId);
    }

    private async Task DismissAsync()
    {
        if (Session.UserId is { Length: > 0 } userId)
            await Onboarding.DismissGetStartedAsync(userId);
        _dismissed = true;
    }

    private async Task ScrollToChecklistAsync()
    {
        try { await JS.InvokeVoidAsync("sovrantInterop.scrollToId", "get-started"); }
        catch (JSDisconnectedException) { }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        if (_firstVisit && Session.UserId is { Length: > 0 } uid)
            await Onboarding.MarkWelcomeSeenAsync(uid);
        try { _localHour = await JS.InvokeAsync<int>("sovrantInterop.localHour"); }
        catch (JSDisconnectedException) { return; }
        UpdateGreeting();
        StateHasChanged();
    }

    /// <summary>Web route for a guide link; null for admin-only pages when the user isn't an admin.</summary>
    private string? LinkFor(WelcomeTarget? target)
    {
        if (target is not { } t || (OnboardingService.IsAdminOnly(t) && !Session.IsAdmin))
            return null;
        return t switch
        {
            WelcomeTarget.Chat or WelcomeTarget.Privacy => "/",
            WelcomeTarget.Agents => "/agents",
            WelcomeTarget.Orchestration => "/orchestration",
            WelcomeTarget.Workflows => "/workflows",
            WelcomeTarget.Knowledge => "/skills",
            WelcomeTarget.Projects => "/projects",
            WelcomeTarget.Integrations => "/admin/integrations",
            WelcomeTarget.TrustBoundary => "/trust-boundary",
            WelcomeTarget.Workspaces => "/admin/workspaces",
            WelcomeTarget.Users => "/admin",
            // First run (nothing configured yet) uses the setup page; afterwards, Admin → Providers.
            WelcomeTarget.ProviderSetup => string.IsNullOrWhiteSpace(Config.ApiKey) && Config.BaseUrl is null ? "/setup" : "/admin/providers",
            _ => null,
        };
    }

    private const int PageSize = 10;
    private int _dashPage;

    private UserDashboardState? _state;
    private bool _loading;
    private bool _showHelp;
    private string _error = string.Empty;
    private System.Threading.Timer? _timer;

    protected override async Task OnInitializedAsync()
    {
        if (!Session.IsAuthenticated)
        {
            Nav.NavigateTo("/login", forceLoad: false);
            return;
        }

        // Phase 141: first visit greets with "Welcome to Sovrant"; afterwards a time-of-day greeting.
        // Decided here (prerender and live render both see "not seen"); recorded after the live render.
        if (Session.UserId is { Length: > 0 } uid)
            _firstVisit = !await Onboarding.HasSeenWelcomeAsync(uid);
        UpdateGreeting();

        await LoadAsync();
        _timer = new System.Threading.Timer(_ => InvokeAsync(LoadAsync), null,
            TimeSpan.FromSeconds(30), TimeSpan.FromSeconds(30));
    }

    private async Task LoadAsync()
    {
        if (string.IsNullOrEmpty(Session.UserId)) return;

        await LoadGuideAsync(); // Phase 141: checklist ticks refresh with the activity

        _loading = true;
        try
        {
            _state = await Aggregator.GetStateAsync(Session.UserId);
            int dashTotal = _state.Rows.Count;
            int dashTotalPages = (int)Math.Ceiling(dashTotal / (double)PageSize);
            if (dashTotalPages == 0) _dashPage = 0;
            else if (_dashPage >= dashTotalPages) _dashPage = dashTotalPages - 1;
            _error = string.Empty;
        }
        catch (Exception ex)
        {
            _error = $"Failed to load dashboard: {ex.Message}";
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }


    private static string FormatRelative(DateTimeOffset when)
    {
        var delta = DateTimeOffset.UtcNow - when;
        if (delta.TotalSeconds < 5) return "just now";
        if (delta.TotalSeconds < 60) return $"{(int)delta.TotalSeconds}s ago";
        if (delta.TotalMinutes < 60) return $"{(int)delta.TotalMinutes}m ago";
        if (delta.TotalHours < 24) return $"{(int)delta.TotalHours}h ago";
        return when.LocalDateTime.ToString("MMM d, HH:mm", CultureInfo.InvariantCulture);
    }

    private async Task TogglePrivacyAsync(UserDashboardRow row)
    {
        if (string.IsNullOrEmpty(Session.UserId)) return;
        var newValue = !row.IsPrivate;
        try
        {
            switch (row.Kind)
            {
                case "workflow":
                    await WorkflowStore.UpdatePrivacyAsync(row.Id, Session.UserId, newValue);
                    await AuditStore.LogPrivacyChangeAsync(Session.UserId, "workflow", row.Id, newValue);
                    break;
                case "agent-run":
                case "team-run":
                    await RunStore.UpdatePrivacyAsync(row.Id, Session.UserId, newValue);
                    await AuditStore.LogPrivacyChangeAsync(Session.UserId, "agent_run", row.Id, newValue);
                    break;
                case "session":
                    await SessionStore.UpdatePrivacyAsync(row.Id, Session.UserId, newValue);
                    await AuditStore.LogPrivacyChangeAsync(Session.UserId, "session", row.Id, newValue);
                    break;
            }
        }
        catch (Exception ex)
        {
            _error = $"Failed to update privacy: {ex.Message}";
        }
        await LoadAsync();
    }

    public void Dispose() => _timer?.Dispose();
}
