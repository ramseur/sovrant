@page "/activity"
@using Sovrant.Runtime.Memory
@using Sovrant.Runtime.Session
@using Sovrant.Web.Services

<MasterDetailLayout TItem="SessionSummary"
                    Title="Activity"
                    ItemCount="@_summaries.Count"
                    Items="@_summaries"
                    SelectedItem="@_selected"
                    EmptyMessage="No activity yet — start a chat session to see history here."
                    OnRefresh="LoadAsync"
                    OnItemSelected="OnSelectedAsync"
                    ShowSearch="false">
    <ItemTemplate>
        <div class="item-title">
            @(context.Tasks.Count > 0 ? Truncate(context.Tasks[0], 80) : "(no task recorded)")
        </div>
        <div class="item-subtitle">
            <span class="outcome-badge @context.Outcome.ToString().ToLowerInvariant()">@context.Outcome</span>
            &middot; @context.StartedAt.LocalDateTime.ToString("MMM d, HH:mm")
            &middot; @context.TurnCount turns
        </div>
    </ItemTemplate>
    <DetailTemplate>
        <div class="detail-content activity-detail">
            <div class="activity-header">
                <h2>@(context.Tasks.Count > 0 ? context.Tasks[0] : "(no task recorded)")</h2>
                <div class="detail-meta">
                    <span class="outcome-badge @context.Outcome.ToString().ToLowerInvariant()">@context.Outcome</span>
                    <span>Started: @context.StartedAt.LocalDateTime.ToString("MMM d, HH:mm:ss")</span>
                    <span>Duration: @FormatDuration(context.EndedAt - context.StartedAt)</span>
                    <span>Turns: @context.TurnCount</span>
                    @if (context.TotalInputTokens + context.TotalOutputTokens > 0)
                    {
                        <span>Tokens: @(context.TotalInputTokens + context.TotalOutputTokens)</span>
                    }
                    @if (context.ErrorCount > 0)
                    {
                        <span class="text-fail">Errors: @context.ErrorCount</span>
                    }
                </div>
                @if (context.ToolsUsed.Count > 0)
                {
                    <div class="detail-meta">Tools used: @string.Join(", ", context.ToolsUsed)</div>
                }
                @if (context.FilesModified.Count > 0)
                {
                    <div class="detail-meta">Files: @string.Join(", ", context.FilesModified)</div>
                }
            </div>

            <h3>Turns</h3>
            @if (_loadingDetail)
            {
                <div class="text-secondary">Loading turns…</div>
            }
            else if (!string.IsNullOrEmpty(_detailError))
            {
                <div class="text-fail">@_detailError</div>
            }
            else if (_entries.Count == 0)
            {
                <div class="text-muted">No turn detail recorded for this session.</div>
            }
            else
            {
                <div class="turn-list">
                    @foreach (var entry in _entries)
                    {
                        <div class="turn-row turn-@RoleClass(entry)">
                            <div class="turn-row-head">
                                <span class="turn-role">@RoleLabel(entry)</span>
                                @if (!string.IsNullOrEmpty(entry.ToolName))
                                {
                                    <span class="turn-tool">@entry.ToolName</span>
                                }
                                <span class="turn-time">@entry.Timestamp.LocalDateTime.ToString("HH:mm:ss")</span>
                                @if (entry.InputTokens + entry.OutputTokens > 0)
                                {
                                    <span class="turn-tokens">in @entry.InputTokens / out @entry.OutputTokens</span>
                                }
                                @if (entry.IsError)
                                {
                                    <span class="turn-error">error</span>
                                }
                            </div>
                            <pre class="turn-content">@TruncateOutput(entry.Content)</pre>
                        </div>
                    }
                </div>
            }
        </div>
    </DetailTemplate>
</MasterDetailLayout>

@code {
    [Inject] private IMemoryStore MemoryStore { get; set; } = default!;
    [Inject] private ISessionStore SessionStore { get; set; } = default!;

    private List<SessionSummary> _summaries = [];
    private SessionSummary? _selected;
    private List<SessionEntry> _entries = [];
    private bool _loadingDetail;
    private string _detailError = string.Empty;

    private static readonly string Project = Directory.GetCurrentDirectory();
    private const int MaxOutputBytes = 2048;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        try
        {
            _summaries = (await MemoryStore.LoadSummariesAsync(Project, maxCount: 50)).ToList();
        }
        catch (Exception ex)
        {
            _summaries = [];
            _detailError = $"Failed to load activity: {ex.Message}";
        }
    }

    private async Task OnSelectedAsync(SessionSummary summary)
    {
        _selected = summary;
        _loadingDetail = true;
        _detailError = string.Empty;
        _entries = [];
        StateHasChanged();
        try
        {
            var entries = await SessionStore.LoadAsync(summary.SessionId, ownerUserId: Program.SovrantUserId);
            _entries = entries.ToList();
        }
        catch (Exception ex)
        {
            _detailError = $"Failed to load turn detail: {ex.Message}";
        }
        finally
        {
            _loadingDetail = false;
            StateHasChanged();
        }
    }

    private static string Truncate(string s, int max)
    {
        if (string.IsNullOrEmpty(s)) return string.Empty;
        return s.Length <= max ? s : s[..(max - 1)] + "…";
    }

    private static string TruncateOutput(string s)
    {
        if (string.IsNullOrEmpty(s)) return string.Empty;
        return s.Length <= MaxOutputBytes ? s : s[..MaxOutputBytes] + "\n…(truncated)";
    }

    private static string RoleLabel(SessionEntry e) => e.Role switch
    {
        "user" => "User",
        "assistant" => "Assistant",
        "tool_use" => "Tool",
        "tool_result" => "Tool result",
        "system" => "System",
        _ => e.Role,
    };

    private static string RoleClass(SessionEntry e) => e.Role switch
    {
        "user" => "user",
        "assistant" => "assistant",
        "tool_use" or "tool_result" => "tool",
        _ => "system",
    };

    private static string FormatDuration(TimeSpan ts)
    {
        if (ts.TotalSeconds < 60) return $"{ts.TotalSeconds:F0}s";
        if (ts.TotalMinutes < 60) return $"{ts.Minutes}m {ts.Seconds}s";
        return $"{(int)ts.TotalHours}h {ts.Minutes}m";
    }
}
