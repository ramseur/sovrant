@page "/activity"

<div class="settings-page">
    <div class="diag-header">
        <div>
            <h1>Activity</h1>
            <p class="text-secondary" style="margin:0;">Live view of every agent — what's running, what's waiting, what's stuck</p>
        </div>
    </div>

    <div class="empty-state" style="margin-top: 32px; text-align: center; padding: 48px 24px;">
        <div style="font-size: 48px; margin-bottom: 16px;">&#x1F4CA;</div>
        <h2 style="margin: 0 0 8px 0;">Coming soon</h2>
        <p class="text-secondary" style="max-width: 480px; margin: 0 auto;">
            A unified control surface to see what every agent is doing right now — active runs, tool calls in flight,
            pending confirmations, and recent completions across all orchestrations.
        </p>
    </div>
</div>
