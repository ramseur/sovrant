@page "/tools/templates"
@using Sovrant.Tools.Templates
@using Sovrant.Web.Components.Shared
@using Markdig

@if (_editing is not null)
{
    <div class="detail-content" style="padding:0; height:100%;">
        <MarkdownEditor Value="@_editing.Source"
                        Title="@(_editing.IsNew ? "New tool template" : _editing.Slug)"
                        ReadOnly="@_editing.ReadOnly"
                        OnSave="HandleSave"
                        OnCancel="@(() => { _editing = null; return Task.CompletedTask; })" />
    </div>
}
else
{
    <MasterDetailLayout TItem="TemplateItem"
                        Title="Tool Templates"
                        ItemCount="@_filtered.Count"
                        Items="@_filtered"
                        SelectedItem="@_selected"
                        EmptyMessage="No user tool templates. Click + New to create one."
                        OnRefresh="Reload"
                        OnItemSelected="@(t => { _selected = t; return Task.CompletedTask; })"
                        OnSearch="Search">
        <ItemTemplate>
            <div class="item-title">
                @context.Name
                <span class="tier-badge tier-@(context.Tier.ToString().ToLowerInvariant())">@context.Tier.ToString().ToLowerInvariant()</span>
            </div>
            <div class="item-subtitle">@(string.IsNullOrEmpty(context.Category) ? "uncategorized" : context.Category)</div>
        </ItemTemplate>
        <FooterTemplate>
            <button class="btn-primary btn-sm" @onclick="StartNew">+ New template</button>
            <a class="btn-outline btn-sm" href="/tools" style="margin-left:8px;">Built-in tools</a>
        </FooterTemplate>
        <DetailTemplate>
            <div class="detail-content">
                <div style="display:flex; justify-content:space-between; align-items:center; gap:12px;">
                    <h2 style="margin:0;">@context.Name</h2>
                    <div style="display:flex; gap:8px;">
                        @if (context.Tier == UserToolTier.BuiltIn)
                        {
                            <button class="btn-outline btn-sm" @onclick="@(() => StartDuplicate(context))">Duplicate to user</button>
                            <button class="btn-outline btn-sm" @onclick="@(() => StartEdit(context, readOnly: true))">View source</button>
                        }
                        else
                        {
                            <button class="btn-outline btn-sm" @onclick="@(() => StartEdit(context, readOnly: false))">Edit</button>
                            <button class="btn-outline btn-sm" @onclick="@(() => DeleteAsync(context))">Delete</button>
                        }
                    </div>
                </div>
                <div class="detail-meta">
                    <span><code>@context.Slug</code></span>
                    @if (!string.IsNullOrEmpty(context.Category))
                    {
                        <span>@context.Category</span>
                    }
                </div>
                @if (!string.IsNullOrEmpty(context.Description))
                {
                    <p class="text-secondary">@context.Description</p>
                }
                @if (!string.IsNullOrEmpty(context.Body))
                {
                    <h3>Guide</h3>
                    <div class="message-markdown">
                        @((MarkupString)Markdown.ToHtml(context.Body, _pipeline))
                    </div>
                }
            </div>
        </DetailTemplate>
    </MasterDetailLayout>
}

@code {
    [Inject] private UserToolTemplateRegistry Registry { get; set; } = default!;

    private List<TemplateItem> _all = [];
    private List<TemplateItem> _filtered = [];
    private TemplateItem? _selected;
    private EditorState? _editing;

    private static readonly MarkdownPipeline _pipeline = new MarkdownPipelineBuilder()
        .UseAdvancedExtensions().Build();

    private const string NewTemplate = """
        ---
        name: untitled-tool-guide
        description: One-line description of when to use this tool guide.
        category: general
        ---
        ## When to use
        ...

        ## Example
        ...
        """;

    protected override void OnInitialized() => Reload();

    private void Reload()
    {
        _all = Registry.All
            .OrderBy(t => t.Name, StringComparer.OrdinalIgnoreCase)
            .Select(t => new TemplateItem
            {
                Slug = t.Slug,
                Name = t.Name,
                Description = t.Description,
                Category = t.Category,
                Body = t.Body,
                Tier = t.Tier,
                SourcePath = t.SourcePath,
            }).ToList();
        _filtered = _all;
    }

    private void Search(string text)
    {
        _filtered = string.IsNullOrWhiteSpace(text)
            ? _all
            : _all.Where(t =>
                t.Name.Contains(text, StringComparison.OrdinalIgnoreCase) ||
                t.Description.Contains(text, StringComparison.OrdinalIgnoreCase) ||
                t.Category.Contains(text, StringComparison.OrdinalIgnoreCase)
            ).ToList();
    }

    private void StartNew() =>
        _editing = new EditorState { Slug = string.Empty, Source = NewTemplate, IsNew = true, ReadOnly = false };

    private void StartEdit(TemplateItem item, bool readOnly)
    {
        var source = File.Exists(item.SourcePath) ? File.ReadAllText(item.SourcePath) : item.Body;
        _editing = new EditorState
        {
            Slug = item.Slug,
            Source = source,
            IsNew = false,
            ReadOnly = readOnly,
        };
    }

    private void StartDuplicate(TemplateItem item)
    {
        var source = File.Exists(item.SourcePath) ? File.ReadAllText(item.SourcePath) : item.Body;
        _editing = new EditorState { Slug = item.Slug, Source = source, IsNew = true, ReadOnly = false };
    }

    private Task HandleSave(string markdown)
    {
        if (_editing is null) return Task.CompletedTask;
        var slug = ExtractSlug(markdown) ?? _editing.Slug;
        if (string.IsNullOrWhiteSpace(slug)) return Task.CompletedTask;

        Registry.SaveGlobal(slug, markdown);
        _editing = null;
        Reload();
        return Task.CompletedTask;
    }

    private Task DeleteAsync(TemplateItem item)
    {
        Registry.DeleteGlobal(item.Slug);
        if (_selected == item) _selected = null;
        Reload();
        return Task.CompletedTask;
    }

    private static string? ExtractSlug(string markdown)
    {
        if (!markdown.StartsWith("---", StringComparison.Ordinal)) return null;
        var end = markdown.IndexOf("\n---", 3, StringComparison.Ordinal);
        if (end < 0) return null;
        var fm = markdown.Substring(3, end - 3);
        foreach (var line in fm.Split('\n'))
        {
            var trimmed = line.Trim();
            if (trimmed.StartsWith("name:", StringComparison.OrdinalIgnoreCase))
            {
                var raw = trimmed.Substring(5).Trim().Trim('"', '\'');
                return Slugify(raw);
            }
        }
        return null;
    }

    private static string Slugify(string raw)
    {
        var sb = new System.Text.StringBuilder();
        foreach (var c in raw.ToLowerInvariant())
        {
            if (char.IsLetterOrDigit(c)) sb.Append(c);
            else if (c == ' ' || c == '-' || c == '_') sb.Append('-');
        }
        return sb.ToString().Trim('-');
    }

    private sealed class TemplateItem
    {
        public string Slug { get; init; } = string.Empty;
        public string Name { get; init; } = string.Empty;
        public string Description { get; init; } = string.Empty;
        public string Category { get; init; } = string.Empty;
        public string Body { get; init; } = string.Empty;
        public UserToolTier Tier { get; init; }
        public string SourcePath { get; init; } = string.Empty;
    }

    private sealed class EditorState
    {
        public string Slug { get; init; } = string.Empty;
        public string Source { get; init; } = string.Empty;
        public bool IsNew { get; init; }
        public bool ReadOnly { get; init; }
    }
}
