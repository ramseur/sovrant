@page "/artifacts"
@using Sovrant.Runtime.Artifacts
@using Sovrant.Runtime.Workspaces
@using Sovrant.Web.Services
@using Markdig
@using BlazorMonaco.Editor
@implements IAsyncDisposable

@if (!string.IsNullOrEmpty(_loadError))
{
    <div class="page-error-banner" role="alert">
        <span>&#9888;</span>
        <span class="error-message">@_loadError</span>
        <button class="btn-sm" @onclick="LoadAsync">Retry</button>
    </div>
}

<MasterDetailLayout TItem="ArtifactItem"
                    Title="Artifacts"
                    ItemCount="@_filtered.Count"
                    Items="@_filtered"
                    SelectedItem="@_selected"
                    EmptyMessage="No artifacts found."
                    OnRefresh="LoadAsync"
                    OnItemSelected="SelectItem"
                    OnSearch="Search">
    <ItemTemplate>
        @if (context.IsFolder)
        {
            <div class="item-title">📁 @context.FolderName</div>
            <div class="item-subtitle">@context.LastModified.LocalDateTime.ToString("MMM d, yyyy") &middot; @(context.FolderFiles!.Count) files &middot; @context.SizeDisplay</div>
        }
        else
        {
            <div class="item-title">@context.FileName</div>
            <div class="item-subtitle">@context.LastModified.LocalDateTime.ToString("MMM d, yyyy") &middot; @context.SizeDisplay</div>
        }
    </ItemTemplate>
    <DetailTemplate>
        <div class="detail-content">
            @if (context.IsFolder)
            {
                <h2>📁 @context.FolderName</h2>
                <div class="detail-meta">
                    <span>@context.LastModified.LocalDateTime.ToString("MMM d, yyyy h:mm tt")</span>
                    <span>@(context.FolderFiles!.Count) files</span>
                    <span>@context.SizeDisplay total</span>
                </div>
                @if (!string.IsNullOrEmpty(context.ZipUrl))
                {
                    <div class="detail-meta" style="margin-top:6px;">
                        <a href="@context.ZipUrl" download="@($"{context.FolderName}.zip")" class="btn-outline btn-sm">Download all (.zip)</a>
                    </div>
                }
                <div class="artifact-file-list">
                    @foreach (var f in context.FolderFiles!.OrderBy(f => f.ArtifactRelPath, StringComparer.OrdinalIgnoreCase))
                    {
                        <div class="artifact-file-row">
                            <span class="artifact-file-path">@f.ArtifactRelPath</span>
                            <span class="text-muted text-sm">@f.SizeDisplay</span>
                            @if (!string.IsNullOrEmpty(f.AccessUrl))
                            {
                                <a href="@f.AccessUrl" target="_blank" rel="noopener" class="btn-outline btn-sm">Open</a>
                            }
                        </div>
                    }
                </div>
            }
            else
            {
                <h2>@context.FileName</h2>
                <div class="detail-meta">
                    <span>@context.LastModified.LocalDateTime.ToString("MMM d, yyyy h:mm tt")</span>
                    <span>@context.SizeDisplay</span>
                    <span>@context.ContentType</span>
                </div>
                @if (!string.IsNullOrEmpty(context.AccessUrl))
                {
                    <div class="detail-meta" style="margin-top: 6px; gap: 10px;">
                        <a href="@context.AccessUrl" target="_blank" rel="noopener" class="btn-outline btn-sm">Open</a>
                        <a href="@context.AccessUrl" target="_blank" rel="noopener" download="@context.FileName" class="btn-outline btn-sm">Download</a>
                        @if (!string.IsNullOrEmpty(context.ZipUrl))
                        {
                            <a href="@context.ZipUrl" download="@($"{context.RunId}.zip")" class="btn-outline btn-sm">Download run (.zip)</a>
                        }
                    </div>
                }
                @if (context.IsPdf && !string.IsNullOrEmpty(context.AccessUrl))
                {
                    <iframe src="@context.AccessUrl" title="@context.FileName"
                            style="width: 100%; height: 520px; border: 1px solid var(--surface-border); border-radius: 6px; margin-top: 10px; background: #fff;"></iframe>
                }
                else if (context.IsMarkdown && !string.IsNullOrEmpty(context.Preview))
                {
                    <div class="detail-preview message-markdown">
                        @((MarkupString)Markdown.ToHtml(context.Preview, _pipeline))
                    </div>
                }
                else if (context.IsCode && !string.IsNullOrEmpty(_selectedEditorKey))
                {
                    <div style="height: 480px; margin-top: 10px; border-radius: 6px; overflow: hidden;">
                        <div @key="@_selectedEditorKey" style="height: 100%;">
                            <StandaloneCodeEditor @ref="_codeEditor"
                                                  Id="@($"artifact-preview-{Math.Abs(_selectedEditorKey.GetHashCode()):x}")"
                                                  ConstructionOptions="GetCodePreviewOptions" />
                        </div>
                    </div>
                }
                else if (!string.IsNullOrEmpty(context.Preview))
                {
                    <pre class="detail-preview" style="white-space: pre-wrap; font-size: 13px; font-family: Consolas, monospace;">@context.Preview</pre>
                }
                else if (!context.IsPdf && !context.IsCode)
                {
                    <p class="text-muted">No preview available for this file type.</p>
                }
            }
        </div>
    </DetailTemplate>
</MasterDetailLayout>

@code {
    [Inject] private IArtifactStore ArtifactStore { get; set; } = default!;
    [Inject] private IWorkspaceService WorkspaceService { get; set; } = default!;

    private List<ArtifactItem> _all = [];
    private List<ArtifactItem> _filtered = [];
    private ArtifactItem? _selected;
    private string _search = string.Empty;
    private string _loadError = string.Empty;
    private string _selectedEditorKey = string.Empty;
    private StandaloneCodeEditor? _codeEditor;

    private static readonly MarkdownPipeline _pipeline = new MarkdownPipelineBuilder()
        .UseAdvancedExtensions().Build();

    private static readonly HashSet<string> TextExtensions = new(StringComparer.OrdinalIgnoreCase)
    {
        ".md", ".txt", ".json", ".xml", ".html", ".htm", ".css", ".js", ".ts", ".tsx", ".jsx",
        ".cs", ".py", ".go", ".rs", ".java", ".rb", ".php", ".yaml", ".yml", ".toml", ".csv",
        ".log", ".sh", ".ps1", ".sql", ".csproj", ".axaml", ".razor", ".ini", ".cfg", ".conf", ".env",
        ".sln", ".gitignore", ".editorconfig", ".nvmrc", ".env.example",
    };

    private static readonly HashSet<string> CodeExtensions = new(StringComparer.OrdinalIgnoreCase)
    {
        ".ts", ".tsx", ".js", ".jsx", ".cs", ".py", ".go", ".rs", ".java", ".rb", ".php",
        ".json", ".xml", ".html", ".htm", ".css", ".sql", ".sh", ".ps1", ".yaml", ".yml",
        ".toml", ".csproj", ".axaml", ".razor",
    };

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loadError = string.Empty;
        _selected = null;
        _selectedEditorKey = string.Empty;
        try
        {
            var workspaces = await WorkspaceService.ListAllAsync();
            var items = new List<ArtifactItem>();

            foreach (var ws in workspaces)
            {
                // List workspace-level artifacts (DefaultProjectId → workspace scope).
                // Project-level artifacts require enumerating projects and are deferred
                // until multi-user web and project-level artifact display are built.
                var scope = new ArtifactScope
                {
                    WorkspaceId = ws.WorkspaceId,
                    WorkspaceName = ws.Name,
                };

                await foreach (var entry in ArtifactStore.ListAsync(scope))
                {
                    var runId = entry.RunId ?? string.Empty;
                    if (string.IsNullOrEmpty(runId)) continue;

                    // RelativePath when listing without RunId = "{run}/{artifactPath}"
                    var artifactPath = entry.RelativePath.Length > runId.Length + 1
                        ? entry.RelativePath[(runId.Length + 1)..]
                        : entry.RelativePath;

                    var fileName = System.IO.Path.GetFileName(artifactPath);
                    var ext = System.IO.Path.GetExtension(artifactPath);
                    var isCode = CodeExtensions.Contains(ext);

                    // URL layout: /artifacts/{ws}/{proj-or-dir}/{run}/{file}
                    // For workspace-level, the intermediate dir segment is "artifacts"
                    // (the layout: {root}/{ws}/artifacts/{run}) — FindRunDir in Program.cs
                    // matches this correctly via its FindSegmentDir helper.
                    var escapedTail = string.Join('/', artifactPath.Split('/').Select(Uri.EscapeDataString));
                    var accessUrl = $"/artifacts/{Uri.EscapeDataString(ws.WorkspaceId)}/artifacts/{Uri.EscapeDataString(runId)}/{escapedTail}";
                    var zipUrl = $"/artifacts/{Uri.EscapeDataString(ws.WorkspaceId)}/artifacts/{Uri.EscapeDataString(runId)}.zip";

                    items.Add(new ArtifactItem
                    {
                        WorkspaceId = ws.WorkspaceId,
                        WorkspaceName = ws.Name,
                        RunId = runId,
                        FileName = fileName,
                        Extension = ext,
                        ArtifactRelPath = artifactPath,
                        SizeBytes = entry.SizeBytes,
                        SizeDisplay = FormatSize(entry.SizeBytes),
                        ContentType = GuessMime(ext),
                        LastModified = entry.LastModified,
                        IsMarkdown = ext.Equals(".md", StringComparison.OrdinalIgnoreCase),
                        IsPdf = ext.Equals(".pdf", StringComparison.OrdinalIgnoreCase),
                        IsCode = isCode,
                        MonacoLanguage = isCode ? GetMonacoLanguage(ext) : "plaintext",
                        AccessUrl = accessUrl,
                        ZipUrl = zipUrl,
                    });
                }
            }

            // Group multi-file runs into folder items; single-file runs stay flat.
            var grouped = new List<ArtifactItem>();
            foreach (var runGroup in items.GroupBy(a => $"{a.WorkspaceId}/{a.RunId}"))
            {
                var files = runGroup.ToList();
                if (files.Count > 1)
                {
                    var first = files.OrderBy(f => f.LastModified).First();
                    var folderName = first.ArtifactRelPath.Contains('/')
                        ? first.ArtifactRelPath.Split('/')[0]
                        : files[0].RunId;
                    var totalBytes = files.Sum(f => f.SizeBytes);
                    grouped.Add(new ArtifactItem
                    {
                        WorkspaceId = files[0].WorkspaceId,
                        WorkspaceName = files[0].WorkspaceName,
                        RunId = files[0].RunId,
                        IsFolder = true,
                        FolderName = folderName,
                        FolderFiles = files,
                        LastModified = files.Max(f => f.LastModified),
                        SizeBytes = totalBytes,
                        SizeDisplay = FormatSize(totalBytes),
                        ZipUrl = files[0].ZipUrl,
                    });
                }
                else
                {
                    grouped.Add(files[0]);
                }
            }

            _all = grouped.OrderByDescending(a => a.LastModified).ToList();
            ApplyFilter();
        }
        catch (Exception ex)
        {
            _loadError = $"Failed to load artifacts: {ex.Message}";
            _all = [];
            ApplyFilter();
        }
    }

    private async Task SelectItem(ArtifactItem item)
    {
        _selected = item;
        _selectedEditorKey = string.Empty; // hide Monaco while content loads
        StateHasChanged();

        if (string.IsNullOrEmpty(item.Preview) && TextExtensions.Contains(item.Extension) && item.SizeBytes < 512 * 1024)
        {
            try
            {
                var scope = new ArtifactScope
                {
                    WorkspaceId = item.WorkspaceId,
                    WorkspaceName = item.WorkspaceName,
                    RunId = item.RunId,
                };
                var handle = await ArtifactStore.CreateRunScopeAsync(scope);
                await using var stream = await ArtifactStore.ReadAsync(handle, item.ArtifactRelPath);
                using var reader = new System.IO.StreamReader(stream, System.Text.Encoding.UTF8);
                var content = await reader.ReadToEndAsync();
                if (content.Length > 20_000) content = content[..20_000] + "\n\n... (truncated at 20,000 chars)";
                item.Preview = content;
            }
            catch { item.Preview = "(Could not load preview)"; }
        }

        // Reveal Monaco only after content is ready so ConstructionOptions sees the value
        if (item.IsCode && !string.IsNullOrEmpty(item.Preview))
            _selectedEditorKey = $"{item.WorkspaceId}/{item.RunId}/{item.ArtifactRelPath}";

        StateHasChanged();
    }

    private StandaloneEditorConstructionOptions GetCodePreviewOptions(StandaloneCodeEditor _) => new()
    {
        Value = _selected?.Preview ?? string.Empty,
        Language = _selected?.MonacoLanguage ?? "plaintext",
        Theme = "vs-dark",
        AutomaticLayout = true,
        WordWrap = "off",
        Minimap = new EditorMinimapOptions { Enabled = false },
        ReadOnly = true,
        FontSize = 13,
        ScrollBeyondLastLine = false,
        LineNumbers = "on",
    };

    private void Search(string text) { _search = text; ApplyFilter(); }

    private void ApplyFilter()
    {
        if (string.IsNullOrWhiteSpace(_search)) { _filtered = _all; return; }
        _filtered = _all.Where(a =>
            a.IsFolder
                ? a.FolderName.Contains(_search, StringComparison.OrdinalIgnoreCase)
                  || (a.FolderFiles?.Any(f => f.FileName.Contains(_search, StringComparison.OrdinalIgnoreCase)) ?? false)
                : a.FileName.Contains(_search, StringComparison.OrdinalIgnoreCase)).ToList();
    }

    private static string FormatSize(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024.0:F1} KB";
        return $"{bytes / (1024.0 * 1024.0):F1} MB";
    }

    private static string GuessMime(string ext) => ArtifactMime.For(ext);

    private static string GetMonacoLanguage(string ext) => ext.ToLowerInvariant() switch
    {
        ".ts" or ".tsx" => "typescript",
        ".js" or ".jsx" => "javascript",
        ".cs" or ".csproj" => "csharp",
        ".py" => "python",
        ".json" => "json",
        ".xml" or ".axaml" => "xml",
        ".html" or ".htm" or ".razor" => "html",
        ".css" => "css",
        ".sql" => "sql",
        ".yaml" or ".yml" => "yaml",
        ".sh" => "shell",
        ".ps1" => "powershell",
        ".go" => "go",
        ".rs" => "rust",
        ".java" => "java",
        ".rb" => "ruby",
        ".php" => "php",
        ".toml" => "ini",
        _ => "plaintext",
    };

    public async ValueTask DisposeAsync()
    {
        if (_codeEditor is not null)
        {
            try { await _codeEditor.DisposeEditor(); } catch { /* ignore disposal errors */ }
        }
    }

    private sealed class ArtifactItem
    {
        public string WorkspaceId { get; init; } = string.Empty;
        public string WorkspaceName { get; init; } = string.Empty;
        public string RunId { get; init; } = string.Empty;
        public string FileName { get; init; } = string.Empty;
        public string Extension { get; init; } = string.Empty;
        public string ArtifactRelPath { get; init; } = string.Empty;
        public long SizeBytes { get; init; }
        public string SizeDisplay { get; init; } = string.Empty;
        public string ContentType { get; init; } = string.Empty;
        public DateTimeOffset LastModified { get; init; }
        public bool IsMarkdown { get; init; }
        public bool IsPdf { get; init; }
        public bool IsCode { get; init; }
        public string MonacoLanguage { get; init; } = "plaintext";
        public string AccessUrl { get; init; } = string.Empty;
        public string ZipUrl { get; init; } = string.Empty;
        public string? Preview { get; set; }
        // Folder grouping
        public bool IsFolder { get; set; }
        public string FolderName { get; set; } = string.Empty;
        public List<ArtifactItem>? FolderFiles { get; set; }
    }
}
