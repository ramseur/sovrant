@page "/artifacts"
@using Sovrant.Runtime.Artifacts
@using Sovrant.Web.Services
@using Markdig

@if (!string.IsNullOrEmpty(_loadError))
{
    <div class="page-error-banner" role="alert">
        <span>&#9888;</span>
        <span class="error-message">@_loadError</span>
        <button class="btn-sm" @onclick="LoadAsync">Retry</button>
    </div>
}

<MasterDetailLayout TItem="ArtifactItem"
                    Title="Artifacts"
                    ItemCount="@_filtered.Count"
                    Items="@_filtered"
                    SelectedItem="@_selected"
                    EmptyMessage="No artifacts found."
                    OnRefresh="LoadAsync"
                    OnItemSelected="SelectItem"
                    OnSearch="Search">
    <ItemTemplate>
        <div class="item-title">@context.FileName</div>
        <div class="item-subtitle">@context.LastModified.LocalDateTime.ToString("MMM d, yyyy") &middot; @context.SizeDisplay</div>
    </ItemTemplate>
    <DetailTemplate>
        <div class="detail-content">
            <h2>@context.FileName</h2>
            <div class="detail-meta">
                <span>@context.LastModified.LocalDateTime.ToString("MMM d, yyyy h:mm tt")</span>
                <span>@context.SizeDisplay</span>
                <span>@context.ContentType</span>
            </div>
            @if (!string.IsNullOrEmpty(context.AccessUrl))
            {
                <div class="detail-meta" style="margin-top: 6px; gap: 10px;">
                    <a href="@context.AccessUrl" target="_blank" rel="noopener" class="btn-outline btn-sm">Open</a>
                    <a href="@context.AccessUrl" target="_blank" rel="noopener" download="@context.FileName" class="btn-outline btn-sm">Download</a>
                </div>
            }
            @if (context.IsPdf && !string.IsNullOrEmpty(context.AccessUrl))
            {
                <iframe src="@context.AccessUrl" title="@context.FileName"
                        style="width: 100%; height: 520px; border: 1px solid var(--surface-border); border-radius: 6px; margin-top: 10px; background: #fff;"></iframe>
            }
            else if (context.IsMarkdown && !string.IsNullOrEmpty(context.Preview))
            {
                <div class="detail-preview message-markdown">
                    @((MarkupString)Markdown.ToHtml(context.Preview, _pipeline))
                </div>
            }
            else if (!string.IsNullOrEmpty(context.Preview))
            {
                <pre class="detail-preview" style="white-space: pre-wrap; font-size: 13px; font-family: Consolas, monospace;">@context.Preview</pre>
            }
            else if (!context.IsPdf)
            {
                <p class="text-muted">No preview available for this file type.</p>
            }
        </div>
    </DetailTemplate>
</MasterDetailLayout>

@code {
    [Inject] private IArtifactStore ArtifactStore { get; set; } = default!;

    private List<ArtifactItem> _all = [];
    private List<ArtifactItem> _filtered = [];
    private ArtifactItem? _selected;
    private string _search = string.Empty;
    private string _loadError = string.Empty;

    private static readonly MarkdownPipeline _pipeline = new MarkdownPipelineBuilder()
        .UseAdvancedExtensions().Build();

    private static readonly HashSet<string> TextExtensions = new(StringComparer.OrdinalIgnoreCase)
    {
        ".md", ".txt", ".json", ".xml", ".html", ".css", ".js", ".ts", ".cs", ".py",
        ".yaml", ".yml", ".toml", ".csv", ".log", ".sh", ".ps1", ".sql",
    };

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private Task LoadAsync()
    {
        _loadError = string.Empty;
        try
        {
            var root = (ArtifactStore as LocalArtifactStore)?.Root;
            if (root is null || !Directory.Exists(root))
            {
                _all = [];
                ApplyFilter();
                return Task.CompletedTask;
            }

            var items = new List<ArtifactItem>();
            foreach (var file in Directory.EnumerateFiles(root, "*", SearchOption.AllDirectories))
            {
                var fileName = System.IO.Path.GetFileName(file);
                if (string.Equals(fileName, "_manifest.json", StringComparison.OrdinalIgnoreCase))
                    continue;

                var relativePath = System.IO.Path.GetRelativePath(root, file).Replace('\\', '/');
                var segments = relativePath.Split('/');
                if (segments.Length < 4) continue;

                var info = new FileInfo(file);
                var ext = System.IO.Path.GetExtension(file);

                var workspaceId = SegmentId(segments[0]);
                var projectId = SegmentId(segments[1]);
                var runId = segments[2];
                var artifactPath = string.Join('/', segments[3..]);

                var accessUrl = string.Empty;
                if (!string.IsNullOrEmpty(workspaceId) && !string.IsNullOrEmpty(projectId) && !string.IsNullOrEmpty(runId))
                {
                    var escapedTail = string.Join('/', artifactPath.Split('/').Select(Uri.EscapeDataString));
                    accessUrl = $"/artifacts/{Uri.EscapeDataString(workspaceId)}/{Uri.EscapeDataString(projectId)}/{Uri.EscapeDataString(runId)}/{escapedTail}";
                }

                items.Add(new ArtifactItem
                {
                    FullDiskPath = file,
                    FileName = fileName,
                    Extension = ext,
                    SizeBytes = info.Length,
                    SizeDisplay = FormatSize(info.Length),
                    ContentType = GuessMime(ext),
                    LastModified = new DateTimeOffset(info.LastWriteTimeUtc, TimeSpan.Zero),
                    IsMarkdown = ext.Equals(".md", StringComparison.OrdinalIgnoreCase),
                    IsPdf = ext.Equals(".pdf", StringComparison.OrdinalIgnoreCase),
                    AccessUrl = accessUrl,
                });
            }

            _all = items.OrderByDescending(a => a.LastModified).ToList();
            ApplyFilter();
        }
        catch (Exception ex)
        {
            _loadError = $"Failed to load artifacts: {ex.Message}";
            _all = [];
            ApplyFilter();
        }
        return Task.CompletedTask;
    }

    private async Task SelectItem(ArtifactItem item)
    {
        _selected = item;
        if (string.IsNullOrEmpty(item.Preview) && TextExtensions.Contains(item.Extension) && item.SizeBytes < 512 * 1024)
        {
            try
            {
                if (File.Exists(item.FullDiskPath))
                {
                    var content = await File.ReadAllTextAsync(item.FullDiskPath);
                    if (content.Length > 20000) content = content[..20000] + "\n\n... (truncated at 20,000 chars)";
                    item.Preview = content;
                    StateHasChanged();
                }
            }
            catch { item.Preview = "(Could not load preview)"; }
        }
    }

    private void Search(string text) { _search = text; ApplyFilter(); }

    private void ApplyFilter()
    {
        _filtered = string.IsNullOrWhiteSpace(_search)
            ? _all
            : _all.Where(a => a.FileName.Contains(_search, StringComparison.OrdinalIgnoreCase)).ToList();
    }

    private static string FormatSize(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024.0:F1} KB";
        return $"{bytes / (1024.0 * 1024.0):F1} MB";
    }

    private static string GuessMime(string ext) => ArtifactMime.For(ext);

    private static string SegmentId(string segment)
    {
        var idx = segment.IndexOf("__", StringComparison.Ordinal);
        return idx >= 0 ? segment[..idx] : segment;
    }

    private sealed class ArtifactItem
    {
        public string FullDiskPath { get; init; } = string.Empty;
        public string FileName { get; init; } = string.Empty;
        public string Extension { get; init; } = string.Empty;
        public long SizeBytes { get; init; }
        public string SizeDisplay { get; init; } = string.Empty;
        public string ContentType { get; init; } = string.Empty;
        public DateTimeOffset LastModified { get; init; }
        public bool IsMarkdown { get; init; }
        public bool IsPdf { get; init; }
        public string AccessUrl { get; init; } = string.Empty;
        public string? Preview { get; set; }
    }
}
