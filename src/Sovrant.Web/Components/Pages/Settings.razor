@page "/settings"
@using Sovrant.Api.Auth
@using Sovrant.Runtime.Config
@using Sovrant.Runtime.Mcp
@using Sovrant.Runtime.Permissions
@using Sovrant.Runtime.Preferences
@using Sovrant.Web.Services

<div class="settings-page">
    <h1>Settings</h1>

    <!-- General section -->
    <div class="settings-section">
        <h2>Permissions</h2>
        <div class="form-field">
            <label>Permission Mode</label>
            <select @bind="_permissionMode" @bind:after="OnPermissionModeChanged">
                <option value="Default">Default</option>
                <option value="AcceptEdits">AcceptEdits</option>
                <option value="BypassPermissions">BypassPermissions</option>
            </select>
            <span class="text-muted text-sm">
                <strong>Default</strong> — ask before destructive ops.
                <strong>AcceptEdits</strong> — auto-approve edits, ask for bash.
                <strong>BypassPermissions</strong> — allow all.
            </span>
        </div>

        <h2>Appearance</h2>
        <div class="toggle-card">
            <div>
                <div class="toggle-title">Dark Mode</div>
                <div class="toggle-desc">Switch between dark and light theme</div>
            </div>
            <label class="switch">
                <input type="checkbox" checked="@_isDarkMode" @onchange="ToggleTheme" />
                <span class="slider"></span>
            </label>
        </div>

        @if (!string.IsNullOrEmpty(_statusMessage))
        {
            <div class="status-message">@_statusMessage</div>
        }

        <p class="text-muted text-sm">Settings auto-save when changed.</p>

        <h2>Account</h2>
        <div class="settings-section-row">
            <button class="btn btn-secondary" @onclick="LogoutAsync">Log out</button>
        </div>
    </div>
</div>

@code {
    [Inject] private SovrantConfig Config { get; set; } = default!;
    [Inject] private IPermissionModeAccessor PermissionModeAccessor { get; set; } = default!;
    [Inject] private IJSRuntime JS { get; set; } = default!;
    [Inject] private IUserPreferenceStore Prefs { get; set; } = default!;
    [Inject] private ICredentialStore Credentials { get; set; } = default!;
    [Inject] private WebSessionService Session { get; set; } = default!;
    [Inject] private NavigationManager Nav { get; set; } = default!;

    private string _permissionMode = "Default";
    private bool _isDarkMode = true;
    private string _statusMessage = string.Empty;

    private CancellationTokenSource? _autoSaveCts;

    protected override async Task OnInitializedAsync()
    {
        _permissionMode = PermissionModeAccessor.Mode.ToString();
        await Task.CompletedTask;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var theme = await JS.InvokeAsync<string>("sovrantInterop.getTheme");
            _isDarkMode = theme != "light";
            StateHasChanged();
        }
    }

    private void OnPermissionModeChanged()
    {
        if (Enum.TryParse<PermissionMode>(_permissionMode, out var mode))
            PermissionModeAccessor.Mode = mode;
        ScheduleAutoSave();
    }

    private async Task ToggleTheme(ChangeEventArgs e)
    {
        _isDarkMode = (bool)(e.Value ?? true);
        await JS.InvokeVoidAsync("sovrantInterop.setTheme", _isDarkMode ? "dark" : "light");
        ScheduleAutoSave();
    }

    private void ScheduleAutoSave()
    {
        _autoSaveCts?.Cancel();
        _autoSaveCts = new CancellationTokenSource();
        var token = _autoSaveCts.Token;
        _ = Task.Run(async () =>
        {
            try { await Task.Delay(600, token); await InvokeAsync(async () => await SaveAsync()); }
            catch (OperationCanceledException) { }
        }, token);
    }

    private async Task SaveAsync()
    {
        try
        {
            var userId = Session.UserId!;
            await Prefs.SetAsync(userId, UserPreferenceKeys.PermissionMode, _permissionMode);

            if (Enum.TryParse<PermissionMode>(_permissionMode, out var pm))
                Config.PermissionMode = pm;

            _statusMessage = "Settings saved.";
        }
        catch (Exception ex) { _statusMessage = $"Save failed: {ex.Message}"; }
        StateHasChanged();
    }

    private const string StoredWebTokenKey = "sovrant.web.auth_token";

    private async Task LogoutAsync()
    {
        await Credentials.DeleteAsync(StoredWebTokenKey).ConfigureAwait(false);
        Session.SignOut();
        Nav.NavigateTo("/login", forceLoad: false);
    }
}
