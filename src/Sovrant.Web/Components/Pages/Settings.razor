@page "/settings"
@using Microsoft.Extensions.DependencyInjection
@using Sovrant.Api.Routing
@using Sovrant.Runtime.Config
@using Sovrant.Runtime.Permissions
@using Sovrant.Web.Adapters
@using System.Text.Json
@using System.Text.Json.Serialization
@using Sovrant.Web.Services

<div class="settings-page">
    <h1>Settings</h1>

    <!-- Tab bar -->
    <div class="tab-bar">
        <button class="tab-btn @(_selectedTab == 0 ? "active" : "")" @onclick="() => _selectedTab = 0">Providers</button>
        <button class="tab-btn @(_selectedTab == 1 ? "active" : "")" @onclick="() => _selectedTab = 1">General</button>
    </div>

    @if (_selectedTab == 0)
    {
        <!-- Providers tab -->
        <div class="settings-section">
            <h2>Your Providers</h2>
            <p class="text-muted text-sm">Configure API keys and endpoints. The model dropdown above uses the active provider's connection.</p>

            @if (_savedProfiles.Count == 0)
            {
                <p class="text-secondary">Add a provider below to get started.</p>
            }
            @foreach (var profile in _savedProfiles)
            {
                <div class="provider-card">
                    <div class="provider-info">
                        <div class="provider-name">@profile.Provider</div>
                        <div class="provider-detail">@profile.BaseUrl</div>
                    </div>
                    <div class="provider-actions">
                        <button class="btn-sm btn-primary" @onclick="() => ActivateProfile(profile)">Activate</button>
                        <button class="btn-sm btn-danger" @onclick="() => DeleteProfile(profile)">X</button>
                    </div>
                </div>
            }

            <h2 class="mt-16">Add Provider</h2>

            <form autocomplete="off" @onsubmit:preventDefault>
            <div class="form-field">
                <label>Provider</label>
                <select @bind="_selectedProvider" @bind:after="OnProviderChanged">
                    @foreach (var p in Providers)
                    {
                        <option value="@p">@p</option>
                    }
                </select>
            </div>

            <div class="form-field">
                <label>API Key</label>
                <input type="password" @bind="_apiKey" placeholder="sk-..." autocomplete="off" data-lpignore="true" data-1p-ignore />
            </div>

            <div class="form-field">
                <label>Base URL</label>
                <input type="text" @bind="_baseUrl" placeholder="https://api.openai.com/v1" />
                <span class="text-muted text-sm">Auto-filled when you select a provider. Edit for custom endpoints.</span>
            </div>

            <div class="card">
                <div class="form-field">
                    <input type="text" @bind="_newProfileName" placeholder="Display name (or leave blank for auto)" />
                </div>
                <button class="btn-primary" @onclick="AddProvider">Add Provider</button>
            </div>
            </form>

            @if (!string.IsNullOrEmpty(_statusMessage))
            {
                <div class="status-message">@_statusMessage</div>
            }

            <p class="text-muted text-sm">Providers are stored in ~/.sovrant/providers.json. Click Activate to switch the active provider.</p>
        </div>
    }
    else
    {
        <!-- General tab -->
        <div class="settings-section">
            <div class="form-field">
                <label>Max Output Tokens</label>
                <input type="number" @bind="_maxOutputTokens" min="256" max="128000" step="1000" />
            </div>

            <div class="toggle-card">
                <div>
                    <div class="toggle-title">Streaming</div>
                    <div class="toggle-desc">Stream response tokens as they arrive</div>
                </div>
                <label class="switch">
                    <input type="checkbox" @bind="_streaming" />
                    <span class="slider"></span>
                </label>
            </div>

            <div class="toggle-card">
                <div>
                    <div class="toggle-title">Intent Routing</div>
                    <div class="toggle-desc">Auto-select model tier based on message intent (fast/standard/high)</div>
                </div>
                <label class="switch">
                    <input type="checkbox" @bind="_intentRoutingEnabled" @bind:after="OnIntentRoutingChanged" />
                    <span class="slider"></span>
                </label>
            </div>

            <h2>Permissions</h2>
            <div class="form-field">
                <label>Permission Mode</label>
                <select @bind="_permissionMode" @bind:after="OnPermissionModeChanged">
                    <option value="Default">Default</option>
                    <option value="AcceptEdits">AcceptEdits</option>
                    <option value="BypassPermissions">BypassPermissions</option>
                </select>
                <span class="text-muted text-sm">
                    <strong>Default</strong> — ask before destructive ops.
                    <strong>AcceptEdits</strong> — auto-approve edits, ask for bash.
                    <strong>BypassPermissions</strong> — allow all.
                </span>
            </div>

            <h2>Appearance</h2>
            <div class="toggle-card">
                <div>
                    <div class="toggle-title">Dark Mode</div>
                    <div class="toggle-desc">Switch between dark and light theme</div>
                </div>
                <label class="switch">
                    <input type="checkbox" checked="@_isDarkMode" @onchange="ToggleTheme" />
                    <span class="slider"></span>
                </label>
            </div>

            @if (!string.IsNullOrEmpty(_statusMessage))
            {
                <div class="status-message">@_statusMessage</div>
            }

            <p class="text-muted text-sm">Settings auto-save when changed.</p>
        </div>
    }
</div>

@code {
    [Inject] private SovrantConfig Config { get; set; } = default!;
    [Inject] private IPermissionModeAccessor PermissionModeAccessor { get; set; } = default!;
    [Inject] private MutableAuthProvider AuthProvider { get; set; } = default!;
    [Inject] private IJSRuntime JS { get; set; } = default!;
    [Inject] private ActiveContextService ActiveContext { get; set; } = default!;
    [Inject] private IServiceProvider Services { get; set; } = default!;

    private ISmartRouter? _router;
    private int _selectedTab;
    private string _selectedProvider = "OpenAI";
    private string _apiKey = string.Empty;
    private string _baseUrl = string.Empty;
    private int _maxOutputTokens = 32000;
    private bool _streaming = true;
    private string _permissionMode = "Default";
    private bool _isDarkMode = true;
    private string _statusMessage = string.Empty;
    private string _newProfileName = string.Empty;
    private bool _intentRoutingEnabled;
    private List<ProviderProfile> _savedProfiles = [];

    private CancellationTokenSource? _autoSaveCts;

    private static readonly string SettingsPath = Path.Combine(
        Environment.GetFolderPath(Environment.SpecialFolder.UserProfile), ".sovrant", "settings.json");
    private static readonly string ProfilesPath = Path.Combine(
        Environment.GetFolderPath(Environment.SpecialFolder.UserProfile), ".sovrant", "providers.json");

    private static readonly JsonSerializerOptions SerializerOptions = new()
    {
        WriteIndented = true,
        DefaultIgnoreCondition = JsonIgnoreCondition.WhenWritingNull,
    };

    private static readonly Dictionary<string, string> ProviderBaseUrls = new(StringComparer.Ordinal)
    {
        ["OpenAI"] = "https://api.openai.com/v1",
        ["OpenRouter"] = "https://openrouter.ai/api/v1",
        ["DeepSeek"] = "https://api.deepseek.com/v1",
        ["Groq"] = "https://api.groq.com/openai/v1",
        ["Mistral"] = "https://api.mistral.ai/v1",
        ["Together AI"] = "https://api.together.xyz/v1",
        ["Ollama"] = "http://localhost:11434/v1",
        ["LM Studio"] = "http://localhost:1234/v1",
        ["Google"] = "https://generativelanguage.googleapis.com/v1beta/openai",
        ["Azure OpenAI"] = "",
        ["Custom"] = "",
    };

    private static readonly string[] Providers =
        ["OpenAI", "DeepSeek", "Groq", "Mistral", "Together AI", "Azure OpenAI", "Google", "OpenRouter", "Ollama", "LM Studio", "Custom"];

    protected override async Task OnInitializedAsync()
    {
        _router = Services.GetService<ISmartRouter>();
        _maxOutputTokens = Config.MaxTokens;
        _apiKey = Config.ApiKey ?? string.Empty;
        _baseUrl = Config.BaseUrl?.ToString() ?? string.Empty;
        _permissionMode = PermissionModeAccessor.Mode.ToString();
        _intentRoutingEnabled = _router?.IntentRoutingEnabled ?? false;
        _selectedProvider = InferProvider();
        LoadProfiles();
        await Task.CompletedTask;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var theme = await JS.InvokeAsync<string>("sovrantInterop.getTheme");
            _isDarkMode = theme != "light";
            StateHasChanged();
        }
    }

    private void OnProviderChanged()
    {
        if (ProviderBaseUrls.TryGetValue(_selectedProvider, out var url))
            _baseUrl = url;
        // Auto-apply saved profile credentials for this provider.
        var profile = _savedProfiles.FirstOrDefault(p =>
            p.Provider.Equals(_selectedProvider, StringComparison.OrdinalIgnoreCase));
        if (profile is not null)
        {
            _apiKey = profile.ApiKey;
            _baseUrl = profile.BaseUrl;
        }
    }

    private async Task AddProvider()
    {
        if (string.IsNullOrWhiteSpace(_apiKey)) { _statusMessage = "Please enter an API key."; return; }

        var displayName = string.IsNullOrWhiteSpace(_newProfileName)
            ? _selectedProvider : _newProfileName.Trim();

        // Update existing profile for same provider, or add new one.
        var existing = _savedProfiles.FirstOrDefault(p =>
            p.Provider.Equals(_selectedProvider, StringComparison.OrdinalIgnoreCase));
        if (existing is not null)
        {
            existing.Name = displayName;
            existing.ApiKey = _apiKey; existing.BaseUrl = _baseUrl; existing.MaxTokens = _maxOutputTokens;
        }
        else
        {
            _savedProfiles.Add(new ProviderProfile
            {
                Name = displayName, Provider = _selectedProvider,
                ApiKey = _apiKey, BaseUrl = _baseUrl, MaxTokens = _maxOutputTokens,
            });
        }
        PersistProfiles();
        await ActivateProfile(_savedProfiles.First(p =>
            p.Provider.Equals(_selectedProvider, StringComparison.OrdinalIgnoreCase)));
        _newProfileName = string.Empty;
        _statusMessage = $"Provider '{_selectedProvider}' saved and activated.";
    }

    private async Task ActivateProfile(ProviderProfile profile)
    {
        _selectedProvider = profile.Provider; _apiKey = profile.ApiKey; _baseUrl = profile.BaseUrl;
        _maxOutputTokens = profile.MaxTokens;
        await SaveAsync();
        _statusMessage = $"Switched to '{profile.Name}'.";
    }

    private void DeleteProfile(ProviderProfile profile)
    {
        _savedProfiles.Remove(profile);
        PersistProfiles();
        _statusMessage = $"Profile '{profile.Name}' deleted.";
    }

    private void LoadProfiles()
    {
        _savedProfiles.Clear();
        if (!File.Exists(ProfilesPath)) return;
        try
        {
            var json = File.ReadAllText(ProfilesPath);
            _savedProfiles = JsonSerializer.Deserialize<List<ProviderProfile>>(json, SerializerOptions) ?? [];
        }
        catch { /* ignore */ }
    }

    private void PersistProfiles()
    {
        try
        {
            Directory.CreateDirectory(Path.GetDirectoryName(ProfilesPath)!);
            File.WriteAllText(ProfilesPath, JsonSerializer.Serialize(_savedProfiles, SerializerOptions));
        }
        catch { /* best effort */ }
    }

    private void OnPermissionModeChanged()
    {
        if (Enum.TryParse<PermissionMode>(_permissionMode, out var mode))
            PermissionModeAccessor.Mode = mode;
        ScheduleAutoSave();
    }

    private void OnIntentRoutingChanged()
    {
        if (_router is not null)
            _router.IntentRoutingEnabled = _intentRoutingEnabled;
        ScheduleAutoSave();
    }

    private async Task ToggleTheme(ChangeEventArgs e)
    {
        _isDarkMode = (bool)(e.Value ?? true);
        await JS.InvokeVoidAsync("sovrantInterop.setTheme", _isDarkMode ? "dark" : "light");
        ScheduleAutoSave();
    }

    private void ScheduleAutoSave()
    {
        _autoSaveCts?.Cancel();
        _autoSaveCts = new CancellationTokenSource();
        var token = _autoSaveCts.Token;
        _ = Task.Run(async () =>
        {
            try { await Task.Delay(600, token); await InvokeAsync(async () => await SaveAsync()); }
            catch (OperationCanceledException) { }
        }, token);
    }

    private async Task SaveAsync()
    {
        try
        {
            Directory.CreateDirectory(Path.GetDirectoryName(SettingsPath)!);
            Dictionary<string, object?> existing = [];
            if (File.Exists(SettingsPath))
                existing = JsonSerializer.Deserialize<Dictionary<string, object?>>(await File.ReadAllTextAsync(SettingsPath)) ?? [];

            existing["Provider"] = _selectedProvider;
            existing["Model"] = Config.Model;
            existing["MaxTokens"] = _maxOutputTokens;
            existing["PermissionMode"] = _permissionMode;
            existing["IntentRouting"] = _intentRoutingEnabled;
            if (!string.IsNullOrWhiteSpace(_apiKey)) existing["ApiKey"] = _apiKey;
            if (!string.IsNullOrWhiteSpace(_baseUrl)) existing["BaseUrl"] = _baseUrl; else existing.Remove("BaseUrl");

            await File.WriteAllTextAsync(SettingsPath, JsonSerializer.Serialize(existing, SerializerOptions));

            // Hot-swap runtime config, env vars, and auth provider.
            // Model is managed by sidebar dropdown, not settings.
            Config.MaxTokens = _maxOutputTokens;
            if (Enum.TryParse<PermissionMode>(_permissionMode, out var pm))
                Config.PermissionMode = pm;

            if (!string.IsNullOrWhiteSpace(_apiKey))
            {
                Config.ApiKey = _apiKey.Trim();
                Environment.SetEnvironmentVariable("LLM_API_KEY", _apiKey.Trim());
                AuthProvider.ApiKey = _apiKey.Trim();
                if (_baseUrl.Contains("openrouter", StringComparison.OrdinalIgnoreCase))
                    Environment.SetEnvironmentVariable("OPENROUTER_API_KEY", _apiKey.Trim());
            }

            if (!string.IsNullOrWhiteSpace(_baseUrl))
            {
                var parsed = new Uri(_baseUrl.Trim());
                Config.BaseUrl = parsed;
                AuthProvider.BaseUrl = parsed;
                Environment.SetEnvironmentVariable("LLM_BASE_URL", _baseUrl.Trim());
            }
            else
            {
                Config.BaseUrl = null;
                AuthProvider.BaseUrl = null;
                Environment.SetEnvironmentVariable("LLM_BASE_URL", null);
            }

            ActiveContext.SetModel(Config.Model, _selectedProvider);
            _statusMessage = "Settings saved.";
        }
        catch (Exception ex) { _statusMessage = $"Save failed: {ex.Message}"; }
        StateHasChanged();
    }

    private string InferProvider()
    {
        try
        {
            if (File.Exists(SettingsPath))
            {
                var json = File.ReadAllText(SettingsPath);
                using var doc = JsonDocument.Parse(json);
                if (doc.RootElement.TryGetProperty("Provider", out var prop) && prop.GetString() is { Length: > 0 } saved)
                    return saved;
            }
        }
        catch { }
        var url = Config.BaseUrl?.ToString() ?? string.Empty;
        if (url.Contains("openrouter", StringComparison.OrdinalIgnoreCase)) return "OpenRouter";
        if (url.Contains("deepseek", StringComparison.OrdinalIgnoreCase)) return "DeepSeek";
        return "OpenAI";
    }

    private class ProviderProfile
    {
        public string Name { get; set; } = string.Empty;
        public string Provider { get; set; } = string.Empty;
        public string ApiKey { get; set; } = string.Empty;
        public string BaseUrl { get; set; } = string.Empty;
        public int MaxTokens { get; set; } = 32000;
    }
}
