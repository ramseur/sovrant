@page "/workflows"
@using System.Text.Json
@using Sovrant.Runtime.Artifacts
@using Sovrant.Runtime.Engine
@using Sovrant.Runtime.Storage
@using Sovrant.Runtime.Workflows
@using Sovrant.Web.Services
@implements IDisposable

<div class="master-detail">
    <div class="master-panel">
        <div class="master-header">
            <h1>Workflows</h1>
            <div class="master-header-right">
                <span class="item-count">@_filtered.Count</span>
                <button class="btn-sm btn-primary" title="New workflow"
                        @onclick="StartCreate">+ New</button>
            </div>
        </div>

        <div class="master-search">
            <input type="text" placeholder="Search workflows..."
                   @bind="_search" @bind:event="oninput" @bind:after="ApplyFilter" />
        </div>

        <div class="master-list">
            @if (_filtered.Count == 0)
            {
                <p class="text-secondary" style="padding:12px;">@EmptyMessage()</p>
            }
            else
            {
                @foreach (var item in _filtered)
                {
                    <button class="master-item @(ReferenceEquals(item, _selected) && !_isCreating ? "active" : "")"
                            @onclick="() => Select(item)">
                        <div class="item-title">
                            <span class="cc-status cc-status-@item.Status.ToString().ToLowerInvariant()">@item.Status</span>
                            <span>@Truncate(item.Goal, 48)</span>
                        </div>
                        <div class="item-subtitle">@Subtitle(item)</div>
                    </button>
                }
            }
        </div>
    </div>

    <div class="detail-panel">
        @if (!string.IsNullOrEmpty(_status))
        {
            <div class="status-message" style="margin:16px 24px 0;">@_status</div>
        }

        @if (_isCreating)
        {
            <!-- ── New Workflow form ─────────────────────────────────── -->
            <div class="detail-content">
                <div class="orch-detail-header">
                    <h2>New Workflow</h2>
                    <button class="btn-sm btn-outline" @onclick="CancelCreate">Cancel</button>
                </div>
                <div class="gov-card orch-form" style="max-width:560px;">
                    <div style="display:flex;flex-direction:column;gap:6px;">
                        <span>Goal</span>
                        <textarea class="gov-field-input" rows="3"
                                  placeholder="Describe what you want accomplished…"
                                  style="width:100%;resize:vertical;"
                                  @bind="_createGoal" @bind:event="oninput"></textarea>
                    </div>
                </div>
                <div style="display:flex;gap:8px;margin-top:12px;align-items:center;">
                    <button class="btn-primary" style="max-width:180px;"
                            disabled="@(string.IsNullOrWhiteSpace(_createGoal) || _isGeneratingPlan)"
                            @onclick="ConfirmCreate">Create Workflow</button>
                    <button class="btn-outline" style="max-width:200px;"
                            disabled="@(string.IsNullOrWhiteSpace(_createGoal) || _isGeneratingPlan)"
                            title="Ask the model to break this goal into steps you can review and edit before anything runs"
                            @onclick="GeneratePlanAsync">@(_isGeneratingPlan ? "Generating…" : "Generate Plan first")</button>
                    <button class="btn-outline btn-sm" @onclick="CancelCreate">Cancel</button>
                </div>
            </div>
        }
        else if (_selected is not null)
        {
            <div class="detail-content">
                <div class="orch-detail-header">
                    <div>
                        <span class="cc-status cc-status-@_selected.Status.ToString().ToLowerInvariant()">@_selected.Status</span>
                        <h2>@_selected.Goal</h2>
                        @if (_artifactCount > 0)
                        {
                            <a href="/artifacts" class="text-muted text-sm" style="display:inline-block;margin-top:4px;">📎 @_artifactCount artifact@(_artifactCount == 1 ? "" : "s")</a>
                        }
                    </div>
                    @if (!IsTerminal(_selected.Status))
                    {
                        <button class="btn-sm btn-danger" @onclick="CancelWorkflowAsync">Cancel</button>
                    }
                </div>

                <!-- ── Plan ──────────────────────────────────────────── -->
                <div class="orch-detail-section">
                    <h3>Plan</h3>
                    @if (IsPlanReview)
                    {
                        <p class="text-muted text-sm" style="margin-bottom:8px;">
                            Awaiting your review. Edit the steps below, then Save, or Resume to run as-is.
                        </p>
                        @for (var i = 0; i < _editableSteps.Count; i++)
                        {
                            var idx = i;
                            var step = _editableSteps[idx];
                            <div class="gov-card" style="margin-bottom:8px;padding:10px 12px;display:flex;flex-direction:column;gap:6px;">
                                <div style="display:flex;gap:8px;align-items:center;">
                                    <span class="text-muted text-sm" style="flex-shrink:0;">@(idx + 1).</span>
                                    <input class="gov-field-input" style="flex:1;" placeholder="Intent"
                                           value="@step.Intent" @oninput="e => step.Intent = (string)e.Value!" />
                                    <select class="gov-field-input" style="max-width:110px;"
                                            value="@step.Tier" @onchange="e => step.Tier = (string)e.Value!">
                                        <option value="Standard">Standard</option>
                                        <option value="High">High</option>
                                        <option value="Fast">Fast</option>
                                    </select>
                                    <button class="btn-sm btn-outline" title="Remove step"
                                            disabled="@(_editableSteps.Count <= 1)"
                                            @onclick="() => RemoveStep(idx)">✕</button>
                                </div>
                                <input class="gov-field-input" placeholder="Expected outcome"
                                       value="@step.Expected" @oninput="e => step.Expected = (string)e.Value!" />
                            </div>
                        }
                        <div style="display:flex;gap:8px;margin-top:4px;">
                            <button class="btn-outline btn-sm" @onclick="AddStep">+ Add step</button>
                            <button class="btn-primary btn-sm" @onclick="SavePlanAsync" disabled="@_isSavingPlan">
                                @(_isSavingPlan ? "Saving…" : "Save changes")
                            </button>
                        </div>
                    }
                    else if (_selectedPlan is null || _selectedPlan.Steps.Count == 0)
                    {
                        <p class="text-muted text-sm">No plan yet.</p>
                    }
                    else
                    {
                        @foreach (var step in _selectedPlan.Steps)
                        {
                            <div class="ma-member-card">
                                <div class="ma-member-info">
                                    <div>
                                        <span class="ma-member-name">@(step.Index + 1). @step.Intent</span>
                                    </div>
                                    <div class="ma-member-meta"><span>@step.ExpectedOutcome</span></div>
                                </div>
                                <span class="ma-role-badge">@step.ModelTier</span>
                            </div>
                        }
                    }
                </div>

                <!-- ── Event journal (chat-style) ───────────────────────── -->
                <div class="orch-detail-section">
                    <h3>Event Journal</h3>
                    @if (_journalItems.Count == 0)
                    {
                        <p class="text-muted text-sm">No events yet.</p>
                    }
                    else
                    {
                        <div class="wf-journal">
                            @foreach (var item in _journalItems)
                            {
                                @if (item.Kind == JournalItemKind.SystemEvent)
                                {
                                    <div class="wf-journal-system">
                                        <span class="wf-journal-time">@item.Timestamp.ToLocalTime().ToString("HH:mm:ss")</span>
                                        <span>@item.Text</span>
                                    </div>
                                }
                                else
                                {
                                    <div class="msg-card @(item.IsError ? "wf-journal-error" : "")" style="margin-bottom:10px;">
                                        <div class="msg-row">
                                            <div class="msg-avatar sovrant-avatar">
                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
                                            </div>
                                            <span class="msg-sender">@(item.IsError ? "Step failed" : "Step output")</span>
                                            <span class="wf-journal-time">@item.Timestamp.ToLocalTime().ToString("HH:mm:ss")</span>
                                        </div>
                                        <div class="msg-indent message-text">@item.Text</div>
                                    </div>
                                }
                            }
                        </div>
                    }
                </div>

                <!-- ── Actions ───────────────────────────────────────── -->
                <div class="orch-detail-section" style="display:flex;gap:12px;align-items:center;">
                    @if (_selected.Status == WorkflowStatus.Running)
                    {
                        <span class="text-muted text-sm">Already running — check back, or the scheduler will keep it moving.</span>
                    }
                    else if (!IsTerminal(_selected.Status))
                    {
                        <button class="btn-primary" style="max-width:180px;"
                                disabled="@_isRunning"
                                @onclick="RunNowAsync">
                            @(_isRunning ? "Running…" : (_selected.Status == WorkflowStatus.AwaitingHuman ? "Resume" : "Run now"))
                        </button>
                    }
                    <button class="btn-outline btn-sm" @onclick="ToggleExport">Export</button>
                </div>

                @if (_showExport)
                {
                    <div class="orch-run-output" style="margin-top:12px;">
                        <pre style="white-space:pre-wrap;font-size:12px;margin:0;">@_exportText</pre>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="detail-empty">
                <span class="text-muted">Select a workflow to view details</span>
            </div>
        }
    </div>
</div>

@code {
    [Inject] private IWorkflowStore WorkflowStore { get; set; } = default!;
    [Inject] private IWorkflowExecutor Executor { get; set; } = default!;
    [Inject] private WorkflowPlanningService Planner { get; set; } = default!;
    [Inject] private WorkflowExportService Exporter { get; set; } = default!;
    [Inject] private IRuntimeTraceStore TraceStore { get; set; } = default!;
    [Inject] private IArtifactStore ArtifactStore { get; set; } = default!;
    [Inject] private ActiveContextService ActiveContext { get; set; } = default!;
    [Inject] private WebSessionService Session { get; set; } = default!;

    private string _search = string.Empty;
    private string _status = string.Empty;

    private List<Workflow> _all = [];
    private List<Workflow> _filtered = [];
    private Workflow? _selected;
    private RuntimePlan? _selectedPlan;
    private List<WorkflowEvent> _selectedEvents = [];
    private List<JournalItem> _journalItems = [];
    private int _artifactCount;
    private readonly List<EditableStep> _editableSteps = [];

    private bool _isCreating;
    private string _createGoal = string.Empty;
    private bool _isGeneratingPlan;
    private bool _isSavingPlan;

    private bool _isRunning;
    private bool _showExport;
    private string _exportText = string.Empty;

    /// <summary>
    /// True when the selected workflow has a plan waiting for human review
    /// before it has ever run — as opposed to AwaitingHuman from a post-run
    /// acceptance-gate pause, which shows the plan read-only like normal.
    /// </summary>
    private bool IsPlanReview =>
        _selected?.Status == WorkflowStatus.AwaitingHuman
        && !_selectedEvents.Any(e => e.EventType == WorkflowEventTypes.RunStarted);

    private System.Threading.Timer? _pollTimer;

    protected override async Task OnInitializedAsync() => await LoadAllAsync();

    private async Task LoadAllAsync()
    {
        var ownerUserId = Session.IsAdmin ? null : Session.UserId;
        var items = await WorkflowStore.ListAsync(ownerUserId, status: null, limit: 200);
        _all = items.OrderByDescending(w => w.CreatedAt).ToList();
        if (_selected is not null)
            _selected = _all.FirstOrDefault(w => w.Id == _selected.Id);
        ApplyFilter();
        await LoadSelectedDetailAsync();
        UpdatePolling();
    }

    /// <summary>
    /// Live-refreshes the detail view while the selected workflow is
    /// actively moving (Planning/Running) — otherwise watching a multi-minute
    /// run means manually reloading the page repeatedly to see progress.
    /// Stops itself once the workflow lands on a status that won't change
    /// without a human action (AwaitingHuman, or terminal).
    /// </summary>
    private void UpdatePolling()
    {
        var shouldPoll = _selected is { Status: WorkflowStatus.Planning or WorkflowStatus.Running };
        if (shouldPoll && _pollTimer is null)
        {
            _pollTimer = new System.Threading.Timer(_ => InvokeAsync(LoadAllAsync), null,
                TimeSpan.FromSeconds(4), TimeSpan.FromSeconds(4));
        }
        else if (!shouldPoll && _pollTimer is not null)
        {
            _pollTimer.Dispose();
            _pollTimer = null;
        }
    }

    public void Dispose() => _pollTimer?.Dispose();

    private void ApplyFilter()
    {
        if (string.IsNullOrWhiteSpace(_search)) { _filtered = _all; return; }
        var s = _search.Trim();
        _filtered = _all.Where(w => w.Goal.Contains(s, StringComparison.OrdinalIgnoreCase)).ToList();
    }

    private async Task Select(Workflow item)
    {
        _isCreating = false;
        _showExport = false;
        _selected = item;
        await LoadSelectedDetailAsync();
        UpdatePolling();
    }

    private async Task LoadSelectedDetailAsync()
    {
        _selectedPlan = null;
        _selectedEvents = [];
        _journalItems = [];
        _artifactCount = 0;
        _editableSteps.Clear();
        if (_selected is null) return;

        _selectedPlan = WorkflowPlanJson.TryDeserialize(_selected.PlanJson, _selected.Goal);
        _selectedEvents = (await WorkflowStore.GetEventsAsync(_selected.Id)).ToList();
        _journalItems = await BuildJournalAsync(_selectedEvents);
        _artifactCount = await CountArtifactsAsync(_selected);

        if (IsPlanReview && _selectedPlan is not null)
        {
            foreach (var step in _selectedPlan.Steps)
                _editableSteps.Add(new EditableStep { Intent = step.Intent, Expected = step.ExpectedOutcome, Tier = step.ModelTier.ToString() });
        }
    }

    // ── Journal + output ─────────────────────────────────────────────────

    /// <summary>
    /// Merges the workflow's own lifecycle events with the real per-step
    /// output text pulled from runtime_traces — persisted by the engine
    /// layer for every step but never previously surfaced anywhere on this
    /// page. Joined via the runtime_run_id recorded in each RunStarted
    /// event's payload.
    /// </summary>
    private async Task<List<JournalItem>> BuildJournalAsync(List<WorkflowEvent> events)
    {
        var items = new List<JournalItem>();
        foreach (var e in events)
        {
            items.Add(new JournalItem(JournalItemKind.SystemEvent, e.Timestamp, HumanizeEventType(e.EventType), IsError: false));

            if (e.EventType != WorkflowEventTypes.RunStarted) continue;
            var runId = TryGetRuntimeRunId(e.PayloadJson);
            if (runId is null) continue;

            var traces = await TraceStore.LoadAsync(runId);
            foreach (var t in traces.Where(t => t.EntryType is "step_completed" or "step_failed"))
            {
                var (summary, error) = ParseStepPayload(t.Payload);
                var isFailed = t.EntryType == "step_failed";
                var text = isFailed ? (error ?? summary ?? "(no error detail)") : (summary ?? "(no output)");
                items.Add(new JournalItem(JournalItemKind.StepOutput, t.Timestamp, text, IsError: isFailed));
            }
        }
        return items.OrderBy(i => i.Timestamp).ToList();
    }

    private static string? TryGetRuntimeRunId(string payloadJson)
    {
        try
        {
            using var doc = JsonDocument.Parse(payloadJson);
            return doc.RootElement.TryGetProperty("runtime_run_id", out var v) ? v.GetString() : null;
        }
        catch (JsonException)
        {
            return null;
        }
    }

    private static (string? Summary, string? Error) ParseStepPayload(string payloadJson)
    {
        try
        {
            using var doc = JsonDocument.Parse(payloadJson);
            var summary = doc.RootElement.TryGetProperty("summary", out var s) ? s.GetString() : null;
            var error = doc.RootElement.TryGetProperty("error", out var er) && er.ValueKind != JsonValueKind.Null
                ? er.GetString() : null;
            return (summary, error);
        }
        catch (JsonException)
        {
            return (null, null);
        }
    }

    private async Task<int> CountArtifactsAsync(Workflow workflow)
    {
        var scope = new ArtifactScope
        {
            WorkspaceId = workflow.WorkspaceId ?? ArtifactScope.DefaultWorkspaceFor(Session.UserId ?? "anon"),
            ProjectId = workflow.ProjectId ?? ArtifactScope.DefaultProjectId,
            RunId = workflow.SessionId ?? workflow.Id,
        };
        var count = 0;
        await foreach (var _ in ArtifactStore.ListAsync(scope))
            count++;
        return count;
    }

    // ── Create ────────────────────────────────────────────────────────────

    private void StartCreate()
    {
        _isCreating = true;
        _selected = null;
        _showExport = false;
        _createGoal = string.Empty;
        _status = string.Empty;
        UpdatePolling();
    }

    private void CancelCreate() => _isCreating = false;

    private async Task ConfirmCreate()
    {
        var goal = _createGoal.Trim();
        if (string.IsNullOrEmpty(goal)) return;

        var workflow = await WorkflowStore.CreateAsync(
            goal,
            workspaceId: ActiveContext.WorkspaceId,
            projectId: string.IsNullOrEmpty(ActiveContext.ProjectId) ? null : ActiveContext.ProjectId,
            ownerUserId: Session.UserId);

        _isCreating = false;
        _status = "Workflow created — the scheduler will pick it up on its next poll tick.";
        await LoadAllAsync();
        _selected = _all.FirstOrDefault(w => w.Id == workflow.Id);
        await LoadSelectedDetailAsync();
    }

    private async Task GeneratePlanAsync()
    {
        var goal = _createGoal.Trim();
        if (string.IsNullOrEmpty(goal) || _isGeneratingPlan) return;

        _isGeneratingPlan = true;
        StateHasChanged();
        try
        {
            var workflow = await Planner.GenerateAsync(
                goal,
                workspaceId: ActiveContext.WorkspaceId,
                projectId: string.IsNullOrEmpty(ActiveContext.ProjectId) ? null : ActiveContext.ProjectId,
                ownerUserId: Session.UserId);

            _isCreating = false;
            _status = "Plan generated — review the steps below, then Save or Resume to run.";
            await LoadAllAsync();
            _selected = _all.FirstOrDefault(w => w.Id == workflow.Id);
            await LoadSelectedDetailAsync();
        }
        catch (Exception ex)
        {
            _status = $"Plan generation failed: {ex.Message}";
        }
        finally
        {
            _isGeneratingPlan = false;
        }
    }

    // ── Plan review ──────────────────────────────────────────────────────

    private void AddStep() => _editableSteps.Add(new EditableStep());

    private void RemoveStep(int index)
    {
        if (_editableSteps.Count <= 1) return;
        _editableSteps.RemoveAt(index);
    }

    private async Task SavePlanAsync()
    {
        if (_selected is null || _isSavingPlan) return;
        var steps = _editableSteps
            .Where(s => !string.IsNullOrWhiteSpace(s.Intent))
            .Select((s, i) => new RuntimeStep(i, s.Intent.Trim(), string.IsNullOrWhiteSpace(s.Expected) ? "step completed successfully" : s.Expected.Trim(), ParseTier(s.Tier)))
            .ToList();
        if (steps.Count == 0)
        {
            _status = "Add at least one step with an intent before saving.";
            return;
        }

        _isSavingPlan = true;
        StateHasChanged();
        try
        {
            await Planner.SavePlanAsync(_selected.Id, steps);
            _status = "Plan saved.";
            await LoadAllAsync();
        }
        catch (Exception ex)
        {
            _status = $"Save failed: {ex.Message}";
        }
        finally
        {
            _isSavingPlan = false;
        }
    }

    private static RuntimeModelTier ParseTier(string tier) => tier switch
    {
        "High" => RuntimeModelTier.High,
        "Fast" => RuntimeModelTier.Fast,
        _ => RuntimeModelTier.Standard,
    };

    // ── Actions ───────────────────────────────────────────────────────────

    private async Task RunNowAsync()
    {
        if (_selected is null || _isRunning || _selected.Status == WorkflowStatus.Running) return;

        _isRunning = true;
        StateHasChanged();
        try
        {
            await Executor.RunAsync(_selected.Id);
            _status = "Workflow advanced.";
        }
        catch (Exception ex)
        {
            _status = $"Run failed: {ex.Message}";
        }
        finally
        {
            _isRunning = false;
            await LoadAllAsync();
        }
    }

    private async Task CancelWorkflowAsync()
    {
        if (_selected is null || IsTerminal(_selected.Status)) return;

        await WorkflowStore.AppendEventAsync(_selected.Id, WorkflowEventTypes.Cancelled, "{}");
        await WorkflowStore.UpdateStateAsync(_selected.Id, WorkflowStatus.Cancelled, completedAt: DateTimeOffset.UtcNow);
        _status = "Workflow cancelled.";
        await LoadAllAsync();
    }

    private async Task ToggleExport()
    {
        if (_selected is null) return;
        _showExport = !_showExport;
        if (_showExport)
            _exportText = await Exporter.ExportMarkdownAsync(_selected.Id);
    }

    // The event_type values persisted in the journal (mission_created, etc.)
    // are historical data left unrenamed on purpose -- rewriting rows for a
    // cosmetic win wasn't worth the risk. This only humanizes the display.
    private static string HumanizeEventType(string eventType) => eventType switch
    {
        WorkflowEventTypes.WorkflowCreated => "Workflow created",
        WorkflowEventTypes.PlanRevised => "Plan revised",
        WorkflowEventTypes.RunStarted => "Run started",
        WorkflowEventTypes.RunCompleted => "Run completed",
        WorkflowEventTypes.AcceptanceApproved => "Accepted",
        WorkflowEventTypes.AcceptanceRejected => "Rejected",
        WorkflowEventTypes.Paused => "Paused",
        WorkflowEventTypes.Resumed => "Resumed",
        WorkflowEventTypes.Completed => "Completed",
        WorkflowEventTypes.Failed => "Failed",
        WorkflowEventTypes.Cancelled => "Cancelled",
        _ => eventType.Replace('_', ' '),
    };

    private static bool IsTerminal(WorkflowStatus status) =>
        status is WorkflowStatus.Completed or WorkflowStatus.Failed or WorkflowStatus.Cancelled;

    private static string Subtitle(Workflow w) =>
        w.CompletedAt is not null
            ? $"finished {w.CompletedAt.Value.ToLocalTime():MMM d, HH:mm}"
            : $"started {w.CreatedAt.ToLocalTime():MMM d, HH:mm}";

    private static string Truncate(string value, int max) =>
        value.Length <= max ? value : string.Concat(value.AsSpan(0, max - 1), "…");

    private string EmptyMessage() =>
        string.IsNullOrWhiteSpace(_search) ? "No workflows yet. Click + New to create one." : "No matches.";

    private sealed class EditableStep
    {
        public string Intent { get; set; } = string.Empty;
        public string Expected { get; set; } = string.Empty;
        public string Tier { get; set; } = "Standard";
    }

    private enum JournalItemKind { SystemEvent, StepOutput }

    private sealed record JournalItem(JournalItemKind Kind, DateTimeOffset Timestamp, string Text, bool IsError);
}
