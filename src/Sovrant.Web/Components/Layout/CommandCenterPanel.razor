@*  Phase 90 — Command Center group secondary panel.

    The cockpit is intentionally a single page (no sub-routes yet), so this
    panel is just a launcher + jump points into the existing detail pages
    that the cockpit grid links into.
*@

<div class="rail-secondary-header">Command Center</div>
<NavButton Href="/command" Icon="&#x1F3AF;" Label="Live cockpit" OnClick="OnNavigate" />
<NavButton Href="/activity" Icon="&#x1F4DD;" Label="Activity" OnClick="OnNavigate" />
<NavButton Href="/orchestration" Icon="&#x1F465;" Label="Orchestration" OnClick="OnNavigate" />
<NavButton Href="/agents" Icon="&#x1F916;" Label="Agents" OnClick="OnNavigate" />

@code {
    [Parameter] public EventCallback<string> OnNavigate { get; set; }
}
