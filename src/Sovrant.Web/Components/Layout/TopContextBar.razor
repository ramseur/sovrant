@using System.Text.Json
@using Sovrant.Api.Auth
@using Sovrant.Api.Capabilities
@using Sovrant.Runtime.Config
@using Sovrant.Runtime.Mcp
@using Sovrant.Runtime.Preferences
@using Sovrant.Runtime.Providers
@using Sovrant.Runtime.Workspaces
@using Sovrant.Runtime.Projects
@using Sovrant.Web.Adapters
@using Sovrant.Web.Services
@inject NavigationManager NavManager
@implements IDisposable

<div class="top-context-bar">
    <!-- Model / Provider two-step switcher -->
    <div class="model-tree-switcher tcb-switcher">
        <button class="model-tree-trigger" @ref="_triggerRef" @onclick="ToggleTreeDropdown" @onclick:stopPropagation="true">
            <div class="model-tree-trigger-content">
                <span class="status-dot @(_isConnected ? "connected" : "warning")"></span>
                <div class="model-tree-trigger-text">
                    <span class="model-tree-model">@_currentModel</span>
                    <span class="model-tree-provider">@_currentProvider</span>
                </div>
            </div>
            <span class="model-tree-chevron @(_treeOpen ? "open" : "")">&#x25BE;</span>
        </button>
        @if (_treeOpen)
        {
            <div class="model-tree-dropdown" style="@_dropdownStyle" @onclick:stopPropagation="true">
                @if (_selectedTreeGroup is null)
                {
                    @if (_treeGroups.Count > 0)
                    {
                        <div class="model-tree-step-label">Select provider</div>
                        @foreach (var group in _treeGroups)
                        {
                            var isCurrent = group.Provider.Equals(_currentProvider, StringComparison.OrdinalIgnoreCase);
                            <button class="model-tree-provider-item @(isCurrent ? "active" : "")"
                                    @onclick="() => DrillIntoProvider(group)">
                                <span class="model-tree-provider-name">@group.Provider</span>
                                <div class="model-tree-provider-badges">
                                    @if (group.IsWorkspaceProfile)
                                    {
                                        <span class="model-workspace-badge">Workspace</span>
                                    }
                                    <span class="model-tree-group-badge">@(group.Models.Count > 0 ? group.Models.Count.ToString() : "...")</span>
                                </div>
                            </button>
                        }
                    }
                    @if (_unconfiguredProviders.Count > 0)
                    {
                        @if (_treeGroups.Count > 0)
                        {
                            <div class="model-tree-divider"></div>
                        }
                        <div class="model-tree-step-label">@(_treeGroups.Count == 0 ? "Get started" : "Available to set up")</div>
                        @foreach (var p in _unconfiguredProviders)
                        {
                            <button class="model-tree-provider-item model-tree-unconfigured"
                                    @onclick="() => NavigateToProviderSetup(p.Name)">
                                <span class="model-tree-provider-name">@p.Icon @p.Name</span>
                                <span class="model-tree-setup-label">Set up →</span>
                            </button>
                        }
                    }
                }
                else
                {
                    <button class="model-tree-back" @onclick="() => _selectedTreeGroup = null">
                        &#x25C2; Back to providers
                    </button>
                    <div class="model-tree-step-label">@_selectedTreeGroup.Provider models</div>
                    <div class="model-tree-models">
                        @foreach (var model in _selectedTreeGroup.Models)
                        {
                            var isActive = model.Id.Equals(Config.Model, StringComparison.OrdinalIgnoreCase);
                            <button class="model-tree-model-item @(isActive ? "active" : "")"
                                    @onclick="() => SelectModel(_selectedTreeGroup, model.Id)">
                                <span class="model-tree-model-name">@ShortenModelName(model.Id)</span>
                                @if (model.IsFree)
                                {
                                    <span class="model-free-badge">Free</span>
                                }
                            </button>
                        }
                    </div>
                }
            </div>
        }
    </div>

    <div class="tcb-divider"></div>

    <!-- Workspace -->
    <div class="tcb-field">
        <span class="tcb-icon"><SovrantIcon Name="building" /></span>
        <select @bind="_selectedWorkspaceId" @bind:after="OnWorkspaceChanged" disabled="@(_workspaces.Count <= 1)">
            @foreach (var w in _workspaces)
            {
                <option value="@w.Id">@w.Name</option>
            }
        </select>
    </div>

    <!-- Project -->
    <div class="tcb-field">
        <span class="tcb-icon"><SovrantIcon Name="project" /></span>
        <select @bind="_selectedProjectId" @bind:after="OnProjectChanged" disabled="@(_projects.Count == 0)">
            <option value="">@(_projects.Count == 0 ? "No projects" : "(No project)")</option>
            @foreach (var p in _projects)
            {
                <option value="@p.Id">@p.Name</option>
            }
        </select>
    </div>

    <div class="tcb-divider"></div>

    <!-- Integrations / MCP multi-select — always visible, matches workspace/project style -->
    <div class="tcb-mcp-switcher">
        <button class="tcb-field tcb-mcp-trigger"
                title="Choose which MCP servers are available to agents"
                @ref="_mcpTriggerRef"
                @onclick="ToggleMcpDropdown"
                @onclick:stopPropagation="true">
            <span class="tcb-icon"><SovrantIcon Name="link" /></span>
            <span class="tcb-mcp-summary">@McpSummaryLabel</span>
            <span class="tcb-mcp-chevron @(_mcpDropdownOpen ? "open" : "")">&#x25BE;</span>
        </button>
        @if (_mcpDropdownOpen)
        {
            <div class="tcb-mcp-dropdown" @onclick:stopPropagation="true">
                <div class="tcb-mcp-header">INTEGRATIONS</div>

                @if (_availableMcpServers.Count > 0)
                {
                    @foreach (var name in _availableMcpServers)
                    {
                        var serverName = name;
                        var isActive = _activeMcpServers.Contains(serverName);
                        <label class="tcb-mcp-item @(isActive ? "active" : "")">
                            <input type="checkbox"
                                   checked="@isActive"
                                   @onchange="e => ToggleMcpServer(serverName, (bool)(e.Value ?? false))" />
                            <span class="tcb-mcp-item-name">@serverName</span>
                        </label>
                    }
                }
                else
                {
                    <p class="tcb-mcp-empty">No integrations connected.</p>
                }

                @if (Session.IsAdmin)
                {
                    <div class="tcb-mcp-footer-divider"></div>
                    <a class="tcb-mcp-footer-link" href="/admin/integrations" @onclick="() => _mcpDropdownOpen = false">
                        Manage Integrations →
                    </a>
                }
            </div>
        }
    </div>

    @if (ActiveContext.ActiveAgentName is not null)
    {
        <div class="tcb-divider"></div>
        <div class="tcb-agent-badge" title="This session is scoped to @ActiveContext.ActiveAgentName">
            <span class="tcb-icon"><SovrantIcon Name="agent" /></span>
            <span class="tcb-agent-name">@ActiveContext.ActiveAgentName</span>
            <button class="tcb-agent-clear" title="Clear agent" @onclick="ClearAgent" @onclick:stopPropagation="true"><SovrantIcon Name="x" /></button>
        </div>
    }
</div>

@code {
    [Inject] private SovrantConfig Config { get; set; } = default!;
    [Inject] private IWorkspaceService WorkspaceService { get; set; } = default!;
    [Inject] private IProjectService ProjectService { get; set; } = default!;
    [Inject] private ActiveContextService ActiveContext { get; set; } = default!;
    [Inject] private MutableAuthProvider AuthProvider { get; set; } = default!;
    [Inject] private IHttpClientFactory HttpFactory { get; set; } = default!;
    [Inject] private IUserPreferenceStore Prefs { get; set; } = default!;
    [Inject] private IProviderProfileStore ProfileStore { get; set; } = default!;
    [Inject] private ICredentialStore Credentials { get; set; } = default!;
    [Inject] private IWorkspaceSettingsStore WsSettings { get; set; } = default!;
    [Inject] private IModelCapabilityRegistry CapabilityRegistry { get; set; } = default!;
    [Inject] private IJSRuntime JS { get; set; } = default!;
    [Inject] private WebSessionService Session { get; set; } = default!;
    [Inject] private IMcpServerStore McpServerStore { get; set; } = default!;

    // MCP switcher state
    private List<string> _availableMcpServers = [];
    private HashSet<string> _activeMcpServers = new(StringComparer.Ordinal);
    private bool _mcpDropdownOpen;

    private string McpSummaryLabel
    {
        get
        {
            if (_availableMcpServers.Count == 0) return "Integrations";
            return _activeMcpServers.Count switch
            {
                0 => "None active",
                1 => _activeMcpServers.First(),
                _ => $"{_activeMcpServers.Count} active",
            };
        }
    }

    private ElementReference _triggerRef;
    private string _dropdownStyle = string.Empty;
    private DotNetObjectReference<TopContextBar>? _selfRef;
    private int _dismissBindingId;
    private ElementReference _mcpTriggerRef;
    private int _mcpDismissBindingId;

    private string _currentModel = string.Empty;
    private string _currentProvider = string.Empty;
    private bool _treeOpen;
    private bool _isConnected;

    private record ProviderProfileItem(string ProfileId, string CredentialId, string Name, string Provider, string Model, string BaseUrl, int MaxTokens, bool IsWorkspaceProfile = false);
    private List<ProviderProfileItem> _providerProfiles = [];

    private TreeGroup? _selectedTreeGroup;

    private record ModelItem(string Id, bool IsFree);

    private class TreeGroup
    {
        public string ProfileId { get; set; } = string.Empty;
        public string CredentialId { get; set; } = string.Empty;
        public string Provider { get; set; } = string.Empty;
        public string BaseUrl { get; set; } = string.Empty;
        public int MaxTokens { get; set; } = 32000;
        public List<ModelItem> Models { get; set; } = [];
        public bool ModelsFetchedLive { get; set; }
        public bool IsWorkspaceProfile { get; set; }
    }

    private List<TreeGroup> _treeGroups = [];
    private List<(string Name, string Icon)> _unconfiguredProviders = [];

    private static readonly (string Name, string Icon)[] _knownProviders =
    [
        ("OpenAI",       "brain"),
        ("Anthropic",    "brain"),
        ("OpenRouter",   "route"),
        ("DeepSeek",     "search"),
        ("Groq",         "zap"),
        ("Mistral",      "wind"),
        ("Google",       "sparkles"),
        ("Together AI",  "team"),
        ("Ollama",       "agent"),
        ("LM Studio",    "monitor"),
        ("Azure OpenAI", "cloud"),
    ];

    private static readonly Dictionary<string, string[]> StaticProviderModels = new(StringComparer.Ordinal)
    {
        ["OpenAI"] = ["gpt-5", "gpt-4.1", "gpt-4.1-mini", "gpt-4.1-nano", "gpt-4o", "gpt-4o-mini", "o4-mini", "o3", "o3-mini", "o1", "o1-mini"],
        ["DeepSeek"] = ["deepseek-chat", "deepseek-reasoner"],
        ["Groq"] = ["llama-3.3-70b-versatile", "llama-3.1-8b-instant", "mixtral-8x7b-32768", "gemma2-9b-it"],
        ["Mistral"] = ["mistral-large-latest", "mistral-medium-latest", "mistral-small-latest", "open-mixtral-8x22b"],
        ["Together AI"] = ["meta-llama/Llama-3.3-70B-Instruct-Turbo", "meta-llama/Meta-Llama-3.1-8B-Instruct-Turbo", "mistralai/Mixtral-8x7B-Instruct-v0.1", "Qwen/Qwen2.5-72B-Instruct-Turbo"],
        ["Google"] = ["gemini-2.5-pro", "gemini-2.5-flash", "gemini-2.0-flash", "gemini-2.0-flash-lite"],
        ["Azure OpenAI"] = ["gpt-4o", "gpt-4o-mini", "gpt-4.1"],
    };

    private string _selectedWorkspaceId = string.Empty;
    private string _selectedProjectId = string.Empty;

    private record WorkspaceItem(string Id, string Name, string Type);
    private record ProjectItem(string Id, string Name);

    private List<WorkspaceItem> _workspaces = [];
    private List<ProjectItem> _projects = [];

    protected override async Task OnInitializedAsync()
    {
        await InferProviderAsync();
        await LoadProviderProfilesAsync();
        await ApplyDisplayStateAsync();
        await LoadMcpServersAsync();

        ActiveContext.SetModel(_currentModel, _currentProvider);
        ActiveContext.OnChanged += OnActiveContextChanged;
        ActiveContext.OnDataChanged += OnDataChanged;
    }

    private async Task LoadMcpServersAsync()
    {
        try
        {
            var wsId = ActiveContext.WorkspaceId;
            var visible = await McpServerStore.GetEnabledEntriesAsync(WsSettings, wsId);
            _availableMcpServers = visible.Select(e => e.Name).OrderBy(n => n, StringComparer.Ordinal).ToList();

            // Load persisted selection — filter saved names against what's now visible.
            var userId = Session.UserId;
            if (!string.IsNullOrEmpty(userId))
            {
                var saved = await Prefs.GetAsync(userId, UserPreferenceKeys.ActiveMcpServers);
                if (!string.IsNullOrWhiteSpace(saved))
                {
                    var visibleSet = new HashSet<string>(_availableMcpServers, StringComparer.Ordinal);
                    _activeMcpServers = new HashSet<string>(
                        saved.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                             .Where(n => visibleSet.Contains(n)),
                        StringComparer.Ordinal);
                }
            }

            ActiveContext.SetActiveMcpServers([.. _activeMcpServers]);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[TopContextBar] LoadMcpServersAsync failed: {ex.Message}");
        }
    }

    private async Task ToggleMcpDropdown()
    {
        _mcpDropdownOpen = !_mcpDropdownOpen;
        if (!_mcpDropdownOpen)
        {
            await UnbindMcpDismissAsync();
            return;
        }
        await LoadMcpServersAsync();
        try
        {
            _selfRef ??= DotNetObjectReference.Create(this);
            _mcpDismissBindingId = await JS.InvokeAsync<int>(
                "sovrantInterop.bindLightDismiss", _mcpTriggerRef, ".tcb-mcp-dropdown", _selfRef, nameof(CloseMcpDropdown));
        }
        catch { /* without JS interop dropdown still closes on button click */ }
    }

    [JSInvokable]
    public Task CloseMcpDropdown()
    {
        return InvokeAsync(async () =>
        {
            if (!_mcpDropdownOpen) return;
            _mcpDropdownOpen = false;
            await UnbindMcpDismissAsync();
            StateHasChanged();
        });
    }

    private async Task UnbindMcpDismissAsync()
    {
        if (_mcpDismissBindingId == 0) return;
        var id = _mcpDismissBindingId;
        _mcpDismissBindingId = 0;
        try { await JS.InvokeVoidAsync("sovrantInterop.unbindLightDismiss", id); }
        catch { /* best effort */ }
    }

    private async Task ToggleMcpServer(string name, bool active)
    {
        // Guard: activating a server no longer in the workspace-allowed list is a no-op.
        // Reloads the list so the UI reflects the current admin state.
        if (active && !_availableMcpServers.Contains(name, StringComparer.Ordinal))
        {
            await LoadMcpServersAsync();
            StateHasChanged();
            return;
        }

        if (active) _activeMcpServers.Add(name);
        else _activeMcpServers.Remove(name);

        var selected = _activeMcpServers.ToList();
        ActiveContext.SetActiveMcpServers(selected);

        try
        {
            var userId = Session.UserId;
            if (!string.IsNullOrEmpty(userId))
            {
                var value = string.Join(',', selected);
                await Prefs.SetAsync(userId, UserPreferenceKeys.ActiveMcpServers, value);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[TopContextBar] Failed to persist MCP selection: {ex.Message}");
        }
    }

    // Drives the trigger label from stored prefs (ActiveProviderProfileId + Model)
    // rather than Config.Model, which carries the hardcoded "gpt-4o-mini" default
    // and a legacy LlmApiKey credential — both can falsely imply a configured state.
    private async Task ApplyDisplayStateAsync()
    {
        var userId = Session.UserId;
        var savedProfileId = string.Empty;
        var savedModel = string.Empty;
        if (!string.IsNullOrEmpty(userId))
        {
            try
            {
                savedProfileId = await Prefs.GetAsync(userId, UserPreferenceKeys.ActiveProviderProfileId) ?? string.Empty;
                savedModel = await Prefs.GetAsync(userId, UserPreferenceKeys.Model) ?? string.Empty;
            }
            catch { /* best effort */ }
        }

        var matched = !string.IsNullOrEmpty(savedProfileId)
            ? _providerProfiles.FirstOrDefault(p => p.ProfileId == savedProfileId)
            : null;

        if (matched is null)
        {
            _currentModel = "No model";
            _currentProvider = _providerProfiles.Count == 0 ? "Add a provider" : "Select a provider";
            _isConnected = false;
        }
        else if (string.IsNullOrWhiteSpace(savedModel))
        {
            _currentModel = "Select a model";
            _currentProvider = matched.Provider;
            _isConnected = false;
        }
        else
        {
            _currentModel = ShortenModelName(savedModel);
            _currentProvider = matched.Provider;
            _isConnected = !string.IsNullOrWhiteSpace(Config.ApiKey);
        }
    }

    private async Task LoadProviderProfilesAsync()
    {
        _providerProfiles = [];
        _treeGroups = [];
        try
        {
            var rows = await ProfileStore.ListUserAndWorkspaceAsync(
                Session.UserId!, ActiveContext.WorkspaceId, WsSettings);
            var list = new List<ProviderProfileItem>(rows.Count);
            foreach (var row in rows)
            {
                list.Add(new ProviderProfileItem(
                    ProfileId: row.ProfileId,
                    CredentialId: row.CredentialId,
                    Name: row.Name,
                    Provider: row.ProviderKind,
                    Model: row.DefaultModel ?? string.Empty,
                    BaseUrl: row.BaseUrl ?? string.Empty,
                    MaxTokens: row.MaxTokens ?? 32000,
                    IsWorkspaceProfile: row.IsAdminManaged));
            }
            _providerProfiles = list;
            BuildTreeGroups();
        }
        catch { /* best effort */ }
    }

    private bool IsFreeModel(string modelId)
    {
        if (modelId.EndsWith(":free", StringComparison.OrdinalIgnoreCase))
            return true;
        var caps = CapabilityRegistry.GetCapabilities(modelId);
        return caps.CostPerMillionInput is 0m && caps.CostPerMillionOutput is 0m;
    }

    private void BuildTreeGroups()
    {
        var groups = new Dictionary<string, TreeGroup>(StringComparer.OrdinalIgnoreCase);
        foreach (var profile in _providerProfiles)
        {
            if (!groups.TryGetValue(profile.Provider, out var group))
            {
                group = new TreeGroup
                {
                    ProfileId = profile.ProfileId,
                    CredentialId = profile.CredentialId,
                    Provider = profile.Provider,
                    BaseUrl = profile.BaseUrl,
                    MaxTokens = profile.MaxTokens,
                    IsWorkspaceProfile = profile.IsWorkspaceProfile,
                };
                if (StaticProviderModels.TryGetValue(profile.Provider, out var staticModels))
                    group.Models.AddRange(staticModels.Select(m => new ModelItem(m, IsFreeModel(m))));
                groups[profile.Provider] = group;
            }
            // Only seed the saved model as a fallback for providers with a static list.
            // Providers like OpenRouter will fetch live — their list should start empty.
            if (!string.IsNullOrWhiteSpace(profile.Model)
                && StaticProviderModels.ContainsKey(profile.Provider)
                && !group.Models.Any(m => m.Id.Equals(profile.Model, StringComparison.OrdinalIgnoreCase)))
            {
                group.Models.Insert(0, new ModelItem(profile.Model, IsFreeModel(profile.Model)));
            }
        }
        _treeGroups = groups.Values.ToList();
        var configuredSet = new HashSet<string>(groups.Keys, StringComparer.OrdinalIgnoreCase);

        // Provider setup lives at /admin/providers (system-admin only). Non-admins have no
        // path to act on an unconfigured provider, so the "Set up →" prompt is admin-only;
        // non-admins only ever see providers a workspace admin has already enabled for them.
        _unconfiguredProviders = Session.IsAdmin
            ? _knownProviders.Where(p => !configuredSet.Contains(p.Name)).ToList()
            : [];
    }

    private async Task ToggleTreeDropdown()
    {
        _treeOpen = !_treeOpen;
        if (!_treeOpen)
        {
            _selectedTreeGroup = null;
            _dropdownStyle = string.Empty;
            await UnbindLightDismissAsync();
            return;
        }
        await LoadProviderProfilesAsync();
        try
        {
            var rect = await JS.InvokeAsync<DropdownRect?>("sovrantInterop.getElementRect", _triggerRef);
            if (rect is not null)
            {
                var width = Math.Max(rect.Width, 280);
                _dropdownStyle = string.Create(System.Globalization.CultureInfo.InvariantCulture,
                    $"position: fixed; top: {rect.Bottom + 4}px; left: {rect.Left}px; width: {width}px; right: auto;");
            }
        }
        catch { /* fall back to CSS-only positioning */ }

        try
        {
            _selfRef ??= DotNetObjectReference.Create(this);
            _dismissBindingId = await JS.InvokeAsync<int>(
                "sovrantInterop.bindLightDismiss", _triggerRef, ".model-tree-dropdown", _selfRef, nameof(CloseTreeDropdown));
        }
        catch { /* without JS interop the dropdown still closes on chevron click */ }
    }

    [JSInvokable]
    public Task CloseTreeDropdown()
    {
        return InvokeAsync(async () =>
        {
            if (!_treeOpen) return;
            _treeOpen = false;
            _selectedTreeGroup = null;
            _dropdownStyle = string.Empty;
            await UnbindLightDismissAsync();
            StateHasChanged();
        });
    }

    private async Task UnbindLightDismissAsync()
    {
        if (_dismissBindingId == 0) return;
        var id = _dismissBindingId;
        _dismissBindingId = 0;
        try { await JS.InvokeVoidAsync("sovrantInterop.unbindLightDismiss", id); }
        catch { /* best effort */ }
    }

    private sealed record DropdownRect(double Top, double Left, double Width, double Height, double Bottom, double Right);

    private async Task DrillIntoProvider(TreeGroup group)
    {
        _selectedTreeGroup = group;
        if (!group.ModelsFetchedLive && !string.IsNullOrWhiteSpace(group.BaseUrl))
        {
            var apiKey = await Credentials.RetrieveAsync(group.CredentialId) ?? string.Empty;
            var fetched = await FetchModelIdsAsync(group.BaseUrl, apiKey);
            var filtered = FilterChatModels(fetched);
            if (filtered.Count > 0)
            {
                group.Models.Clear();
                group.Models.AddRange(filtered.Select(m => new ModelItem(m, IsFreeModel(m))));
                group.ModelsFetchedLive = true;
                StateHasChanged();
            }
        }
    }

    private static List<string> FilterChatModels(List<string> ids)
    {
        if (ids.Count == 0) return ids;
        var excludes = new[]
        {
            "embedding", "embed-", "-embed",
            "dall-e", "dalle", "image-",
            "whisper", "tts-", "-tts",
            "moderation",
            "realtime-preview", "transcribe",
            "babbage", "ada-00", "curie", "davinci",
        };
        return ids.Where(id =>
        {
            foreach (var ex in excludes)
                if (id.Contains(ex, StringComparison.OrdinalIgnoreCase)) return false;
            return true;
        }).ToList();
    }

    private async Task<List<string>> FetchModelIdsAsync(string baseUrl, string apiKey)
    {
        try
        {
            using var http = HttpFactory.CreateClient("ProviderProbe");
            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(8));
            var modelsUrl = baseUrl.TrimEnd('/') + "/models";
            using var request = new HttpRequestMessage(HttpMethod.Get, new Uri(modelsUrl));
            var safeKey = new string(apiKey.Where(c => c < 128).ToArray()).Trim();
            if (!string.IsNullOrEmpty(safeKey))
                request.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", safeKey);
            var response = await http.SendAsync(request, cts.Token);
            response.EnsureSuccessStatusCode();
            using var stream = await response.Content.ReadAsStreamAsync(cts.Token);
            using var doc = await JsonDocument.ParseAsync(stream, cancellationToken: cts.Token);
            var seen = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
            var models = new List<string>();
            if (doc.RootElement.TryGetProperty("data", out var data))
                foreach (var item in data.EnumerateArray())
                    if (item.TryGetProperty("id", out var id) && id.GetString() is { } modelId && seen.Add(modelId))
                        models.Add(modelId);
            models.Sort(StringComparer.OrdinalIgnoreCase);
            return models;
        }
        catch { return []; }
    }

    private async Task SelectModel(TreeGroup group, string model)
    {
        // Guard: profile must still be in the workspace-allowed list loaded into memory.
        // If it was removed since the dropdown opened, refresh and bail.
        if (_providerProfiles.All(p => p.ProfileId != group.ProfileId))
        {
            await LoadProviderProfilesAsync();
            await ApplyDisplayStateAsync();
            _treeOpen = false;
            _selectedTreeGroup = null;
            _dropdownStyle = string.Empty;
            await UnbindLightDismissAsync();
            StateHasChanged();
            return;
        }

        var apiKey = await Credentials.RetrieveAsync(group.CredentialId) ?? string.Empty;

        Config.ApiKey = apiKey;
        Config.MaxTokens = group.MaxTokens;
        Config.Model = model;
        AuthProvider.ApiKey = apiKey;

        if (!string.IsNullOrWhiteSpace(group.BaseUrl))
        {
            var parsed = new Uri(group.BaseUrl);
            Config.BaseUrl = parsed;
            AuthProvider.BaseUrl = parsed;
        }
        else
        {
            Config.BaseUrl = null;
            AuthProvider.BaseUrl = null;
        }

        _currentModel = ShortenModelName(model);
        _currentProvider = group.Provider;
        _isConnected = !string.IsNullOrWhiteSpace(apiKey);
        _treeOpen = false;
        _dropdownStyle = string.Empty;
        await UnbindLightDismissAsync();

        // Persist prefs first so ApplyDisplayStateAsync — triggered by the
        // OnChanged event below — reads the new values instead of the stale ones.
        await PersistActiveProfileAsync(group, model, apiKey);

        ActiveContext.SetModel(_currentModel, _currentProvider);
    }

    private async Task PersistActiveProfileAsync(TreeGroup group, string model, string apiKey)
    {
        try
        {
            var userId = Session.UserId!;
            if (!string.IsNullOrWhiteSpace(group.ProfileId))
                await Prefs.SetAsync(userId, UserPreferenceKeys.ActiveProviderProfileId, group.ProfileId);
            await Prefs.SetAsync(userId, UserPreferenceKeys.Provider, group.Provider);
            if (!string.IsNullOrWhiteSpace(model))
                await Prefs.SetAsync(userId, UserPreferenceKeys.Model, model);
            await Prefs.SetAsync(userId, UserPreferenceKeys.MaxTokens,
                group.MaxTokens.ToString(System.Globalization.CultureInfo.InvariantCulture));
            if (!string.IsNullOrWhiteSpace(group.BaseUrl))
                await Prefs.SetAsync(userId, UserPreferenceKeys.BaseUrl, group.BaseUrl);
            if (!string.IsNullOrWhiteSpace(apiKey))
                await Credentials.StoreAsync(CredentialKeys.LlmApiKey, apiKey);
        }
        catch { /* best effort */ }
    }

    private void OnDataChanged()
    {
        _ = InvokeAsync(async () =>
        {
            try
            {
                await LoadWorkspacesAsync();
                await LoadProjectsAsync();
                await LoadMcpServersAsync();
            }
            catch (Exception ex)
            {
                Console.WriteLine($"[TopContextBar] OnDataChanged failed: {ex.Message}");
            }
            StateHasChanged();
        });
    }

    private void OnActiveContextChanged()
    {
        InvokeAsync(async () =>
        {
            await InferProviderAsync();
            await LoadProviderProfilesAsync();
            await ApplyDisplayStateAsync();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        ActiveContext.OnChanged -= OnActiveContextChanged;
        ActiveContext.OnDataChanged -= OnDataChanged;
        if (_dismissBindingId != 0)
        {
            try { _ = JS.InvokeVoidAsync("sovrantInterop.unbindLightDismiss", _dismissBindingId); }
            catch { /* component is unmounting; best effort */ }
            _dismissBindingId = 0;
        }
        _selfRef?.Dispose();
        _selfRef = null;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await Sovrant.Web.Program.RuntimeReady.Task;
        await LoadWorkspacesAsync();
        StateHasChanged();
    }

    private async Task InferProviderAsync()
    {
        var url = Config.BaseUrl?.ToString() ?? string.Empty;
        _currentProvider = url switch
        {
            _ when url.Contains("openrouter", StringComparison.OrdinalIgnoreCase) => "OpenRouter",
            _ when url.Contains("deepseek", StringComparison.OrdinalIgnoreCase) => "DeepSeek",
            _ when url.Contains("groq", StringComparison.OrdinalIgnoreCase) => "Groq",
            _ when url.Contains("mistral", StringComparison.OrdinalIgnoreCase) => "Mistral",
            _ when url.Contains("together", StringComparison.OrdinalIgnoreCase) => "Together AI",
            _ when url.Contains("localhost:11434", StringComparison.Ordinal) => "Ollama",
            _ when url.Contains("localhost:1234", StringComparison.Ordinal) => "LM Studio",
            _ when string.IsNullOrEmpty(url) => "OpenAI",
            _ => "Custom",
        };

        try
        {
            var saved = await Prefs.GetAsync(Session.UserId!, UserPreferenceKeys.Provider);
            if (!string.IsNullOrWhiteSpace(saved))
                _currentProvider = saved;
        }
        catch { /* use inferred */ }
    }

    private void NavigateToProviderSetup(string providerName)
    {
        _treeOpen = false;
        NavManager.NavigateTo("/admin/providers?provider=" + Uri.EscapeDataString(providerName));
    }

    private static string ShortenModelName(string model)
    {
        if (string.IsNullOrEmpty(model)) return model;
        var slashIdx = model.IndexOf('/', StringComparison.Ordinal);
        if (slashIdx >= 0 && slashIdx < model.Length - 1)
            model = model[(slashIdx + 1)..];
        foreach (var suffix in new[] { ":free", ":extended" })
        {
            if (model.EndsWith(suffix, StringComparison.OrdinalIgnoreCase))
            {
                model = model[..^suffix.Length];
                break;
            }
        }
        return model;
    }

    private async Task LoadWorkspacesAsync()
    {
        try
        {
            var list = await WorkspaceService.ListForUserAsync(Session.UserId!);
            _workspaces = list.Select(w => new WorkspaceItem(w.WorkspaceId, w.Name, w.Type.ToString())).ToList();
            Console.WriteLine($"[TopContextBar] Loaded {_workspaces.Count} workspace(s).");
            var personal = _workspaces.FirstOrDefault(w => w.Type.Equals("Personal", StringComparison.OrdinalIgnoreCase));
            if (personal is not null && string.IsNullOrEmpty(_selectedWorkspaceId))
            {
                _selectedWorkspaceId = personal.Id;
                var personalRole = await GetWorkspaceRoleAsync(personal.Id);
                ActiveContext.SetWorkspace(personal.Id, personal.Name, personalRole);
                await LoadProjectsAsync();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[TopContextBar] LoadWorkspacesAsync failed: {ex.Message}");
        }
    }

    private async Task LoadProjectsAsync()
    {
        if (string.IsNullOrEmpty(_selectedWorkspaceId)) return;
        try
        {
            var list = await ProjectService.ListAsync(_selectedWorkspaceId);
            _projects = list.Select(p => new ProjectItem(p.ProjectId, p.Name)).ToList();
        }
        catch { _projects = []; }
    }

    private async Task OnWorkspaceChanged()
    {
        _selectedProjectId = string.Empty;
        await LoadProjectsAsync();
        var ws = _workspaces.FirstOrDefault(w => w.Id == _selectedWorkspaceId);
        var role = await GetWorkspaceRoleAsync(_selectedWorkspaceId);
        ActiveContext.SetWorkspace(_selectedWorkspaceId, ws?.Name ?? "Personal", role);
    }

    private async Task<string?> GetWorkspaceRoleAsync(string workspaceId)
    {
        try
        {
            if (string.IsNullOrEmpty(Session.UserId)) return null;
            var role = await WorkspaceService.GetMemberRoleAsync(workspaceId, Session.UserId);
            return role.HasValue ? role.Value.ToString().ToLower(System.Globalization.CultureInfo.InvariantCulture) : null;
        }
        catch { return null; }
    }

    private void OnProjectChanged()
    {
        var proj = _projects.FirstOrDefault(p => p.Id == _selectedProjectId);
        ActiveContext.SetProject(_selectedProjectId, proj?.Name ?? string.Empty);
    }

    private void ClearAgent() => ActiveContext.SetActiveAgent(null);
}
