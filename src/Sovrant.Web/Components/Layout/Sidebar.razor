@using Sovrant.Runtime.Config
@using Sovrant.Runtime.Session
@using Sovrant.Runtime.Workspaces
@using Sovrant.Runtime.Projects
@using Sovrant.Web.Services
@implements IDisposable

<aside class="sidebar">
    <div class="sidebar-scroll">
        <!-- Logo row -->
        <div class="sidebar-header">
            <div class="logo-row">
                <div class="logo-icon">&#9889;</div>
                <span class="logo-text">Sovrant</span>
            </div>
            <button class="icon-btn-sm" @onclick="OnToggleCollapse" title="Collapse sidebar">&#9707;</button>
        </div>

        <!-- New Chat -->
        <button class="btn-primary new-chat-btn" @onclick='() => OnNavigate.InvokeAsync("/")'>
            <span>&#xFF0B; New Chat</span>
        </button>

        <!-- Search -->
        <div class="sidebar-search">
            <input type="text" placeholder="Search conversations..." @bind="_searchText" @bind:event="oninput" @bind:after="FilterSessions" />
        </div>

        <!-- Model/Provider card -->
        <button class="model-card" @onclick='() => OnNavigate.InvokeAsync("/settings")' title="Click to change model">
            <span class="status-dot connected"></span>
            <span class="model-name">@_currentModel</span>
            <span class="provider-name">@_currentProvider</span>
        </button>

        <!-- Connection status -->
        <div class="connection-status">
            <span class="status-dot @(_isConnected ? "connected" : "warning")"></span>
            <span>@_connectionStatus</span>
        </div>

        <!-- Workspace/Project selectors -->
        <div class="context-card">
            <div class="context-field">
                <label>&#x1F3E2; Workspace</label>
                <select @bind="_selectedWorkspaceId" @bind:after="OnWorkspaceChanged">
                    @foreach (var w in _workspaces)
                    {
                        <option value="@w.Id">@w.Name</option>
                    }
                </select>
            </div>
            <div class="context-field">
                <label>&#x1F4C1; Project</label>
                <select @bind="_selectedProjectId" @bind:after="OnProjectChanged">
                    <option value="">(None)</option>
                    @foreach (var p in _projects)
                    {
                        <option value="@p.Id">@p.Name</option>
                    }
                </select>
            </div>
        </div>

        <!-- Primary nav -->
        <NavButton Href="/" Icon="&#x1F4AC;" Label="Chat" OnClick="OnNavigate" />
        <NavButton Href="/settings" Icon="&#9881;" Label="Settings" OnClick="OnNavigate" />
        <NavButton Href="/diagnostics" Icon="&#x1F527;" Label="Diagnostics" OnClick="OnNavigate" />

        <!-- Knowledge section -->
        <div class="nav-section-header">KNOWLEDGE</div>
        <NavButton Href="/artifacts" Icon="&#x1F4C4;" Label="Artifacts" OnClick="OnNavigate" />
        <NavButton Href="/tools" Icon="&#x1F6E0;" Label="Tools" OnClick="OnNavigate" />
        <NavButton Href="/skills" Icon="&#x1F4DC;" Label="Skills" OnClick="OnNavigate" />
        <NavButton Href="/agents" Icon="&#x1F916;" Label="Agents" OnClick="OnNavigate" />
        <NavButton Href="/memory" Icon="&#x1F9E0;" Label="Memory" OnClick="OnNavigate" />

        <!-- Orchestration section -->
        <div class="nav-section-header">ORCHESTRATION</div>
        <NavButton Href="/projects" Icon="&#x1F4C1;" Label="Projects" OnClick="OnNavigate" />
        <NavButton Href="/workspaces" Icon="&#x1F3E2;" Label="Workspaces" OnClick="OnNavigate" />
        <NavButton Href="/multi-agent" Icon="&#x1F465;" Label="Multi-Agent" OnClick="OnNavigate" />
        <NavButton Href="/integrations" Icon="&#x1F50C;" Label="Integrations" OnClick="OnNavigate" />
        <NavButton Href="/automations" Icon="&#x26A1;" Label="Automations" OnClick="OnNavigate" />
        <NavButton Href="/governance" Icon="&#x1F6E1;" Label="Governance" OnClick="OnNavigate" />

        <!-- Recent conversations -->
        <div class="nav-section-header">RECENT</div>
        @if (_filteredSessions.Count == 0)
        {
            <div class="no-sessions">No recent conversations</div>
        }
        @foreach (var session in _filteredSessions)
        {
            <div class="session-item">
                <button class="session-btn" @onclick="() => ResumeSession(session.Id)">
                    <div class="session-label">@session.Label</div>
                    <div class="session-time">@session.Timestamp.ToString("MMM d, HH:mm")</div>
                </button>
                <button class="session-delete" @onclick="() => DeleteSession(session.Id)" title="Delete session">&#x2715;</button>
            </div>
        }
    </div>

    <!-- Bottom: User profile -->
    <div class="sidebar-footer">
        <div class="user-avatar">@_userInitial</div>
        <div class="user-info">
            <div class="user-name">@_userName</div>
            <div class="user-workspace">Personal workspace</div>
        </div>
    </div>
</aside>

@code {
    [Parameter] public bool IsCollapsed { get; set; }
    [Parameter] public EventCallback OnToggleCollapse { get; set; }
    [Parameter] public EventCallback<string> OnNavigate { get; set; }

    [Inject] private SovrantConfig Config { get; set; } = default!;
    [Inject] private ISessionStore SessionStore { get; set; } = default!;
    [Inject] private IWorkspaceService WorkspaceService { get; set; } = default!;
    [Inject] private IProjectService ProjectService { get; set; } = default!;
    [Inject] private ActiveContextService ActiveContext { get; set; } = default!;

    private string _searchText = string.Empty;
    private string _currentModel = string.Empty;
    private string _currentProvider = string.Empty;
    private bool _isConnected;
    private string _connectionStatus = "Connected";
    private string _userName = Environment.UserName;
    private string _userInitial = Environment.UserName.Length > 0
        ? Environment.UserName[..1].ToUpperInvariant() : "U";

    private string _selectedWorkspaceId = string.Empty;
    private string _selectedProjectId = string.Empty;

    private record WorkspaceItem(string Id, string Name, string Type);
    private record ProjectItem(string Id, string Name);
    private record SessionItem(string Id, string Label, DateTimeOffset Timestamp);

    private List<WorkspaceItem> _workspaces = [];
    private List<ProjectItem> _projects = [];
    private List<SessionItem> _recentSessions = [];
    private List<SessionItem> _filteredSessions = [];

    protected override void OnInitialized()
    {
        _currentModel = ShortenModelName(Config.Model);
        _isConnected = !string.IsNullOrWhiteSpace(Config.ApiKey);
        _connectionStatus = _isConnected ? "Connected" : "No API key";
        InferProvider();

        // Seed the shared context with initial model/provider
        ActiveContext.SetModel(_currentModel, _currentProvider);
        ActiveContext.OnChanged += OnActiveContextChanged;
        ActiveContext.OnDataChanged += OnDataChanged;
    }

    private void OnDataChanged()
    {
        InvokeAsync(async () =>
        {
            await LoadWorkspacesAsync();
            await LoadProjectsAsync();
            StateHasChanged();
        });
    }

    private void OnActiveContextChanged()
    {
        InvokeAsync(() =>
        {
            // Refresh model card from config (Settings may have changed it)
            _currentModel = ShortenModelName(Config.Model);
            _isConnected = !string.IsNullOrWhiteSpace(Config.ApiKey);
            _connectionStatus = _isConnected ? "Connected" : "No API key";
            InferProvider();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        ActiveContext.OnChanged -= OnActiveContextChanged;
        ActiveContext.OnDataChanged -= OnDataChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await Sovrant.Web.Program.RuntimeReady.Task;
        await LoadWorkspacesAsync();
        await LoadSessionsAsync();
        StateHasChanged();
    }

    private void InferProvider()
    {
        var url = Config.BaseUrl?.ToString() ?? string.Empty;
        _currentProvider = url switch
        {
            _ when url.Contains("openrouter", StringComparison.OrdinalIgnoreCase) => "OpenRouter",
            _ when url.Contains("deepseek", StringComparison.OrdinalIgnoreCase) => "DeepSeek",
            _ when url.Contains("groq", StringComparison.OrdinalIgnoreCase) => "Groq",
            _ when url.Contains("mistral", StringComparison.OrdinalIgnoreCase) => "Mistral",
            _ when url.Contains("together", StringComparison.OrdinalIgnoreCase) => "Together AI",
            _ when url.Contains("localhost:11434", StringComparison.Ordinal) => "Ollama",
            _ when url.Contains("localhost:1234", StringComparison.Ordinal) => "LM Studio",
            _ when string.IsNullOrEmpty(url) => "OpenAI",
            _ => "Custom",
        };

        // Try saved provider name
        try
        {
            var path = Path.Combine(
                Environment.GetFolderPath(Environment.SpecialFolder.UserProfile),
                ".sovrant", "settings.json");
            if (File.Exists(path))
            {
                var json = System.Text.Json.JsonDocument.Parse(File.ReadAllText(path));
                if (json.RootElement.TryGetProperty("Provider", out var prop) &&
                    prop.GetString() is { Length: > 0 } saved)
                    _currentProvider = saved;
            }
        }
        catch { /* use inferred */ }
    }

    private static string ShortenModelName(string model)
    {
        if (string.IsNullOrEmpty(model)) return model;
        var slashIdx = model.IndexOf('/', StringComparison.Ordinal);
        if (slashIdx >= 0 && slashIdx < model.Length - 1)
            model = model[(slashIdx + 1)..];
        foreach (var suffix in new[] { ":free", ":extended" })
        {
            if (model.EndsWith(suffix, StringComparison.OrdinalIgnoreCase))
            {
                model = model[..^suffix.Length];
                break;
            }
        }
        return model;
    }

    private async Task LoadWorkspacesAsync()
    {
        try
        {
            var list = await WorkspaceService.ListForUserAsync(Sovrant.Web.Program.SovrantUserId);
            _workspaces = list.Select(w => new WorkspaceItem(w.WorkspaceId, w.Name, w.Type.ToString())).ToList();
            var personal = _workspaces.FirstOrDefault(w => w.Type.Equals("Personal", StringComparison.OrdinalIgnoreCase));
            if (personal is not null)
            {
                _selectedWorkspaceId = personal.Id;
                ActiveContext.SetWorkspace(personal.Id, personal.Name);
                await LoadProjectsAsync();
            }
        }
        catch { /* best effort */ }
    }

    private async Task LoadProjectsAsync()
    {
        if (string.IsNullOrEmpty(_selectedWorkspaceId)) return;
        try
        {
            var list = await ProjectService.ListAsync(_selectedWorkspaceId);
            _projects = list.Select(p => new ProjectItem(p.ProjectId, p.Name)).ToList();
        }
        catch { _projects = []; }
    }

    private async Task OnWorkspaceChanged()
    {
        _selectedProjectId = string.Empty;
        await LoadProjectsAsync();
        var ws = _workspaces.FirstOrDefault(w => w.Id == _selectedWorkspaceId);
        ActiveContext.SetWorkspace(_selectedWorkspaceId, ws?.Name ?? "Personal");
    }

    private void OnProjectChanged()
    {
        var proj = _projects.FirstOrDefault(p => p.Id == _selectedProjectId);
        ActiveContext.SetProject(_selectedProjectId, proj?.Name ?? string.Empty);
    }

    private async Task LoadSessionsAsync()
    {
        try
        {
            var ids = await SessionStore.ListAsync();
            var items = new List<SessionItem>();
            foreach (var id in ids.Take(20))
            {
                var entries = await SessionStore.LoadAsync(id);
                var firstUser = entries.FirstOrDefault(e => e.Role == "user");
                var label = firstUser?.Content ?? id;
                if (label.Length > 40) label = string.Concat(label.AsSpan(0, 37), "...");
                items.Add(new SessionItem(id, label,
                    entries.Count > 0 ? entries[^1].Timestamp : DateTimeOffset.MinValue));
            }
            _recentSessions = items.OrderByDescending(s => s.Timestamp).ToList();
            _filteredSessions = _recentSessions;
        }
        catch { /* best effort */ }
    }

    private void FilterSessions()
    {
        _filteredSessions = string.IsNullOrWhiteSpace(_searchText)
            ? _recentSessions
            : _recentSessions.Where(s =>
                s.Label.Contains(_searchText, StringComparison.OrdinalIgnoreCase)
            ).ToList();
    }

    private void ResumeSession(string sessionId)
    {
        ActiveContext.ResumeSession(sessionId);
        OnNavigate.InvokeAsync("/");
    }

    private async Task DeleteSession(string sessionId)
    {
        await SessionStore.DeleteAsync(sessionId);
        _recentSessions.RemoveAll(s => s.Id == sessionId);
    }
}
