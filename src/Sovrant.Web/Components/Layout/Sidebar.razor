@using Sovrant.Runtime.Session
@using Sovrant.Web.Services
@inject IJSRuntime JS
@implements IDisposable

<aside class="sidebar">
    <div class="sidebar-scroll">
        <!-- New Chat button -->
        <button class="new-chat-btn btn-primary" @onclick="NewChat">+ New Chat</button>

        <!-- Search -->
        <div class="sidebar-search">
            <input type="text" placeholder="Search conversations..." @bind="_searchText" @bind:event="oninput" @bind:after="FilterSessions" />
        </div>

        <!-- Active background sessions -->
        @if (_activeSessions.Count > 0)
        {
            <div class="nav-section-header">ACTIVE</div>
            @foreach (var session in _activeSessions)
            {
                <div class="session-item session-item--active">
                    <button class="session-btn" @onclick="() => ResumeSession(session.SessionId)">
                        <div class="session-label">
                            @if (session.Status == ActiveSessionStatus.Running)
                            {
                                <span class="active-spinner" title="Running"></span>
                            }
                            else if (session.Status == ActiveSessionStatus.Completed)
                            {
                                <span class="active-done" title="Completed">&#10003;</span>
                            }
                            else
                            {
                                <span class="active-failed" title="@session.Error">&#9888;</span>
                            }
                            @session.Title
                        </div>
                        <div class="session-time">@FormatElapsed(session.Elapsed)</div>
                    </button>
                    @if (session.Status == ActiveSessionStatus.Running)
                    {
                        <button class="session-delete" @onclick="() => CancelSession(session.SessionId)" title="Cancel">&#x25FC;</button>
                    }
                    else
                    {
                        <button class="session-delete" @onclick="() => DismissSession(session.SessionId)" title="Dismiss">&#x2715;</button>
                    }
                </div>
            }
        }

        <!-- Recent conversations grouped by date -->
        @if (_filteredSessions.Count == 0)
        {
            <div class="no-sessions">No recent conversations</div>
        }
        else
        {
            @foreach (var group in GetGroupedSessions())
            {
                <div class="nav-section-header">@group.Label</div>
                @foreach (var session in group.Sessions)
                {
                    var isActive = ActiveSessions.HasSession(session.Id);
                    <div class="session-item @(isActive ? "session-item--active-badge" : "")">
                        <button class="session-btn" @onclick="() => ResumeSession(session.Id)">
                            <div class="session-label">
                                @if (isActive)
                                {
                                    <span class="active-badge">ACTIVE</span>
                                }
                                @session.Label
                            </div>
                            <div class="session-time">@session.Timestamp.ToString("MMM d, HH:mm")</div>
                        </button>
                        <button class="session-delete" @onclick="() => DeleteSession(session.Id)" title="Delete session">&#x2715;</button>
                    </div>
                }
            }
        }
    </div>
</aside>

@code {
    [Parameter] public EventCallback<string> OnNavigate { get; set; }

    [Inject] private ISessionStore SessionStore { get; set; } = default!;
    [Inject] private ActiveContextService ActiveContext { get; set; } = default!;
    [Inject] private ActiveSessionsService ActiveSessions { get; set; } = default!;

    private string _searchText = string.Empty;

    private record SessionItem(string Id, string Label, DateTimeOffset Timestamp);

    private List<SessionItem> _recentSessions = [];
    private List<SessionItem> _filteredSessions = [];
    private List<ActiveSessionInfo> _activeSessions = [];

    // 1-second tick to refresh elapsed time while any sessions are running.
    private CancellationTokenSource? _timerCts;

    protected override void OnInitialized()
    {
        ActiveContext.OnDataChanged += OnDataChanged;
        ActiveSessions.OnChanged += OnActiveSessionsChanged;
    }

    private void OnDataChanged()
    {
        InvokeAsync(async () =>
        {
            await LoadSessionsAsync();
            StateHasChanged();
        });
    }

    private void OnActiveSessionsChanged()
    {
        InvokeAsync(async () =>
        {
            _activeSessions = ActiveSessions.GetAll().ToList();
            var hasRunning = _activeSessions.Any(s => s.Status == ActiveSessionStatus.Running);
            if (hasRunning) EnsureTimer();
            else StopTimer();

            // Update browser tab title when a session finishes or fails while the user is away.
            var needsAttention = _activeSessions.Any(s =>
                s.Status == ActiveSessionStatus.Completed || s.Status == ActiveSessionStatus.Failed);
            try
            {
                if (needsAttention)
                    await JS.InvokeVoidAsync("sovrantInterop.setTabTitlePrefix", "● ");
                else
                    await JS.InvokeVoidAsync("sovrantInterop.clearTabTitlePrefix");
            }
            catch { /* JS interop may fail if circuit is not fully connected */ }

            StateHasChanged();
        });
    }

    private void EnsureTimer()
    {
        if (_timerCts is not null) return;
        _timerCts = new CancellationTokenSource();
        var token = _timerCts.Token;
        _ = Task.Run(async () =>
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
            while (!token.IsCancellationRequested && await timer.WaitForNextTickAsync(token).ConfigureAwait(false))
                await InvokeAsync(StateHasChanged);
        }, token);
    }

    private void StopTimer()
    {
        _timerCts?.Cancel();
        _timerCts?.Dispose();
        _timerCts = null;
    }

    public void Dispose()
    {
        ActiveContext.OnDataChanged -= OnDataChanged;
        ActiveSessions.OnChanged -= OnActiveSessionsChanged;
        StopTimer();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await Sovrant.Web.Program.RuntimeReady.Task;
        await LoadSessionsAsync();
        _activeSessions = ActiveSessions.GetAll().ToList();
        StateHasChanged();
    }

    private async Task LoadSessionsAsync()
    {
        try
        {
            var ids = await SessionStore.ListAsync(ownerUserId: Sovrant.Web.Program.SovrantUserId);
            var items = new List<SessionItem>();
            foreach (var id in ids.Take(20))
            {
                var entries = await SessionStore.LoadAsync(id, ownerUserId: Sovrant.Web.Program.SovrantUserId);
                var firstUser = entries.FirstOrDefault(e => e.Role == "user");
                var label = firstUser?.Content ?? id;
                if (label.Length > 40) label = string.Concat(label.AsSpan(0, 37), "...");
                items.Add(new SessionItem(id, label,
                    entries.Count > 0 ? entries[^1].Timestamp : DateTimeOffset.MinValue));
            }
            _recentSessions = items.OrderByDescending(s => s.Timestamp).ToList();
            _filteredSessions = _recentSessions;
        }
        catch { /* best effort */ }
    }

    private void FilterSessions()
    {
        _filteredSessions = string.IsNullOrWhiteSpace(_searchText)
            ? _recentSessions
            : _recentSessions.Where(s =>
                s.Label.Contains(_searchText, StringComparison.OrdinalIgnoreCase)
            ).ToList();
    }

    private async Task ResumeSession(string sessionId)
    {
        try { await JS.InvokeVoidAsync("sovrantInterop.clearTabTitlePrefix"); } catch { }
        ActiveContext.ResumeSession(sessionId);
        await OnNavigate.InvokeAsync("/");
    }

    private async Task NewChat()
    {
        ActiveContext.StartNewSession();
        await OnNavigate.InvokeAsync("/");
    }

    private async Task DeleteSession(string sessionId)
    {
        await SessionStore.DeleteAsync(sessionId, ownerUserId: Sovrant.Web.Program.SovrantUserId);
        _recentSessions.RemoveAll(s => s.Id == sessionId);
    }

    private void CancelSession(string sessionId) => ActiveSessions.Cancel(sessionId);
    private void DismissSession(string sessionId) => ActiveSessions.Dismiss(sessionId);

    private static string FormatElapsed(TimeSpan t) =>
        t.TotalSeconds < 60 ? $"{(int)t.TotalSeconds}s" : $"{(int)t.TotalMinutes}m {t.Seconds}s";

    private record SessionGroup(string Label, List<SessionItem> Sessions);

    private IEnumerable<SessionGroup> GetGroupedSessions()
    {
        var now = DateTimeOffset.Now;
        var todayStart = now.Date;
        var yesterdayStart = todayStart.AddDays(-1);
        var weekStart = todayStart.AddDays(-7);

        var today = _filteredSessions.Where(s => s.Timestamp >= todayStart).ToList();
        var yesterday = _filteredSessions.Where(s => s.Timestamp >= yesterdayStart && s.Timestamp < todayStart).ToList();
        var thisWeek = _filteredSessions.Where(s => s.Timestamp >= weekStart && s.Timestamp < yesterdayStart).ToList();
        var older = _filteredSessions.Where(s => s.Timestamp < weekStart).ToList();

        if (today.Count > 0) yield return new SessionGroup("TODAY", today);
        if (yesterday.Count > 0) yield return new SessionGroup("YESTERDAY", yesterday);
        if (thisWeek.Count > 0) yield return new SessionGroup("THIS WEEK", thisWeek);
        if (older.Count > 0) yield return new SessionGroup("OLDER", older);
    }
}
