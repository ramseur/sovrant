@{
    var relativePath = Nav.ToBaseRelativePath(Nav.Uri);
    var isActive = Href == "/"
        ? string.IsNullOrEmpty(relativePath) || relativePath == "/" || relativePath.StartsWith("?", StringComparison.Ordinal)
        : ("/" + relativePath).Equals(Href, StringComparison.OrdinalIgnoreCase);
}

<button class="nav-btn @(isActive ? "active" : "")"
        @onclick="() => OnClick.InvokeAsync(Href)">
    <span class="nav-icon"><SovrantIcon Name="@Icon" /></span>
    <span class="nav-label">@Label</span>
</button>

@code {
    [Parameter] public string Href { get; set; } = "/";
    [Parameter] public string Icon { get; set; } = "";
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public EventCallback<string> OnClick { get; set; }

    [Inject] private NavigationManager Nav { get; set; } = default!;
}
