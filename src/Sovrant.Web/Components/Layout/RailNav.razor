@*
    Phase 69 — horizontal group-icon row that lives at the top of the
    single secondary sidebar. Settings + avatar are rendered separately
    in the sidebar footer to avoid duplicating them at the bottom.
*@
@using Sovrant.Web.Services
@inject WebSessionService Session

<div class="rail-icons-row">
    <button class="rail-icon @(Selected == "chat" ? "active" : "")"
            title="Chat" @onclick='() => OnSelect.InvokeAsync("chat")'>&#x1F4AC;</button>
    <button class="rail-icon @(Selected == "knowledge" ? "active" : "")"
            title="Knowledge" @onclick='() => OnSelect.InvokeAsync("knowledge")'>&#x1F4DA;</button>
    <button class="rail-icon @(Selected == "agents" ? "active" : "")"
            title="Agents" @onclick='() => OnSelect.InvokeAsync("agents")'>&#x1F916;</button>
    <button class="rail-icon @(Selected == "workspace" ? "active" : "")"
            title="Projects" @onclick='() => OnSelect.InvokeAsync("workspace")'>&#x1F5C2;&#xFE0F;</button>
    <button class="rail-icon @(Selected == "connect" ? "active" : "")"
            title="Connect" @onclick='() => OnSelect.InvokeAsync("connect")'>&#x1F50C;</button>
    <button class="rail-icon @(Selected == "dashboard" ? "active" : "")"
            title="User Dashboard" @onclick='() => OnSelect.InvokeAsync("dashboard")'>&#x1F464;</button>
    <button class="rail-icon @(Selected == "settings" ? "active" : "")"
            title="Settings" @onclick='() => OnSelect.InvokeAsync("settings")'>&#9881;</button>
    @if (Session.IsAdmin)
    {
        <button class="rail-icon @(Selected == "admin" ? "active" : "")"
                title="Admin" @onclick='() => OnSelect.InvokeAsync("admin")'>&#x1F511;</button>
    }
</div>

@code {
    [Parameter] public string Selected { get; set; } = "chat";
    [Parameter] public EventCallback<string> OnSelect { get; set; }
}
