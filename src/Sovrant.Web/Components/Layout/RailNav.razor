@*
    Phase 69 — vertical group-icon list that lives at the top of the
    single secondary sidebar. Settings + avatar are rendered separately
    in the sidebar footer to avoid duplicating them at the bottom.
    Always icon+label; the collapsed rail state (driven by MainLayout's
    .rail-secondary.collapsed) hides the label and centers the icon via CSS.
*@
@using Sovrant.Web.Services
@inject WebSessionService Session

<div class="rail-icons-row">
    <button class="rail-icon @(Selected == "dashboard" ? "active" : "")"
            title="User Dashboard" @onclick='() => OnSelect.InvokeAsync("dashboard")'>
        <span class="rail-icon-glyph">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="9" rx="1.5"/><rect x="14" y="3" width="7" height="5" rx="1.5"/><rect x="14" y="12" width="7" height="9" rx="1.5"/><rect x="3" y="16" width="7" height="5" rx="1.5"/></svg>
        </span>
        <span class="rail-label">Dashboard</span>
    </button>
    <button class="rail-icon @(Selected == "chat" ? "active" : "")"
            title="Chat" @onclick='() => OnSelect.InvokeAsync("chat")'>
        <span class="rail-icon-glyph">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
        </span>
        <span class="rail-label">Chat</span>
    </button>
    <button class="rail-icon @(Selected == "knowledge" ? "active" : "")"
            title="Knowledge" @onclick='() => OnSelect.InvokeAsync("knowledge")'>
        <span class="rail-icon-glyph">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
        </span>
        <span class="rail-label">Knowledge</span>
    </button>
    <button class="rail-icon @(Selected == "agents" ? "active" : "")"
            title="Agents" @onclick='() => OnSelect.InvokeAsync("agents")'>
        <span class="rail-icon-glyph">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="7" width="16" height="13" rx="2.5"/><path d="M9 7V5a3 3 0 0 1 6 0v2"/><line x1="9" y1="13" x2="9" y2="13.01"/><line x1="15" y1="13" x2="15" y2="13.01"/><path d="M9 17h6"/></svg>
        </span>
        <span class="rail-label">Agents</span>
    </button>
    <button class="rail-icon @(Selected == "workspace" ? "active" : "")"
            title="Projects" @onclick='() => OnSelect.InvokeAsync("workspace")'>
        <span class="rail-icon-glyph">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7.5A1.5 1.5 0 0 1 4.5 6H9l2 2.5h8.5A1.5 1.5 0 0 1 21 10v8a1.5 1.5 0 0 1-1.5 1.5h-15A1.5 1.5 0 0 1 3 18z"/></svg>
        </span>
        <span class="rail-label">Projects</span>
    </button>
    @if (Session.IsAdmin)
    {
        <button class="rail-icon @(Selected == "admin" ? "active" : "")"
                title="Admin" @onclick='() => OnSelect.InvokeAsync("admin")'>
            <span class="rail-icon-glyph">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l8 3.5v6c0 5-3.4 8.9-8 10.5-4.6-1.6-8-5.5-8-10.5v-6z"/></svg>
            </span>
            <span class="rail-label">Admin</span>
        </button>
    }
</div>

@code {
    [Parameter] public string Selected { get; set; } = "chat";
    [Parameter] public EventCallback<string> OnSelect { get; set; }
}
