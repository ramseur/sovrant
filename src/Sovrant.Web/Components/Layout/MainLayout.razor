@inherits LayoutComponentBase
@implements IDisposable

<div class="app-shell">
    <aside class="rail-secondary @(_collapsed ? "collapsed" : "")">
        <button class="rail-collapse-btn" @onclick="() => _collapsed = !_collapsed"
                title="@(_collapsed ? "Expand sidebar" : "Collapse sidebar")" aria-label="@(_collapsed ? "Expand sidebar" : "Collapse sidebar")">
            <SovrantIcon Name="@(_collapsed ? IconNames.RailExpand : IconNames.RailCollapse)" Size="16" />
        </button>
        @if (_collapsed)
        {
            @* Phase 135 — collapsed rail: icons with keyboard-accessible flyouts. *@
            <RailNav OnExpand="() => _collapsed = false" />
        }
        else
        {
            @* Phase 135 — expanded rail: collapsible nav groups, then Conversations
               on every page. The nav never scrolls on its own; Conversations fill the
               rest (min 160px) with their own scroll; only a very short window scrolls
               this middle area as one. *@
            <div class="rail-body">
                <AppNav />
                <div class="rail-conversations">
                    <div class="rail-section-label">Conversations</div>
                    <Sidebar OnNavigate="Navigate" />
                </div>
            </div>
        }

        @if (_acctOpen && !Program.IsRemoteMode)
        {
            @* Phase 145 — account menu: who you are, how long this browser stays signed in, sign out here or everywhere. *@
            <div class="acct-scrim" @onclick="() => _acctOpen = false"></div>
            <div class="acct-menu" role="menu">
                <div class="acct-head">
                    <div class="rail-footer-avatar">@_userInitial</div>
                    <div>
                        <div class="acct-name">@_userName</div>
                        <div class="acct-email">@Session.Email · @(Session.IsAdmin ? "Admin" : "Member")</div>
                    </div>
                </div>
                <div class="acct-body">
                    @((MarkupString)_acctLifetime)<br />Signed in on @_acctBrowsers @(_acctBrowsers == 1 ? "browser" : "browsers").
                </div>
                <button class="acct-item" role="menuitem" @onclick='() => { _acctOpen = false; Nav.NavigateTo("/settings"); }'>Settings</button>
                <form class="signout-form" method="post" action="/auth/logout">
                    <AntiforgeryToken />
                    <button class="acct-item" role="menuitem" type="submit">Sign out</button>
                    <button class="acct-item" role="menuitem" type="submit" name="scope" value="all">Sign out of all browsers</button>
                </form>
            </div>
        }
        <div class="rail-footer">
            <button class="rail-footer-user @(_acctOpen ? "open" : "")" title="@(Program.IsRemoteMode ? "Settings" : "Account")"
                    aria-haspopup="@(Program.IsRemoteMode ? "false" : "menu")" aria-expanded="@_acctOpen"
                    @onclick="OnFooterClick">
                <div class="rail-footer-avatar">@_userInitial</div>
                <div class="rail-footer-info">
                    <div class="rail-footer-name">@_userName</div>
                    @* The account's role, not the workspace role: everyone owns their personal workspace, so
                       that showed "owner" for every person. *@
                    @if (Session.IsAuthenticated)
                    {
                        <div class="rail-footer-sub">@(Session.IsAdmin ? "Admin" : "Member")</div>
                    }
                </div>
            </button>
            @if (Program.IsRemoteMode)
            {
                <button class="rail-footer-settings" title="Sign out" @onclick="LogoutAsync">&#x21AA;</button>
            }
        </div>
    </aside>

    <main class="content-area">
        <TopContextBar />
        @Body
    </main>

    <CommandPalette @ref="_palette" OnCommandOutput="OnCommandOutput" OnInjectMessage="OnInjectMessage" />
</div>

@code {
    [Inject] private NavigationManager Nav { get; set; } = default!;
    [Inject] private IJSRuntime JS { get; set; } = default!;
    [Inject] private IServiceProvider Services { get; set; } = default!;
    [Inject] private Sovrant.Web.Services.ActiveContextService ActiveContext { get; set; } = default!;
    [Inject] private Sovrant.Web.Services.WebSessionService Session { get; set; } = default!;
    [Inject] private Sovrant.Runtime.Onboarding.OnboardingService Onboarding { get; set; } = default!;

    private bool _collapsed;
    private CommandPalette? _palette;
    private DotNetObjectReference<MainLayout>? _dotNetRef;

    private string _userName => LocalPart(Session.Email) ?? Session.UserId ?? "user";
    private string _userInitial => (_userName.Length > 0 ? _userName[..1] : "U").ToUpperInvariant();

    private static string? LocalPart(string? email)
    {
        if (email is null) return null;
        var idx = email.IndexOf('@', StringComparison.Ordinal);
        return idx > 0 ? email[..idx] : email;
    }

    protected override void OnInitialized()
    {
        // Phase 145: carry why a refused cookie was refused (timed out / revoked) to the Sign in notice.
        if (!Session.IsAuthenticated)
            Nav.NavigateTo(Session.SignedOutReason is { } why ? $"/login?reason={why}" : "/login", forceLoad: false);
        Nav.LocationChanged += OnLocationChanged;
        MarkKnowledgeVisited(Nav.Uri);
    }

    // Phase 140 — opening any Knowledge page ticks "Explore Knowledge" on the member checklist.
    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e) =>
        MarkKnowledgeVisited(e.Location);

    private void MarkKnowledgeVisited(string uri)
    {
        var userId = Session.UserId;
        if (string.IsNullOrEmpty(userId) || AppNavModel.GroupForPath(Nav.ToBaseRelativePath(uri).Insert(0, "/"))?.Key != "knowledge")
            return;
        _ = Onboarding.MarkKnowledgeVisitedAsync(userId);
    }

    private void Navigate(string url)
    {
        Nav.NavigateTo(url);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("sovrantInterop.registerCtrlK", _dotNetRef);
            if (Session.IsCookieSignIn)
            {
                await JS.InvokeVoidAsync("sovrantSignIn.start");
                _ = WatchSignInAsync(_signInWatch.Token);
            }
        }
    }

    /// <summary>
    /// Phase 145: once a minute, check this tab's sign-in on the server. If it ended (idle timeout,
    /// 12-hour limit, revoked, signed out in another tab) the tab stops acting as the user at once
    /// and goes to Sign in, even if the browser-side check didn't run.
    /// </summary>
    private async Task WatchSignInAsync(CancellationToken ct)
    {
        var signIns = Services.GetService<Sovrant.Runtime.Auth.IWebSignInService>();
        var policy = Services.GetService<Sovrant.Runtime.Auth.WebSignInPolicySource>()?.Current;
        if (signIns is null || policy is null || Session.SignInId is null) return;
        using var timer = new PeriodicTimer(TimeSpan.FromMinutes(1));
        try
        {
            while (await timer.WaitForNextTickAsync(ct))
            {
                var check = await signIns.CheckByIdAsync(Session.SignInId, policy, ct);
                if (check.IsValid) continue;
                var reason = check.Status switch
                {
                    Sovrant.Runtime.Auth.WebSignInStatus.TimedOut => Sovrant.Web.Auth.WebAuth.ReasonTimedOut,
                    Sovrant.Runtime.Auth.WebSignInStatus.Revoked when check.RevokedReason == Sovrant.Runtime.Auth.WebSignInRevokeReasons.Admin => Sovrant.Web.Auth.WebAuth.ReasonRevoked,
                    _ => null,
                };
                Session.MarkSignedOut(reason);
                await InvokeAsync(() => Nav.NavigateTo(reason is null ? "/login" : $"/login?reason={reason}", forceLoad: true));
                return;
            }
        }
        catch (OperationCanceledException) { /* tab closed */ }
    }

    [JSInvokable]
    public async Task OnCtrlK()
    {
        if (_palette is not null)
            await _palette.ToggleAsync();
    }

    private void OnCommandOutput(string output) { /* could show toast */ }
    private void OnInjectMessage(string msg) => Nav.NavigateTo($"/?inject={Uri.EscapeDataString(msg)}");

    /// <summary>Remote mode only (process-wide sign-in until Phase 145 Part C).</summary>
    private void LogoutAsync()
    {
        Session.SignOut();
        Nav.NavigateTo("/login", forceLoad: false);
    }

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
        _signInWatch.Cancel();
        _signInWatch.Dispose();
        _dotNetRef?.Dispose();
    }

    private readonly CancellationTokenSource _signInWatch = new();

    // ── Phase 145 account menu ──────────────────────────────────────────────
    private bool _acctOpen;
    private string _acctLifetime = string.Empty;
    private int _acctBrowsers = 1;

    private async Task OnFooterClick()
    {
        if (Program.IsRemoteMode) { Nav.NavigateTo("/settings"); return; }
        _acctOpen = !_acctOpen;
        if (_acctOpen) await LoadAccountAsync();
    }

    private async Task LoadAccountAsync()
    {
        var signIns = Services.GetService<Sovrant.Runtime.Auth.IWebSignInService>();
        var policy = Services.GetService<Sovrant.Runtime.Auth.WebSignInPolicySource>()?.Current;
        if (signIns is null || policy is null || Session.UserId is null) return;
        var mine = await signIns.ListActiveAsync(Session.UserId, policy);
        _acctBrowsers = Math.Max(1, mine.Count);
        var current = mine.FirstOrDefault(s => s.SignInId == Session.SignInId);
        _acctLifetime = AccountLifetime(current, policy);
    }

    internal static string AccountLifetime(Sovrant.Runtime.Auth.WebSignIn? s, Sovrant.Runtime.Auth.WebSignInPolicy policy)
    {
        if (s is not null && policy.KeepsSignedIn(s))
            return $"<b>Kept signed in for {Sovrant.Runtime.Auth.WebSignInSettings.Describe(policy.RememberLifetime)}</b> on this browser (until {policy.ExpiryOf(s).LocalDateTime:d MMM}). You chose \"Keep me signed in\".";
        var idle = Sovrant.Runtime.Auth.WebSignInSettings.Describe(policy.IdleTimeout);
        var since = s is null ? string.Empty : $" Signed in {Ago(DateTimeOffset.UtcNow - s.CreatedAt)}.";
        return $"<b>Signed out after {idle} idle</b>, renewed while you're active ({Sovrant.Runtime.Auth.WebSignInSettings.Describe(policy.AbsoluteLifetime)} at most).{since}";
    }

    private static string Ago(TimeSpan t) =>
        t.TotalMinutes < 1 ? "just now"
        : t.TotalMinutes < 60 ? $"{(int)t.TotalMinutes} min ago"
        : $"{(int)t.TotalHours} h {t.Minutes} min ago";
}
