@inherits LayoutComponentBase
@implements IDisposable

<div class="app-shell">
    @if (_isCollapsed)
    {
        <nav class="sidebar-collapsed">
            <button class="icon-btn" @onclick="ToggleSidebar" title="Expand sidebar">&#9707;</button>
            <button class="icon-btn" @onclick='() => Navigate("/")' title="Chat">&#x1F4AC;</button>
            <button class="icon-btn" @onclick='() => Navigate("/settings")' title="Settings">&#9881;</button>
            <button class="icon-btn" @onclick='() => Navigate("/diagnostics")' title="Diagnostics">&#x1F527;</button>
            <div class="icon-divider"></div>
            <button class="icon-btn" @onclick='() => Navigate("/artifacts")' title="Artifacts">&#x1F4C4;</button>
            <button class="icon-btn" @onclick='() => Navigate("/tools")' title="Tools">&#x1F6E0;</button>
            <button class="icon-btn" @onclick='() => Navigate("/skills")' title="Skills">&#x1F4DC;</button>
            <button class="icon-btn" @onclick='() => Navigate("/agents")' title="Agents">&#x1F916;</button>
            <button class="icon-btn" @onclick='() => Navigate("/memory")' title="Memory">&#x1F9E0;</button>
            <div class="icon-divider"></div>
            <button class="icon-btn" @onclick='() => Navigate("/projects")' title="Projects">&#x1F4C1;</button>
            <button class="icon-btn" @onclick='() => Navigate("/workspaces")' title="Workspaces">&#x1F3E2;</button>
            <button class="icon-btn" @onclick='() => Navigate("/multi-agent")' title="Multi-Agent">&#x1F465;</button>
            <button class="icon-btn" @onclick='() => Navigate("/integrations")' title="Integrations">&#x1F50C;</button>
            <div class="sidebar-collapsed-bottom">
                <div class="user-avatar-small" title="@_userName">@_userInitial</div>
            </div>
        </nav>
    }
    else
    {
        <Sidebar IsCollapsed="_isCollapsed"
                 OnToggleCollapse="ToggleSidebar"
                 OnNavigate="Navigate" />
    }

    <main class="content-area">
        @Body
    </main>

    <CommandPalette @ref="_palette" OnCommandOutput="OnCommandOutput" OnInjectMessage="OnInjectMessage" />
</div>

@code {
    [Inject] private NavigationManager Nav { get; set; } = default!;
    [Inject] private IJSRuntime JS { get; set; } = default!;

    private bool _isCollapsed;
    private string _userName = Environment.UserName;
    private string _userInitial = Environment.UserName.Length > 0
        ? Environment.UserName[..1].ToUpperInvariant() : "U";
    private CommandPalette? _palette;
    private DotNetObjectReference<MainLayout>? _dotNetRef;

    private void ToggleSidebar() => _isCollapsed = !_isCollapsed;

    private void Navigate(string url)
    {
        Nav.NavigateTo(url);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("sovrantInterop.registerCtrlK", _dotNetRef);
        }
    }

    [JSInvokable]
    public async Task OnCtrlK()
    {
        if (_palette is not null)
            await _palette.ToggleAsync();
    }

    private void OnCommandOutput(string output) { /* could show toast */ }
    private void OnInjectMessage(string msg) => Nav.NavigateTo($"/?inject={Uri.EscapeDataString(msg)}");

    public void Dispose() => _dotNetRef?.Dispose();
}
