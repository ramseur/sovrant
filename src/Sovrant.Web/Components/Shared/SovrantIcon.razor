@using Blazicons

<Blazicon Svg="@Resolve(Name)" />

@code {
    [Parameter, EditorRequired] public string? Name { get; set; }

    private static SvgIcon Resolve(string? name) => name switch
    {
        "activity" => Lucide.Activity,
        "agent" => Lucide.Bot,
        "alert" => Lucide.TriangleAlert,
        "artifacts" => Lucide.FileText,
        "bot" => Lucide.Bot,
        "brain" => Lucide.Brain,
        "building" => Lucide.Building2,
        "chart" => Lucide.ChartNoAxesCombined,
        "check" => Lucide.Check,
        "check-circle" => Lucide.CircleCheck,
        "cloud" => Lucide.Cloud,
        "code" => Lucide.Code,
        "database" => Lucide.Database,
        "database-zap" => Lucide.DatabaseZap,
        "document" => Lucide.FileText,
        "file" => Lucide.File,
        "file-chart" => Lucide.FileChartColumn,
        "file-spreadsheet" => Lucide.FileSpreadsheet,
        "folder" => Lucide.Folder,
        "globe" => Lucide.Globe,
        "governance" => Lucide.Shield,
        "image" => Lucide.Image,
        "integrations" => Lucide.Plug,
        "kanban" => Lucide.Kanban,
        "key" => Lucide.KeyRound,
        "knowledge" => Lucide.BookOpen,
        "layers" => Lucide.Layers,
        "link" => Lucide.Link,
        "lock" => Lucide.Lock,
        "unlock" => Lucide.LockOpen,
        "logout" => Lucide.LogOut,
        "memory" => Lucide.BrainCircuit,
        "message" => Lucide.MessageSquare,
        "monitor" => Lucide.Monitor,
        "music" => Lucide.Music,
        "network" => Lucide.Network,
        "orchestration" => Lucide.Workflow,
        "panel" => Lucide.PanelsTopLeft,
        "paperclip" => Lucide.Paperclip,
        "play" => Lucide.Play,
        "project" => Lucide.Folder,
        "refresh" => Lucide.RefreshCw,
        "route" => Lucide.Route,
        "search" => Lucide.Search,
        "send" => Lucide.Send,
        "settings" => Lucide.Settings2,
        "shield" => Lucide.Shield,
        "snowflake" => Lucide.Snowflake,
        "sparkles" => Lucide.Sparkles,
        "square" => Lucide.Square,
        "swarm" => Lucide.Network,
        "target" => Lucide.Target,
        "team" => Lucide.Users,
        "tools" => Lucide.Wrench,
        "users" => Lucide.Users,
        "waypoints" => Lucide.Waypoints,
        "wind" => Lucide.Wind,
        "workflow" => Lucide.Workflow,
        "x" => Lucide.X,
        "zap" => Lucide.Zap,
        _ => Lucide.Circle,
    };
}
