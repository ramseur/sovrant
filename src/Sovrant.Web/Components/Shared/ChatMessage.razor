@using Markdig
@inject IJSRuntime JS

@* Phase 137 — user messages are right-aligned brand bubbles with the initials avatar;
   assistant messages are flat beside a neutral avatar tile, with one muted meta line. *@
<div class="message @(Message.IsUser ? "msg-user" : "msg-assistant")">
    @if (Message.IsUser)
    {
        <div class="user-bubble message-text">@Message.Text</div>
        <div class="msg-avatar user-avatar-chat" title="@Message.SenderLabel">@AvatarText.Initials(Message.SenderLabel)</div>
    }
    else
    {
        <div class="msg-avatar sovrant-avatar" aria-hidden="true">
            <SovrantIcon Name="@IconNames.Chat" />
        </div>
        <div class="msg-content">

            @if (!string.IsNullOrEmpty(Message.IntentNarration) && (Message.IsThinking || Message.IsExecutingTools))
            {
                <div class="intent-narration msg-indent">@Message.IntentNarration</div>
            }

            @if (Message.IsThinking)
            {
                <div class="thinking-indicator msg-indent">
                    <span class="thinking-dot"></span>
                    <span class="thinking-text">@Message.ThinkingText</span>
                    <span class="elapsed-text">@Message.ElapsedText</span>
                </div>
            }

            @{
                var pendingTools = Message.ToolUses.Where(t => t.IsPendingConfirmation).ToList();
                var stripTools = Message.ToolUses.Where(t => !t.IsPendingConfirmation).ToList();
                var hasWork = pendingTools.Count > 0 || stripTools.Count > 0 || Message.IsExecutingTools;
            }

            @* Answer-first (Phase 126 #4): once the turn is complete, the answer renders
               above the work strip so it's readable without scrolling past tool blocks. *@
            @if (Message.IsComplete && !string.IsNullOrEmpty(Message.Text))
            {
                <div class="msg-indent">
                    <div class="message-markdown">@((MarkupString)RenderMarkdown(Message.Text))</div>
                </div>
                @if (hasWork)
                {
                    <div class="work-separator"></div>
                }
            }

            @if (pendingTools.Count > 0)
            {
                <div class="msg-indent">
                    @foreach (var tool in pendingTools)
                    {
                        <div class="tool-use-block">
                            <div class="tool-header">
                                <span class="tool-icon"><SovrantIcon Name="@IconNames.Tool" Size="13" /></span>
                                <span class="tool-name">@ChatMessageModel.FriendlyToolLabel(tool.ToolName)</span>
                                <span class="tool-status status-running">@tool.Status</span>
                            </div>
                            <div class="tool-confirmation">
                                <div class="tool-input-preview">@tool.Result</div>
                                <div class="tool-actions">
                                    <button class="btn-approve" @onclick="() => OnApprove.InvokeAsync(tool)"><SovrantIcon Name="@IconNames.Allow" Size="13" Class="icon-inline icon-lead" />Allow once</button>
                                    <button class="btn-approve-turn" @onclick="() => OnApproveForTurn.InvokeAsync(tool)" title="Auto-approve this tool for the rest of this turn"><SovrantIcon Name="@IconNames.AllowAll" Size="13" Class="icon-inline icon-lead" />Allow for turn</button>
                                    <button class="btn-deny" @onclick="() => OnDeny.InvokeAsync(tool)"><SovrantIcon Name="@IconNames.Deny" Size="13" Class="icon-inline icon-lead" />Deny</button>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }

            @if (stripTools.Count > 0 || Message.IsExecutingTools)
            {
                <div class="msg-indent">
                    <WorkStrip ToolUses="stripTools"
                               IsExecuting="Message.IsExecutingTools"
                               ExecutionStatusText="@Message.ExecutionStatusText"
                               ActionSummary="@Message.ActionSummary"
                               ElapsedText="@Message.ElapsedText" />
                </div>
            }

            @if (Message.StandaloneArtifacts.Count > 0)
            {
                <div class="msg-indent doc-artifact-list">
                    @foreach (var art in Message.StandaloneArtifacts)
                    {
                        <div class="doc-artifact-card">
                            <div class="doc-artifact-header">
                                <span class="doc-artifact-icon"><SovrantIcon Name="@IconNames.Attach" Size="16" /></span>
                                <div class="doc-artifact-meta">
                                    <div class="doc-artifact-name">@System.IO.Path.GetFileName(art.Path)</div>
                                    <div class="doc-artifact-sub">
                                        <span>@art.Format.ToUpperInvariant()</span>
                                        <span> · @DocumentArtifactCard.FormatBytes(art.SizeBytes)</span>
                                        <span class="doc-artifact-auto-label"> · auto-saved</span>
                                    </div>
                                </div>
                                @if (!string.IsNullOrEmpty(art.AccessUrl))
                                {
                                    <a class="doc-artifact-download" href="@art.AccessUrl" target="_blank" rel="noopener">Download</a>
                                }
                            </div>
                        </div>
                    }
                </div>
            }

            @if (!Message.IsComplete && !string.IsNullOrEmpty(Message.Text))
            {
                <div class="msg-indent">
                    <div class="message-text streaming">@Message.Text<span class="stream-caret" aria-hidden="true"></span></div>
                </div>
            }

            @if (Message.HasSources)
            {
                <details class="msg-sources msg-indent">
                    <summary class="sources-summary">Sources <span class="sources-count">(@Message.Sources.Count)</span></summary>
                    <div class="sources-list">
                        @foreach (var source in Message.Sources)
                        {
                            <span class="source-chip source-kind-@source.Kind.Replace("-", "")">@SourceLabel(source.Kind) @source.Slug</span>
                        }
                    </div>
                </details>
            }

            @if (Message.HasError)
            {
                <div class="message-error msg-indent">
                    <div class="error-content">
                        <div class="error-title">Request failed</div>
                        <div class="error-detail">@Message.ErrorMessage</div>
                    </div>
                    <button class="btn-retry" @onclick="() => OnRetry.InvokeAsync()">Retry</button>
                </div>
            }

            @if (Message.IsComplete)
            {
                <div class="msg-meta">
                    <span>@Message.SenderLabel</span>
                    @if (!string.IsNullOrEmpty(Message.ElapsedText))
                    {
                        <span aria-hidden="true">·</span>
                        <span>@Message.ElapsedText</span>
                    }
                    <span aria-hidden="true">·</span>
                    <button class="msg-meta-act" title="Copy reply" @onclick="CopyMessageAsync">@_copyLabel</button>
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public ChatMessageModel Message { get; set; } = default!;
    [Parameter] public EventCallback OnRetry { get; set; }
    [Parameter] public EventCallback<ToolUseModel> OnApprove { get; set; }
    [Parameter] public EventCallback<ToolUseModel> OnApproveForTurn { get; set; }
    [Parameter] public EventCallback<ToolUseModel> OnDeny { get; set; }

    private string _copyLabel = "Copy";

    private async Task CopyMessageAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", Message.Text);
            _copyLabel = "Copied!";
            StateHasChanged();
            await Task.Delay(1500);
            _copyLabel = "Copy";
            StateHasChanged();
        }
        catch { }
    }

    private static string SourceLabel(string kind) => kind switch
    {
        "skills" => "Skill:",
        "agents" => "Agent:",
        "document-templates" => "Template:",
        "tools" => "Guide:",
        _ => kind + ":",
    };

    private static readonly MarkdownPipeline Pipeline = new MarkdownPipelineBuilder()
        .UseAdvancedExtensions()
        .Build();

    private static string RenderMarkdown(string markdown)
    {
        try
        {
            var html = Markdown.ToHtml(markdown, Pipeline);
            // Wrap each <pre> in a container with a copy button
            html = System.Text.RegularExpressions.Regex.Replace(html,
                @"<pre><code(?:\s+class=""language-(\w+)"")?>([\s\S]*?)</code></pre>",
                m =>
                {
                    var lang = m.Groups[1].Value;
                    var code = m.Groups[2].Value;
                    var langLabel = !string.IsNullOrEmpty(lang) ? $"<span class=\"code-lang\">{lang}</span>" : "";
                    return $"<div class=\"code-block-wrapper\">" +
                           $"<div class=\"code-block-header\">{langLabel}<button class=\"btn-copy\" onclick=\"sovrantInterop.copyCode(this)\">Copy</button></div>" +
                           $"<pre><code>{code}</code></pre></div>";
                });
            return html;
        }
        catch
        {
            return $"<pre>{System.Net.WebUtility.HtmlEncode(markdown)}</pre>";
        }
    }
}
