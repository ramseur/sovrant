<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- CA2007: ConfigureAwait not needed in Blazor Server (SynchronizationContext handles dispatch).
         CA1031: Top-level error handlers intentionally catch Exception.
         CA1848: LoggerMessage delegates are overkill for a web frontend's handful of log sites. -->
    <NoWarn>$(NoWarn);CA2007;CA1031;CA1848;CA1003;CA1062;CA1515;CA1716;CA1002</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" Version="0.40.0" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="9.0.4" />
    <PackageReference Include="BlazorMonaco" Version="3.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sovrant.Api\Sovrant.Api.csproj" />
    <ProjectReference Include="..\Sovrant.Api.Client\Sovrant.Api.Client.csproj" />
    <ProjectReference Include="..\Sovrant.Runtime\Sovrant.Runtime.csproj" />
    <ProjectReference Include="..\Sovrant.Tools\Sovrant.Tools.csproj" />
    <ProjectReference Include="..\Sovrant.Commands\Sovrant.Commands.csproj" />
    <ProjectReference Include="..\Sovrant.Agents\Sovrant.Agents.csproj" />
    <ProjectReference Include="..\Sovrant.Storage.Postgres\Sovrant.Storage.Postgres.csproj" />
  </ItemGroup>

</Project>
